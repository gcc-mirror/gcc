msgid "ISO C++11 requires at least one argument for the %<...%> in a variadic macro"
msgstr "ISO C++11 pieprasa vismaz vienu argumentu %<...%> mainīga argumentu skaita makro"

#: macro.cc:1213
#, gcc-internal-format
msgid "ISO C99 requires at least one argument for the %<...%> in a variadic macro"
msgstr "ISO C99 pieprasa vismaz vienu argumentu %<...%> mainīga argumentu skaita makro"

#: macro.cc:1220
#, gcc-internal-format
msgid "macro %qs requires %u arguments, but only %u given"
msgstr "makro %qs nepieciešami %u argumenti, bet doti tikai %u"

#: macro.cc:1225
#, gcc-internal-format
msgid "macro %qs passed %u arguments, but takes just %u"
msgstr "makro %qs nodoti %u argumenti, bet tas pieņem tikai %u"

#: macro.cc:1229
#, gcc-internal-format
msgid "macro %qs defined here"
msgstr "makro %qs definēts šeit"

#: macro.cc:1423 traditional.cc:822
#, gcc-internal-format
msgid "unterminated argument list invoking macro %qs"
msgstr "nepabeigts argumentu saraksts, izsaucot makro %qs"

#: macro.cc:1569
#, gcc-internal-format
msgid "function-like macro %qs must be used with arguments in traditional C"
msgstr "tradicionālajā C funkcijveida makro %qs jāizmanto ar argumentiem"

#: macro.cc:2404
#, gcc-internal-format, gfc-internal-format
msgid "invoking macro %s argument %d: empty macro arguments are undefined in ISO C++98"
msgstr "izsaucot makro %s argumentu %d: tukši makro argumenti ISO C++98 ir nedefinēti"

#: macro.cc:2412 macro.cc:2421
#, gcc-internal-format, gfc-internal-format
msgid "invoking macro %s argument %d: empty macro arguments are undefined in ISO C90"
msgstr "izsaucot makro %s argumentu %d: tukši makro argumenti ISO C90 ir nedefinēti"

#: macro.cc:3244
#, gcc-internal-format
msgid "%qc in module name or partition comes from or after macro expansion"
msgstr "%qc moduļa nosaukumā vai nodalījumā rodas no makro izvēršanas vai pēc tās"

#: macro.cc:3494
#, gcc-internal-format
msgid "duplicate macro parameter %qs"
msgstr "dublēts makro parametrs %qs"

#: macro.cc:3576
#, gcc-internal-format
msgid "expected parameter name, found %qs"
msgstr "gaidīts parametra nosaukums, atrasts %qs"

#: macro.cc:3577
#, gcc-internal-format
msgid "expected %<,%> or %<)%>, found %qs"
msgstr "gaidīts %<,%> vai %<)%>, atrasts %qs"

#: macro.cc:3578
msgid "expected parameter name before end of line"
msgstr "pirms rindas beigām gaidīts parametra nosaukums"

#: macro.cc:3579
#, gcc-internal-format
msgid "expected %<)%> before end of line"
msgstr "pirms rindas beigām gaidīts %<)%>"

#: macro.cc:3580
#, gcc-internal-format
msgid "expected %<)%> after %<...%>"
msgstr "pēc %<...%> gaidīts %<)%>"

#: macro.cc:3638
msgid "anonymous variadic macros were introduced in C++11"
msgstr "anonīmie mainīga argumentu skaita makro ieviesti C++11"

#: macro.cc:3639 macro.cc:3643
msgid "anonymous variadic macros were introduced in C99"
msgstr "anonīmie mainīga argumentu skaita makro ieviesti C99"

#: macro.cc:3649
msgid "ISO C++ does not permit named variadic macros"
msgstr "ISO C++ neatļauj nosauktus mainīga argumentu skaita makro"

#: macro.cc:3650
msgid "ISO C does not permit named variadic macros"
msgstr "ISO C neatļauj nosauktus mainīga argumentu skaita makro"

#: macro.cc:3696
#, gcc-internal-format
msgid "%<##%> cannot appear at either end of a macro expansion"
msgstr "%<##%> nevar būt nevienā makro izvēršanas galā"

#: macro.cc:3734
msgid "ISO C++11 requires whitespace after the macro name"
msgstr "ISO C++11 pieprasa tukšumzīmi pēc makro nosaukuma"

#: macro.cc:3735
msgid "ISO C99 requires whitespace after the macro name"
msgstr "ISO C99 pieprasa tukšumzīmi pēc makro nosaukuma"

#: macro.cc:3759
msgid "missing whitespace after the macro name"
msgstr "pēc makro nosaukuma trūkst tukšumzīmes"

#: macro.cc:3812
#, gcc-internal-format
msgid "%<#%> is not followed by a macro parameter"
msgstr "aiz %<#%> neseko makro parametrs"

#: macro.cc:3976 macro.cc:3980
#, gcc-internal-format
msgid "keyword %qs defined as macro"
msgstr "atslēgvārds %qs definēts kā makro"

#: macro.cc:3996
#, gcc-internal-format
msgid "%qs redefined"
msgstr "%qs pārdefinēts"

#: macro.cc:4000
msgid "this is the location of the previous definition"
msgstr "šī ir iepriekšējās definīcijas atrašanās vieta"

#: macro.cc:4009
#, gcc-internal-format
msgid "%qs defined"
msgstr "%qs definēts"

#: macro.cc:4143
#, gcc-internal-format
msgid "macro argument %qs would be stringified in traditional C"
msgstr "makro arguments %qs tradicionālajā C tiktu pārvērsts virknē"

#: pch.cc:90 pch.cc:342 pch.cc:356 pch.cc:374 pch.cc:380 pch.cc:389 pch.cc:396
msgid "while writing precompiled header"
msgstr "rakstot priekškompilēto galveni"

#: pch.cc:616
#, gcc-internal-format
msgid "%s: not used because %<%.*s%> is poisoned"
msgstr "%s: netiek izmantots, jo %<%.*s%> ir saindēts"

#: pch.cc:638
#, gcc-internal-format
msgid "%s: not used because %<%.*s%> not defined"
msgstr "%s: netiek izmantots, jo %<%.*s%> nav definēts"

#: pch.cc:650
#, gcc-internal-format
msgid "%s: not used because %<%.*s%> defined as %qs not %<%.*s%>"
msgstr "%s: netiek izmantots, jo %<%.*s%> definēts kā %qs, nevis %<%.*s%>"

#: pch.cc:693
#, gcc-internal-format
msgid "%s: not used because %qs is defined"
msgstr "%s: netiek izmantots, jo %qs ir definēts"

#: pch.cc:713
#, gcc-internal-format
msgid "%s: not used because %<__COUNTER__%> is invalid"
msgstr "%s: netiek izmantots, jo %<__COUNTER__%> ir nederīgs"

#: pch.cc:722 pch.cc:968
msgid "while reading precompiled header"
msgstr "lasot priekškompilēto galveni"

#: traditional.cc:891
#, gcc-internal-format
msgid "detected recursion whilst expanding macro %qs"
msgstr "izvēršot makro %qs, konstatēta rekursija"

#: traditional.cc:1114
msgid "syntax error in macro parameter list"
msgstr "sintakses kļūda makro parametru sarakstā"
