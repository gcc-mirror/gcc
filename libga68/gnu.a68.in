module GNU =
def
    { GNU68-2026-004-fixed-sized-modes }

    {iter L  {} {word}}
    {iter K  {} {WORDEN}}
    {iter L_ {} {word_}}
    pub op = = ({L} compl a,b) bool: (re'a = re'b AND im'a = im'b);
    pub op EQ = ({L} compl a,b) bool: a = b;

    pub op /= = ({L} compl a,b) bool: NOT (a = b);
    pub op NE = ({L} compl a,b) bool: a /= b;

    pub op + = ({L} compl a,b) {L} compl: (re'a + re'b, im'a + im'b);
    pub op +:= = (ref {L} compl a, {L} compl b) ref {L} compl:
       (a := a + b; a);
    pub op PLUSAB = (ref {L} compl a, {L} compl b) ref {L} compl:
       a +:= b;

    pub op - = ({L} compl a) {L} compl: (-re'a, -im'a);
    pub op - = ({L} compl a,b) {L} compl: (re'a - re'b, im'a - im'b);
    pub op -:= = (ref {L} compl a, {L} compl b) ref {L} compl:
       (a := a - b; a);
    pub op MINUSAB = (ref {L} compl a, {L} compl b) ref {L} compl:
       a -:= b;

    pub op * = ({L} compl a,b) {L} compl:
       (re'a * re'b - im'a * im'b, re'a * im'b + im'a * re'b);
    pub op *:= = (ref {L} compl a, {L} compl b) ref {L} compl:
       (a := a * b; a);
    pub op TIMESAB = (ref {L} compl a, {L} compl b) ref {L} compl:
       a *:= b;

    pub op / = ({L} compl a,b) {L} compl:
    begin
          {L} real d = re'(b * CONJ b);
          {L} compl n = a * CONJ b;
          (re'n/d, im'n/d)
    end;

    pub op /:= = (ref {L} compl a, {L} compl b) ref {L} compl:
       (a := a / b; a);
    pub op DIVAB = (ref {L} compl a, {L} compl b) ref {L} compl:
       a /:= b;

    pub op CONJ = ({L} compl z) {L} compl: (re'z, -im'z);
    pub op ABS  = ({L} compl z) {L} real: {L_}sqrt(re'z*re'z + im'z*im'z);

    pub op ARG = ({L} compl z) {L} real:
       if {L} real zr = re'z, zi = im'z;
          zr /= {L} 0 OR zi /= {L} 0
       then if ABS zr > ABS zi
            then {L_}arctan(zi/zr)
                 + {L_}pi/{L} 2*(zi<{L} 0 | {K} SIGN zr - {L} 1 | {L} 1 - {K} SIGN zr)
            else -{L_}arctan(zr/zi) + {L_}pi/{L} 2*{K} SIGN zi
            fi
       fi;
    {reti}

    skip
fed
