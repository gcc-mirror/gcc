msgstr "Specifies bis grootte van immediate TLS offsets. Geldige waardes is 12, 24, 32, 48."

#: config/aarch64/aarch64.opt:187
#, no-c-format
msgid "Use features of architecture ARCH."
msgstr "Gebruik kenmerke van argitektuur ARCH."

#: config/aarch64/aarch64.opt:191
#, no-c-format
msgid "Use features of and optimize for CPU."
msgstr "Gebruik kenmerke van en optimeer vir CPU."

#: config/aarch64/aarch64.opt:195
#, no-c-format
msgid "Optimize for CPU."
msgstr "Optimeer vir CPU."

#: config/aarch64/aarch64.opt:199
#, no-c-format
