#: cif-code.def:39
msgid "function not considered for inlining"
msgstr "funksie nie oorweeg vir inlining nie"

#: cif-code.def:43
msgid "caller is not optimized"
msgstr "caller is nie geoptimeer nie"

#: cif-code.def:47
msgid "function body not available"
msgstr "funksie body nie beskikbaar nie"

#: cif-code.def:51
msgid "redefined extern inline functions are not considered for inlining"
msgstr "herdefinieer extern inline funksies is nie oorweeg vir inlining nie"

#: cif-code.def:56
msgid "function not inlinable"
msgstr "funksie nie inlinable nie"

#: cif-code.def:60
msgid "function body can be overwritten at link time"
msgstr "funksie body kan wees overwritten by skakel tyd"

#: cif-code.def:64
msgid "function not inline candidate"
msgstr "funksie nie inline kandidaat nie"

#: cif-code.def:68
msgid "--param large-function-growth limit reached"
msgstr "--param large-function-growth limiet reached"

#: cif-code.def:70
msgid "--param large-stack-frame-growth limit reached"
msgstr "--param large-stack-frame-growth limiet reached"

#: cif-code.def:72
msgid "--param max-inline-insns-single limit reached"
msgstr "--param max-inline-insns-single limiet reached"

#: cif-code.def:74
msgid "--param max-inline-insns-auto limit reached"
msgstr "--param max-inline-insns-auto limiet reached"

#: cif-code.def:76
msgid "--param inline-unit-growth limit reached"
msgstr "--param inline-unit-growth limiet reached"

#: cif-code.def:80
msgid "recursive inlining"
msgstr "rekursiewe inlining"

#: cif-code.def:84
msgid "call is unlikely and code size would grow"
msgstr "oproep is unlikely en kode grootte sou groei"

#: cif-code.def:88
msgid "call is considered never executed and code size would grow"
msgstr "oproep is oorweeg nooit uitgevoer en kode grootte sou groei"

#: cif-code.def:92
msgid "function not declared inline and code size would grow"
msgstr "funksie nie verklaar inline en kode grootte sou groei nie"

#: cif-code.def:96
msgid "mismatched declarations during linktime optimization"
msgstr "mismatched declarations tydens linktime optimering"

#: cif-code.def:100
msgid "variadic thunk call"
msgstr "variadiese thunk oproep"

#: cif-code.def:104
msgid "originally indirect function call not considered for inlining"
msgstr "oorspronklik indirekte funksie-oproep nie oorweeg vir inlining nie"

#: cif-code.def:108
msgid "indirect function call with a yet undetermined callee"
msgstr "indirekte funksie-oproep met a nog undetermined callee"

#: cif-code.def:112
msgid "exception handling personality mismatch"
msgstr "uitsondering handling persoonlikheid wanpassing"

#: cif-code.def:117
msgid "non-call exception handling mismatch"
msgstr "non-call uitsondering handling wanpassing"

#: cif-code.def:121
msgid "target specific option mismatch"
msgstr "teiken spesifieke opsie wanpassing"

#: cif-code.def:125
msgid "optimization level attribute mismatch"
msgstr "optimering vlak kenmerk wanpassing"

#: cif-code.def:129
msgid "callee refers to comdat-local symbols"
msgstr "callee refers na comdat-local simbole"

#: cif-code.def:134
msgid "sanitizer function attribute mismatch"
msgstr "sanitizer funksie kenmerk wanpassing"

#: cif-code.def:139
msgid "function has external linkage when the user requests only inlining static for live patching"
msgstr "funksie het eksterne binding wanneer die gebruiker requests slegs inlining statiese vir live patching"

#: cif-code.def:145
msgid "callee must remain in translation unit"
msgstr "callee moet remain in translation eenheid"

#: cif-code.def:149
msgid "unreachable"
msgstr "onbereikbaar"

#: cif-code.def:154
msgid "callback edges cannot be inlined"
msgstr "callback edges kan nie wees geïnline nie"

