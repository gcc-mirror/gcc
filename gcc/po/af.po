#: common.opt:1205
#, no-c-format
msgid "Use sample profile information for call graph node weights. The default profile file is fbdata.afdo in 'pwd'."
msgstr "Gebruik sample profiel inligting vir oproep graph node weights. Die verstek profiel lêer is fbdata.afdo in 'pwd'."

#: common.opt:1210
#, no-c-format
msgid "Use sample profile information for call graph node weights. The profile file is specified in the argument."
msgstr "Gebruik sample profiel inligting vir oproep graph node weights. Die profiel lêer is gespesifiseer in die argument."

#: common.opt:1215
#, no-c-format
msgid "Perform inlining using auto-profile."
msgstr "Voer uit inlining gebruik auto-profile."

#: common.opt:1223
#, no-c-format
msgid "Generate code to check bounds before indexing arrays."
msgstr "Genereer kode na kontroleer grense voor indexing skikkings."

#: common.opt:1227
#, no-c-format
msgid "Replace add, compare, branch with branch on count register."
msgstr "Vervang voeg by, vergelyk, vertakking met vertakking op telling register."

#: common.opt:1231
#, no-c-format
msgid "Use profiling information for branch probabilities."
msgstr "Gebruik profilering inligting vir vertakking probabilities."

#: common.opt:1247
#, no-c-format
msgid "Output callgraph information on a per-file basis."
msgstr "Afvoer callgraph inligting op a per-file basis."

#: common.opt:1251
#, no-c-format
msgid "Output callgraph information on a per-file basis with decorations."
msgstr "Afvoer callgraph inligting op a per-file basis met decorations."

#: common.opt:1255
#, no-c-format
msgid "-fcall-saved-<register>\tMark <register> as being preserved across functions."
msgstr "-fcall-saved-<register>\tMark <register> as besig om te preserved oor funksies."

#: common.opt:1259
#, no-c-format
msgid "-fcall-used-<register>\tMark <register> as being corrupted by function calls."
msgstr "-fcall-used-<register>\tMark <register> as besig om te corrupted deur funksie oproepe."

#: common.opt:1266
#, no-c-format
msgid "Save registers around function calls."
msgstr "Bewaar registers rondom funksie oproepe."

#: common.opt:1270
#, no-c-format
msgid "This switch is deprecated; do not use."
msgstr "Hierdie skakelaar is verouderde; moenie gebruik."

#: common.opt:1274
#, no-c-format
msgid "Check the return value of new in C++."
msgstr "Kontroleer die terugkeer waarde van nuwe in C++."

#: common.opt:1278 common.opt:1282
#, no-c-format
msgid "Perform internal consistency checkings."
msgstr "Voer uit interne consistency checkings."

#: common.opt:1286
#, no-c-format
msgid "For -f*-prefix-map= options compare canonicalized pathnames rather than just strings."
msgstr "Vir -f*-prefix-map= opsies vergelyk canonicalized pathnames eerder as net strings."

#: common.opt:1290
#, no-c-format
msgid "Enable code hoisting."
msgstr "Aktiveer kode hoisting."

#: common.opt:1294
#, no-c-format
msgid "Looks for opportunities to reduce stack adjustments and stack references."
msgstr "Looks vir opportunities na verminder stapel adjustments en stapel references."

#: common.opt:1298
#, no-c-format
msgid "Put uninitialized globals in the common section."
msgstr "Put ongeïnisialiseerde globals in die gemeenskaplike afdeling."

#: common.opt:1306
#, no-c-format
msgid "-fcompare-debug[=<opts>]\tCompile with and without e.g. -gtoggle, and compare the final-insns dump."
msgstr "-fcompare-debug[=<opts>]\tKompileer met en sonder e.g. -gtoggle, en vergelyk die final-insns stort."

#: common.opt:1310
#, no-c-format
msgid "Run only the second compilation of -fcompare-debug."
msgstr "Run slegs die tweede kompilering van -fcompare-debug."

#: common.opt:1314
#, no-c-format
msgid "Perform comparison elimination after register allocation has finished."
msgstr "Voer uit vergelyking elimination ná register toewysing het finished."

#: common.opt:1318
#, no-c-format
msgid "Do not perform optimizations increasing noticeably stack usage."
msgstr "moenie voer uit optimizations increasing noticeably stapel gebruik."

#: common.opt:1322
#, no-c-format
msgid "Perform a register copy-propagation optimization pass."
msgstr "Voer uit a register copy-propagation optimering gee deur."

#: common.opt:1326
#, no-c-format
msgid "Fold instructions calculating memory offsets to the memory access instruction if possible."
msgstr "Vou instruksies calculating geheue offsets na die geheue toegang instruksie as moontlike."

#: common.opt:1330
#, no-c-format
msgid "Perform cross-jumping optimization."
msgstr "Voer uit cross-jumping optimering."

#: common.opt:1334
#, no-c-format
msgid "When running CSE, follow jumps to their targets."
msgstr "Wanneer running CSE, volg jumps na hul targets."

#: common.opt:1360
#, no-c-format
msgid "Omit range reduction step when performing complex division."
msgstr "Laat weg bestek vermindering step wanneer uitvoer van komplekse deling."

#: common.opt:1364
#, no-c-format
msgid "Complex multiplication and division follow Fortran rules."
msgstr "Komplekse vermenigvuldiging en deling volg Fortran reëls."

#: common.opt:1368
#, no-c-format
msgid "Place data items into their own section."
msgstr "Place data items in hul eie afdeling."

#: common.opt:1372
#, no-c-format
msgid "List all available debugging counters with their limits and counts."
msgstr "Lys alle beskikbaar ontfouting counters met hul limits en counts."

#: common.opt:1376
#, no-c-format
msgid "-fdbg-cnt=<counter>[:<lower_limit1>-]<upper_limit1>[:<lower_limit2>-<upper_limit2>:...][,<counter>:...]\tSet the debug counter limit."
msgstr "-fdbg-cnt=<teller>[:<onderste_limiet1>-]<boonste_limiet1>[:<onderste_limiet2>-<boonste_limiet2>:...][,<teller>:...]\tStel die ontfout teller limiet."

#: common.opt:1380
#, no-c-format
msgid "-fdebug-prefix-map=<old>=<new>\tMap one directory name to another in debug information."
msgstr "-fdebug-prefix-map=<ou>=<nuwe>\tMap one gids naam na nog 'n in ontfout inligting."

#: common.opt:1384
#, no-c-format
msgid "-ffile-prefix-map=<old>=<new>\tMap one directory name to another in compilation result."
msgstr "-ffile-prefix-map=<ou>=<nuwe>\tMap one gids naam na nog 'n in kompilering resultaat."

#: common.opt:1388
#, no-c-format
msgid "Output .debug_types section when using DWARF v4 debuginfo."
msgstr "Afvoer.ontfout_tipes afdeling wanneer gebruik DWARF v4 debuginfo."

#: common.opt:1394
#, no-c-format
msgid "Defer popping functions args from stack until later."
msgstr "Defer popping funksies args van stapel totdat later."

#: common.opt:1398
#, no-c-format
msgid "Attempt to fill delay slots of branch instructions."
msgstr "Attempt na fill delay slots van vertakking instruksies."

#: common.opt:1402
#, no-c-format
msgid "Delete dead instructions that may throw exceptions."
msgstr "Skrap dead instruksies wat mag gooi uitsonderings."

#: common.opt:1406
#, no-c-format
msgid "Delete useless null pointer checks."
msgstr "Skrap useless nullwyser checks."

#: common.opt:1410
#, no-c-format
msgid "Issue defining instructions back to back with their single uses, provided they are macro-fusible in the target microarchitecture."
msgstr "Issue defining instruksies back na back met hul enkele gebruik, verskaf hulle is macro-fusible in die teiken microarchitecture."

#: common.opt:1414
#, no-c-format
msgid "Stream extra data to support more aggressive devirtualization in LTO local transformation mode."
msgstr "Stroom ekstra data na ondersteun more aggressive devirtualization in LTO plaaslike transformation modus."

#: common.opt:1418
#, no-c-format
msgid "Perform speculative devirtualization."
msgstr "Voer uit spekulatiewe devirtualization."

#: common.opt:1422
#, no-c-format
msgid "Try to convert virtual calls to direct ones."
msgstr "Probeer na skakel om virtuele oproepe na direkte ones."

#: common.opt:1426
#, no-c-format
msgid "-fdiagnostics-show-location=[once|every-line]\tHow often to emit source location at the beginning of line-wrapped diagnostics."
msgstr "-fdiagnostics-show-location=[een keer|every-line]\tHow often na genereer bron ligging by die beginning van line-wrapped diagnostics."

#: common.opt:1443
#, no-c-format
msgid "Show the source line with a caret indicating the column."
msgstr "Show die bron reël met a karet indicating die kolom."

#: common.opt:1447
#, no-c-format
msgid "Show lines linking related events in diagnostic paths."
msgstr "Show lines skakeling related events in diagnostic paaie."

#: common.opt:1451
#, no-c-format
msgid "Show labels annotating ranges of source code when showing source."
msgstr "Show labels annotating ranges van bron kode wanneer showing bron."

#: common.opt:1455
#, no-c-format
msgid "Show line numbers in the left margin when showing source."
msgstr "Show reël numbers in die linker margin wanneer showing bron."

#: common.opt:1463
#, no-c-format
msgid "-fdiagnostics-color=[never|always|auto]\tColorize diagnostics."
msgstr "-fdiagnostics-color=[nooit|altyd|outomaties]\tColorize diagnostics."

#: common.opt:1483
#, no-c-format
msgid "Enable formatting of JSON output."
msgstr "Aktiveer formatting van JSON afvoer."

#: common.opt:1487
#, no-c-format
msgid "-fdiagnostics-urls=[never|always|auto]\tEmbed URLs in diagnostics."
msgstr "-fdiagnostics-urls=[nooit|altyd|outomaties]\tEmbed URLs in diagnostics."

#: common.opt:1507
#, no-c-format
msgid "-fdiagnostics-column-unit=[display|byte]\tSelect whether column numbers are output as display columns (default) or raw bytes."
msgstr "-fdiagnostics-column-unit=[display|greep]\tSelect of kolom numbers is afvoer as display columns (verstek) of raw grepe."

#: common.opt:1511
#, no-c-format
msgid "-fdiagnostics-column-origin=<number>\tSet the number of the first column.  The default is 1-based as per GNU style, but some utilities may expect 0-based, for example."
msgstr "-fdiagnostics-column-origin=<getal>\tStel die aantal die eerste kolom. Die verstek is 1-based as per GNU style, maar some utilities mag verwag 0-based, vir example."

#: common.opt:1515
#, no-c-format
msgid "-fdiagnostics-format=[text|sarif-stderr|sarif-file]\tSelect output format."
msgstr "-fdiagnostics-format=[teks|sarif-stderr|sarif-file]\tSelect afvoer formaat."

#: common.opt:1519
#, no-c-format
msgid "Add output format."
msgstr "Voeg by afvoer formaat."

#: common.opt:1523
#, no-c-format
msgid "Set output format."
msgstr "Stel afvoer formaat."

#: common.opt:1527
#, no-c-format
msgid "-fdiagnostics-escape-format=[unicode|bytes]\tSelect how to escape non-printable-ASCII bytes in the source for diagnostics that suggest it."
msgstr "-fdiagnostics-escape-format=[Unicode|grepe]\tSelect how na escape non-printable-ASCII grepe in die bron vir diagnostics wat stel voor dit."

#: common.opt:1565
#, no-c-format
msgid "Print fix-it hints in machine-readable form."
msgstr "Druk regstelling hints in machine-readable vorm."

#: common.opt:1569
#, no-c-format
msgid "Print fix-it hints to stderr in unified diff format."
msgstr "Druk regstelling hints na stderr in unified diff formaat."

#: common.opt:1573
#, no-c-format
msgid "Amend appropriate diagnostic messages with the command line option that controls them."
msgstr "Amend toepaslik diagnostic boodskappe met die opdragreël opsie wat controls them."

#: common.opt:1577
#, no-c-format
msgid "Print CWE identifiers for diagnostic messages, where available."
msgstr "Druk CWE identifiers vir diagnostic boodskappe, waar beskikbaar."

#: common.opt:1581
#, no-c-format
msgid "Print any rules associated with diagnostic messages."
msgstr "Druk enige reëls geassosieer met diagnostic boodskappe."

#: common.opt:1585
#, no-c-format
msgid "Use color within diagnostic messages to highlight pertinent information."
msgstr "Gebruik color binne diagnostic boodskappe na highlight pertinent inligting."

#: common.opt:1589
#, no-c-format
msgid "Specify how to print any control-flow path associated with a diagnostic."
msgstr "Spesifiseer how na druk enige control-flow pad geassosieer met a diagnostic."

#: common.opt:1593
#, no-c-format
msgid "Turn off any diagnostics features that complicate the output, such as line numbers, color, and warning URLs."
msgstr "Turn af enige diagnostics kenmerke wat complicate die afvoer, sulke as reël numbers, color, en waarskuwing URLs."

#: common.opt:1597
#, no-c-format
msgid "-ftabstop=<number>      Distance between tab stops for column reporting."
msgstr "-ftabstop=<getal> Distance tussen tab stops vir kolom reporting."

#: common.opt:1613
#, no-c-format
msgid "Show stack depths of events in paths."
msgstr "Show stapel depths van events in paaie."

#: common.opt:1617
#, no-c-format
msgid "-fdiagnostics-text-art-charset=[none|ascii|unicode|emoji]\tDetermine which characters to use in text arg diagrams."
msgstr "-fdiagnostics-text-art-charset=[geen|ascii|Unicode|emoji]\tDetermine wat karakters na gebruik in teks arg diagrams."

#: common.opt:1636
#, no-c-format
msgid "Set minimum width of left margin of source code when showing source."
msgstr "Stel minimum breedte van linker margin van bron kode wanneer showing bron."

#: common.opt:1640
#, no-c-format
msgid "Use indentation to show nesting of diagnostics in text output."
msgstr "Gebruik indentation na show nesting van diagnostics in teks afvoer."

#: common.opt:1644
#, no-c-format
msgid "Show location information when showing nested diagnostics."
msgstr "Show ligging inligting wanneer showing geneste diagnostics."

#: common.opt:1648
#, no-c-format
msgid "Show nesting levels as numbers when showing nested diagnostics."
msgstr "Show nesting levels as numbers wanneer showing geneste diagnostics."

#: common.opt:1655
#, no-c-format
msgid "Collect and print more context information for diagnostics."
msgstr "Collect en druk more konteks inligting vir diagnostics."

#: common.opt:1659
#, no-c-format
msgid "-fdisable-[tree|rtl|ipa]-<pass>=range1+range2\tDisable an optimization pass."
msgstr "-fdisable-[tree|rtl|IPA]-<gee deur>=bestek1+bestek2\tDeaktiveer 'n optimering gee deur."

#: common.opt:1663
#, no-c-format
msgid "-fenable-[tree|rtl|ipa]-<pass>=range1+range2\tEnable an optimization pass."
msgstr "-fenable-[tree|rtl|IPA]-<gee deur>=bestek1+bestek2\tAktiveer 'n optimering gee deur."

#: common.opt:1667
#, no-c-format
msgid "-fdump-<type>\tDump various compiler internals to a file."
msgstr "-fdump-<tipe>\tStort various kompileerder internals na a lêer."

#: common.opt:1674
#, no-c-format
msgid "-fdump-final-insns=filename\tDump to filename the insns at the end of translation."
msgstr "-fdump-final-insns=filename\tStort na filename die insns by die einde van translation."

#: common.opt:1678
#, no-c-format
msgid "-fdump-go-spec=filename\tWrite all declarations to file as Go code."
msgstr "-fdump-go-spec=filename\tSkryf alle declarations na lêer as Go kode."

#: common.opt:1682
#, no-c-format
msgid "Suppress output of addresses in debugging dumps."
msgstr "Suppress afvoer van addresses in ontfouting dumps."

#: common.opt:1686
#, no-c-format
msgid "Collect and dump debug information into temporary file if ICE in C/C++ compiler occurred."
msgstr "Collect en stort ontfout inligting in tydelike lêer as ICE in C/C++ kompileerder occurred."

#: common.opt:1691
#, no-c-format
msgid "Dump detailed information on GCC's internal representation of source code locations."
msgstr "Stort detailed inligting op GCC's interne representation van bron kode locations."

#: common.opt:1695
#, no-c-format
msgid "Dump optimization passes."
msgstr "Stort optimering passes."

#: common.opt:1699
#, no-c-format
msgid "Suppress output of instruction numbers, line number notes and addresses in debugging dumps."
msgstr "Suppress afvoer van instruksie numbers, reëlnommer notes en addresses in ontfouting dumps."

#: common.opt:1703
#, no-c-format
msgid "Suppress output of previous and next insn numbers in debugging dumps."
msgstr "Suppress afvoer van vorige en volgende insn numbers in ontfouting dumps."

#: common.opt:1707
#, no-c-format
msgid "Enable CFI tables via GAS assembler directives."
msgstr "Aktiveer CFI tables via GAS samesteller directives."

#: common.opt:1711
#, no-c-format
msgid "Perform early inlining."
msgstr "Voer uit early inlining."

#: common.opt:1719
#, no-c-format
msgid "Perform interprocedural reduction of aggregates."
msgstr "Voer uit interprocedural vermindering van aggregates."

#: common.opt:1723
#, no-c-format
msgid "Perform unused symbol elimination in debug info."
msgstr "Voer uit ongebruikte simbool elimination in ontfout inligting."

#: common.opt:1727
#, no-c-format
msgid "Perform unused type elimination in debug info."
msgstr "Voer uit ongebruikte tipe elimination in ontfout inligting."

#: common.opt:1731
#, no-c-format
msgid "Do not suppress C++ class debug information."
msgstr "moenie suppress C++ klas ontfout inligting."

#: common.opt:1735
#, no-c-format
msgid "Enable exception handling."
msgstr "Aktiveer uitsondering handling."

#: common.opt:1739
#, no-c-format
msgid "Perform a number of minor, expensive optimizations."
msgstr "Voer uit a aantal minor, expensive optimizations."

#: common.opt:1743
#, no-c-format
msgid "-fexcess-precision=[fast|standard|16]\tSpecify handling of excess floating-point precision."
msgstr "-fexcess-precision=[fast|standaard|16]\tSpesifiseer handling van excess dryfpunt presisie."

#: common.opt:1761
#, no-c-format
msgid "-fpermitted-flt-eval-methods=[c11|ts-18661]\tSpecify which values of FLT_EVAL_METHOD are permitted."
msgstr "-fpermitted-flt-eval-methods=[c11|ts-18661]\tSpesifiseer wat waardes van FLT_EVAL_METODE is toegelaat."

#: common.opt:1777
#, no-c-format
msgid "Output lto objects containing both the intermediate language and binary output."
msgstr "Afvoer LTO objekte containing beide die intermediate taal en binêre afvoer."

#: common.opt:1781
#, no-c-format
msgid "Assume no NaNs or infinities are generated."
msgstr "Neem aan geen NaNs of infinities is gegenereer."

#: common.opt:1785
#, no-c-format
msgid "Assume that loops with an exit will terminate and not loop indefinitely."
msgstr "Neem aan wat lusse met 'n verlaat sal beëindig en nie lus indefinitely nie."

#: common.opt:1789
#, no-c-format
msgid "-ffixed-<register>\tMark <register> as being unavailable to the compiler."
msgstr "-ffixed-<register>\tMark <register> as besig om te unavailable na die kompileerder."

#: common.opt:1793
#, no-c-format
msgid "Don't allocate floats and doubles in extended-precision registers."
msgstr "Don't wys toe floats en doubles in extended-precision registers."

#: common.opt:1801
#, no-c-format
msgid "Perform a forward propagation pass on RTL."
msgstr "Voer uit a forward propagation gee deur op RTL."

#: common.opt:1805
#, no-c-format
msgid "-ffp-contract=[off|on|fast]\tPerform floating-point expression contraction."
msgstr "-ffp-contract=[af|op|fast]\tVoer uit dryfpunt uitdrukking contraction."

#: common.opt:1821
#, no-c-format
msgid "Allow built-in functions ceil, floor, round, trunc to raise \"inexact\" exceptions."
msgstr "Laat toe ingeboude funksies ceil, floor, rond, trunc na raise \"onpresiese\" uitsonderings."

#: common.opt:1828
#, no-c-format
msgid "Allow function addresses to be held in registers."
msgstr "Laat toe funksie addresses na wees held in registers."

#: common.opt:1832
#, no-c-format
msgid "Place each function into its own section."
msgstr "Place elke funksie in sy eie afdeling."

#: common.opt:1836
#, no-c-format
msgid "Allow limited optimization of operations with volatile memory access."
msgstr "Laat toe limited optimering van bewerkings met vlugtige geheue toegang."

#: common.opt:1840
#, no-c-format
msgid "Perform global common subexpression elimination."
msgstr "Voer uit globale gemeenskaplike subexpression elimination."

#: common.opt:1844
#, no-c-format
msgid "Perform enhanced load motion during global common subexpression elimination."
msgstr "Voer uit enhanced laai motion tydens globale gemeenskaplike subexpression elimination."

#: common.opt:1848
#, no-c-format
msgid "Perform store motion after global common subexpression elimination."
msgstr "Voer uit stoor motion ná globale gemeenskaplike subexpression elimination."

#: common.opt:1852
#, no-c-format
msgid "Try to avoid store forwarding."
msgstr "Probeer na avoid stoor forwarding."

#: common.opt:1856
#, no-c-format
msgid "Perform redundant load after store elimination in global common subexpression elimination."
msgstr "Voer uit oortollige laai ná stoor elimination in globale gemeenskaplike subexpression elimination."

#: common.opt:1861
#, no-c-format
msgid "Perform global common subexpression elimination after register allocation has finished."
msgstr "Voer uit globale gemeenskaplike subexpression elimination ná register toewysing het finished."

#: common.opt:1878
#, no-c-format
msgid "-fgnat-encodings=[all|gdb|minimal]\tSelect the balance between GNAT encodings and standard DWARF emitted in the debug information."
msgstr "-fgnat-encodings=[alle|gdb|minimal]\tSelect die balance tussen GNAT encodings en standaard DWARF gegenereer in die ontfout inligting."

#: common.opt:1883
#, no-c-format
msgid "Enable in and out of Graphite representation."
msgstr "Aktiveer in en buite van Graphite representation."

#: common.opt:1887
#, no-c-format
msgid "Enable Graphite Identity transformation."
msgstr "Aktiveer Graphite Identity transformation."

#: common.opt:1891
#, no-c-format
msgid "Enable hoisting adjacent loads to encourage generating conditional move instructions."
msgstr "Aktiveer hoisting adjacent loads na encourage generating voorwaardelike skuif instruksies."

#: common.opt:1904
#, no-c-format
msgid "Run two instruction combination passes late in the pass pipeline; one before register allocation and one after."
msgstr "Run two instruksie combination passes late in die gee deur pipeline; one voor register toewysing en one ná."

#: common.opt:1909
#, no-c-format
msgid "Mark all loops as parallel."
msgstr "Mark alle lusse as parallelle."

#: common.opt:1913 common.opt:1921 common.opt:3319
#, no-c-format
msgid "Enable loop nest transforms.  Same as -floop-nest-optimize."
msgstr "Aktiveer lus nest transforms. Dieselfde as -floop-nest-optimize."

#: common.opt:1917
#, no-c-format
msgid "Enable loop interchange on trees."
msgstr "Aktiveer lus interchange op trees."

#: common.opt:1925
#, no-c-format
msgid "Perform unroll-and-jam on loops."
msgstr "Voer uit unroll-and-jam op lusse."

#: common.opt:1929
#, no-c-format
msgid "Enable support for GNU transactional memory."
msgstr "Aktiveer ondersteun vir GNU transactional geheue."

#: common.opt:1933
#, no-c-format
msgid "Use STB_GNU_UNIQUE if supported by the assembler."
msgstr "Gebruik STB_GNU_UNIEKE as ondersteun deur die samesteller."

#: common.opt:1941
#, no-c-format
msgid "Enable the loop nest optimizer."
msgstr "Aktiveer die lus nest optimizer."

#: common.opt:1945
#, no-c-format
msgid "Turn indirect calls of pointers loaded from structures to speculative calls if there is one known candidate."
msgstr "Turn indirekte oproepe van wysers gelaai van structures na spekulatiewe oproepe as daar is one known kandidaat."

#: common.opt:1949
#, no-c-format
msgid "Force bitfield accesses to match their type width."
msgstr "Force bitfield accesses na pas hul tipe breedte."

#: common.opt:1953
#, no-c-format
msgid "Merge adjacent stores."
msgstr "Saamvoeg adjacent stores."

#: common.opt:1957
#, no-c-format
msgid "Enable guessing of branch probabilities."
msgstr "Aktiveer guessing van vertakking probabilities."

#: common.opt:1961
#, no-c-format
msgid "Enable various security-relevant flags."
msgstr "Aktiveer various security-relevant vlae."

#: common.opt:1965
#, no-c-format
msgid "Harden conditionals not used in branches, checking reversed conditions."
msgstr "Harden conditionals nie gebruik in branches, kontrolering reversed conditions nie."

#: common.opt:1969
#, no-c-format
msgid "Harden conditional branches by checking reversed conditions."
msgstr "Harden voorwaardelike branches deur kontrolering reversed conditions."

#: common.opt:1973
#, no-c-format
msgid "Harden control flow by recording and checking execution paths."
msgstr "Harden beheer flow deur recording en kontrolering uitvoering paaie."

#: common.opt:1977
#, no-c-format
msgid "Disable CFR in leaf functions."
msgstr "Deaktiveer CFR in leaf funksies."

#: common.opt:1981
#, no-c-format
msgid "Check CFR execution paths also before calls followed by returns of their results."
msgstr "Kontroleer CFR uitvoering paaie ook voor oproepe followed deur returns van hul resultate."

#: common.opt:1985
#, no-c-format
msgid "Check CFR execution paths also when exiting a function through an exception."
msgstr "Kontroleer CFR uitvoering paaie ook wanneer exiting a funksie deur 'n uitsondering."

#: common.opt:1989
#, no-c-format
msgid "-fhardcfr-check-noreturn-calls=[always|no-xthrow|nothrow|never]\tCheck CFR execution paths also before calling noreturn functions."
msgstr "-fhardcfr-check-noreturn-calls=[altyd|no-xthrow|nothrow|nooit]\tKontroleer CFR uitvoering paaie ook voor oproep noreturn funksies."

#: common.opt:2010
#, no-c-format
msgid "Emit .ident assembler directives."
msgstr "Genereer.ident samesteller directives."

#: common.opt:2014
#, no-c-format
msgid "Perform conversion of conditional jumps to branchless equivalents."
msgstr "Voer uit omskakeling van voorwaardelike jumps na branchless equivalents."

#: common.opt:2018
#, no-c-format
msgid "Perform conversion of conditional jumps to conditional execution."
msgstr "Voer uit omskakeling van voorwaardelike jumps na voorwaardelike uitvoering."

#: common.opt:2022
#, no-c-format
msgid "-fstack-reuse=[all|named_vars|none]\tSet stack reuse level for local variables."
msgstr "-fstack-reuse=[alle|benoemde_vars|geen]\tStel stapel reuse vlak vir plaaslike veranderlikes."

#: common.opt:2038
#, no-c-format
msgid "Convert conditional jumps in innermost loops to branchless equivalents."
msgstr "Skakel om voorwaardelike jumps in innermost lusse na branchless equivalents."

#: common.opt:2050
#, no-c-format
msgid "Do not generate .size directives."
msgstr "moenie genereer.grootte directives."

#: common.opt:2054
#, no-c-format
msgid "Perform indirect inlining."
msgstr "Voer uit indirekte inlining."

#: common.opt:2060
#, no-c-format
msgid "Enable inlining of function declared \"inline\", disabling disables all inlining."
msgstr "Aktiveer inlining van funksie verklaar \"inline\", disabling disables alle inlining."

#: common.opt:2064
#, no-c-format
msgid "Integrate functions into their callers when code size is known not to grow."
msgstr "Integrate funksies in hul callers wanneer kode grootte is known nie na groei nie."

#: common.opt:2068
#, no-c-format
msgid "Integrate functions not declared \"inline\" into their callers when profitable."
msgstr "Integrate funksies nie verklaar \"inline\" in hul callers wanneer profitable nie."

#: common.opt:2072
#, no-c-format
msgid "Integrate functions only required by their single caller."
msgstr "Integrate funksies slegs vereis deur hul enkele caller."

#: common.opt:2079
#, no-c-format
msgid "-finline-limit=<number>\tLimit the size of inlined functions to <number>."
msgstr "-finline-limit=<getal>\tLimiet die grootte van geïnline funksies na <getal>."

#: common.opt:2083
#, no-c-format
msgid "Inline __atomic operations when a lock free instruction sequence is available."
msgstr "Inline __atomiese bewerkings wanneer a slot stel vry instruksie volgorde is beskikbaar."

#: common.opt:2093
#, no-c-format
msgid "-finline-stringops[=memcmp|memcpy|memmove|memset] Expand supported mem/str operations inline, even if against optimization."
msgstr "-finline-stringops[=memcmp|memcpy|memmove|memset] Brei uit ondersteun mem/str bewerkings inline, even as teen optimering."

#: common.opt:2121
#, no-c-format
msgid "Equivalent to -fcf-protection=full."
msgstr "Equivalent na -fcf-protection=volle."

#: common.opt:2125
#, no-c-format
msgid "-fcf-protection=[full|branch|return|none|check]\tInstrument functions with checks to verify jump/call/return control-flow transfer instructions have valid targets."
msgstr "-fcf-protection=[volle|vertakking|terugkeer|geen|kontroleer]\tInstrument funksies met checks na verify jump/oproep/terugkeer control-flow transfer instruksies het geldige targets."

#: common.opt:2148
#, no-c-format
msgid "Instrument function entry and exit with profiling calls."
msgstr "Instrument funksie inskrywing en verlaat met profilering oproepe."

#: common.opt:2152
#, no-c-format
msgid "Instrument function entry and exit with profiling calls invoked once."
msgstr "Instrument funksie inskrywing en verlaat met profilering oproepe invoked een keer."

#: common.opt:2156
#, no-c-format
msgid "-finstrument-functions-exclude-function-list=name,...\tDo not instrument listed functions."
msgstr "-finstrument-functions-exclude-function-list=naam,...\tmoenie instrument listed funksies."

#: common.opt:2160
#, no-c-format
msgid "-finstrument-functions-exclude-file-list=filename,...\tDo not instrument functions listed in files."
msgstr "-finstrument-functions-exclude-file-list=filename,...\tmoenie instrument funksies listed in lêers."

#: common.opt:2164
#, no-c-format
msgid "Perform interprocedural constant propagation."
msgstr "Voer uit interprocedural konstant propagation."

#: common.opt:2168
#, no-c-format
msgid "Perform cloning to make Interprocedural constant propagation stronger."
msgstr "Voer uit cloning na make Interprocedural konstant propagation stronger."

#: common.opt:2176
#, no-c-format
msgid "Perform interprocedural bitwise constant propagation."
msgstr "Voer uit interprocedural bisgewyse konstant propagation."

#: common.opt:2180
#, no-c-format
msgid "Perform interprocedural modref analysis."
msgstr "Voer uit interprocedural modref analysis."

#: common.opt:2184
#, no-c-format
msgid "Perform reordering and cloning of functions to maximize locality."
msgstr "Voer uit reordering en cloning van funksies na maximize locality."

#: common.opt:2188
#, no-c-format
msgid "Perform interprocedural profile propagation."
msgstr "Voer uit interprocedural profiel propagation."

#: common.opt:2192
#, no-c-format
msgid "Perform interprocedural points-to analysis."
msgstr "Voer uit interprocedural points-to analysis."

#: common.opt:2196
#, no-c-format
msgid "Discover pure and const functions."
msgstr "Discover suiwer en const funksies."

#: common.opt:2200
#, no-c-format
msgid "Perform Identical Code Folding for functions and read-only variables."
msgstr "Voer uit Identical Kode Folding vir funksies en read-only veranderlikes."

#: common.opt:2204
#, no-c-format
msgid "Perform Identical Code Folding for functions."
msgstr "Voer uit Identical Kode Folding vir funksies."

#: common.opt:2208
#, no-c-format
msgid "Perform Identical Code Folding for variables."
msgstr "Voer uit Identical Kode Folding vir veranderlikes."

#: common.opt:2212
#, no-c-format
msgid "Discover read-only and non addressable static variables."
msgstr "Discover read-only en non addressable statiese veranderlikes."

#: common.opt:2216
#, no-c-format
msgid "Discover read-only, write-only and non-addressable static variables."
msgstr "Discover read-only, write-only en non-addressable statiese veranderlikes."

#: common.opt:2220
#, no-c-format
msgid "Reduce stack alignment on call sites if possible."
msgstr "Verminder stapel belyning op oproep sites as moontlike."

#: common.opt:2232
#, no-c-format
msgid "Perform IPA Value Range Propagation."
msgstr "Voer uit IPA Waarde Bestek Propagation."

#: common.opt:2236
#, no-c-format
msgid "-fira-algorithm=[CB|priority]\tSet the used IRA algorithm."
msgstr "-fira-algorithm=[CB|prioriteit]\tStel die gebruik IRA algorithm."

#: common.opt:2240
#, no-c-format
msgid "Assume strict aliasing rules apply across (uninlined) function boundaries."
msgstr "Neem aan streng aliasing reëls pas toe oor (uninlined) funksie boundaries."

#: common.opt:2253
#, no-c-format
msgid "-fira-region=[one|all|mixed]\tSet regions for IRA."
msgstr "-fira-region=[one|alle|mixed]\tStel regions vir IRA."

#: common.opt:2269
#, no-c-format
msgid "Use IRA based register pressure calculation in RTL hoist optimizations."
msgstr "Gebruik IRA based register pressure berekening in RTL hys optimizations."

#: common.opt:2274
#, no-c-format
msgid "Use IRA based register pressure calculation in RTL loop optimizations."
msgstr "Gebruik IRA based register pressure berekening in RTL lus optimizations."

#: common.opt:2279
#, no-c-format
msgid "Share slots for saving different hard registers."
msgstr "Share slots vir saving verskillende hard registers."

#: common.opt:2283
#, no-c-format
msgid "Share stack slots for spilled pseudo-registers."
msgstr "Share stapel slots vir gestort pseudo-registers."

#: common.opt:2287
#, no-c-format
msgid "-fira-verbose=<number>\tControl IRA's level of diagnostic messages."
msgstr "-fira-verbose=<getal>\tBeheer IRA's vlak van diagnostic boodskappe."

#: common.opt:2291
#, no-c-format
msgid "Optimize induction variables on trees."
msgstr "Optimeer induction veranderlikes op trees."

#: common.opt:2295
#, no-c-format
msgid "Use jump tables for sufficiently large switch statements."
msgstr "Gebruik jump tables vir sufficiently groot skakelaar stellings."

#: common.opt:2299
#, no-c-format
msgid "Use bit tests for sufficiently large switch statements."
msgstr "Gebruik bis tests vir sufficiently groot skakelaar stellings."

#: common.opt:2303
#, no-c-format
msgid "Generate code for functions even if they are fully inlined."
msgstr "Genereer kode vir funksies even as hulle is ten volle geïnline."

#: common.opt:2307
#, no-c-format
msgid "Generate code for static functions even if they are never called."
msgstr "Genereer kode vir statiese funksies even as hulle is nooit opgeroep."

#: common.opt:2311
#, no-c-format
msgid "Emit static const variables even if they are not used."
msgstr "Genereer statiese const veranderlikes even as hulle is nie gebruik nie."

#: common.opt:2315
#, no-c-format
msgid "Give external symbols a leading underscore."
msgstr "Give eksterne simbole a leidende underscore."

#: common.opt:2323
#, no-c-format
msgid "Do CFG-sensitive rematerialization in LRA."
msgstr "Doen CFG-sensitive rematerialization in LRA."

#: common.opt:2327
#, no-c-format
msgid "Enable link-time optimization."
msgstr "Aktiveer skakeltyd optimering."

#: common.opt:2331
#, no-c-format
msgid "Link-time optimization with number of parallel jobs or jobserver."
msgstr "Skakeltyd optimering met aantal parallelle jobs of jobserver."

#: common.opt:2335
#, no-c-format
msgid "Enable incremental LTO, with its cache in given directory."
msgstr "Aktiveer incremental LTO, met sy kas in gegee gids."

#: common.opt:2339
#, no-c-format
msgid "Number of cache entries in incremental LTO after which to prune old entries."
msgstr "aantal kas entries in incremental LTO ná wat na prune ou entries."

#: common.opt:2364
#, no-c-format
msgid "Specify the algorithm to partition symbols and vars at linktime."
msgstr "Spesifiseer die algorithm na partisie simbole en vars by linktime."

#: common.opt:2368
#, no-c-format
msgid "Enable heuristics to recognize symbol identifiers in toplevel (not extended) assembly and prevent their mangling/deletion."
msgstr "Aktiveer heuristics na recognize simbool identifiers in toplevel (nie uitgebrei) assembly en prevent hul mangling/deletion nie."

#: common.opt:2373
#, no-c-format
msgid "Use zlib/zstd compression level <number> for IL."
msgstr "Gebruik zlib/zstd compression vlak <getal> vir IL."

#: common.opt:2381
#, no-c-format
msgid "Report various link-time optimization statistics."
msgstr "Verslag various skakeltyd optimering statistics."

#: common.opt:2385
#, no-c-format
msgid "Report various link-time optimization statistics for WPA only."
msgstr "Verslag various skakeltyd optimering statistics vir WPA slegs."

#: common.opt:2389
#, no-c-format
msgid "Set errno after built-in math functions."
msgstr "Stel errno ná ingeboude math funksies."

#: common.opt:2393
#, no-c-format
msgid "-fmax-errors=<number>\tMaximum number of errors to report."
msgstr "-fmax-errors=<getal>\tMaksimum aantal foute na verslag."

#: common.opt:2397
#, no-c-format
msgid "Allow removal of malloc and free pairs when allocated block is unused."
msgstr "Laat toe removal van malloc en stel vry pairs wanneer toegewys blok is ongebruikte."

#: common.opt:2404
#, no-c-format
msgid "Report on permanent memory allocation."
msgstr "Verslag op permanent geheue toewysing."

#: common.opt:2408
#, no-c-format
msgid "Report on permanent memory allocation in WPA only."
msgstr "Verslag op permanent geheue toewysing in WPA slegs."

#: common.opt:2415
#, no-c-format
msgid "Attempt to merge identical constants and constant variables."
msgstr "Attempt na saamvoeg identical konstantes en konstant veranderlikes."

#: common.opt:2419
#, no-c-format
msgid "Attempt to merge identical constants across compilation units."
msgstr "Attempt na saamvoeg identical konstantes oor kompilering units."

#: common.opt:2423
#, no-c-format
msgid "Attempt to merge identical debug strings across compilation units."
msgstr "Attempt na saamvoeg identical ontfout strings oor kompilering units."

#: common.opt:2427
#, no-c-format
msgid "-fmessage-length=<number>\tLimit diagnostics to <number> characters per line.  0 suppresses line-wrapping."
msgstr "-fmessage-length=<getal>\tLimiet diagnostics na <getal> karakters per reël. 0 suppresses line-wrapping."

#: common.opt:2431
#, no-c-format
msgid "Align the start of every function."
msgstr "Align die begin van elke funksie."

#: common.opt:2435
#, no-c-format
msgid "Perform SMS based modulo scheduling before the first scheduling pass."
msgstr "Voer uit SMS based modulo skedulering voor die eerste skedulering gee deur."

#: common.opt:2439
#, no-c-format
msgid "Perform SMS based modulo scheduling with register moves allowed."
msgstr "Voer uit SMS based modulo skedulering met register moves toegelaat."

#: common.opt:2443
#, no-c-format
msgid "Move loop invariant computations out of loops."
msgstr "Skuif lus invariant computations buite van lusse."

#: common.opt:2447
#, no-c-format
msgid "Move stores out of loops."
msgstr "Skuif stores buite van lusse."

#: common.opt:2451
#, no-c-format
msgid "Building block for specs-based multilib-aware TFLAGS."
msgstr "Building blok vir specs-based multilib-aware TFLAGS."

#: common.opt:2455
#, no-c-format
msgid "Use the RTL dead code elimination pass."
msgstr "Gebruik die RTL dead kode elimination gee deur."

#: common.opt:2459
#, no-c-format
msgid "Use the RTL dead store elimination pass."
msgstr "Gebruik die RTL dead stoor elimination gee deur."

#: common.opt:2463
#, no-c-format
msgid "Enable/Disable the traditional scheduling in loops that already passed modulo scheduling."
msgstr "Aktiveer/Deaktiveer die tradisionele skedulering in lusse wat reeds deurgegee modulo skedulering."

#: common.opt:2467
#, no-c-format
msgid "Support synchronous non-call exceptions."
msgstr "Ondersteun synchronous non-call uitsonderings."

#: common.opt:2474
#, no-c-format
msgid "-foffload-options=<targets>=<options>\tSpecify options for the offloading targets."
msgstr "-foffload-options=<targets>=<opsies>\tSpesifiseer opsies vir die offloading targets."

#: common.opt:2480
#, no-c-format
msgid "-foffload-abi=[lp64|ilp32]\tSet the ABI to use in an offload compiler."
msgstr "-foffload-abi=[lp64|ilp32]\tStel die ABI na gebruik in 'n offload kompileerder."

#: common.opt:2495
#, no-c-format
msgid "-foffload-abi-host-opts=<options>\tSpecify host ABI options."
msgstr "-foffload-abi-host-opts=<opsies>\tSpesifiseer gasheer ABI opsies."

#: common.opt:2499
#, no-c-format
msgid "When possible do not generate stack frames."
msgstr "Wanneer moontlike moenie genereer stapel frames."

#: common.opt:2506
#, no-c-format
msgid "Generate SIMD clones for functions with the OpenMP declare target directive."
msgstr "Genereer SIMD clones vir funksies met die OpenMP verklaar teiken direktef."

#: common.opt:2525
#, no-c-format
msgid "Enable all optimization info dumps on stderr."
msgstr "Aktiveer alle optimering inligting dumps op stderr."

#: common.opt:2529
#, no-c-format
msgid "-fopt-info[-<type>=filename]\tDump compiler optimization details."
msgstr "-fopt-info[-<tipe>=filename]\tStort kompileerder optimering details."

#: common.opt:2533
#, no-c-format
msgid "Write a SRCFILE.opt-record.json file detailing what optimizations were performed."
msgstr "Skryf a SRCFILE.opt-record.json lêer detailing what optimizations was uitgevoer."

#: common.opt:2537
#, no-c-format
msgid "Detect loops calculating CRC and replace with faster implementation. If the target supports CRC instruction and the CRC loop uses the same polynomial as the one used in the CRC instruction, directly replace with the corresponding CRC instruction. Otherwise, if the target supports carry-less-multiplication instruction, generate CRC using it. If neither case applies, generate table-based CRC."
msgstr "Detect lusse calculating CRC en vervang met faster implementering. As die teiken supports CRC instruksie en die CRC lus gebruik die dieselfde polynomial as die one gebruik in die CRC instruksie, direk vervang met die ooreenstemmende CRC instruksie. Andersins, as die teiken supports carry-less-multiplication instruksie, genereer CRC gebruik dit. As neither geval applies, genereer table-based CRC."

#: common.opt:2551
#, no-c-format
msgid "Optimize sibling and tail recursive calls."
msgstr "Optimeer sibbe en stert rekursiewe oproepe."

#: common.opt:2555
#, no-c-format
msgid "Insert path profiling code."
msgstr "Voeg in pad profilering kode."

#: common.opt:2559
#, no-c-format
msgid "Perform partial inlining."
msgstr "Voer uit gedeeltelike inlining."

#: common.opt:2563
#, no-c-format
msgid "Report on memory allocation before interprocedural optimization."
msgstr "Verslag op geheue toewysing voor interprocedural optimering."

#: common.opt:2567
#, no-c-format
msgid "Report on memory allocation after interprocedural optimization."
msgstr "Verslag op geheue toewysing ná interprocedural optimering."

#: common.opt:2571
#, no-c-format
msgid "Pack structure members together without holes."
msgstr "Pak structure lede together sonder holes."

#: common.opt:2575
#, no-c-format
msgid "-fpack-struct=<number>\tSet initial maximum structure member alignment."
msgstr "-fpack-struct=<getal>\tStel aanvanklike maksimum structure lid belyning."

#: common.opt:2579
#, no-c-format
msgid "Return small aggregates in memory, not registers."
msgstr "Terugkeer klein aggregates in geheue, nie registers nie."

#: common.opt:2583
#, no-c-format
msgid "Perform loop peeling."
msgstr "Voer uit lus peeling."

#: common.opt:2587
#, no-c-format
msgid "Enable machine specific peephole optimizations."
msgstr "Aktiveer machine spesifieke peephole optimizations."

#: common.opt:2591
#, no-c-format
msgid "Enable an RTL peephole pass before sched2."
msgstr "Aktiveer 'n RTL peephole gee deur voor sched2."

#: common.opt:2595
#, no-c-format
msgid "Generate position-independent code if possible (large mode)."
msgstr "Genereer position-independent kode as moontlike (groot modus)."

#: common.opt:2599
#, no-c-format
msgid "Generate position-independent code for executables if possible (large mode)."
msgstr "Genereer position-independent kode vir executables as moontlike (groot modus)."

#: common.opt:2603
#, no-c-format
msgid "Generate position-independent code if possible (small mode)."
msgstr "Genereer position-independent kode as moontlike (klein modus)."

#: common.opt:2607
#, no-c-format
msgid "Generate position-independent code for executables if possible (small mode)."
msgstr "Genereer position-independent kode vir executables as moontlike (klein modus)."

#: common.opt:2611
#, no-c-format
msgid "Use PLT for PIC calls (-fno-plt: load the address from GOT at call site)."
msgstr "Gebruik PLT vir PIC oproepe (-fno-plt: laai die adres van GOT by oproep site)."

#: common.opt:2615
#, no-c-format
msgid "Specify a plugin to load."
msgstr "Spesifiseer a inprop na laai."

#: common.opt:2619
#, no-c-format
msgid "-fplugin-arg-<name>-<key>[=<value>]\tSpecify argument <key>=<value> for plugin <name>."
msgstr "-fplugin-arg-<naam>-<key>[=<waarde>]\tSpesifiseer argument <key>=<waarde> vir inprop <naam>."

#: common.opt:2623
#, no-c-format
msgid "Run predictive commoning optimization."
msgstr "Run predictive commoning optimering."

#: common.opt:2627
#, no-c-format
msgid "Generate prefetch instructions, if available, for arrays in loops."
msgstr "Genereer prefetch instruksies, as beskikbaar, vir skikkings in lusse."

#: common.opt:2631
#, no-c-format
msgid "Enable basic program profiling code."
msgstr "Aktiveer basic program profilering kode."

#: common.opt:2635
#, no-c-format
msgid "Generate absolute source path names for gcov."
msgstr "Genereer absolute bron pad name vir gcov."

#: common.opt:2639
#, no-c-format
msgid "Insert arc-based program profiling code."
msgstr "Voeg in arc-based program profilering kode."

#: common.opt:2643
#, no-c-format
msgid "Insert condition coverage profiling code."
msgstr "Voeg in voorwaarde dekking profilering kode."

#: common.opt:2647
#, no-c-format
msgid "Set the top-level directory for storing the profile data. The default is 'pwd'."
msgstr "Stel die top-level gids vir storing die profiel data. Die verstek is 'pwd'."

#: common.opt:2652
#, no-c-format
msgid "Select the name for storing the profile note file."
msgstr "Select die naam vir storing die profiel nota lêer."

#: common.opt:2656
#, no-c-format
msgid "Enable correction of flow inconsistent profile data input."
msgstr "Aktiveer correction van flow inconsistent profiel data toevoer."

#: common.opt:2660
#, no-c-format
msgid "-fprofile-update=[single|atomic|prefer-atomic]\tSet the profile update method."
msgstr "-fprofile-update=[enkele|atomiese|prefer-atomic]\tStel die profiel update metode."

#: common.opt:2664
#, no-c-format
msgid "Instrument only functions from files whose name matches any of the regular expressions (separated by semi-colons)."
msgstr "Instrument slegs funksies van lêers wie se naam matches enige van die regular expressions (separated deur semi-colons)."

#: common.opt:2668
#, no-c-format
msgid "Instrument only functions from files whose name does not match any of the regular expressions (separated by semi-colons)."
msgstr "Instrument slegs funksies van lêers wie se naam doen nie pas enige van die regular expressions (separated deur semi-colons) nie."

#: common.opt:2684
#, no-c-format
msgid "-fprofile-reproducible=[serial|parallel-runs|multithreaded]\tControl level of reproducibility of profile gathered by -fprofile-generate."
msgstr "-fprofile-reproducible=[serial|parallel-runs|multithreaded]\tBeheer vlak van reproducibility van profiel gathered deur -fprofile-generate."

#: common.opt:2700
#, no-c-format
msgid "Remove prefix from absolute path before mangling name for -fprofile-generate= and -fprofile-use=."
msgstr "Verwyder voorvoegsel van absolute pad voor mangling naam vir -fprofile-generate= en -fprofile-use=."

#: common.opt:2704
#, no-c-format
msgid "-fprofile-prefix-map=<old>=<new>\tMap one directory name to another in GCOV coverage result."
msgstr "-fprofile-prefix-map=<ou>=<nuwe>\tMap one gids naam na nog 'n in GCOV dekking resultaat."

#: common.opt:2708
#, no-c-format
msgid "Enable common options for generating profile info for profile feedback directed optimizations."
msgstr "Aktiveer gemeenskaplike opsies vir generating profiel inligting vir profiel feedback directed optimizations."

#: common.opt:2712
#, no-c-format
msgid "Enable common options for generating profile info for profile feedback directed optimizations, and set -fprofile-dir=."
msgstr "Aktiveer gemeenskaplike opsies vir generating profiel inligting vir profiel feedback directed optimizations, en stel -fprofile-dir=."

#: common.opt:2716
#, no-c-format
msgid "Register the profile information in the .gcov_info section instead of using a constructor/destructor."
msgstr "Register die profiel inligting in die.gcov_inligting afdeling in plaas van gebruik a konstruktor/destruktor."

#: common.opt:2720
#, no-c-format
msgid "Register the profile information in the specified section instead of using a constructor/destructor."
msgstr "Register die profiel inligting in die gespesifiseer afdeling in plaas van gebruik a konstruktor/destruktor."

#: common.opt:2724
#, no-c-format
msgid "Do not assume that functions never executed during the train run are cold."
msgstr "moenie neem aan wat funksies nooit uitgevoer tydens die train run is cold."

#: common.opt:2728
#, no-c-format
msgid "Enable common options for performing profile feedback directed optimizations."
msgstr "Aktiveer gemeenskaplike opsies vir uitvoer van profiel feedback directed optimizations."

#: common.opt:2732
#, no-c-format
msgid "Enable common options for performing profile feedback directed optimizations, and set -fprofile-dir=."
msgstr "Aktiveer gemeenskaplike opsies vir uitvoer van profiel feedback directed optimizations, en stel -fprofile-dir=."

#: common.opt:2736
#, no-c-format
msgid "Insert code to profile values of expressions."
msgstr "Voeg in kode na profiel waardes van expressions."

#: common.opt:2740
#, no-c-format
msgid "Report on consistency of profile."
msgstr "Verslag op consistency van profiel."

#: common.opt:2744
#, no-c-format
msgid "Enable function reordering that improves code placement."
msgstr "Aktiveer funksie reordering wat improves kode placement."

#: common.opt:2748
#, no-c-format
msgid "Insert NOP instructions at each function entry."
msgstr "Voeg in NOP instruksies by elke funksie inskrywing."

#: common.opt:2755
#, no-c-format
msgid "-frandom-seed=<string>\tMake compile reproducible using <string>."
msgstr "-frandom-seed=<string>\tMake kompileer reproducible gebruik <string>."

#: common.opt:2765
#, no-c-format
msgid "Record gcc command line switches in the object file."
msgstr "Rekord GCC opdragreël switches in die objek lêer."

#: common.opt:2769
#, no-c-format
msgid "Return small aggregates in registers."
msgstr "Terugkeer klein aggregates in registers."

#: common.opt:2777
#, no-c-format
msgid "Tell DSE that the storage for a C++ object is dead when the constructor starts and when the destructor finishes."
msgstr "Tell DSE wat die berging vir a C++ objek is dead wanneer die konstruktor starts en wanneer die destruktor finishes."

#: common.opt:2791
#, no-c-format
msgid "-flive-patching=[inline-only-static|inline-clone]\tControl IPA optimizations to provide a safe compilation for live-patching.  At the same time, provides multiple-level control on the enabled IPA optimizations."
msgstr "-flive-patching=[inline-only-static|inline-clone]\tBeheer IPA optimizations na verskaf a safe kompilering vir live-patching. By die dieselfde tyd, provides multiple-level beheer op die geaktiveer IPA optimizations."

#: common.opt:2806
#, no-c-format
msgid "Tell DCE to remove unused C++ allocations."
msgstr "Tell DCE na verwyder ongebruikte C++ allocations."

#: common.opt:2810
#, no-c-format
msgid "Relief of register pressure through live range shrinkage."
msgstr "Relief van register pressure deur live bestek shrinkage."

#: common.opt:2814
#, no-c-format
msgid "Perform a register renaming optimization pass."
msgstr "Voer uit a register renaming optimering gee deur."

#: common.opt:2818
#, no-c-format
msgid "Perform a target dependent instruction fusion optimization pass."
msgstr "Voer uit a teiken afhanklike instruksie fusion optimering gee deur."

#: common.opt:2822
#, no-c-format
msgid "Reorder basic blocks to improve code placement."
msgstr "Reorder basic blokke na improve kode placement."

#: common.opt:2826
#, no-c-format
msgid "-freorder-blocks-algorithm=[simple|stc]\tSet the used basic block reordering algorithm."
msgstr "-freorder-blocks-algorithm=[simple|stc]\tStel die gebruik basic blok reordering algorithm."

#: common.opt:2839
#, no-c-format
msgid "Reorder basic blocks and partition into hot and cold sections."
msgstr "Reorder basic blokke en partisie in hot en cold sections."

#: common.opt:2843
#, no-c-format
msgid "Reorder functions to improve code placement."
msgstr "Reorder funksies na improve kode placement."

#: common.opt:2847
#, no-c-format
msgid "Add a common subexpression elimination pass after loop optimizations."
msgstr "Voeg by a gemeenskaplike subexpression elimination gee deur ná lus optimizations."

#: common.opt:2855
#, no-c-format
msgid "Disable optimizations that assume default FP rounding behavior."
msgstr "Deaktiveer optimizations wat neem aan verstek FP afronding gedrag."

#: common.opt:2859
#, no-c-format
msgid "Enable scheduling across basic blocks."
msgstr "Aktiveer skedulering oor basic blokke."

#: common.opt:2863
#, no-c-format
msgid "Enable register pressure sensitive insn scheduling."
msgstr "Aktiveer register pressure sensitive insn skedulering."

#: common.opt:2867
#, no-c-format
msgid "Allow speculative motion of non-loads."
msgstr "Laat toe spekulatiewe motion van non-loads."

#: common.opt:2871
#, no-c-format
msgid "Allow speculative motion of some loads."
msgstr "Laat toe spekulatiewe motion van some loads."

#: common.opt:2875
#, no-c-format
msgid "Allow speculative motion of more loads."
msgstr "Laat toe spekulatiewe motion van more loads."

#: common.opt:2879
#, no-c-format
msgid "-fsched-verbose=<number>\tSet the verbosity level of the scheduler."
msgstr "-fsched-verbose=<getal>\tStel die verbosity vlak van die scheduler."

#: common.opt:2883
#, no-c-format
msgid "If scheduling post reload, do superblock scheduling."
msgstr "As skedulering post herlaai, doen superblock skedulering."

#: common.opt:2891
#, no-c-format
msgid "Reschedule instructions before register allocation."
msgstr "Reschedule instruksies voor register toewysing."

#: common.opt:2895
#, no-c-format
msgid "Reschedule instructions after register allocation."
msgstr "Reschedule instruksies ná register toewysing."

#: common.opt:2902
#, no-c-format
msgid "Schedule instructions using selective scheduling algorithm."
msgstr "Skeduleer instruksies gebruik selective skedulering algorithm."

#: common.opt:2906
#, no-c-format
msgid "Run selective scheduling after reload."
msgstr "Run selective skedulering ná herlaai."

#: common.opt:2910
#, no-c-format
msgid "Run self-tests, using the given path to locate test files."
msgstr "Run self-tests, gebruik die gegee pad na locate test lêers."

#: common.opt:2914
#, no-c-format
msgid "Perform software pipelining of inner loops during selective scheduling."
msgstr "Voer uit software pipelining van binneste lusse tydens selective skedulering."

#: common.opt:2918
#, no-c-format
msgid "Perform software pipelining of outer loops during selective scheduling."
msgstr "Voer uit software pipelining van buitenste lusse tydens selective skedulering."

#: common.opt:2923
#, no-c-format
msgid "Reschedule pipelined regions without pipelining."
msgstr "Reschedule pipelined regions sonder pipelining."

#: common.opt:2927
#, no-c-format
msgid "Allow interposing function (or variables) by ones with different semantics (or initializer) respectively by dynamic linker."
msgstr "Laat toe interposing funksie (of veranderlikes) deur ones met verskillende semantics (of inisieerder) onderskeidelik deur dinamiese skakelaar."

#: common.opt:2933
#, no-c-format
msgid "Allow premature scheduling of queued insns."
msgstr "Laat toe premature skedulering van queued insns."

#: common.opt:2937
#, no-c-format
msgid "-fsched-stalled-insns=<number>\tSet number of queued insns that can be prematurely scheduled."
msgstr "-fsched-stalled-insns=<getal>\tStel aantal queued insns wat kan wees prematurely geskeduleer."

#: common.opt:2945
#, no-c-format
msgid "Set dependence distance checking in premature scheduling of queued insns."
msgstr "Stel dependence distance kontrolering in premature skedulering van queued insns."

#: common.opt:2949
#, no-c-format
msgid "-fsched-stalled-insns-dep=<number>\tSet dependence distance checking in premature scheduling of queued insns."
msgstr "-fsched-stalled-insns-dep=<getal>\tStel dependence distance kontrolering in premature skedulering van queued insns."

#: common.opt:2953
#, no-c-format
msgid "Enable the group heuristic in the scheduler."
msgstr "Aktiveer die groep heuristic in die scheduler."

#: common.opt:2957
#, no-c-format
msgid "Enable the critical path heuristic in the scheduler."
msgstr "Aktiveer die critical pad heuristic in die scheduler."

#: common.opt:2961
#, no-c-format
msgid "Enable the speculative instruction heuristic in the scheduler."
msgstr "Aktiveer die spekulatiewe instruksie heuristic in die scheduler."

#: common.opt:2965
#, no-c-format
msgid "Enable the rank heuristic in the scheduler."
msgstr "Aktiveer die rang heuristic in die scheduler."

#: common.opt:2969
#, no-c-format
msgid "Enable the last instruction heuristic in the scheduler."
msgstr "Aktiveer die laaste instruksie heuristic in die scheduler."

#: common.opt:2973
#, no-c-format
msgid "Enable the dependent count heuristic in the scheduler."
msgstr "Aktiveer die afhanklike telling heuristic in die scheduler."

#: common.opt:2977
#, no-c-format
msgid "Access data in the same section from shared anchor points."
msgstr "Toegang data in die dieselfde afdeling van gedeelde anchor points."

#: common.opt:2989
#, no-c-format
msgid "Turn on Redundant Extensions Elimination pass."
msgstr "Turn op Oortollige Uitbreidings Elimination gee deur."

#: common.opt:2993
#, no-c-format
msgid "Show column numbers in diagnostics, when available.  Default on."
msgstr "Show kolom numbers in diagnostics, wanneer beskikbaar. Verstek op."

#: common.opt:2997
#, no-c-format
msgid "Emit function prologues only before parts of the function that need it, rather than at the top of the function."
msgstr "Genereer funksie prologues slegs voor parts van die funksie wat hoef dit, eerder as by die top van die funksie."

#: common.opt:3002
#, no-c-format
msgid "Shrink-wrap parts of the prologue and epilogue separately."
msgstr "Shrink-wrap parts van die prologue en epilogue separately."

#: common.opt:3006
#, no-c-format
msgid "Disable optimizations observable by IEEE signaling NaNs."
msgstr "Deaktiveer optimizations observable deur IEEE seinende NaNs."

#: common.opt:3010
#, no-c-format
msgid "Disable floating point optimizations that ignore the IEEE signedness of zero."
msgstr "Deaktiveer dryfpunt optimizations wat ignoreer die IEEE signedness van nul."

#: common.opt:3014
#, no-c-format
msgid "Convert floating point constants to single precision constants."
msgstr "Skakel om dryfpunt konstantes na enkele presisie konstantes."

#: common.opt:3018
#, no-c-format
msgid "Split lifetimes of induction variables when loops are unrolled."
msgstr "Split lifetimes van induction veranderlikes wanneer lusse is uitgerol."

#: common.opt:3022
#, no-c-format
msgid "Generate discontiguous stack frames."
msgstr "Genereer discontiguous stapel frames."

#: common.opt:3026
#, no-c-format
msgid "Split wide types into independent registers."
msgstr "Split wyd tipes in independent registers."

#: common.opt:3030
#, no-c-format
msgid "Split wide types into independent registers earlier."
msgstr "Split wyd tipes in independent registers vroeër."

#: common.opt:3034
#, no-c-format
msgid "Enable backward propagation of use properties at the SSA level."
msgstr "Aktiveer backward propagation van gebruik properties by die SSA vlak."

#: common.opt:3038
#, no-c-format
msgid "Optimize conditional patterns using SSA PHI nodes."
msgstr "Optimeer voorwaardelike patterns gebruik SSA PHI nodes."

#: common.opt:3042
#, no-c-format
msgid "Optimize amount of stdarg registers saved to stack at start of function."
msgstr "Optimeer hoeveelheid van stdarg registers saved na stapel by begin van funksie."

#: common.opt:3046
#, no-c-format
msgid "Apply variable expansion when loops are unrolled."
msgstr "Pas toe veranderlike uitbreiding wanneer lusse is uitgerol."

#: common.opt:3050
#, no-c-format
msgid "-fstack-check=[no|generic|specific]\tInsert stack checking code into the program."
msgstr "-fstack-check=[geen|generiese|spesifieke]\tVoeg in stapel kontrolering kode in die program."

#: common.opt:3054
#, no-c-format
msgid "Insert stack checking code into the program.  Same as -fstack-check=specific."
msgstr "Voeg in stapel kontrolering kode in die program. Dieselfde as -fstack-check=spesifieke."

#: common.opt:3058
#, no-c-format
msgid "Insert code to probe each page of stack space as it is allocated to protect from stack-clash style attacks."
msgstr "Voeg in kode na probe elke page van stapel space as dit is toegewys na protect van stack-clash style attacks."

#: common.opt:3067
#, no-c-format
msgid "-fstack-limit-register=<register>\tTrap if the stack goes past <register>."
msgstr "-fstack-limit-register=<register>\tVal as die stapel goes past <register>."

#: common.opt:3071
#, no-c-format
msgid "-fstack-limit-symbol=<name>\tTrap if the stack goes past symbol <name>."
msgstr "-fstack-limit-symbol=<naam>\tVal as die stapel goes past simbool <naam>."

#: common.opt:3075
#, no-c-format
msgid "Use propolice as a stack protection method."
msgstr "Gebruik propolice as a stapel protection metode."

#: common.opt:3079
#, no-c-format
msgid "Use a stack protection method for every function."
msgstr "Gebruik a stapel protection metode vir elke funksie."

#: common.opt:3083
#, no-c-format
msgid "Use a smart stack protection method for certain functions."
msgstr "Gebruik a smart stapel protection metode vir certain funksies."

#: common.opt:3087
#, no-c-format
msgid "Use stack protection method only for functions with the stack_protect attribute."
msgstr "Gebruik stapel protection metode slegs vir funksies met die stapel_protect kenmerk."

#: common.opt:3091
#, no-c-format
msgid "Output stack usage information on a per-function basis."
msgstr "Afvoer stapel gebruik inligting op a per-function basis."

#: common.opt:3103
#, no-c-format
msgid "Assume strict aliasing rules apply."
msgstr "Neem aan streng aliasing reëls pas toe."

#: common.opt:3107
#, no-c-format
msgid "Treat signed overflow as undefined.  Negated as -fwrapv -fwrapv-pointer."
msgstr "Treat getekende oorloop as ongedefinieerde. Negated as -fwrapv -fwrapv-pointer."

#: common.opt:3111
#, no-c-format
msgid "Disable stack scrub entirely, disregarding strub attributes."
msgstr "Deaktiveer stapel scrub heeltemal, disregarding strub kenmerke."

#: common.opt:3115
#, no-c-format
msgid "Enable stack scrub as per attributes, with strict call checking."
msgstr "Aktiveer stapel scrub as per kenmerke, met streng oproep kontrolering."

#: common.opt:3124
#, no-c-format
msgid "Restore default strub mode: as per attributes, with relaxed checking."
msgstr "Restore verstek strub modus: as per kenmerke, met verslapte kontrolering."

#: common.opt:3128
#, no-c-format
msgid "Enable stack scrubbing for all viable functions."
msgstr "Aktiveer stapel scrubbing vir alle lewensvatbare funksies."

#: common.opt:3132
#, no-c-format
msgid "Enable at-calls stack scrubbing for all viable functions."
msgstr "Aktiveer at-calls stapel scrubbing vir alle lewensvatbare funksies."

#: common.opt:3136
#, no-c-format
msgid "Enable internal stack scrubbing for all viable functions."
msgstr "Aktiveer interne stapel scrubbing vir alle lewensvatbare funksies."

#: common.opt:3140
#, no-c-format
msgid "Implement __atomic operations via libcalls to legacy __sync functions."
msgstr "Implement __atomiese bewerkings via libcalls na legacy __sync funksies."

#: common.opt:3144
#, no-c-format
msgid "Check for syntax errors, then stop."
msgstr "Kontroleer vir sintaksis foute, dan stop."

#: common.opt:3148
#, no-c-format
msgid "Create data files needed by \"gcov\"."
msgstr "Skep data lêers benodig deur \"gcov\"."

#: common.opt:3152
#, no-c-format
msgid "Perform jump threading optimizations."
msgstr "Voer uit jump threading optimizations."

#: common.opt:3156
#, no-c-format
msgid "Report the time taken by each compiler pass."
msgstr "Verslag die tyd taken deur elke kompileerder gee deur."

#: common.opt:3160
#, no-c-format
msgid "Record times taken by sub-phases separately."
msgstr "Rekord keer taken deur sub-phases separately."

#: common.opt:3164
#, no-c-format
msgid "-ftls-model=[global-dynamic|local-dynamic|initial-exec|local-exec]\tSet the default thread-local storage code generation model."
msgstr "-ftls-model=[global-dynamic|local-dynamic|initial-exec|local-exec]\tStel die verstek draad-lokaal berging kode generation model."

#: common.opt:3183
#, no-c-format
msgid "Reorder top level functions, variables, and asms."
msgstr "Reorder top vlak funksies, veranderlikes, en asms."

#: common.opt:3187
#, no-c-format
msgid "Perform superblock formation via tail duplication."
msgstr "Voer uit superblock formation via stert duplication."

#: common.opt:3191
#, no-c-format
msgid "For targets that normally need trampolines for nested functions, always generate them instead of using descriptors."
msgstr "Vir targets wat normaalweg hoef trampolines vir geneste funksies, altyd genereer them in plaas van gebruik descriptors."

#: common.opt:3196
#, no-c-format
msgid "Whether trampolines are generated in executable memory rather than executable stack."
msgstr "Of trampolines is gegenereer in uitvoerbare lêer geheue eerder as uitvoerbare lêer stapel."

#: common.opt:3214
#, no-c-format
msgid "Assume floating-point operations can trap."
msgstr "Neem aan dryfpunt bewerkings kan val."

#: common.opt:3218
#, no-c-format
msgid "Trap for signed overflow in addition, subtraction and multiplication."
msgstr "Val vir getekende oorloop in addition, subtraction en vermenigvuldiging."

#: common.opt:3222
#, no-c-format
msgid "Enable SSA-CCP optimization on trees."
msgstr "Aktiveer SSA-CCP optimering op trees."

#: common.opt:3226
#, no-c-format
msgid "Enable SSA-BIT-CCP optimization on trees."
msgstr "Aktiveer SSA-BIT-CCP optimering op trees."

#: common.opt:3234
#, no-c-format
msgid "Enable loop header copying on trees."
msgstr "Aktiveer lus koplêer copying op trees."

#: common.opt:3242
#, no-c-format
msgid "Enable SSA coalescing of user variables."
msgstr "Aktiveer SSA coalescing van gebruiker veranderlikes."

#: common.opt:3250
#, no-c-format
msgid "Enable copy propagation on trees."
msgstr "Aktiveer kopie propagation op trees."

#: common.opt:3258
#, no-c-format
msgid "Transform condition stores into unconditional ones."
msgstr "Transform voorwaarde stores in unconditional ones."

#: common.opt:3262
#, no-c-format
msgid "Perform conversions of switch initializations."
msgstr "Voer uit conversions van skakelaar initializations."

#: common.opt:3266
#, no-c-format
msgid "Enable SSA dead code elimination optimization on trees."
msgstr "Aktiveer SSA dead kode elimination optimering op trees."

#: common.opt:3270
#, no-c-format
msgid "Enable dominator optimizations."
msgstr "Aktiveer dominator optimizations."

#: common.opt:3274
#, no-c-format
msgid "Enable tail merging on trees."
msgstr "Aktiveer stert merging op trees."

#: common.opt:3278
#, no-c-format
msgid "Enable dead store elimination."
msgstr "Aktiveer dead stoor elimination."

#: common.opt:3282
#, no-c-format
msgid "Enable forward propagation on trees."
msgstr "Aktiveer forward propagation op trees."

#: common.opt:3286
#, no-c-format
msgid "Enable Full Redundancy Elimination (FRE) on trees."
msgstr "Aktiveer Volle Redundancy Elimination (FRE) op trees."

#: common.opt:3290
#, no-c-format
msgid "Enable string length optimizations on trees."
msgstr "Aktiveer string lengte optimizations op trees."

#: common.opt:3294
#, no-c-format
msgid "Detect paths that trigger erroneous or undefined behavior due to dereferencing a null pointer.  Isolate those paths from the main control flow and turn the statement with erroneous or undefined behavior into a trap."
msgstr "Detect paaie wat trigger erroneous of ongedefinieerde gedrag due na dereferencing a nullwyser. Isolate daardie paaie van die main beheer flow en turn die stelling met erroneous of ongedefinieerde gedrag in a val."

#: common.opt:3300
#, no-c-format
msgid "Detect paths that trigger erroneous or undefined behavior due to a null value being used in a way forbidden by a returns_nonnull or nonnull attribute.  Isolate those paths from the main control flow and turn the statement with erroneous or undefined behavior into a trap."
msgstr "Detect paaie wat trigger erroneous of ongedefinieerde gedrag due na a null waarde besig om te gebruik in a wyse verbode deur a returns_nonnull of nonnull kenmerk. Isolate daardie paaie van die main beheer flow en turn die stelling met erroneous of ongedefinieerde gedrag in a val."

#: common.opt:3307
#, no-c-format
msgid "Enable loop distribution on trees."
msgstr "Aktiveer lus distribution op trees."

#: common.opt:3311
#, no-c-format
msgid "Enable loop distribution for patterns transformed into a library call."
msgstr "Aktiveer lus distribution vir patterns transformed in a biblioteek oproep."

#: common.opt:3315
#, no-c-format
msgid "Enable loop invariant motion on trees."
msgstr "Aktiveer lus invariant motion op trees."

#: common.opt:3323
#, no-c-format
msgid "Create canonical induction variables in loops."
msgstr "Skep kanonieke induction veranderlikes in lusse."

#: common.opt:3327
#, no-c-format
msgid "Enable loop optimizations on tree level."
msgstr "Aktiveer lus optimizations op tree vlak."

#: common.opt:3331
#, no-c-format
msgid "-ftree-parallelize-loops=<number>\tEnable automatic parallelization of loops."
msgstr "-ftree-parallelize-loops=<getal>\tAktiveer outomatiese parallelization van lusse."

#: common.opt:3335
#, no-c-format
msgid "Enable automatic parallelization of loops."
msgstr "Aktiveer outomatiese parallelization van lusse."

#: common.opt:3339
#, no-c-format
msgid "Enable hoisting loads from conditional pointers."
msgstr "Aktiveer hoisting loads van voorwaardelike wysers."

#: common.opt:3343
#, no-c-format
msgid "Enable SSA-PRE optimization on trees."
msgstr "Aktiveer SSA-PRE optimering op trees."

#: common.opt:3347
#, no-c-format
msgid "In SSA-PRE optimization on trees, enable partial-partial redundancy elimination."
msgstr "In SSA-PRE optimering op trees, aktiveer partial-partial redundancy elimination."

#: common.opt:3351
#, no-c-format
msgid "Perform function-local points-to analysis on trees."
msgstr "Voer uit function-local points-to analysis op trees."

#: common.opt:3355
#, no-c-format
msgid "Enable reassociation on tree level."
msgstr "Aktiveer reassociation op tree vlak."

#: common.opt:3363
#, no-c-format
msgid "Enable SSA code sinking on trees."
msgstr "Aktiveer SSA kode sinking op trees."

#: common.opt:3367
#, no-c-format
msgid "Perform straight-line strength reduction."
msgstr "Voer uit straight-line sterkte vermindering."

#: common.opt:3371
#, no-c-format
msgid "Perform scalar replacement of aggregates."
msgstr "Voer uit skalaar vervanging van aggregates."

#: common.opt:3375
#, no-c-format
msgid "Replace temporary expressions in the SSA->normal pass."
msgstr "Vervang tydelike expressions in die SSA->normale gee deur."

#: common.opt:3383
#, no-c-format
msgid "Perform Value Range Propagation on trees."
msgstr "Voer uit Waarde Bestek Propagation op trees."

#: common.opt:3387
#, no-c-format
msgid "Split paths leading to loop backedges."
msgstr "Split paaie leidende na lus backedges."

#: common.opt:3391
#, no-c-format
msgid "Assume common declarations may be overridden with ones with a larger trailing array."
msgstr "Neem aan gemeenskaplike declarations mag wees overridden met ones met a larger agterste skikking."

#: common.opt:3396
#, no-c-format
msgid "Compile whole compilation unit at a time."
msgstr "Kompileer whole kompilering eenheid by a tyd."

#: common.opt:3400
#, no-c-format
msgid "Trap on __builtin_unreachable instead of using it for optimization."
msgstr "Val op __ingeboude_onbereikbaar in plaas van gebruik dit vir optimering."

#: common.opt:3404
#, no-c-format
msgid "Perform loop unrolling when iteration count is known."
msgstr "Voer uit lus unrolling wanneer iteration telling is known."

#: common.opt:3408
#, no-c-format
msgid "Perform loop unrolling for all loops."
msgstr "Voer uit lus unrolling vir alle lusse."

#: common.opt:3423
#, no-c-format
msgid "Allow optimization for floating-point arithmetic which may change the result of the operation due to rounding."
msgstr "Laat toe optimering vir dryfpunt rekenkundige wat mag change die resultaat van die bewerking due na afronding."

#: common.opt:3428
#, no-c-format
msgid "Same as -fassociative-math for expressions which include division."
msgstr "Dieselfde as -fassociative-math vir expressions wat sluit in deling."

#: common.opt:3436
#, no-c-format
msgid "Allow math optimizations that may violate IEEE or ISO standards."
msgstr "Laat toe math optimizations wat mag violate IEEE of ISO standards."

#: common.opt:3440
#, no-c-format
msgid "Perform loop unswitching."
msgstr "Voer uit lus unswitching."

#: common.opt:3444
#, no-c-format
msgid "Perform loop splitting."
msgstr "Voer uit lus splitting."

#: common.opt:3448
#, no-c-format
msgid "Version loops based on whether indices have a stride of one."
msgstr "Weergawe lusse based op of indices het a stap van one."

#: common.opt:3452
#, no-c-format
msgid "Just generate unwind tables for exception handling."
msgstr "Net genereer afwikkel tables vir uitsondering handling."

#: common.opt:3456
#, no-c-format
msgid "Use the bfd linker instead of the default linker."
msgstr "Gebruik die BFD skakelaar in plaas van die verstek skakelaar."

#: common.opt:3460
#, no-c-format
msgid "Use the gold linker instead of the default linker."
msgstr "Gebruik die gold skakelaar in plaas van die verstek skakelaar."

#: common.opt:3464
#, no-c-format
msgid "Use the lld LLVM linker instead of the default linker."
msgstr "Gebruik die lld LLVM skakelaar in plaas van die verstek skakelaar."

#: common.opt:3468
#, no-c-format
msgid "Use the Modern linker (MOLD) linker instead of the default linker."
msgstr "Gebruik die Modern skakelaar (MOLD) skakelaar in plaas van die verstek skakelaar."

#: common.opt:3472
#, no-c-format
msgid "Use the Wild linker instead of the default linker."
msgstr "Gebruik die Wild skakelaar in plaas van die verstek skakelaar."

#: common.opt:3479
#, no-c-format
msgid "Enable linking of libatomic."
msgstr "Aktiveer skakeling van libatomic."

#: common.opt:3486
#, no-c-format
msgid "Perform variable tracking."
msgstr "Voer uit veranderlike tracking."

#: common.opt:3493
#, no-c-format
msgid "Perform variable tracking by annotating assignments."
msgstr "Voer uit veranderlike tracking deur annotating assignments."

#: common.opt:3499
#, no-c-format
msgid "Toggle -fvar-tracking-assignments."
msgstr "Toggle -fvar-tracking-assignments."

#: common.opt:3506
#, no-c-format
msgid "Perform variable tracking and also tag variables that are uninitialized."
msgstr "Voer uit veranderlike tracking en ook tag veranderlikes wat is ongeïnisialiseerde."

#: common.opt:3511
#, no-c-format
msgid "Enable vectorization on trees."
msgstr "Aktiveer vektorisering op trees."

#: common.opt:3519
#, no-c-format
msgid "Enable loop vectorization on trees."
msgstr "Aktiveer lus vektorisering op trees."

#: common.opt:3523
#, no-c-format
msgid "Enable basic block vectorization (SLP) on trees."
msgstr "Aktiveer basic blok vektorisering (SLP) op trees."

#: common.opt:3527
#, no-c-format
msgid "-fvect-cost-model=[unlimited|dynamic|cheap|very-cheap]\tSpecifies the cost model for vectorization."
msgstr "-fvect-cost-model=[unlimited|dinamiese|cheap|very-cheap]\tSpecifies die koste model vir vektorisering."

#: common.opt:3531
#, no-c-format
msgid "-fsimd-cost-model=[unlimited|dynamic|cheap|very-cheap]\tSpecifies the vectorization cost model for code marked with a simd directive."
msgstr "-fsimd-cost-model=[unlimited|dinamiese|cheap|very-cheap]\tSpecifies die vektorisering koste model vir kode marked met a SIMD direktef."

#: common.opt:3550
#, no-c-format
msgid "Enables the dynamic vectorizer cost model.  Preserved for backward compatibility."
msgstr "Enables die dinamiese vectorizer koste model. Preserved vir backward compatibility."

#: common.opt:3558
#, no-c-format
msgid "Enable copy propagation of scalar-evolution information."
