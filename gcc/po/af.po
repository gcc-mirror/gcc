#, no-c-format
msgid "Warn when not issuing stack smashing protection for some reason."
msgstr "waarsku wanneer nie issuing stapel smashing protection vir some reason nie."

#: common.opt:768
#, no-c-format
msgid "-Wstack-usage=<byte-size>\tWarn if stack usage might exceed <byte-size>."
msgstr "-Wstack-usage=<byte-size>\twaarsku as stapel gebruik mag exceed <byte-size>."

#: common.opt:772
#, no-c-format
msgid "Disable Wstack-usage= warning.  Equivalent to Wstack-usage=<SIZE_MAX> or larger."
msgstr "Deaktiveer Wstack-usage= waarskuwing. Equivalent na Wstack-usage=<GROOTTE_MAX> of larger."

#: common.opt:776 common.opt:780
#, no-c-format
msgid "Warn about code which might break strict aliasing rules."
msgstr "waarsku oor kode wat mag break streng aliasing reëls."

#: common.opt:784 common.opt:788
#, no-c-format
msgid "Warn about optimizations that assume that signed overflow is undefined."
msgstr "waarsku oor optimizations wat neem aan wat getekende oorloop is ongedefinieerde."

#: common.opt:792
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((cold))."
msgstr "waarsku oor funksies wat mag wees kandidate vir __kenmerk__((cold))."

#: common.opt:796
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((const))."
msgstr "waarsku oor funksies wat mag wees kandidate vir __kenmerk__((const))."

#: common.opt:800
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((pure))."
msgstr "waarsku oor funksies wat mag wees kandidate vir __kenmerk__((suiwer))."

#: common.opt:804
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((noreturn))."
msgstr "waarsku oor funksies wat mag wees kandidate vir __kenmerk__((noreturn))."

#: common.opt:808
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((malloc))."
msgstr "waarsku oor funksies wat mag wees kandidate vir __kenmerk__((malloc))."

