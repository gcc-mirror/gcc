msgstr "Issue waarskuwings benodig vir streng compliance na die standaard."

#: common.opt:738
#, no-c-format
msgid "Warn about returning a pointer/reference to a local or temporary variable."
msgstr "waarsku oor teruggee a wyser/verwysing na a plaaslike of tydelike veranderlike."

#: common.opt:742
#, no-c-format
msgid "Warn when one variable shadows another.  Same as -Wshadow=global."
msgstr "waarsku wanneer one veranderlike oorskadu nog 'n. Dieselfde as -Wshadow=globale."

#: common.opt:746
#, no-c-format
msgid "Warn when one variable shadows another (globally)."
msgstr "waarsku wanneer one veranderlike oorskadu nog 'n (globally)."

#: common.opt:750
#, no-c-format
msgid "Warn when one local variable shadows another local variable or parameter."
msgstr "waarsku wanneer one plaaslike veranderlike oorskadu nog 'n plaaslike veranderlike of parameter."

