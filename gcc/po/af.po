#, no-c-format
msgid "Warn about statements between switch's controlling expression and the first case."
msgstr "waarsku oor stellings tussen switch's controlling uitdrukking en die eerste geval."

#: common.opt:829
#, no-c-format
msgid "Do not suppress warnings from system headers."
msgstr "moenie suppress waarskuwings van stelsel headers."

