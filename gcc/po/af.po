#: common.opt:1125
#, no-c-format
msgid "Allow the compiler to introduce new data races on stores."
msgstr "Laat toe die kompileerder na introduce nuwe data races op stores."

#: common.opt:1129
#, no-c-format
msgid "Enable static analysis pass."
msgstr "Aktiveer statiese analysis gee deur."

#: common.opt:1149
#, no-c-format
msgid "Select what to sanitize."
msgstr "Select what na sanitize."

#: common.opt:1153
#, no-c-format
msgid "Select type of coverage sanitization."
msgstr "Select tipe van dekking sanitization."

#: common.opt:1166
#, no-c-format
msgid "-fasan-shadow-offset=<number>\tUse custom shadow memory offset."
msgstr "-fasan-shadow-offset=<getal>\tGebruik pasgemaakte shadow geheue verplasing."

#: common.opt:1170
#, no-c-format
msgid "-fsanitize-sections=<sec1,sec2,...>\tSanitize global variables in user-defined sections."
msgstr "-fsanitize-sections=<sec1,sec2,...>\tSanitize globale veranderlikes in user-defined sections."

#: common.opt:1175
#, no-c-format
msgid "After diagnosing undefined behavior attempt to continue execution."
msgstr "Ná diagnosing ongedefinieerde gedrag attempt na continue uitvoering."

#: common.opt:1179
#, no-c-format
msgid "This switch is deprecated; use -fsanitize-recover= instead."
msgstr "Hierdie skakelaar is verouderde; gebruik -fsanitize-recover= in plaas."

#: common.opt:1183
#, no-c-format
msgid "Use traps instead of diagnostics of undefined behavior sanitizers."
msgstr "Gebruik traps in plaas van diagnostics van ongedefinieerde gedrag sanitizers."

#: common.opt:1193
#, no-c-format
msgid "This switch is deprecated; use -fsanitize-trap= instead."
msgstr "Hierdie skakelaar is verouderde; gebruik -fsanitize-trap= in plaas."

#: common.opt:1197
#, no-c-format
msgid "Generate unwind tables that are exact at each instruction boundary."
msgstr "Genereer afwikkel tables wat is exact by elke instruksie boundary."

#: common.opt:1201
#, no-c-format
msgid "Generate auto-inc/dec instructions."
