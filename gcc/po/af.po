msgstr "Display die simbole in reverse volgorde."

#: lto/lang.opt:109
#, no-c-format
msgid "Dump the details of LTO objects."
msgstr "Stort die details van LTO objekte."

#: lto/lang.opt:113
#, no-c-format
msgid "Dump the statistics of tree types."
msgstr "Stort die statistics van tree tipes."

#: lto/lang.opt:117
#, no-c-format
