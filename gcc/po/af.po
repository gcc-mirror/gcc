msgstr "waarsku oor lees past die einde van a bron skikking in string manipulation funksies like memchr en memcpy."

#: c-family/c.opt:1476
#, no-c-format
msgid "Warn about truncation in string manipulation functions like strncat and strncpy."
msgstr "waarsku oor afkapping in string manipulation funksies like strncat en strncpy."

#: c-family/c.opt:1480
#, no-c-format
msgid "Warn if a class type has a base or a field whose type uses the anonymous namespace or depends on a type with no linkage."
msgstr "waarsku as a klas tipe het a basis of a veld wie se tipe gebruik die anonieme naamruimte of depends op a tipe met geen binding."

#: c-family/c.opt:1484
#, no-c-format
msgid "Warn about functions which might be candidates for format attributes."
msgstr "waarsku oor funksies wat mag wees kandidate vir formaat kenmerke."

#: c-family/c.opt:1488
#, no-c-format
msgid "Suggest that the override keyword be used when the declaration of a virtual function overrides another."
msgstr "Stel voor wat die oorheers sleutelwoord wees gebruik wanneer die verklaring van a virtuele funksie overrides nog 'n."

#: c-family/c.opt:1493
#, no-c-format
msgid "Warn about enumerated switches, with no default, missing a case."
msgstr "waarsku oor enumerated switches, met geen verstek, ontbreek a geval."

#: c-family/c.opt:1497
#, no-c-format
msgid "Warn about enumerated switches missing a \"default:\" statement."
msgstr "waarsku oor enumerated switches ontbreek a \"verstek:\" stelling."

#: c-family/c.opt:1501
#, no-c-format
msgid "Warn about all enumerated switches missing a specific case."
msgstr "waarsku oor alle enumerated switches ontbreek a spesifieke geval."

#: c-family/c.opt:1505
#, no-c-format
msgid "Warn about switches with boolean controlling expression."
msgstr "waarsku oor switches met boolese controlling uitdrukking."

#: c-family/c.opt:1509
#, no-c-format
msgid "Warn about switch values that are outside of the switch's type range."
msgstr "waarsku oor skakelaar waardes wat is buite van die switch's tipe bestek."

#: c-family/c.opt:1513
#, no-c-format
msgid "Warn when __sync_fetch_and_nand and __sync_nand_and_fetch built-in functions are used."
msgstr "waarsku wanneer __sync_fetch_en_nand en __sync_nand_en_fetch ingeboude funksies is gebruik."

#: c-family/c.opt:1525
#, no-c-format
msgid "Warn on primary template declaration."
msgstr "Waarsku op primary sjabloon verklaring."

#: c-family/c.opt:1529
#, no-c-format
msgid "Diagnose errors when parsing a template."
msgstr "Diagnose foute wanneer ontleding a sjabloon."

#: c-family/c.opt:1533
#, no-c-format
msgid "Warn about simple-template-id in a constructor or destructor."
msgstr "waarsku oor simple-template-id in a konstruktor of destruktor."

#: c-family/c.opt:1537
#, no-c-format
msgid "Warn about templates naming TU-local entities in a module."
msgstr "waarsku oor sjablone naming TU-local entities in a module."

#: c-family/c.opt:1541
#, no-c-format
msgid "Warn if a throw expression will always result in a call to terminate()."
msgstr "waarsku as a gooi uitdrukking sal altyd resultaat in a oproep na beëindig()."

#: c-family/c.opt:1545
#, no-c-format
msgid "Warn about features not present in traditional C."
msgstr "waarsku oor kenmerke nie teenwoordig in tradisionele C nie."

#: c-family/c.opt:1549
#, no-c-format
msgid "Warn of prototypes causing type conversions different from what would happen in the absence of prototype."
msgstr "Waarsku van prototypes causing tipe conversions verskillende van what sou happen in die absence van prototype."

#: c-family/c.opt:1565
#, no-c-format
msgid "Warn about trailing whitespace on lines except when in raw string literals."
msgstr "waarsku oor agterste whitespace op lines behalwe wanneer in raw string literals."

#: c-family/c.opt:1569
#, no-c-format
msgid "Warn about trailing whitespace on lines except when in raw string literals.   Equivalent to Wtrailing-whitespace=blanks when enabled or Wtrailing-whitespace=none when disabled."
msgstr "waarsku oor agterste whitespace op lines behalwe wanneer in raw string literals. Equivalent na Wtrailing-whitespace=blanks wanneer geaktiveer of Wtrailing-whitespace=geen wanneer gedeaktiveer."

#: c-family/c.opt:1573
#, no-c-format
msgid "Warn if trigraphs are encountered that might affect the meaning of the program."
msgstr "waarsku as trigraphs is encountered wat mag affect die betekenis van die program."

#: c-family/c.opt:1577
#, no-c-format
msgid "Warn about @selector()s without previously declared methods."
msgstr "waarsku oor @selekteerder()s sonder voorheen verklaar methods."

#: c-family/c.opt:1581
#, no-c-format
msgid "Warn if an undefined macro is used in an #if directive."
msgstr "waarsku as 'n ongedefinieerde makro is gebruik in 'n #as direktef."

#: c-family/c.opt:1585
#, no-c-format
msgid "Warn about invalid forms of delimited or named escape sequences."
msgstr "waarsku oor ongeldige forms van delimited of benoemde escape sequences."

#: c-family/c.opt:1593
#, no-c-format
msgid "Warn about unrecognized pragmas."
msgstr "waarsku oor onherkende pragmas."

#: c-family/c.opt:1597
#, no-c-format
msgid "Warn about unsuffixed float constants."
msgstr "waarsku oor unsuffixed float konstantes."

#: c-family/c.opt:1601
#, no-c-format
msgid "Warn about character arrays initialized as unterminated character sequences with a string literal."
msgstr "waarsku oor karakter skikkings geïnisialiseer as unterminated karakter sequences met a stringletterlik."

#: c-family/c.opt:1617
#, no-c-format
msgid "Warn when typedefs locally defined in a function are not used."
msgstr "waarsku wanneer typedefs locally gedefinieerde in a funksie is nie gebruik nie."

#: c-family/c.opt:1621
#, no-c-format
msgid "Warn about macros defined in the main file that are not used."
msgstr "waarsku oor makro's gedefinieerde in die main lêer wat is nie gebruik nie."

#: c-family/c.opt:1641
#, no-c-format
msgid "Warn about useless casts."
msgstr "waarsku oor useless casts."

#: c-family/c.opt:1645
#, no-c-format
msgid "Warn about using variadic macros."
msgstr "waarsku oor gebruik variadiese makro's."

#: c-family/c.opt:1649
#, no-c-format
msgid "Warn about questionable usage of the macros used to retrieve variable arguments."
msgstr "waarsku oor questionable gebruik van die makro's gebruik na retrieve veranderlike argumente."

#: c-family/c.opt:1653
#, no-c-format
msgid "Warn about the most vexing parse syntactic ambiguity."
msgstr "waarsku oor die most vexing ontleed syntactic ambiguity."

#: c-family/c.opt:1657
#, no-c-format
msgid "Warn if a virtual base has a non-trivial move assignment operator."
msgstr "waarsku as a virtuele basis het a non-trivial skuif toekenning operator."

#: c-family/c.opt:1661
#, no-c-format
msgid "Warn if a variable length array is used."
msgstr "waarsku as a veranderlike lengte skikking is gebruik."

#: c-family/c.opt:1665
#, no-c-format
msgid "-Wvla-larger-than=<number>\tWarn on unbounded uses of variable-length arrays, and on bounded uses of variable-length arrays whose bound can be larger than <number> bytes."
msgstr "-Wvla-larger-than=<getal>\tWaarsku op unbounded gebruik van variable-length skikkings, en op bounded gebruik van variable-length skikkings wie se gebonde kan wees larger as <getal> grepe."

#: c-family/c.opt:1671
#, no-c-format
msgid "Disable Wvla-larger-than= warning.  Equivalent to Wvla-larger-than=<SIZE_MAX> or larger."
msgstr "Deaktiveer Wvla-larger-than= waarskuwing. Equivalent na Wvla-larger-than=<GROOTTE_MAX> of larger."

#: c-family/c.opt:1675
#, no-c-format
msgid "Warn about mismatched declarations of VLA parameters."
msgstr "waarsku oor mismatched declarations van VLA parameters."

#: c-family/c.opt:1679
#, no-c-format
msgid "Warn about deprecated uses of volatile qualifier."
msgstr "waarsku oor verouderde gebruik van vlugtige kwalifiseerder."

#: c-family/c.opt:1683
#, no-c-format
msgid "Warn when a register variable is declared volatile."
msgstr "waarsku wanneer a register veranderlike is verklaar vlugtige."

#: c-family/c.opt:1687
#, no-c-format
msgid "Warn on direct virtual inheritance."
msgstr "Waarsku op direkte virtuele oorerwing."

#: c-family/c.opt:1691
#, no-c-format
msgid "In C++, nonzero means warn about deprecated conversion from string literals to 'char *'.  In C, similar warning, except that the conversion is of course not deprecated by the ISO C standard."
msgstr "In C++, nie-nul means waarsku oor verouderde omskakeling van string literals na 'char *'. In C, soortgelyke waarskuwing, behalwe wat die omskakeling is van course nie verouderde deur die ISO C standaard nie."

#: c-family/c.opt:1695
#, no-c-format
msgid "Warn about xor operators where it appears the user meant exponentiation."
msgstr "waarsku oor xor operators waar dit appears die gebruiker meant exponentiation."

#: c-family/c.opt:1699
#, no-c-format
msgid "Warn when a literal '0' is used as null pointer."
msgstr "waarsku wanneer a letterlik '0' is gebruik as nullwyser."

#: c-family/c.opt:1703
#, no-c-format
msgid "Warn about accesses to interior zero-length array members."
msgstr "waarsku oor accesses na interior zero-length skikking lede."

#: c-family/c.opt:1707
#, no-c-format
msgid "A synonym for -std=c89 (for C) or -std=c++98 (for C++)."
msgstr "A synonym vir -std=c89 (vir C) of -std=c++98 (vir C++)."

#: c-family/c.opt:1715
#, no-c-format
msgid "The version of the C++ ABI used for -Wabi warnings and link compatibility aliases."
msgstr "Die weergawe van die C++ ABI gebruik vir -Wabi waarskuwings en skakel compatibility aliases."

#: c-family/c.opt:1719
#, no-c-format
msgid "Enforce class member access control semantics."
msgstr "Enforce klas lid toegang beheer semantics."

#: c-family/c.opt:1723
#, no-c-format
msgid "-fada-spec-parent=unit\tDump Ada specs as child units of given parent."
msgstr "-fada-spec-parent=eenheid\tStort Ada spesifikasies as child units van gegee parent."

#: c-family/c.opt:1727
#, no-c-format
msgid "Support C++17 allocation of over-aligned types."
msgstr "Ondersteun C++17 toewysing van over-aligned tipes."

#: c-family/c.opt:1731
#, no-c-format
msgid "-faligned-new=<N>\tUse C++17 over-aligned type allocation for alignments greater than N."
msgstr "-faligned-new=<N>\tGebruik C++17 over-aligned tipe toewysing vir alignments groter as N."

#: c-family/c.opt:1742 c-family/c.opt:2089 c-family/c.opt:2506
#: c-family/c.opt:2510 c-family/c.opt:2526
#, no-c-format
msgid "No longer supported."
msgstr "Geen longer ondersteun."

#: c-family/c.opt:1746
#, no-c-format
msgid "Recognize the \"asm\" keyword."
msgstr "Recognize die \"asm\" sleutelwoord."

#: c-family/c.opt:1750
#, no-c-format
msgid "Assume C++ replaceable global operators new, new[], delete, delete[] don't read or write visible global state."
msgstr "Neem aan C++ replaceable globale operators nuwe, nuwe[], skrap, skrap[] don't lees of skryf visible globale state."

#: c-family/c.opt:1758
#, no-c-format
msgid "Recognize built-in functions."
msgstr "Recognize ingeboude funksies."

#: c-family/c.opt:1765
#, no-c-format
msgid "Where shorter, use canonicalized paths to systems headers."
msgstr "Waar shorter, gebruik canonicalized paaie na systems headers."

#: c-family/c.opt:1769
#, no-c-format
msgid "Enable the char8_t fundamental type and use it as the type for UTF-8 string and character literals."
msgstr "Aktiveer die char8_t fundamental tipe en gebruik dit as die tipe vir UTF-8 string en karakter literals."

#: c-family/c.opt:1857
#, no-c-format
msgid "Removed in GCC 8.  This switch has no effect."
msgstr "Verwyder in GCC 8. Hierdie skakelaar het geen effek."

#: c-family/c.opt:1861
#, no-c-format
msgid "Enable support for C++ concepts."
msgstr "Aktiveer ondersteun vir C++ concepts."

#: c-family/c.opt:1865
#, no-c-format
msgid "Removed in GCC 15.  This switch has no effect."
msgstr "Verwyder in GCC 15. Hierdie skakelaar het geen effek."

#: c-family/c.opt:1869
#, no-c-format
msgid "Specify maximum error replay depth during recursive diagnosis of a constraint satisfaction failure."
msgstr "Spesifiseer maksimum fout replay diepte tydens rekursiewe diagnosis van a beperking bevrediging mislukking."

#: c-family/c.opt:1873
#, no-c-format
msgid "Allow the arguments of the '?' operator to have different types."
msgstr "Laat toe die argumente van die '?' operator na het verskillende tipes."

#: c-family/c.opt:1881
#, no-c-format
msgid "-fconst-string-class=<name>\tUse class <name> for constant strings."
msgstr "-fconst-string-class=<naam>\tGebruik klas <naam> vir konstant strings."

#: c-family/c.opt:1885
#, no-c-format
msgid "-fconstexpr-depth=<number>\tSpecify maximum constexpr recursion depth."
msgstr "-fconstexpr-depth=<getal>\tSpesifiseer maksimum constexpr rekursie diepte."

#: c-family/c.opt:1889
#, no-c-format
msgid "-fconstexpr-cache-depth=<number>\tSpecify maximum constexpr recursion cache depth."
msgstr "-fconstexpr-cache-depth=<getal>\tSpesifiseer maksimum constexpr rekursie kas diepte."

#: c-family/c.opt:1893
#, no-c-format
msgid "Allow IEC559 floating point exceptions in constant expressions."
msgstr "Laat toe IEC559 dryfpunt uitsonderings in konstant expressions."

#: c-family/c.opt:1897
#, no-c-format
msgid "-fconstexpr-loop-limit=<number>\tSpecify maximum constexpr loop iteration count."
msgstr "-fconstexpr-loop-limit=<getal>\tSpesifiseer maksimum constexpr lus iteration telling."

#: c-family/c.opt:1901
#, no-c-format
msgid "-fconstexpr-ops-limit=<number>\tSpecify maximum number of constexpr operations during a single constexpr evaluation."
msgstr "-fconstexpr-ops-limit=<getal>\tSpesifiseer maksimum aantal constexpr bewerkings tydens a enkele constexpr evaluering."

#: c-family/c.opt:1905
#, no-c-format
msgid "Enable features proposed for C++26 Contracts."
msgstr "Aktiveer kenmerke proposed vir C++26 Contracts."

#: c-family/c.opt:1926
#, no-c-format
msgid "-fcontract-evaluation-semantic=[ignore|observe|enforce|quick_enforce]\tSelect the contract evaluation semantic (defaults to enforce)."
msgstr "-fcontract-evaluation-semantic=[ignoreer|observe|enforce|quick_enforce]\tSelect die contract evaluering semantiese (defaults na enforce)."

#: c-family/c.opt:1930
#, no-c-format
msgid "-fcontracts-conservative-ipa\tDo not allow certain optimisations between functions in contract assertions."
msgstr "-fcontracts-conservative-ipa\tmoenie laat toe certain optimisations tussen funksies in contract assertions."

#: c-family/c.opt:1935
#, no-c-format
msgid "-fcontract-checks-outlined\tBuild contract checks using outlined functions."
msgstr "-fcontract-checks-outlined\tBuild contract checks gebruik outlined funksies."

#: c-family/c.opt:1939
#, no-c-format
msgid "-fcontract-disable-optimized-checks\tDisable optimisation of contract checks."
msgstr "-fcontract-disable-optimized-checks\tDeaktiveer optimisation van contract checks."

#: c-family/c.opt:1955
#, no-c-format
msgid "-fcontracts-client-check=[none|pre|all] Select which contracts will be checked on the client side for non virtual functions."
msgstr "-fcontracts-client-check=[geen|pre|alle] Select wat contracts sal wees checked op die client newes vir non virtuele funksies."

#: c-family/c.opt:1968
#, no-c-format
msgid "-fcontracts-definition-check=[on|off]\tEnable or disable contract checks on the definition side for all functions (default on)."
msgstr "-fcontracts-definition-check=[op|af]\tAktiveer of deaktiveer contract checks op die definisie newes vir alle funksies (verstek op)."

#: c-family/c.opt:1972
#, no-c-format
msgid "Enable C++ coroutines (experimental)."
msgstr "Aktiveer C++ coroutines (experimental)."

#: c-family/c.opt:1976
#, no-c-format
msgid "Emit debug annotations during preprocessing."
msgstr "Genereer ontfout annotations tydens voorverwerking."

#: c-family/c.opt:1984
#, no-c-format
msgid "Factor complex constructors and destructors to favor space over speed."
msgstr "Faktor komplekse constructors en destructors na favor space oor speed."

#: c-family/c.opt:1992
#, no-c-format
msgid "Print hierarchical comparisons when template types are mismatched."
msgstr "Druk hierarchical comparisons wanneer sjabloon tipes is mismatched."

#: c-family/c.opt:1996
#, no-c-format
msgid "Note all candidates during overload resolution failure."
msgstr "Nota alle kandidate tydens oorlading resolusie mislukking."

#: c-family/c.opt:2000
#, no-c-format
msgid "Preprocess directives only."
msgstr "Voorverwerk directives slegs."

#: c-family/c.opt:2004
#, no-c-format
msgid "Permit '$' as an identifier character."
msgstr "Permit '$' as 'n identifiseerder karakter."

#: c-family/c.opt:2008
#, no-c-format
msgid "-fmacro-prefix-map=<old>=<new>\tMap one directory name to another in __FILE__, __BASE_FILE__, and __builtin_FILE()."
msgstr "-fmacro-prefix-map=<ou>=<nuwe>\tMap one gids naam na nog 'n in __LÊER__, __BASIS_LÊER__, en __ingeboude_LÊER()."

#: c-family/c.opt:2012
#, no-c-format
msgid "Write all declarations as Ada code transitively."
msgstr "Skryf alle declarations as Ada kode transitively."

#: c-family/c.opt:2016
#, no-c-format
msgid "Write all declarations as Ada code for the given file only."
msgstr "Skryf alle declarations as Ada kode vir die gegee lêer slegs."

#: c-family/c.opt:2023
#, no-c-format
msgid "Do not elide common elements in template comparisons."
msgstr "moenie elide gemeenskaplike elemente in sjabloon comparisons."

#: c-family/c.opt:2027
#, no-c-format
msgid "Generate code to check exception specifications."
msgstr "Genereer kode na kontroleer uitsondering specifications."

#: c-family/c.opt:2034
#, no-c-format
msgid "-fexec-charset=<cset>\tConvert all strings and character constants to character set <cset>."
msgstr "-fexec-charset=<cset>\tSkakel om alle strings en karakter konstantes na karakter stel <cset>."

#: c-family/c.opt:2038
#, no-c-format
msgid "Permit universal character names (\\u and \\U) in identifiers."
msgstr "Permit universal karakter name (\\u en \\U) in identifiers."

#: c-family/c.opt:2042
#, no-c-format
msgid "-finput-charset=<cset>\tSpecify the default character set for source files."
msgstr "-finput-charset=<cset>\tSpesifiseer die verstek karakter stel vir bron lêers."

#: c-family/c.opt:2046
#, no-c-format
msgid "Support dynamic initialization of thread-local variables in a different translation unit."
msgstr "Ondersteun dinamiese inisialisering van draad-lokaal veranderlikes in a verskillende translation eenheid."

#: c-family/c.opt:2053
#, no-c-format
msgid "Fold calls to simple inline functions."
msgstr "Vou oproepe na simple inline funksies."

#: c-family/c.opt:2060
#, no-c-format
msgid "Do not assume that standard C libraries and \"main\" exist."
msgstr "moenie neem aan wat standaard C biblioteke en \"main\" exist."

#: c-family/c.opt:2064
#, no-c-format
msgid "Recognize GNU-defined keywords."
msgstr "Recognize GNU-defined keywords."

#: c-family/c.opt:2068
#, no-c-format
msgid "Generate code for GNU runtime environment."
msgstr "Genereer kode vir GNU looptyd omgewing."

#: c-family/c.opt:2072
#, no-c-format
msgid "Use traditional GNU semantics for inline functions."
msgstr "Gebruik tradisionele GNU semantics vir inline funksies."

#: c-family/c.opt:2085
#, no-c-format
msgid "Assume normal C execution environment."
msgstr "Neem aan normale C uitvoering omgewing."

#: c-family/c.opt:2093
#, no-c-format
msgid "Implement P2564 for consteval propagation."
msgstr "Implement P2564 vir consteval propagation."

#: c-family/c.opt:2097
#, no-c-format
msgid "Export functions even if they can be inlined."
msgstr "Export funksies even as hulle kan wees geïnline."

#: c-family/c.opt:2101
#, no-c-format
msgid "Make inline functions constexpr by default."
msgstr "Make inline funksies constexpr deur verstek."

#: c-family/c.opt:2105
#, no-c-format
msgid "Emit implicit instantiations of inline templates."
msgstr "Genereer implisiete instantiations van inline sjablone."

#: c-family/c.opt:2109
#, no-c-format
msgid "Emit implicit instantiations of templates."
msgstr "Genereer implisiete instantiations van sjablone."

#: c-family/c.opt:2113
#, no-c-format
msgid "Implement C++17 inheriting constructor semantics."
msgstr "Implement C++17 inheriting konstruktor semantics."

#: c-family/c.opt:2120
#, no-c-format
msgid "Don't emit dllexported inline functions unless needed."
msgstr "Don't genereer dllexported inline funksies tensy benodig."

#: c-family/c.opt:2127
#, no-c-format
msgid "Allow implicit conversions between vectors with differing numbers of subparts and/or differing element types."
msgstr "Laat toe implisiete conversions tussen vectors met differing numbers van subparts en/of differing element tipes."

#: c-family/c.opt:2131
#, no-c-format
msgid "Enable C++20 Modules (experimental)."
msgstr "Aktiveer C++20 Modules (experimental)."

#: c-family/c.opt:2139
#, no-c-format
msgid "Enable C++ header module (experimental)."
msgstr "Aktiveer C++ koplêer module (experimental)."

#: c-family/c.opt:2146
#, no-c-format
msgid "Member functions defined within their class are inline in module purview."
msgstr "Lid funksies gedefinieerde binne hul klas is inline in module purview."

#: c-family/c.opt:2150
#, no-c-format
msgid "Only emit Compiled Module Interface."
msgstr "Slegs genereer Gekombineer Module Koppelvlak."

#: c-family/c.opt:2154
#, no-c-format
msgid "Mapper for module to CMI files."
msgstr "Mapper vir module na CMI lêers."

#: c-family/c.opt:2158
#, no-c-format
msgid "Enable lazy module importing."
msgstr "Aktiveer lui module importing."

#: c-family/c.opt:2166
#, no-c-format
msgid "Warn about macros that have conflicting header units definitions."
msgstr "waarsku oor makro's wat het botsende koplêer units definitions."

#: c-family/c.opt:2170
#, no-c-format
msgid "Warn if pointers of distinct types are compared without a cast."
msgstr "waarsku as wysers van distinct tipes is vergelyk sonder a set om."

#: c-family/c.opt:2174
#, no-c-format
msgid "Note #include directives translated to import declarations."
msgstr "Nota #sluit in directives translated na import declarations."

#: c-family/c.opt:2178
#, no-c-format
msgid "Note #include directives not translated to import declarations, and not known to be textual."
msgstr "Nota #sluit in directives nie translated na import declarations, en nie known na wees textual nie."

#: c-family/c.opt:2182
#, no-c-format
msgid "Note a #include translation of a specific header."
msgstr "Nota a #sluit in translation van a spesifieke koplêer."

#: c-family/c.opt:2186
#, no-c-format
msgid "Note Compiled Module Interface pathnames."
msgstr "Nota Gekombineer Module Koppelvlak pathnames."

#: c-family/c.opt:2190
#, no-c-format
msgid "Note Compiled Module Interface pathname of a specific module or header-unit."
msgstr "Nota Gekombineer Module Koppelvlak pathname van a spesifieke module of header-unit."

#: c-family/c.opt:2194
#, no-c-format
msgid "fmax-include-depth=<number> Set the maximum depth of the nested #include."
msgstr "fmax-include-depth=<getal> Stel die maksimum diepte van die geneste #sluit in."

#: c-family/c.opt:2198
#, no-c-format
msgid "Don't warn about uses of Microsoft extensions."
msgstr "Don't waarsku oor gebruik van Microsoft uitbreidings."

#: c-family/c.opt:2217
#, no-c-format
msgid "Implement resolution of DR 150 for matching of template template arguments."
msgstr "Implement resolusie van DR 150 vir passing van sjabloon sjabloon argumente."

#: c-family/c.opt:2221
#, no-c-format
msgid "Generate code for NeXT (Apple macOS) runtime environment."
msgstr "Genereer kode vir Volgende (Apple macOS) looptyd omgewing."

#: c-family/c.opt:2225
#, no-c-format
msgid "Assume that receivers of Objective-C messages may be nil."
msgstr "Neem aan wat receivers van Objective-C boodskappe mag wees nil."

#: c-family/c.opt:2229
#, no-c-format
msgid "Allow access to instance variables as if they were local declarations within instance method implementations."
msgstr "Laat toe toegang na instance veranderlikes as as hulle was plaaslike declarations binne instance metode implementations."

#: c-family/c.opt:2233
#, no-c-format
msgid "-fvisibility=[private|protected|public|package]\tSet the default symbol visibility."
msgstr "-fvisibility=[private|beskermde|publieke|package]\tStel die verstek simbool sigbaarheid."

#: c-family/c.opt:2258
#, no-c-format
msgid "Treat a throw() exception specification as noexcept to improve code size."
msgstr "Treat a gooi() uitsondering spesifikasie as noexcept na improve kode grootte."

#: c-family/c.opt:2262
#, no-c-format
msgid "Specify which ABI to use for Objective-C family code and meta-data generation."
msgstr "Spesifiseer wat ABI na gebruik vir Objective-C family kode en meta-data generation."

#: c-family/c.opt:2268
#, no-c-format
msgid "Generate special Objective-C methods to initialize/destroy non-POD C++ ivars, if needed."
msgstr "Genereer special Objective-C methods na inisialiseer/vernietig non-POD C++ ivars, as benodig."

#: c-family/c.opt:2272
#, no-c-format
msgid "Allow fast jumps to the message dispatcher."
msgstr "Laat toe fast jumps na die boodskap dispatcher."

#: c-family/c.opt:2278
#, no-c-format
msgid "Enable Objective-C exception and synchronization syntax."
msgstr "Aktiveer Objective-C uitsondering en sinchronisasie sintaksis."

#: c-family/c.opt:2282
#, no-c-format
msgid "Enable garbage collection (GC) in Objective-C/Objective-C++ programs."
msgstr "Aktiveer garbage collection (GC) in Objective-C/Objective-C++ programme."

#: c-family/c.opt:2286
#, no-c-format
msgid "Enable inline checks for nil receivers with the NeXT runtime and ABI version 2."
msgstr "Aktiveer inline checks vir nil receivers met die Volgende looptyd en ABI weergawe 2."

#: c-family/c.opt:2291
#, no-c-format
msgid "Enable Objective-C setjmp exception handling runtime."
msgstr "Aktiveer Objective-C setjmp uitsondering handling looptyd."

#: c-family/c.opt:2295
#, no-c-format
msgid "Conform to the Objective-C 1.0 language as implemented in GCC 4.0."
msgstr "Conform na die Objective-C 1.0 taal as implemented in GCC 4.0."

#: c-family/c.opt:2299
#, no-c-format
msgid "Enable OpenACC."
msgstr "Aktiveer OpenACC."

#: c-family/c.opt:2303
#, no-c-format
msgid "Specify default OpenACC compute dimensions."
msgstr "Spesifiseer verstek OpenACC bereken dimensions."

#: c-family/c.opt:2307
#, no-c-format
msgid "Enable OpenMP (implies -frecursive in Fortran)."
msgstr "Aktiveer OpenMP (implies -frecursive in Fortran)."

#: c-family/c.opt:2311
#, no-c-format
msgid "Enable OpenMP's SIMD directives."
msgstr "Aktiveer OpenMP's SIMD directives."

#: c-family/c.opt:2315
#, no-c-format
msgid "Recognize C++ keywords like \"compl\" and \"xor\"."
msgstr "Recognize C++ keywords like \"compl\" en \"xor\"."

#: c-family/c.opt:2326
#, no-c-format
msgid "Look for and use PCH files even when preprocessing."
msgstr "Look vir en gebruik PCH lêers even wanneer voorverwerking."

#: c-family/c.opt:2330
#, no-c-format
msgid "Downgrade conformance errors to warnings."
msgstr "Downgrade conformance foute na waarskuwings."

#: c-family/c.opt:2334
#, no-c-format
msgid "Enable Plan 9 language extensions."
msgstr "Aktiveer Plan 9 taal uitbreidings."

#: c-family/c.opt:2338
#, no-c-format
msgid "Treat the input file as already preprocessed."
msgstr "Treat die toevoer lêer as reeds voorverwerkte."

#: c-family/c.opt:2346
#, no-c-format
msgid "-ftrack-macro-expansion=<0|1|2>\tTrack locations of tokens coming from macro expansion and display them in error messages."
msgstr "-ftrack-macro-expansion=<0|1|2>\tTrack locations van tokens coming van makro uitbreiding en display them in fout boodskappe."

#: c-family/c.opt:2350
#, no-c-format
msgid "Do not pretty-print template specializations as the template signature followed by the arguments."
msgstr "moenie pretty-print sjabloon specializations as die sjabloon signature followed deur die argumente."

#: c-family/c.opt:2354
#, no-c-format
msgid "Treat known sprintf return values as constants."
msgstr "Treat known sprintf terugkeer waardes as konstantes."

#: c-family/c.opt:2358
#, no-c-format
msgid "Enable lifetime extension of range based for temporaries."
msgstr "Aktiveer lewensduur uitbreiding van bestek based vir temporaries."

#: c-family/c.opt:2362
#, no-c-format
msgid "Enable experimental C++26 Reflection."
msgstr "Aktiveer experimental C++26 Reflection."

#: c-family/c.opt:2366
#, no-c-format
msgid "Used in Fix-and-Continue mode to indicate that object files may be swapped in at runtime."
msgstr "Gebruik in Fix-and-Continue modus na indicate wat objek lêers mag wees swapped in by looptyd."

#: c-family/c.opt:2370
#, no-c-format
msgid "Removed in GCC 10.  This switch has no effect."
msgstr "Verwyder in GCC 10. Hierdie skakelaar het geen effek."

#: c-family/c.opt:2374
#, no-c-format
msgid "Generate run time type descriptor information."
msgstr "Genereer run tyd tipe beskrywer inligting."

#: c-family/c.opt:2378
#, no-c-format
msgid "Look for the main source file on the include path."
msgstr "Look vir die main bron lêer op die sluit in pad."

#: c-family/c.opt:2389
#, no-c-format
msgid "Force the underlying type for \"wchar_t\" to be \"unsigned short\"."
msgstr "Force die underlying tipe vir \"wchar_t\" na wees \"ongetekende kort\"."

#: c-family/c.opt:2393
#, no-c-format
msgid "When \"signed\" or \"unsigned\" is not given make the bitfield signed."
msgstr "Wanneer \"getekende\" of \"ongetekende\" is nie gegee make die bitfield getekende nie."

#: c-family/c.opt:2401
#, no-c-format
msgid "Enable C++14 sized deallocation support."
msgstr "Aktiveer C++14 sized vrystelling ondersteun."

#: c-family/c.opt:2408
#, no-c-format
msgid "-fstrict-flex-arrays=<level>    Control when to treat the trailing array of a structure as a flexible array member for the purposes of accessing the elements of such an array. The default is treating all trailing arrays of structures as flexible array members."
msgstr "-fstrict-flex-arrays=<vlak> Beheer wanneer na treat die agterste skikking van a structure as a flexible skikking lid vir die purposes van toegang tot die elemente van sulke 'n skikking. Die verstek is treating alle agterste skikkings van structures as flexible skikking lede."

#: c-family/c.opt:2415
#, no-c-format
msgid "-fsso-struct=[big-endian|little-endian|native]\tSet the default scalar storage order."
msgstr "-fsso-struct=[groot-endian|klein-endian|inheems]\tStel die verstek skalaar berging volgorde."

#: c-family/c.opt:2431
#, no-c-format
msgid "Display statistics accumulated during compilation."
msgstr "Display statistics accumulated tydens kompilering."

#: c-family/c.opt:2435
#, no-c-format
msgid "Assume that values of enumeration type are always within the minimum range of that type."
msgstr "Neem aan wat waardes van enumerasie tipe is altyd binne die minimum bestek van wat tipe."

#: c-family/c.opt:2442 c-family/c.opt:2447
#, no-c-format
msgid "Follow the C++17 evaluation order requirements for assignment expressions, shift, member function calls, etc."
msgstr "Volg die C++17 evaluering volgorde requirements vir toekenning expressions, verskuiwing, lidfunksie oproepe, etc."

#: c-family/c.opt:2464
#, no-c-format
msgid "Set the maximum number of template instantiation notes for a single warning or error."
msgstr "Stel die maksimum aantal sjabloon instansiëring notes vir a enkele waarskuwing of fout."

#: c-family/c.opt:2471
#, no-c-format
msgid "-ftemplate-depth=<number>\tSpecify maximum template instantiation depth."
msgstr "-ftemplate-depth=<getal>\tSpesifiseer maksimum sjabloon instansiëring diepte."

#: c-family/c.opt:2478
#, no-c-format
msgid "-fno-threadsafe-statics\tDo not generate thread-safe code for initializing local statics."
msgstr "-fno-threadsafe-statics\tmoenie genereer thread-safe kode vir initializing plaaslike statics."

#: c-family/c.opt:2482
#, no-c-format
msgid "When \"signed\" or \"unsigned\" is not given make the bitfield unsigned."
msgstr "Wanneer \"getekende\" of \"ongetekende\" is nie gegee make die bitfield ongetekende nie."

#: c-family/c.opt:2490
#, no-c-format
msgid "Use __cxa_atexit to register destructors."
msgstr "Gebruik __cxa_atexit na register destructors."

#: c-family/c.opt:2494
#, no-c-format
msgid "Use __cxa_get_exception_ptr in exception handling."
msgstr "Gebruik __cxa_get_uitsondering_ptr in uitsondering handling."

#: c-family/c.opt:2498
#, no-c-format
msgid "Marks all inlined functions and methods as having hidden visibility."
msgstr "Marks alle geïnline funksies en methods as having versteek sigbaarheid."

#: c-family/c.opt:2502
#, no-c-format
msgid "Changes visibility to match Microsoft Visual Studio by default."
msgstr "Changes sigbaarheid na pas Microsoft Visual Studio deur verstek."

#: c-family/c.opt:2514
#, no-c-format
msgid "Emit common-like symbols as weak symbols."
msgstr "Genereer common-like simbole as swak simbole."

#: c-family/c.opt:2518
#, no-c-format
msgid "-fwide-exec-charset=<cset>\tConvert all wide strings and character constants to character set <cset>."
msgstr "-fwide-exec-charset=<cset>\tSkakel om alle wyd strings en karakter konstantes na karakter stel <cset>."

#: c-family/c.opt:2522
#, no-c-format
msgid "Generate a #line directive pointing at the current working directory."
msgstr "Genereer a #reël direktef pointing by die huidige working gids."

#: c-family/c.opt:2530
#, no-c-format
msgid "Generate lazy class lookup (via objc_getClass()) for use in Zero-Link mode."
msgstr "Genereer lui klas soek op (via objc_getClass()) vir gebruik in Zero-Link modus."

#: c-family/c.opt:2534
#, no-c-format
msgid "Dump declarations to a .decl file."
msgstr "Stort declarations na a.decl lêer."

#: c-family/c.opt:2538
#, no-c-format
msgid "-femit-struct-debug-baseonly\tAggressive reduced debug info for structs."
msgstr "-femit-struct-debug-baseonly\tAggressive reduced ontfout inligting vir structs."

#: c-family/c.opt:2542
#, no-c-format
msgid "-femit-struct-debug-reduced\tConservative reduced debug info for structs."
msgstr "-femit-struct-debug-reduced\tConservative reduced ontfout inligting vir structs."

#: c-family/c.opt:2546
#, no-c-format
msgid "-femit-struct-debug-detailed=<spec-list>\tDetailed reduced debug info for structs."
msgstr "-femit-struct-debug-detailed=<spec-list>\tDetailed reduced ontfout inligting vir structs."

#: c-family/c.opt:2550
#, no-c-format
msgid "Interpret imaginary, fixed-point, or other gnu number suffix as the corresponding number literal rather than a user-defined number literal."
msgstr "Interpret imaginêre, fixed-point, of ander GNU getal agtervoegsel as die ooreenstemmende getal letterlik eerder as a user-defined getal letterlik."

#: c-family/c.opt:2555
#, no-c-format
msgid "-idirafter <dir>\tAdd <dir> to the end of the system include path."
msgstr "-idirafter <dir>\tVoeg by <dir> na die einde van die stelsel sluit in pad."

#: c-family/c.opt:2559
#, no-c-format
msgid "-imacros <file>\tAccept definition of macros in <file>."
msgstr "-imacros <lêer>\tAanvaar definisie van makro's in <lêer>."

#: c-family/c.opt:2563
#, no-c-format
msgid "-imultilib <dir>\tSet <dir> to be the multilib include subdirectory."
msgstr "-imultilib <dir>\tStel <dir> na wees die multilib sluit in subdirectory."

#: c-family/c.opt:2567
#, no-c-format
msgid "-include <file>\tInclude the contents of <file> before other files."
msgstr "-sluit in <lêer>\tSluit in die contents van <lêer> voor ander lêers."

#: c-family/c.opt:2571
#, no-c-format
msgid "-iprefix <path>\tSpecify <path> as a prefix for next two options."
msgstr "-iprefix <pad>\tSpesifiseer <pad> as a voorvoegsel vir volgende two opsies."

#: c-family/c.opt:2575
#, no-c-format
