msgstr "Display teiken spesifieke opdragreël opsies (insluitend samesteller en skakelaar opsies)."

#: common.opt:463 common.opt:505 common.opt:509 common.opt:513 common.opt:517
#: common.opt:521 common.opt:525 common.opt:529 common.opt:945 common.opt:3863
#: common.opt:3961 common.opt:4075
#, no-c-format
msgid "Passed to the linker."
msgstr "Deurgegee na die skakelaar."

#: common.opt:467
#, no-c-format
msgid "-O<number>\tSet optimization level to <number>."
msgstr "-O<getal>\tStel optimering vlak na <getal>."

#: common.opt:471
#, no-c-format
msgid "Optimize for space rather than speed."
msgstr "Optimeer vir space eerder as speed."

#: common.opt:475
#, no-c-format
msgid "Optimize for speed disregarding exact standards compliance."
msgstr "Optimeer vir speed disregarding exact standards compliance."

#: common.opt:479
#, no-c-format
msgid "Optimize for debugging experience rather than speed or size."
msgstr "Optimeer vir ontfouting experience eerder as speed of grootte."

#: common.opt:483
#, no-c-format
msgid "Optimize for space aggressively rather than speed."
msgstr "Optimeer vir space aggressively eerder as speed."

#: common.opt:488
#, no-c-format
msgid "-Q --help prints what options are enabled.  Just -Q enables verbose messages."
msgstr "-Q --help prints what opsies is geaktiveer. Net -Q enables verbose boodskappe."

#: common.opt:501
#, no-c-format
msgid "Stop processing after generating assembly code; do not assemble."
msgstr "Stop processing ná generating assembly kode; moenie assemble."

#: common.opt:533
#, no-c-format
msgid "This switch is deprecated; use -Wextra instead."
msgstr "Hierdie skakelaar is verouderde; gebruik -Wextra in plaas."

#: common.opt:546
#, no-c-format
msgid "Warn about returning structures, unions or arrays."
msgstr "waarsku oor teruggee structures, unions of skikkings."

#: common.opt:550
#, no-c-format
msgid "Warn if a loop with constant number of iterations triggers undefined behavior."
msgstr "waarsku as a lus met konstant aantal iterations triggers ongedefinieerde gedrag."

#: common.opt:557
#, no-c-format
msgid "Warn if an array is accessed out of bounds."
msgstr "waarsku as 'n skikking is accessed buite van grense."

#: common.opt:561
#, no-c-format
msgid "Warn about problems with auto-profile data."
msgstr "waarsku oor problems met auto-profile data."

#: common.opt:568
#, no-c-format
msgid "Warn for uses of pointers to deallocated storage."
msgstr "waarsku vir gebruik van wysers na deallocated berging."

#: common.opt:572
#, no-c-format
msgid "Warn about inappropriate attribute usage."
msgstr "waarsku oor inappropriate kenmerk gebruik."

#: common.opt:576
#, no-c-format
msgid "Do not warn about specified attributes."
msgstr "moenie waarsku oor gespesifiseer kenmerke."

#: common.opt:580 common.opt:584
#, no-c-format
msgid "Warn about type safety and similar errors and mismatches in declarations with alias attributes."
msgstr "waarsku oor tipe safety en soortgelyke foute en mismatches in declarations met alias kenmerke."

#: common.opt:588
#, no-c-format
msgid "Warn when profiling instrumentation was requested, but could not be applied to a certain function."
msgstr "waarsku wanneer profilering instrumentation was requested, maar kon nie wees toegepas na a certain funksie nie."

#: common.opt:593 common.opt:597
#, no-c-format
msgid "Warn about pointer casts which increase alignment."
msgstr "waarsku oor wyser casts wat verhoog belyning."

#: common.opt:601
#, no-c-format
msgid "Complain when a command-line option is valid, but not applicable to the current front end."
msgstr "Complain wanneer a opdragreël opsie is geldige, maar nie applicable na die huidige front einde nie."

#: common.opt:605
#, no-c-format
msgid "Warn when a #warning directive is encountered."
msgstr "waarsku wanneer a #waarskuwing direktef is encountered."

#: common.opt:609
#, no-c-format
msgid "Warn about uses of __attribute__((warning)) declarations."
msgstr "waarsku oor gebruik van __kenmerk__((waarskuwing)) declarations."

#: common.opt:613
#, no-c-format
msgid "Warn if a deprecated compiler feature, class, method, or field is used."
msgstr "waarsku as a verouderde kompileerder kenmerk, klas, metode, of veld is gebruik."

#: common.opt:617
#, no-c-format
msgid "Warn about uses of __attribute__((deprecated)) declarations."
msgstr "waarsku oor gebruik van __kenmerk__((verouderde)) declarations."

#: common.opt:621
#, no-c-format
msgid "Warn when an optimization pass is disabled."
msgstr "waarsku wanneer 'n optimering gee deur is gedeaktiveer."

#: common.opt:625
#, no-c-format
msgid "Turn all warnings into errors."
msgstr "Turn alle waarskuwings in foute."

#: common.opt:629
#, no-c-format
msgid "Turn the specified warning into an error."
msgstr "Turn die gespesifiseer waarskuwing in 'n fout."

#: common.opt:633
#, no-c-format
msgid "Print extra (possibly unwanted) warnings."
msgstr "Druk ekstra (moontlik unwanted) waarskuwings."

#: common.opt:637
#, no-c-format
msgid "Exit on the first error occurred."
msgstr "Verlaat op die eerste fout occurred."

#: common.opt:641
#, no-c-format
msgid "-Wframe-larger-than=<byte-size>\tWarn if a function's stack frame requires in excess of <byte-size>."
msgstr "-Wframe-larger-than=<byte-size>\twaarsku as a function's stapel raam vereis in excess van <byte-size>."

#: common.opt:645
#, no-c-format
msgid "Disable -Wframe-larger-than= warning.  Equivalent to -Wframe-larger-than=<SIZE_MAX> or larger."
msgstr "Deaktiveer -Wframe-larger-than= waarskuwing. Equivalent na -Wframe-larger-than=<GROOTTE_MAX> of larger."

#: common.opt:649
#, no-c-format
msgid "Warn when attempting to free a non-heap object."
msgstr "waarsku wanneer attempting na stel vry a non-heap objek."

#: common.opt:653
#, no-c-format
msgid "Warn when -fhardened did not enable an option from its set."
msgstr "waarsku wanneer -fhardened het nie aktiveer 'n opsie van sy stel nie."

#: common.opt:664
#, no-c-format
msgid "Warn when a switch case falls through."
msgstr "waarsku wanneer a skakelaar geval falls deur."

#: common.opt:668 rust/lang.opt:59 c-family/c.opt:919
#, no-c-format
msgid "Warn for infinitely recursive calls."
msgstr "waarsku vir infinitely rekursiewe oproepe."

#: common.opt:672
#, no-c-format
msgid "Warn when an inlined function cannot be inlined."
msgstr "waarsku wanneer 'n geïnline funksie kan nie wees geïnline nie."

#: common.opt:676
#, no-c-format
msgid "Warn when an atomic memory model parameter is known to be outside the valid range."
msgstr "waarsku wanneer 'n atomiese geheue model parameter is known na wees buite die geldige bestek."

#: common.opt:683
#, no-c-format
msgid "-Wlarger-than=<byte-size>\tWarn if an object's size exceeds <byte-size>."
msgstr "-Wlarger-than=<byte-size>\twaarsku as 'n object's grootte oorskry <byte-size>."

#: common.opt:687
#, no-c-format
msgid "Disable -Wlarger-than= warning.  Equivalent to -Wlarger-than=<SIZE_MAX> or larger."
msgstr "Deaktiveer -Wlarger-than= waarskuwing. Equivalent na -Wlarger-than=<GROOTTE_MAX> of larger."

#: common.opt:691
#, no-c-format
msgid "Warn if comparing pointer parameter with nonnull attribute with NULL."
msgstr "waarsku as comparing wyser parameter met nonnull kenmerk met NULL."

#: common.opt:695
#, no-c-format
msgid "Warn if dereferencing a NULL pointer may lead to erroneous or undefined behavior."
msgstr "waarsku as dereferencing a nullwyser mag lead na erroneous of ongedefinieerde gedrag."

#: common.opt:706
#, no-c-format
msgid "Warn about passing a pointer/reference to a local or temporary variable to a musttail call argument."
msgstr "waarsku oor deurgee a wyser/verwysing na a plaaslike of tydelike veranderlike na a musttail oproep argument."

#: common.opt:710
#, no-c-format
msgid "Warn about pointer/reference to a local or temporary variable possibly escaping to a musttail call."
msgstr "waarsku oor wyser/verwysing na a plaaslike of tydelike veranderlike moontlik escaping na a musttail oproep."

#: common.opt:714
#, no-c-format
msgid "Warn about some C++ One Definition Rule violations during link time optimization."
msgstr "waarsku oor some C++ One Definisie Rule violations tydens skakel tyd optimering."

#: common.opt:718
#, no-c-format
msgid "Warn about overflow in arithmetic expressions."
msgstr "waarsku oor oorloop in rekenkundige expressions."

#: common.opt:722
#, no-c-format
msgid "During link time optimization warn about mismatched types of global declarations."
msgstr "Tydens skakel tyd optimering waarsku oor mismatched tipes van globale declarations."

