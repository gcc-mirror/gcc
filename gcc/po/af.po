#, no-c-format
msgid "Enable all -Wunused- warnings."
msgstr "Aktiveer alle -Wunused- waarskuwings."

#: common.opt:868
#, no-c-format
msgid "Warn when a function parameter is only set, otherwise unused."
msgstr "waarsku wanneer a funksie parameter is slegs stel, andersins ongebruikte."

#: common.opt:875
#, no-c-format
msgid "Warn when a variable is only set, otherwise unused."
msgstr "waarsku wanneer a veranderlike is slegs stel, andersins ongebruikte."

#: common.opt:879
#, no-c-format
msgid "Warn when a function is unused."
msgstr "waarsku wanneer a funksie is ongebruikte."

#: common.opt:883
#, no-c-format
msgid "Warn when a label is unused."
msgstr "waarsku wanneer a etiket is ongebruikte."

#: common.opt:887
#, no-c-format
msgid "Warn when a function parameter is unused."
msgstr "waarsku wanneer a funksie parameter is ongebruikte."

#: common.opt:891
#, no-c-format
msgid "Warn when an expression value is unused."
msgstr "waarsku wanneer 'n uitdrukking waarde is ongebruikte."

#: common.opt:895
#, no-c-format
msgid "Warn when a variable is unused."
msgstr "waarsku wanneer a veranderlike is ongebruikte."

#: common.opt:899
#, no-c-format
msgid "Warn in case profiles in -fprofile-use do not match."
msgstr "Waarsku in geval profiles in -fprofile-use moenie pas."

#: common.opt:903
#, no-c-format
msgid "Warn in case a function ends earlier than it begins due to an invalid linenum macros."
msgstr "Waarsku in geval a funksie ends vroeër as dit begins due na 'n ongeldige linenum makro's."

#: common.opt:907
#, no-c-format
msgid "Warn when a conditional has too many terms and condition coverage profiling gives up instrumenting the expression."
msgstr "waarsku wanneer a voorwaardelike het te veel terms en voorwaarde dekking profilering gives op instrumenting die uitdrukking."

#: common.opt:912
#, no-c-format
msgid "-fpath-coverage-limit=<number> Don't instrument functions path count exceeding <number>."
msgstr "-fpath-coverage-limit=<getal> Don't instrument funksies pad telling exceeding <getal>."

#: common.opt:917
#, no-c-format
msgid "Warn if a function exceeds the number of paths (controlled by -fpath-coverage-limit) and path coverage give up instrumenting the function. The limit is approximate and conservative and coverage might give up even if the actual number is slightly below the limit."
msgstr "waarsku as a funksie oorskry die aantal paaie (controlled deur -fpath-coverage-limit) en pad dekking give op instrumenting die funksie. Die limiet is approximate en conservative en dekking mag give op even as die actual getal is slightly hieronder die limiet."

#: common.opt:924
#, no-c-format
msgid "Warn in case profiles in -fprofile-use do not exist."
msgstr "Waarsku in geval profiles in -fprofile-use moenie exist."

#: common.opt:928
#, no-c-format
msgid "Warn when a vector operation is compiled outside the SIMD."
msgstr "waarsku wanneer a vektor bewerking is gekombineer buite die SIMD."

#: common.opt:932
#, no-c-format
msgid "Warn about unsupported features in ThreadSanitizer."
msgstr "waarsku oor nie-ondersteunde kenmerke in ThreadSanitizer nie."

#: common.opt:949
#, no-c-format
msgid "-aux-info <file>\tEmit declaration information into <file>."
msgstr "-aux-info <lêer>\tGenereer verklaring inligting in <lêer>."

#: common.opt:962
#, no-c-format
msgid "-d<letters>\tEnable dumps from specific passes of the compiler."
msgstr "-d<letters>\tAktiveer dumps van spesifieke passes van die kompileerder."

#: common.opt:966
#, no-c-format
msgid "-dumpbase <file>\tSet the file basename to be used for dumps."
msgstr "-dumpbase <lêer>\tStel die lêer basename na wees gebruik vir dumps."

#: common.opt:970
#, no-c-format
msgid "-dumpbase-ext .<ext>    Drop a trailing .<ext> from the dump basename to name auxiliary output files."
msgstr "-dumpbase-ext.<ext> Drop a agterste.<ext> van die stort basename na naam auxiliary afvoer lêers."

#: common.opt:974
#, no-c-format
msgid "-dumpdir <dir>\tSet the directory name to be used for dumps."
msgstr "-dumpdir <dir>\tStel die gids naam na wees gebruik vir dumps."

#: common.opt:1089
#, no-c-format
msgid "The version of the C++ ABI in use."
msgstr "Die weergawe van die C++ ABI in gebruik."

#: common.opt:1093
#, no-c-format
msgid "Aggressively optimize loops using language constraints."
msgstr "Aggressively optimeer lusse gebruik taal constraints."

#: common.opt:1097
#, no-c-format
msgid "Align the start of functions."
msgstr "Align die begin van funksies."

#: common.opt:1104
#, no-c-format
msgid "Align labels which are only reached by jumping."
msgstr "Align labels wat is slegs reached deur jumping."

#: common.opt:1111
#, no-c-format
msgid "Align all labels."
msgstr "Align alle labels."

#: common.opt:1118
#, no-c-format
msgid "Align the start of loops."
