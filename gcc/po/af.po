#: config/darwin.opt:102
#, no-c-format
msgid "-allowable_client <name>\tThe output dylib is private to the client <name>."
msgstr "-allowable_client <naam>\tDie afvoer dylib is private na die client <naam>."

#: config/darwin.opt:106
#, no-c-format
msgid "-arch <name>\tGenerate output for architecture <name>."
msgstr "-arch <naam>\tGenereer afvoer vir argitektuur <naam>."

#: config/darwin.opt:110
#, no-c-format
msgid "Mismatches between file architecture and one specified by \"-arch\" are errors instead of warnings."
msgstr "Mismatches tussen lêer argitektuur en one gespesifiseer deur \"-arch\" is foute in plaas van waarskuwings."

#: config/darwin.opt:114
#, no-c-format
msgid "The earliest macOS version on which this program will run (formatted for the assembler)."
msgstr "Die earliest macOS weergawe op wat hierdie program sal run (geformateerde vir die samesteller)."

#: config/darwin.opt:118
#, no-c-format
msgid "Generate an output executable that binds symbols on load, rather than lazily."
msgstr "Genereer 'n afvoer uitvoerbare lêer wat binds simbole op laai, eerder as lazily."

#: config/darwin.opt:122
#, no-c-format
msgid "Generate a Mach-O bundle (file type MH_BUNDLE)."
msgstr "Genereer a Mach-O bundle (lêer tipe MH_BUNDLE)."

#: config/darwin.opt:126
#, no-c-format
msgid "-bundle_loader <executable>\tTreat <executable> (that will be loading this bundle) as if it was one of the dynamic libraries the bundle is linked against for symbol resolution."
msgstr "-bundle_loader <uitvoerbare lêer>\tTreat <uitvoerbare lêer> (wat sal wees loading hierdie bundle) as as dit was one van die dinamiese biblioteke die bundle is geskakel teen vir simbool resolusie."

#: config/darwin.opt:130
#, no-c-format
msgid "-client_name <name>\tEnable the executable being built to link against a private dylib (using allowable_client)."
msgstr "-client_naam <naam>\tAktiveer die uitvoerbare lêer besig om te built na skakel teen a private dylib (gebruik allowable_client)."

#: config/darwin.opt:134
#, no-c-format
msgid "-compatibility_version <number>\tSet the version for the client interface.  Client programs must record a value less than or equal to <number>, or the binding will fail at runtime."
msgstr "-compatibility_weergawe <getal>\tStel die weergawe vir die client koppelvlak. Client programme moet rekord a waarde minder as of gelyk aan <getal>, of die binding sal fail by looptyd."

#: config/darwin.opt:138
#, no-c-format
msgid "-current_version <number>\tSet the current version for the library to <number>."
msgstr "-huidige_weergawe <getal>\tStel die huidige weergawe vir die biblioteek na <getal>."

#: config/darwin.opt:142
#, no-c-format
msgid "Remove code and data that is unreachable from any exported symbol (including the entry point)."
msgstr "Verwyder kode en data wat is onbereikbaar van enige exported simbool (insluitend die inskrywing punt)."

#: config/darwin.opt:146
#, no-c-format
msgid "-dylib_file install_name:file_name\tThis allows linking of a dylib with \"install_name\" but to be found in a different install position \"file_name\""
msgstr "-dylib_lêer install_naam:lêer_naam\tHierdie allows skakeling van a dylib met \"install_naam\" maar na wees gevind in a verskillende install posisie \"lêer_naam\""

#: config/darwin.opt:150
#, no-c-format
msgid "Produce a Mach-O dylinker (file type MH_DYLINKER), only used for building dyld."
msgstr "Produce a Mach-O dylinker (lêer tipe MH_DYLINKER), slegs gebruik vir building dyld."

#: config/darwin.opt:154
#, no-c-format
msgid "-dylinker_install_name <path>\tOnly used for building dyld."
msgstr "-dylinker_install_naam <pad>\tSlegs gebruik vir building dyld."

#: config/darwin.opt:158
#, no-c-format
msgid "The default (and opposite of -static), implied by user mode executables, shared libraries and bundles."
msgstr "Die verstek (en opposite van -statiese), implied deur gebruiker modus executables, gedeelde biblioteke en bundles."

#: config/darwin.opt:162
#, no-c-format
msgid "Produce a Mach-O shared library (file type MH_DYLIB), synonym for \"-shared\"."
msgstr "Produce a Mach-O gedeelde biblioteek (lêer tipe MH_DYLIB), synonym vir \"-gedeelde\"."

#: config/darwin.opt:166
#, no-c-format
msgid "-exported_symbols_list <filename>\tExport global symbols in <filename> in linked output file; any symbols not mentioned will be treated as \"hidden\"."
msgstr "-exported_simbole_lys <filename>\tExport globale simbole in <filename> in geskakel afvoer lêer; enige simbole nie mentioned sal wees hanteer as \"versteek\" nie."

#: config/darwin.opt:170
#, no-c-format
msgid "Supply a list of objects to be linked from a file, rather than the command line."
msgstr "Supply a lys van objekte na wees geskakel van a lêer, eerder as die opdragreël."

#: config/darwin.opt:175 config/darwin.opt:196
#, no-c-format
msgid "Used for generating code for some older kernel revisions."
msgstr "Gebruik vir generating kode vir some older kernel revisions."

#: config/darwin.opt:179
#, no-c-format
msgid "Ignore the normal two-level namespace; resolve symbols in command line order and do not record which library provided the resolved symbol."
msgstr "Ignoreer die normale two-level naamruimte; los op simbole in opdragreël volgorde en moenie rekord wat biblioteek verskaf die opgelos simbool."

#: config/darwin.opt:183
#, no-c-format
msgid "For the assembler (and linker) permit any architecture sub-variant to be used without error."
msgstr "Vir die samesteller (en skakelaar) permit enige argitektuur sub-variant na wees gebruik sonder fout."

#: config/darwin.opt:187
#, no-c-format
msgid "Set the output object such that, on loading, dyld will ignore any two-level namespace information and resolve symbols in the discovery order for loaded libs."
msgstr "Stel die afvoer objek sulke wat, op loading, dyld sal ignoreer enige two-level naamruimte inligting en los op simbole in die discovery volgorde vir gelaai libs."

#: config/darwin.opt:191
#, no-c-format
msgid "-framework <name>\tThe linker should search for the framework <name> in the framework search path."
msgstr "-framework <naam>\tDie skakelaar moet soek vir die framework <naam> in die framework soek pad."

#: config/darwin.opt:200
#, no-c-format
msgid "Abbreviation for \"-g -fno-eliminate-unused-debug-symbols\"."
msgstr "Abbreviation vir \"-g -fno-eliminate-unused-debug-symbols\"."

#: config/darwin.opt:204
#, no-c-format
msgid "Abbreviation for \"-g -feliminate-unused-debug-symbols\"."
msgstr "Abbreviation vir \"-g -feliminate-unused-debug-symbols\"."

#: config/darwin.opt:208
#, no-c-format
msgid "Automatically adds space for longer path names in load commands (up to MAXPATHLEN)."
msgstr "Outomaties adds space vir longer pad name in laai commands (op na MAXPATHLEN)."

#: config/darwin.opt:212
#, no-c-format
msgid "-image_base <address>\tSpecify <address> as the base address for a dylib or bundle."
msgstr "-image_basis <adres>\tSpesifiseer <adres> as die basis adres vir a dylib of bundle."

#: config/darwin.opt:216
#, no-c-format
msgid "-init <symbol_name>\tThe symbol <symbol_name> will be used as the first initializer for a dylib."
msgstr "-init <simbool_naam>\tDie simbool <simbool_naam> sal wees gebruik as die eerste inisieerder vir a dylib."

#: config/darwin.opt:220
#, no-c-format
msgid "-install_name <name>\tSet the install name for a dylib."
msgstr "-install_naam <naam>\tStel die install naam vir a dylib."

#: config/darwin.opt:224
#, no-c-format
msgid "Usually \"private extern\" (hidden) symbols are made local when linking, this command suppresses that such that they remain exported."
msgstr "Gewoonlik \"private extern\" (versteek) simbole is made plaaslike wanneer skakeling, hierdie opdrag suppresses wat sulke wat hulle remain exported."

#: config/darwin.opt:228
#, no-c-format
msgid "(Obsolete after 10.4) Multi modules are ignored at runtime since macOS 10.4."
msgstr "(Verouderde ná 10.4) Multi modules is geïgnoreer by looptyd aangesien macOS 10.4."

#: config/darwin.opt:232
#, no-c-format
msgid "(Obsolete after 10.4) -multiply_defined <treatment>\tProvided a mechanism for warning about symbols defined in multiple dylibs."
msgstr "(Verouderde ná 10.4) -multiply_gedefinieerde <treatment>\tVerskaf a mechanism vir waarskuwing oor simbole gedefinieerde in veelvuldige dylibs."

#: config/darwin.opt:236
#, no-c-format
msgid "(Obsolete after 10.4) -multiply_defined_unused <treatment>\tProvided a mechanism for warning about symbols defined in the current executable also being defined in linked dylibs."
msgstr "(Verouderde ná 10.4) -multiply_gedefinieerde_ongebruikte <treatment>\tVerskaf a mechanism vir waarskuwing oor simbole gedefinieerde in die huidige uitvoerbare lêer ook besig om te gedefinieerde in geskakel dylibs."

#: config/darwin.opt:240
#, no-c-format
msgid "(Obsolete) Current linkers never dead-strip these items, so the option is not needed."
msgstr "(Verouderde) Huidige linkers nooit dead-strip hierdie items, so die opsie is nie benodig nie."

#: config/darwin.opt:244
#, no-c-format
msgid "Do not add a default symbol exports to modules or dynamic libraries."
msgstr "moenie voeg by a verstek simbool exports na modules of dinamiese biblioteke."

#: config/darwin.opt:248
#, no-c-format
msgid "Do not add default run paths (for the compiler library directories) to executables, modules or dynamic libraries."
msgstr "moenie voeg by verstek run paaie (vir die kompileerder biblioteek directories) na executables, modules of dinamiese biblioteke."

#: config/darwin.opt:252
#, no-c-format
msgid "(Obsolete after 10.3.9) Set MH_NOPREFIXBINDING, in an executable."
msgstr "(Verouderde ná 10.3.9) Stel MH_NOPREFIXBINDING, in 'n uitvoerbare lêer."

#: config/darwin.opt:256
#, no-c-format
msgid "(Obsolete after 10.4)\tSet MH_NOMULTIDEFS in an umbrella framework."
msgstr "(Verouderde ná 10.4)\tStel MH_NOMULTIDEFS in 'n umbrella framework."

#: config/darwin.opt:260 config/darwin.opt:286 config/darwin.opt:290
#, no-c-format
msgid "(Obsolete) LD_PREBIND is no longer supported."
msgstr "(Verouderde) LD_PREBIND is geen longer ondersteun."

#: config/darwin.opt:264
#, no-c-format
msgid "(Obsolete) This is the default."
msgstr "(Verouderde) dit is die verstek."

#: config/darwin.opt:268
#, no-c-format
msgid "Equivalent to -xobjective-c."
msgstr "Equivalent na -xobjective-c."

#: config/darwin.opt:272
#, no-c-format
msgid "Equivalent to -xobjective-c++."
msgstr "Equivalent na -xobjective-c++."

#: config/darwin.opt:282
#, no-c-format
msgid "-pagezero_size <size>\tAllows setting the page 0 size to 4kb when required."
msgstr "-pagezero_grootte <grootte>\tAllows setting die page 0 grootte na 4kb wanneer vereis."

#: config/darwin.opt:294
#, no-c-format
msgid "Produces a Mach-O file suitable for embedded/ROM use."
msgstr "Produces a Mach-O lêer suitable vir embedded/ROM gebruik."

#: config/darwin.opt:298
#, no-c-format
msgid "(Obsolete) Allowed linking to proceed with \"-flat_namespace\" when a linked bundle contained a symbol also exported from the main executable."
msgstr "(Verouderde) Toegelaat skakeling na proceed met \"-flat_naamruimte\" wanneer a geskakel bundle contained a simbool ook exported van die main uitvoerbare lêer."

#: config/darwin.opt:305
#, no-c-format
msgid "Synonym for \"-export-dynamic\" for linker versions that support it."
msgstr "Synonym vir \"-export-dynamic\" vir skakelaar versions wat ondersteun dit."

#: config/darwin.opt:309
#, no-c-format
msgid "-read_only_relocs <treatment>\tAllow relocations in read-only pages (not recommended)."
msgstr "-lees_slegs_relocs <treatment>\tLaat toe relocations in read-only pages (nie recommended) nie."

#: config/darwin.opt:313
#, no-c-format
msgid "-sectalign <segname> <sectname> <value>\tSet section <sectname> in segment <segname> to have alignment <value> which must be an integral power of two expressed in hexadecimal form."
msgstr "-sectalign <segname> <sectname> <waarde>\tStel afdeling <sectname> in segment <segname> na het belyning <waarde> wat moet wees 'n integral power van two expressed in heksadesimale vorm."

#: config/darwin.opt:317
#, no-c-format
msgid "-sectcreate <segname> <sectname> <file>\tCreate section <sectname> in segment <segname> from the contents of <file>."
msgstr "-sectcreate <segname> <sectname> <lêer>\tSkep afdeling <sectname> in segment <segname> van die contents van <lêer>."

#: config/darwin.opt:321
#, no-c-format
msgid "(Obsolete) -sectobjectsymbols <segname> <sectname>\tSetting a local symbol at the start of a section is no longer supported."
msgstr "(Verouderde) -sectobjectsymbols <segname> <sectname>\tSetting a plaaslike simbool by die begin van a afdeling is geen longer ondersteun."

#: config/darwin.opt:325
#, no-c-format
msgid "(Obsolete) -sectorder <segname> <sectname> <orderfile>\tReplaced by a more general option \"-order_file\"."
msgstr "(Verouderde) -sectorder <segname> <sectname> <orderfile>\tReplaced deur a more general opsie \"-volgorde_lêer\"."

#: config/darwin.opt:329
#, no-c-format
msgid "-seg_addr_table <file>\tSpecify the base addresses for dynamic libraries; <file> contains a line for each library."
msgstr "-seg_addr_tabel <lêer>\tSpesifiseer die basis addresses vir dinamiese biblioteke; <lêer> bevat a reël vir elke biblioteek."

#: config/darwin.opt:334
#, no-c-format
msgid "(Obsolete, ld_classic only) -seg_addr_table_filename <path>."
msgstr "(Verouderde, LD_classic slegs) -seg_addr_tabel_filename <pad>."

#: config/darwin.opt:338
#, no-c-format
msgid "Synonym for \"image_base\"."
msgstr "Synonym vir \"image_basis\"."

#: config/darwin.opt:342
#, no-c-format
msgid "-segaddr <name> <address>\tSet the base address of segment <name> to <address> which must be aligned to a page boundary (currently 4kb)."
msgstr "-segaddr <naam> <adres>\tStel die basis adres van segment <naam> na <adres> wat moet wees belyn na a page boundary (tans 4kb)."

#: config/darwin.opt:347
#, no-c-format
msgid "(Obsolete, ld_classic only) -sectcreate <segname> <sectname> <file>\tAllowed creation of a section from a file."
msgstr "(Verouderde, LD_classic slegs) -sectcreate <segname> <sectname> <lêer>\tToegelaat creation van a afdeling van a lêer."

#: config/darwin.opt:351
#, no-c-format
msgid "(Obsolete) Object files with LINKEDIT sections are no longer supported."
msgstr "(Verouderde) Objek lêers met LINKEDIT sections is geen longer ondersteun."

#: config/darwin.opt:355
#, no-c-format
msgid "-segprot <segname> <max_prot> <init_prot>\tThe virtual memory protections for segment <segname> have maximum and initial values <max_prot> and <init_prot> respectively.  The specified values may contain \"r\", \"w\", \"x\" or \"-\" the latter meaning \"no access\"."
msgstr "-segprot <segname> <max_prot> <init_prot>\tDie virtuele geheue protections vir segment <segname> het maksimum en aanvanklike waardes <max_prot> en <init_prot> onderskeidelik. Die gespesifiseer waardes mag bevat \"r\", \"w\", \"x\" of \"-\" die latter betekenis \"geen toegang\"."

#: config/darwin.opt:359
#, no-c-format
msgid "-segs_read_only_addr <address>\tSpecify that <address> is the base address of the read-only segments of a dylib."
msgstr "-segs_lees_slegs_addr <adres>\tSpesifiseer wat <adres> is die basis adres van die read-only segments van a dylib."

#: config/darwin.opt:363
#, no-c-format
msgid "-segs_read_write_addr <address>\tSpecify that <address> is the base address address of the read-write segments of a dylib."
msgstr "-segs_lees_skryf_addr <adres>\tSpesifiseer wat <adres> is die basis adres adres van die read-write segments van a dylib."

#: config/darwin.opt:367
#, no-c-format
msgid "(Obsolete)\tThis is the default."
msgstr "(Verouderde)\tdit is die verstek."

#: config/darwin.opt:371
#, no-c-format
msgid "-sub_library <name>\tLibrary named <name> will be re-exported (only useful for dylibs)."
msgstr "-sub_biblioteek <naam>\tBiblioteek benoemde <naam> sal wees re-exported (slegs useful vir dylibs)."

#: config/darwin.opt:375
#, no-c-format
msgid "-sub_umbrella <name>\tFramework named <name> will be re-exported (only useful for dylibs)."
msgstr "-sub_umbrella <naam>\tFramework benoemde <naam> sal wees re-exported (slegs useful vir dylibs)."

#: config/darwin.opt:379
#, no-c-format
msgid "This is the default."
msgstr "dit is die verstek."

#: config/darwin.opt:383
#, no-c-format
msgid "Add extra information to the executable that can speed up dynamic loading (provided that dependent libraries are unchanged)."
msgstr "Voeg by ekstra inligting na die uitvoerbare lêer wat kan speed op dinamiese loading (verskaf wat afhanklike biblioteke is unchanged)."

#: config/darwin.opt:387
#, no-c-format
msgid "-umbrella <framework>\tThe specified framework will be re-exported."
msgstr "-umbrella <framework>\tDie gespesifiseer framework sal wees re-exported."

#: config/darwin.opt:391
#, no-c-format
msgid "-undefined <treatment>\tSpecify the handling for undefined symbols (default is error)."
msgstr "-ongedefinieerde <treatment>\tSpesifiseer die handling vir ongedefinieerde simbole (verstek is fout)."

#: config/darwin.opt:395
#, no-c-format
msgid "-unexported_symbols_list <filename>\tDo not export the global symbols listed in <filename>."
msgstr "-unexported_simbole_lys <filename>\tmoenie export die globale simbole listed in <filename>."

#: config/darwin.opt:399
#, no-c-format
msgid "-weak_framework <framework>\tMake a weak link to the specified framework."
msgstr "-swak_framework <framework>\tMake a swak skakel na die gespesifiseer framework."

#: config/darwin.opt:403
#, no-c-format
msgid "-weak_reference_mismatches <treatment>\tSpecifies what to do if a symbol import conflicts between file (weak in one and not in another) the default is to treat the symbol as non-weak."
msgstr "-swak_verwysing_mismatches <treatment>\tSpecifies what na doen as a simbool import bots tussen lêer (swak in one en nie in nog 'n) die verstek is na treat die simbool as non-weak nie."

#: config/darwin.opt:407
#, no-c-format
msgid "Logs which object files the linker loads."
msgstr "Logs wat objek lêers die skakelaar loads."

#: config/darwin.opt:411
#, no-c-format
msgid "Logs which symbol(s) caused an object to be loaded."
msgstr "Logs wat simbool(s) caused 'n objek na wees gelaai."

#: config/darwin.opt:419
#, no-c-format
msgid "(Obsolete, ignored)\tOld support similar to \"-whyload\"."
msgstr "(Verouderde, geïgnoreer)\tOu ondersteun soortgelyke na \"-whyload\"."

#: config/darwin.opt:423
#, no-c-format
msgid "(Obsolete and unhandled by ld64, ignored)\tld should produce an executable (only handled by ld_classic)."
msgstr "(Verouderde en unhandled deur LD64, geïgnoreer)\tLD moet produce 'n uitvoerbare lêer (slegs handled deur LD_classic)."

#: config/c6x/c6x-tables.opt:24
#, no-c-format
msgid "Known C6X ISAs (for use with the -march= option):"
msgstr "Known C6X ISAs (vir gebruik met die -march= opsie):"

#: config/c6x/c6x.opt:30 config/mips/mips.opt:134
#, no-c-format
msgid "Use big-endian byte order."
msgstr "Gebruik groot-endian greep volgorde."

#: config/c6x/c6x.opt:34 config/mips/mips.opt:138
#, no-c-format
msgid "Use little-endian byte order."
msgstr "Gebruik klein-endian greep volgorde."

#: config/c6x/c6x.opt:42
#, no-c-format
msgid "Select method for sdata handling."
msgstr "Select metode vir sdata handling."

#: config/c6x/c6x.opt:46
#, no-c-format
msgid "Valid arguments for the -msdata= option:"
msgstr "Geldige argumente vir die -msdata= opsie:"

#: config/c6x/c6x.opt:59
#, no-c-format
msgid "Compile for the DSBT shared library ABI."
msgstr "Kompileer vir die DSBT gedeelde biblioteek ABI."

#: config/mips/mips.opt:32
#, no-c-format
msgid "-mabi=ABI\tGenerate code that conforms to the given ABI."
msgstr "-mabi=ABI\tGenereer kode wat conforms na die gegee ABI."

#: config/mips/mips.opt:36
#, no-c-format
msgid "Known MIPS ABIs (for use with the -mabi= option):"
msgstr "Known MIPS ABIs (vir gebruik met die -mabi= opsie):"

#: config/mips/mips.opt:55
#, no-c-format
msgid "Generate code that can be used in SVR4-style dynamic objects."
msgstr "Genereer kode wat kan wees gebruik in SVR4-style dinamiese objekte."

#: config/mips/mips.opt:59
#, no-c-format
msgid "Use PMC-style 'mad' instructions."
msgstr "Gebruik PMC-style 'mad' instruksies."

#: config/mips/mips.opt:63
#, no-c-format
msgid "Use integer madd/msub instructions."
msgstr "Gebruik heelgetal madd/msub instruksies."

#: config/mips/mips.opt:67
#, no-c-format
msgid "-march=ISA\tGenerate code for the given ISA."
msgstr "-march=ISA\tGenereer kode vir die gegee ISA."

#: config/mips/mips.opt:75
#, no-c-format
msgid "Use Branch Likely instructions, overriding the architecture default."
msgstr "Gebruik Vertakking Likely instruksies, overriding die argitektuur verstek."

#: config/mips/mips.opt:79
#, no-c-format
msgid "Switch on/off MIPS16 ASE on alternating functions for compiler testing."
msgstr "Skakelaar op/af MIPS16 ASE op alternating funksies vir kompileerder testing."

#: config/mips/mips.opt:87
#, no-c-format
msgid "-mcode-readable=SETTING\tSpecify when instructions are allowed to access code."
msgstr "-mcode-readable=SETTING\tSpesifiseer wanneer instruksies is toegelaat na toegang kode."

#: config/mips/mips.opt:91
#, no-c-format
msgid "Valid arguments to -mcode-readable=:"
msgstr "Geldige argumente na -mcode-readable=:"

#: config/mips/mips.opt:104
#, no-c-format
msgid "Use branch-and-break sequences to check for integer divide by zero."
msgstr "Gebruik branch-and-break sequences na kontroleer vir heelgetal divide deur nul."

#: config/mips/mips.opt:108
#, no-c-format
msgid "Use trap instructions to check for integer divide by zero."
msgstr "Gebruik val instruksies na kontroleer vir heelgetal divide deur nul."

#: config/mips/mips.opt:112
#, no-c-format
msgid "Allow the use of MDMX instructions."
msgstr "Laat toe die gebruik van MDMX instruksies."

#: config/mips/mips.opt:120
#, no-c-format
msgid "Use MIPS-DSP instructions."
msgstr "Gebruik MIPS-DSP instruksies."

#: config/mips/mips.opt:124
#, no-c-format
msgid "Use MIPS-DSP REV 2 instructions."
msgstr "Gebruik MIPS-DSP REV 2 instruksies."

#: config/mips/mips.opt:146
#, no-c-format
msgid "Use Enhanced Virtual Addressing instructions."
msgstr "Gebruik Enhanced Virtuele Addressing instruksies."

#: config/mips/mips.opt:171
#, no-c-format
msgid "Don't use %reloc() assembly operators (for backward compatibility)."
msgstr "Don't gebruik %reloc() assembly operators (vir backward compatibility)."

#: config/mips/mips.opt:175
#, no-c-format
msgid "Use -G for data that is not defined by the current object."
msgstr "Gebruik -G vir data wat is nie gedefinieer nie deur die huidige objek nie."

#: config/mips/mips.opt:179
#, no-c-format
msgid "Work around certain 24K errata."
msgstr "Work rondom certain 24K errata."

#: config/mips/mips.opt:183
#, no-c-format
msgid "Work around certain R4000 errata."
msgstr "Work rondom certain R4000 errata."

#: config/mips/mips.opt:187
#, no-c-format
msgid "Work around certain R4400 errata."
msgstr "Work rondom certain R4400 errata."

#: config/mips/mips.opt:191
#, no-c-format
msgid "Work around the R5900 short loop erratum."
msgstr "Work rondom die R5900 kort lus erratum."

#: config/mips/mips.opt:195
#, no-c-format
msgid "Work around certain RM7000 errata."
msgstr "Work rondom certain RM7000 errata."

#: config/mips/mips.opt:199
#, no-c-format
msgid "Work around certain R10000 errata."
msgstr "Work rondom certain R10000 errata."

#: config/mips/mips.opt:203
#, no-c-format
msgid "Work around errata for early SB-1 revision 2 cores."
msgstr "Work rondom errata vir early SB-1 revision 2 cores."

