#: lto/lang.opt:50
#, no-c-format
msgid "Set linker output type (used internally during LTO optimization)."
msgstr "Stel skakelaar afvoer tipe (gebruik internally tydens LTO optimering)."

#: lto/lang.opt:54
#, no-c-format
msgid "Run the link-time optimizer in local transformation (LTRANS) mode."
msgstr "Run die skakeltyd optimizer in plaaslike transformation (LTRANS) modus."

#: lto/lang.opt:58
#, no-c-format
msgid "Specify a file to which a list of files output by LTRANS is written."
msgstr "Spesifiseer a lêer na wat a lys van lêers afvoer deur LTRANS is written."

