msgstr "-mcpu=m32c\tKompileer kode vir M32C variants."

#: config/m32c/m32c.opt:43
#, no-c-format
msgid "-memregs=\tNumber of memreg bytes (default: 16, range: 0..16)."
msgstr "-memregs=\taantal memreg grepe (verstek: 16, bestek: 0..16)."

#: config/stormy16/stormy16.opt:24
#, no-c-format
msgid "Provide libraries for the simulator."
msgstr "Verskaf biblioteke vir die simulator."

#: config/rx/elf.opt:32
#, no-c-format
msgid "Generate assembler output that is compatible with the Renesas AS100 assembler.  This may restrict some of the compiler's capabilities.  The default is to generate GAS compatible syntax."
msgstr "Genereer samesteller afvoer wat is versoenbaar met die Renesas AS100 samesteller. Hierdie mag restrict some van die compiler's capabilities. Die verstek is na genereer GAS versoenbaar sintaksis."

#: config/rx/elf.opt:38 config/rx/rx.opt:99
#, no-c-format
msgid "Specifies the number of registers to reserve for interrupt handlers."
msgstr "Specifies die aantal registers na reserve vir interrupt handlers."

#: config/rx/elf.opt:44 config/rx/rx.opt:105
#, no-c-format
msgid "Specifies whether interrupt functions should save and restore the accumulator register."
msgstr "Specifies of interrupt funksies moet bewaar en restore die accumulator register."

#: config/rx/rx.opt:29
#, no-c-format
msgid "Store doubles in 64 bits."
msgstr "Stoor doubles in 64 bisse."

#: config/rx/rx.opt:33
#, no-c-format
msgid "Stores doubles in 32 bits.  This is the default."
msgstr "Stores doubles in 32 bisse. dit is die verstek."

#: config/rx/rx.opt:37
#, no-c-format
msgid "Disable the use of RX FPU instructions."
msgstr "Deaktiveer die gebruik van RX FPU instruksies."

#: config/rx/rx.opt:44
#, no-c-format
msgid "Enable the use of RX FPU instructions.  This is the default."
msgstr "Aktiveer die gebruik van RX FPU instruksies. dit is die verstek."

#: config/rx/rx.opt:50
#, no-c-format
msgid "Specify the target RX cpu type."
msgstr "Spesifiseer die teiken RX CPU tipe."

#: config/rx/rx.opt:71
#, no-c-format
msgid "Data is stored in big-endian format."
msgstr "Data is gestoor in groot-endian formaat."

#: config/rx/rx.opt:75
#, no-c-format
msgid "Data is stored in little-endian format.  (Default)."
msgstr "Data is gestoor in klein-endian formaat. (Verstek)."

#: config/rx/rx.opt:81
#, no-c-format
msgid "Maximum size of global and static variables which can be placed into the small data area."
msgstr "Maksimum grootte van globale en statiese veranderlikes wat kan wees placed in die klein data area."

#: config/rx/rx.opt:87
#, no-c-format
msgid "Enable linker relaxation."
msgstr "Aktiveer skakelaar relaxation."

#: config/rx/rx.opt:93
#, no-c-format
msgid "Maximum size in bytes of constant values allowed as operands."
msgstr "Maksimum grootte in grepe van konstant waardes toegelaat as operande."

#: config/rx/rx.opt:111
#, no-c-format
msgid "Enables Position-Independent-Data (PID) mode."
msgstr "Enables Position-Independent-Data (PID) modus."

#: config/rx/rx.opt:117
#, no-c-format
msgid "Warn when multiple, different, fast interrupt handlers are in the compilation unit."
msgstr "waarsku wanneer veelvuldige, verskillende, fast interrupt handlers is in die kompilering eenheid."

#: config/rx/rx.opt:123
#, no-c-format
msgid "Enable the use of the old, broken, ABI where all stacked function arguments are aligned to 32-bits."
msgstr "Aktiveer die gebruik van die ou, broken, ABI waar alle stacked funksie argumente is belyn na 32-bisse."

#: config/rx/rx.opt:127
#, no-c-format
msgid "Enable the use the standard RX ABI where all stacked function arguments are naturally aligned.  This is the default."
msgstr "Aktiveer die gebruik die standaard RX ABI waar alle stacked funksie argumente is naturally belyn. dit is die verstek."

#: config/rx/rx.opt:133
#, no-c-format
msgid "Enable the use of the LRA register allocator."
msgstr "Aktiveer die gebruik van die LRA register allocator."

#: config/rx/rx.opt:139
#, no-c-format
msgid "Enables or disables the use of the SMOVF, SMOVB, SMOVU, SUNTIL, SWHILE and RMPA instructions.  Enabled by default."
msgstr "Enables of disables die gebruik van die SMOVF, SMOVB, SMOVU, SUNTIL, SWHILE en RMPA instruksies. Geaktiveer deur verstek."

#: config/rx/rx.opt:145
#, no-c-format
msgid "Always use JSR, never BSR, for calls."
msgstr "Altyd gebruik JSR, nooit BSR, vir oproepe."

#: m2/lang.opt:35
#, no-c-format
msgid "Case statement label compile time checking when using an expression of an enum type."
msgstr "Geval stelling etiket kompileer tyd kontrolering wanneer gebruik 'n uitdrukking van 'n enum tipe."

#: m2/lang.opt:39
#, no-c-format
msgid "Check definition module procedure parameter names match their implementation module counterpart."
msgstr "Kontroleer definisie module prosedure parameter name pas hul implementering module counterpart."

#: m2/lang.opt:43
#, no-c-format
msgid "Warn if a cast is being used on types of differing sizes."
msgstr "waarsku as a set om is besig om te gebruik op tipes van differing sizes."

#: m2/lang.opt:47
#, no-c-format
msgid "Inform user which parameters will be passed by reference."
msgstr "Inform gebruiker wat parameters sal wees deurgegee deur verwysing."

#: m2/lang.opt:51
#, no-c-format
msgid "Semantic checking to catch poor programming style."
msgstr "Semantiese kontrolering na vang poor programming style."

#: m2/lang.opt:55
#, no-c-format
msgid "Compile time analysis in the first basic block of a procedure detecting access to uninitialized data."
msgstr "Kompileer tyd analysis in die eerste basic blok van a prosedure detecting toegang na ongeïnisialiseerde data."

#: m2/lang.opt:59
#, no-c-format
msgid "Compile time analysis to detect access to uninitialized variables, the checking can be specified by: known,cond,all."
msgstr "Kompileer tyd analysis na detect toegang na ongeïnisialiseerde veranderlikes, die kontrolering kan wees gespesifiseer deur: known,cond,alle."

#: m2/lang.opt:63
#, no-c-format
msgid "Automatically initializes all pointers to NIL."
msgstr "Outomaties initializes alle wysers na NIL."

#: m2/lang.opt:67
#, no-c-format
msgid "Runtime subrange, array index and indirection via NIL pointer checking."
msgstr "Looptyd subrange, skikking indeks en indirection via NIL wyser kontrolering."

#: m2/lang.opt:71
#, no-c-format
msgid "Runtime checking to check whether a CASE statement requires an ELSE clause when one was not specified."
msgstr "Looptyd kontrolering na kontroleer of a GEVAL stelling vereis 'n ANDERS klousule wanneer one was nie gespesifiseer nie."

#: m2/lang.opt:75
#, no-c-format
msgid "Preprocess the module using cpp."
msgstr "Voorverwerk die module gebruik cpp."

#: m2/lang.opt:79 m2/lang.opt:83
#, no-c-format
msgid "Passed to the preprocessor if -fcpp is used (internal switch)."
msgstr "Deurgegee na die voorverwerker as -fcpp is gebruik (interne skakelaar)."

#: m2/lang.opt:87
#, no-c-format
msgid "Call a real function, rather than the builtin equivalent."
msgstr "Oproep a reële funksie, eerder as die ingeboude equivalent."

#: m2/lang.opt:91
#, no-c-format
msgid "Internal debugging of the compiler (internal switch)."
msgstr "Interne ontfouting van die kompileerder (interne skakelaar)."

#: m2/lang.opt:95
#, no-c-format
msgid "Trace procedure line numbers (internal switch)."
msgstr "Trace prosedure reël numbers (interne skakelaar)."

#: m2/lang.opt:99
#, no-c-format
msgid "Recognize the specified suffix as a definition module filename."
msgstr "Recognize die gespesifiseer agtervoegsel as a definisie module filename."

#: m2/lang.opt:103
#, no-c-format
msgid "Display all inbuilt system items."
msgstr "Display alle inbuilt stelsel items."

#: m2/lang.opt:107
#, no-c-format
msgid "Allows opaque types to be implemented as any type (a GNU Modula-2 extension)."
msgstr "Allows opaque tipes na wees implemented as enige tipe (a GNU Modula-2 uitbreiding)."

#: m2/lang.opt:111
#, no-c-format
msgid "Runtime checking to check whether a floating point number will exceed range."
msgstr "Looptyd kontrolering na kontroleer of a dryfpunt getal sal exceed bestek."

#: m2/lang.opt:115
#, no-c-format
msgid "Create a topologically sorted module list from all dependent modules used in the application."
msgstr "Skep a topologically sorted module lys van alle afhanklike modules gebruik in die application."

#: m2/lang.opt:119
#, no-c-format
msgid "Range checking for numerical values."
msgstr "Bestek kontrolering vir numerical waardes."

#: m2/lang.opt:123
#, no-c-format
msgid "ISO dialect of Modula-2."
msgstr "ISO dialek van Modula-2."

#: m2/lang.opt:127
#, no-c-format
msgid "Specify the library order, the libraries may be specified by a comma separated abbreviation: log,min,pim,iso or by directory names: m2log,m2min,m2pim,m2iso."
msgstr "Spesifiseer die biblioteek volgorde, die biblioteke mag wees gespesifiseer deur a komma separated abbreviation: log,min,pim,ISO of deur gids name: m2log,m2min,m2pim,m2ISO."

#: m2/lang.opt:131
#, no-c-format
msgid "Set all location values to a specific value (internal switch)."
msgstr "Stel alle ligging waardes na a spesifieke waarde (interne skakelaar)."

#: m2/lang.opt:135
#, no-c-format
msgid "Internal debug tracing for quad,token,line,all (internal switch)."
msgstr "Interne ontfout tracing vir quad,token,reël,alle (interne skakelaar)."

#: m2/lang.opt:139
#, no-c-format
msgid "Dump Modula-2 internal intemediate representation specified by: all,quad,decl,gimple."
msgstr "Stort Modula-2 interne intemediate representation gespesifiseer deur: alle,quad,decl,gimple."

#: m2/lang.opt:143
#, no-c-format
msgid "Dump Modula-2 decls to the filename stem specified."
msgstr "Stort Modula-2 decls na die filename stem gespesifiseer."

#: m2/lang.opt:147
#, no-c-format
msgid "Dump Modula-2 gimple to the filename stem specified."
msgstr "Stort Modula-2 gimple na die filename stem gespesifiseer."

#: m2/lang.opt:151
#, no-c-format
msgid "Dump Modula-2 quads to the filename stem specified."
msgstr "Stort Modula-2 quads na die filename stem gespesifiseer."

#: m2/lang.opt:155
#, no-c-format
msgid "Filter the language dump using a comma separated list of procedures and modules."
msgstr "Filter die taal stort gebruik a komma separated lys van procedures en modules."

#: m2/lang.opt:159
#, no-c-format
msgid "Override the default 64 bit definition of SYSTEM.COFF_T with the argument specified."
msgstr "Oorheers die verstek 64 bis definisie van STELSEL.COFF_T met die argument gespesifiseer."

#: m2/lang.opt:163
#, no-c-format
msgid "Generate extra nops to improve debugging, producing an instruction for every code related keyword."
msgstr "Genereer ekstra nops na improve ontfouting, producing 'n instruksie vir elke kode related sleutelwoord."

#: m2/lang.opt:167
#, no-c-format
msgid "Generate error messages which render keywords in lower case."
msgstr "Genereer fout boodskappe wat render keywords in onderste geval."

#: m2/lang.opt:171
#, no-c-format
msgid "Specify the module mangled prefix name for all modules in the following include paths."
msgstr "Spesifiseer die module mangled voorvoegsel naam vir alle modules in die volgende sluit in paaie."

#: m2/lang.opt:179
#, no-c-format
msgid "Add include paths for all the library names in -flibs= to this directory root."
msgstr "Voeg by sluit in paaie vir alle die biblioteek name in -flibs= na hierdie gids root."

#: m2/lang.opt:187
#, no-c-format
msgid "Insert plugin to identify runtime errors at compiletime."
msgstr "Voeg in inprop na identify looptyd foute by compiletime."

#: m2/lang.opt:191
#, no-c-format
msgid "Specify the module mangled prefix name."
msgstr "Spesifiseer die module mangled voorvoegsel naam."

#: m2/lang.opt:195
#, no-c-format
msgid "Display statistics about the amount of source lines compiled and symbols used."
msgstr "Display statistics oor die hoeveelheid van bron lines gekombineer en simbole gebruik."

#: m2/lang.opt:199
#, no-c-format
msgid "Experimental flag to turn on the new strict type checker."
msgstr "Experimental vlag na turn op die nuwe streng tipe checker."

#: m2/lang.opt:203
#, no-c-format
msgid "Provides more detail why the types are incompatible."
msgstr "Provides more detail why die tipes is onversoenbaar."

#: m2/lang.opt:207
#, no-c-format
msgid "Compile all implementation modules and program module at once."
msgstr "Kompileer alle implementering modules en program module by een keer."

#: m2/lang.opt:215
#, no-c-format
msgid "Recognize the specified suffix as implementation and module filenames."
msgstr "Recognize die gespesifiseer agtervoegsel as implementering en module filenames."

#: m2/lang.opt:219
#, no-c-format
msgid "Runtime checking to detect accessing data through a NIL value pointer."
msgstr "Looptyd kontrolering na detect toegang tot data deur a NIL waarde wyser."

#: m2/lang.opt:223
#, no-c-format
msgid "PIM [234] dialect of Modula-2."
msgstr "PIM [234] dialek van Modula-2."

#: m2/lang.opt:227
#, no-c-format
msgid "PIM 2 dialect of Modula-2."
msgstr "PIM 2 dialek van Modula-2."

#: m2/lang.opt:231
#, no-c-format
msgid "PIM 3 dialect of Modula-2."
msgstr "PIM 3 dialek van Modula-2."

#: m2/lang.opt:235
#, no-c-format
msgid "PIM 4 dialect of Modula-2."
msgstr "PIM 4 dialek van Modula-2."

#: m2/lang.opt:239
#, no-c-format
msgid "Force positive result from MOD and DIV result floor."
msgstr "Force positiewe resultaat van MOD en DIV resultaat floor."

#: m2/lang.opt:243
#, no-c-format
msgid "Link against the pthread library (default on)."
msgstr "Skakel teen die pthread biblioteek (verstek op)."

#: m2/lang.opt:247
#, no-c-format
msgid "Internal compiler debugging information, dump the list of quadruples."
msgstr "Interne kompileerder ontfouting inligting, stort die lys van quadruples."

#: m2/lang.opt:251
#, no-c-format
msgid "Runtime range checking for numerical values."
msgstr "Looptyd bestek kontrolering vir numerical waardes."

#: m2/lang.opt:255
#, no-c-format
msgid "Runtime checking for functions which finish without executing a RETURN statement."
msgstr "Looptyd kontrolering vir funksies wat finish sonder executing a TERUGKEER stelling."

#: m2/lang.opt:259
#, no-c-format
msgid "Specify the list of runtime modules and their initialization order."
msgstr "Spesifiseer die lys van looptyd modules en hul inisialisering volgorde."

#: m2/lang.opt:263
#, no-c-format
msgid "Modules are initialized dynamically, determined by M2RTS and application dependencies."
msgstr "Modules is geïnisialiseer dynamically, determined deur M2RTS en application dependencies."

#: m2/lang.opt:267
#, no-c-format
msgid "Generate a C source scaffold for the current module being compiled."
msgstr "Genereer a C bron scaffold vir die huidige module besig om te gekombineer."

#: m2/lang.opt:271
#, no-c-format
msgid "Generate a C++ source scaffold for the current module being compiled."
msgstr "Genereer a C++ bron scaffold vir die huidige module besig om te gekombineer."

#: m2/lang.opt:275
#, no-c-format
msgid "Generate the main function."
msgstr "Genereer die main funksie."

#: m2/lang.opt:279
#, no-c-format
msgid "Generate static scaffold initialization and finalization for every module inside main."
msgstr "Genereer statiese scaffold inisialisering en finalization vir elke module binne main."

#: m2/lang.opt:283
#, no-c-format
msgid "Generate a shared library from the module."
msgstr "Genereer a gedeelde biblioteek van die module."

#: m2/lang.opt:287
#, no-c-format
msgid "All software runtime checking (an abbreviation for -fnil -frange -findex -fwholediv -fcase -freturn -fwholevalue -ffloatvalue)."
msgstr "Alle software looptyd kontrolering ('n abbreviation vir -fnil -frange -findex -fwholediv -fcase -freturn -fwholevalue -ffloatvalue)."

#: m2/lang.opt:291
#, no-c-format
msgid "Display the location of module source files as they are compiled."
msgstr "Display die ligging van module bron lêers as hulle is gekombineer."

#: m2/lang.opt:295
#, no-c-format
msgid "Create a swig interface file for the module."
msgstr "Skep a swig koppelvlak lêer vir die module."

#: m2/lang.opt:303
#, no-c-format
msgid "Optimize non var unbounded parameters by passing it by reference, providing it is not written to within the callee procedure."
msgstr "Optimeer non var unbounded parameters deur deurgee dit deur verwysing, verskaffing van dit is nie written na binne die callee prosedure nie."

#: m2/lang.opt:307
#, no-c-format
msgid "Order the initialization/finalizations for scaffold-static or force linking of modules if scaffold-dynamic."
msgstr "Volgorde die inisialisering/finalizations vir scaffold-static of force skakeling van modules as scaffold-dynamic."

#: m2/lang.opt:315
#, no-c-format
msgid "Link against the module M2WIDESET to perform the wideset operator, the negative version of this option will generate a warning if this module is required."
msgstr "Skakel teen die module M2WIDESET na voer uit die wideset operator, die negatiewe weergawe van hierdie opsie sal genereer a waarskuwing as hierdie module is vereis."

#: m2/lang.opt:319
#, no-c-format
msgid "Runtime checking of all division and modulus by zero checking for ordinal values."
msgstr "Looptyd kontrolering van alle deling en modulus deur nul kontrolering vir ordinal waardes."

#: m2/lang.opt:323
#, no-c-format
msgid "Runtime checking for whole numbers."
msgstr "Looptyd kontrolering vir whole numbers."

#: m2/lang.opt:327
#, no-c-format
msgid "Link the standard Modula-2 libraries statically in the compilation."
msgstr "Skakel die standaard Modula-2 biblioteke statically in die kompilering."

#: m2/lang.opt:472 m2/lang.opt:476
#, no-c-format
msgid "save temporary preprocessed files."
msgstr "bewaar tydelike voorverwerkte lêers."

#: fortran/lang.opt:146
#, no-c-format
msgid "-J<directory>\tPut MODULE files in 'directory'."
msgstr "-J<gids>\tPut MODULE lêers in 'directory'."

#: fortran/lang.opt:198
#, no-c-format
msgid "Warn about possible aliasing of dummy arguments."
msgstr "waarsku oor moontlike aliasing van skyn argumente."

#: fortran/lang.opt:202
#, no-c-format
msgid "Warn about alignment of COMMON blocks."
msgstr "waarsku oor belyning van GEMEENSKAPLIKE blokke."

#: fortran/lang.opt:206
#, no-c-format
msgid "Warn about missing ampersand in continued character constants."
msgstr "waarsku oor ontbreek ampersand in voortgesit karakter konstantes."

#: fortran/lang.opt:210
#, no-c-format
msgid "Warn about creation of array temporaries."
msgstr "waarsku oor creation van skikking temporaries."

#: fortran/lang.opt:218
#, no-c-format
msgid "Warn if the type of a variable might be not interoperable with C."
msgstr "waarsku as die tipe van a veranderlike mag wees nie interoperable met C nie."

#: fortran/lang.opt:226
#, no-c-format
msgid "Warn about truncated character expressions."
msgstr "waarsku oor afgekap karakter expressions."

#: fortran/lang.opt:230
#, no-c-format
msgid "Warn about equality comparisons involving REAL or COMPLEX expressions."
msgstr "waarsku oor equality comparisons involving REËLE of KOMPLEKSE expressions."

#: fortran/lang.opt:238
#, no-c-format
msgid "Warn about most implicit conversions."
msgstr "waarsku oor most implisiete conversions."

#: fortran/lang.opt:246
#, no-c-format
msgid "Warn about possibly incorrect subscripts in do loops."
msgstr "waarsku oor moontlik incorrect subscripts in doen lusse."

#: fortran/lang.opt:250
#, no-c-format
msgid "Warn when arguments of external procedures do not match."
msgstr "waarsku wanneer argumente van eksterne procedures moenie pas."

#: fortran/lang.opt:258
#, no-c-format
msgid "Warn if loops have been interchanged."
msgstr "waarsku as lusse het gewees interchanged."

#: fortran/lang.opt:262
#, no-c-format
msgid "Warn about function call elimination."
msgstr "waarsku oor funksie-oproep elimination."

#: fortran/lang.opt:266
#, no-c-format
msgid "Warn about calls with implicit interface."
msgstr "waarsku oor oproepe met implisiete koppelvlak."

#: fortran/lang.opt:270
#, no-c-format
msgid "Warn about called procedures not explicitly declared."
msgstr "waarsku oor opgeroep procedures nie eksplisiet verklaar nie."

#: fortran/lang.opt:274
#, no-c-format
msgid "Warn about constant integer divisions with truncated results."
msgstr "waarsku oor konstant heelgetal divisions met afgekap resultate."

#: fortran/lang.opt:278
#, no-c-format
msgid "Warn about truncated source lines."
msgstr "waarsku oor afgekap bron lines."

#: fortran/lang.opt:282
#, no-c-format
msgid "Warn on intrinsics not part of the selected standard."
msgstr "Waarsku op intrinsics nie deel van die selected standaard nie."

#: fortran/lang.opt:294
#, no-c-format
msgid "Warn about USE statements that have no ONLY qualifier."
msgstr "waarsku oor GEBRUIK stellings wat het geen SLEGS kwalifiseerder."

#: fortran/lang.opt:310
#, no-c-format
msgid "Warn that -fno-automatic may break recursion."
msgstr "Waarsku wat -fno-automatic mag break rekursie."

#: fortran/lang.opt:318
#, no-c-format
msgid "Warn about real-literal-constants with 'q' exponent-letter."
msgstr "waarsku oor real-literal-constants met 'q' exponent-letter."

#: fortran/lang.opt:322
#, no-c-format
msgid "Warn when a left-hand-side array variable is reallocated."
msgstr "waarsku wanneer a left-hand-side skikking veranderlike is reallocated."

#: fortran/lang.opt:326
#, no-c-format
msgid "Warn when a left-hand-side variable is reallocated."
msgstr "waarsku wanneer a left-hand-side veranderlike is reallocated."

#: fortran/lang.opt:330
#, no-c-format
msgid "Warn if the pointer in a pointer assignment might outlive its target."
msgstr "waarsku as die wyser in a wyser toekenning mag outlive sy teiken."

#: fortran/lang.opt:338
#, no-c-format
msgid "Warn about \"suspicious\" constructs."
msgstr "waarsku oor \"suspicious\" constructs."

#: fortran/lang.opt:342
#, no-c-format
msgid "Permit nonconforming uses of the tab character."
msgstr "Permit nonconforming gebruik van die tab karakter."

#: fortran/lang.opt:346
#, no-c-format
msgid "Warn about an invalid DO loop."
msgstr "waarsku oor 'n ongeldige DOEN lus."

#: fortran/lang.opt:350
#, no-c-format
msgid "Warn about underflow of numerical constant expressions."
msgstr "waarsku oor onderloop van numerical konstant expressions."

#: fortran/lang.opt:358
#, no-c-format
msgid "Warn if a user-procedure has the same name as an intrinsic."
msgstr "waarsku as a user-procedure het die dieselfde naam as 'n intrinsieke."

#: fortran/lang.opt:366
#, no-c-format
msgid "Warn about unused dummy arguments."
msgstr "waarsku oor ongebruikte skyn argumente."

#: fortran/lang.opt:370
#, no-c-format
msgid "Warn about zero-trip DO loops."
msgstr "waarsku oor zero-trip DOEN lusse."

#: fortran/lang.opt:374
#, no-c-format
msgid "Enable preprocessing."
msgstr "Aktiveer voorverwerking."

#: fortran/lang.opt:382
#, no-c-format
msgid "Disable preprocessing."
msgstr "Deaktiveer voorverwerking."

#: fortran/lang.opt:390
#, no-c-format
msgid "Accept argument mismatches in procedure calls."
msgstr "Aanvaar argument mismatches in prosedure oproepe."

#: fortran/lang.opt:394
#, no-c-format
msgid "Eliminate multiple function invocations also for impure functions."
msgstr "Elimineer veelvuldige funksie invocations ook vir impure funksies."

#: fortran/lang.opt:398
#, no-c-format
msgid "Enable alignment of COMMON blocks."
msgstr "Aktiveer belyning van GEMEENSKAPLIKE blokke."

#: fortran/lang.opt:402
#, no-c-format
msgid "All intrinsics procedures are available regardless of selected standard."
msgstr "Alle intrinsics procedures is beskikbaar regardless van selected standaard."

#: fortran/lang.opt:406
#, no-c-format
msgid "Allow a BOZ literal constant to appear in an invalid context and with X instead of Z."
msgstr "Laat toe a BOZ letterlik konstant na appear in 'n ongeldige konteks en met X in plaas van Z."

#: fortran/lang.opt:414
#, no-c-format
msgid "Do not treat local variables and COMMON blocks as if they were named in SAVE statements."
msgstr "moenie treat plaaslike veranderlikes en GEMEENSKAPLIKE blokke as as hulle was benoemde in BEWAAR stellings."

#: fortran/lang.opt:418
#, no-c-format
msgid "Specify that backslash in string introduces an escape character."
msgstr "Spesifiseer wat backslash in string introduces 'n escape karakter."

#: fortran/lang.opt:422
#, no-c-format
msgid "Produce a backtrace when a runtime error is encountered."
msgstr "Produce a backtrace wanneer a looptyd fout is encountered."

#: fortran/lang.opt:426
#, no-c-format
msgid "-fblas-matmul-limit=<n>\tSize of the smallest matrix for which matmul will use BLAS."
msgstr "-fblas-matmul-limit=<n>\tGrootte van die smallest matrix vir wat matmul sal gebruik BLAS."

#: fortran/lang.opt:437
#, no-c-format
msgid "Produce a warning at runtime if a array temporary has been created for a procedure argument."
msgstr "Produce a waarskuwing by looptyd as a skikking tydelike het gewees geskep vir a prosedure argument."

#: fortran/lang.opt:441
#, no-c-format
msgid "-fconvert=<big-endian|little-endian|native|swap|r16_ieee|r16_ibm>\tThe endianness used for unformatted files."
msgstr "-fconvert=<groot-endian|klein-endian|inheems|swap|r16_ieee|r16_ibm>\tDie endianheid gebruik vir ongeformateerde lêers."

#: fortran/lang.opt:466
#, no-c-format
msgid "Use the Cray Pointer extension."
msgstr "Gebruik die Cray Wyser uitbreiding."

#: fortran/lang.opt:470
#, no-c-format
msgid "Generate C prototypes from BIND(C) declarations."
msgstr "Genereer C prototypes van BIND(C) declarations."

#: fortran/lang.opt:474
#, no-c-format
msgid "Generate C prototypes from non-BIND(C) external procedure definitions."
msgstr "Genereer C prototypes van non-BIND(C) eksterne prosedure definitions."

#: fortran/lang.opt:478
#, no-c-format
msgid "Ignore 'D' in column one in fixed form."
msgstr "Ignoreer 'D' in kolom one in fixed vorm."

#: fortran/lang.opt:482
#, no-c-format
msgid "Treat lines with 'D' in column one as comments."
msgstr "Treat lines met 'D' in kolom one as comments."

#: fortran/lang.opt:486
#, no-c-format
msgid "Issue debug information for compiler-generated auxiliary variables."
msgstr "Issue ontfout inligting vir compiler-generated auxiliary veranderlikes."

#: fortran/lang.opt:490
#, no-c-format
msgid "Enable all DEC language extensions."
msgstr "Aktiveer alle DEC taal uitbreidings."

#: fortran/lang.opt:494
#, no-c-format
msgid "Enable the use of blank format items in format strings."
msgstr "Aktiveer die gebruik van blanko formaat items in formaat strings."

#: fortran/lang.opt:498
#, no-c-format
msgid "Enable the use of character literals in assignments and data statements for non-character variables."
msgstr "Aktiveer die gebruik van karakter literals in assignments en data stellings vir non-character veranderlikes."

#: fortran/lang.opt:503
#, no-c-format
msgid "Enable legacy parsing of INCLUDE as statement."
msgstr "Aktiveer legacy ontleding van SLUIT IN as stelling."

#: fortran/lang.opt:507
#, no-c-format
msgid "Enable default widths for i, f and g format specifiers."
msgstr "Aktiveer verstek widths vir i, f en g formaat specifiers."

#: fortran/lang.opt:511
#, no-c-format
msgid "Enable kind-specific variants of integer intrinsic functions."
msgstr "Aktiveer kind-specific variants van heelgetal intrinsieke funksies."

#: fortran/lang.opt:515
#, no-c-format
msgid "Enable legacy math intrinsics for compatibility."
msgstr "Aktiveer legacy math intrinsics vir compatibility."

#: fortran/lang.opt:519
#, no-c-format
msgid "Enable support for DEC STRUCTURE/RECORD."
msgstr "Aktiveer ondersteun vir DEC STRUCTURE/REKORD."

#: fortran/lang.opt:523
#, no-c-format
msgid "Enable DEC-style STATIC and AUTOMATIC attributes."
msgstr "Aktiveer DEC-style STATIESE en OUTOMATIESE kenmerke."

#: fortran/lang.opt:527
#, no-c-format
msgid "Set the default double precision kind to an 8 byte wide type."
msgstr "Stel die verstek double presisie soort na 'n 8 greep wyd tipe."

#: fortran/lang.opt:531
#, no-c-format
msgid "Set the default integer kind to an 8 byte wide type."
msgstr "Stel die verstek heelgetal soort na 'n 8 greep wyd tipe."

#: fortran/lang.opt:535
#, no-c-format
msgid "Set the default real kind to an 8 byte wide type."
msgstr "Stel die verstek reële soort na 'n 8 greep wyd tipe."

#: fortran/lang.opt:539
#, no-c-format
msgid "Set the default real kind to an 10 byte wide type."
msgstr "Stel die verstek reële soort na 'n 10 greep wyd tipe."

#: fortran/lang.opt:543
#, no-c-format
msgid "Set the default real kind to an 16 byte wide type."
msgstr "Stel die verstek reële soort na 'n 16 greep wyd tipe."

#: fortran/lang.opt:547
#, no-c-format
msgid "Allow dollar signs in entity names."
msgstr "Laat toe dollar signs in entity name."

#: fortran/lang.opt:555
#, no-c-format
msgid "Display the code tree after parsing."
msgstr "Display die kode tree ná ontleding."

#: fortran/lang.opt:559
#, no-c-format
msgid "Display the code tree after front end optimization."
msgstr "Display die kode tree ná front einde optimering."

#: fortran/lang.opt:563
#, no-c-format
msgid "Display the global symbol table after parsing."
msgstr "Display die globale simbool tabel ná ontleding."

#: fortran/lang.opt:567
#, no-c-format
msgid "Display the code tree after parsing; deprecated option."
msgstr "Display die kode tree ná ontleding; verouderde opsie."

#: fortran/lang.opt:571
#, no-c-format
msgid "Specify that an external BLAS library should be used for matmul calls on large-size arrays."
msgstr "Spesifiseer wat 'n eksterne BLAS biblioteek moet wees gebruik vir matmul oproepe op large-size skikkings."

#: fortran/lang.opt:575
#, no-c-format
msgid "Use an external BLAS library with 64-bit indexing for matmul on large-size arrays."
msgstr "Gebruik 'n eksterne BLAS biblioteek met 64-bis indexing vir matmul op large-size skikkings."

#: fortran/lang.opt:579
#, no-c-format
msgid "Use f2c calling convention."
msgstr "Gebruik f2c oproep konvensie."

#: fortran/lang.opt:583 cobol/lang.opt:352
#, no-c-format
msgid "Assume that the source file is fixed form."
msgstr "Neem aan wat die bron lêer is fixed vorm."

#: fortran/lang.opt:587
#, no-c-format
msgid "Force creation of temporary to test infrequently-executed forall code."
msgstr "Force creation van tydelike na test infrequently-executed forall kode."

#: fortran/lang.opt:591
#, no-c-format
msgid "Interpret any INTEGER(4) as an INTEGER(8)."
msgstr "Interpret enige HEELGETAL(4) as 'n HEELGETAL(8)."

#: fortran/lang.opt:595 fortran/lang.opt:599
#, no-c-format
msgid "Specify where to find the compiled intrinsic modules."
msgstr "Spesifiseer waar na vind die gekombineer intrinsieke modules."

#: fortran/lang.opt:603
#, no-c-format
msgid "Allow arbitrary character line width in fixed mode."
msgstr "Laat toe arbitrary karakter reël breedte in fixed modus."

#: fortran/lang.opt:607
#, no-c-format
msgid "-ffixed-line-length-<n>\tUse n as character line width in fixed mode."
msgstr "-ffixed-line-length-<n>\tGebruik n as karakter reël breedte in fixed modus."

#: fortran/lang.opt:611
#, no-c-format
msgid "Pad shorter fixed form lines to line width with spaces."
msgstr "Opvul shorter fixed vorm lines na reël breedte met spaces."

#: fortran/lang.opt:615
#, no-c-format
msgid "-ffpe-trap=[...]\tStop on following floating point exceptions."
msgstr "-ffpe-trap=[...]\tStop op volgende dryfpunt uitsonderings."

#: fortran/lang.opt:619
#, no-c-format
msgid "-ffpe-summary=[...]\tPrint summary of floating point exceptions."
msgstr "-ffpe-summary=[...]\tDruk summary van dryfpunt uitsonderings."

#: fortran/lang.opt:623 cobol/lang.opt:356
#, no-c-format
msgid "Assume that the source file is free form."
msgstr "Neem aan wat die bron lêer is stel vry vorm."

#: fortran/lang.opt:627
#, no-c-format
msgid "Allow arbitrary character line width in free mode."
msgstr "Laat toe arbitrary karakter reël breedte in stel vry modus."

#: fortran/lang.opt:631
#, no-c-format
msgid "-ffree-line-length-<n>\tUse n as character line width in free mode."
msgstr "-ffree-line-length-<n>\tGebruik n as karakter reël breedte in stel vry modus."

#: fortran/lang.opt:635
#, no-c-format
msgid "Try to interchange loops if profitable."
msgstr "Probeer na interchange lusse as profitable."

#: fortran/lang.opt:639
#, no-c-format
msgid "Enable front end optimization."
msgstr "Aktiveer front einde optimering."

#: fortran/lang.opt:643
#, no-c-format
msgid "Specify that no implicit typing is allowed, unless overridden by explicit IMPLICIT statements."
msgstr "Spesifiseer wat geen implisiete typing is toegelaat, tensy overridden deur eksplisiete IMPLISIETE stellings."

#: fortran/lang.opt:647
#, no-c-format
msgid "-finit-character=<n>\tInitialize local character variables to ASCII value n."
msgstr "-finit-character=<n>\tInisialiseer plaaslike karakter veranderlikes na ASCII waarde n."

#: fortran/lang.opt:651
#, no-c-format
msgid "Initialize components of derived type variables according to other init flags."
msgstr "Inisialiseer components van afgeleide tipe veranderlikes according na ander init vlae."

#: fortran/lang.opt:655
#, no-c-format
msgid "-finit-integer=<n>\tInitialize local integer variables to n."
msgstr "-finit-integer=<n>\tInisialiseer plaaslike heelgetal veranderlikes na n."

#: fortran/lang.opt:659
#, no-c-format
msgid "Initialize local variables to zero (from g77)."
msgstr "Inisialiseer plaaslike veranderlikes na nul (van g77)."

#: fortran/lang.opt:663
#, no-c-format
msgid "-finit-logical=<true|false>\tInitialize local logical variables."
msgstr "-finit-logical=<waar|onwaar>\tInisialiseer plaaslike logiese veranderlikes."

#: fortran/lang.opt:667
#, no-c-format
msgid "-finit-real=<zero|snan|nan|inf|-inf>\tInitialize local real variables."
msgstr "-finit-real=<nul|snan|NaN|inf|-inf>\tInisialiseer plaaslike reële veranderlikes."

#: fortran/lang.opt:689
#, no-c-format
msgid "-finline-arg-packing\tPerform argument packing inline."
msgstr "-finline-arg-packing\tVoer uit argument packing inline."

#: fortran/lang.opt:699
#, no-c-format
msgid "Enable generation of inline code instead of calls to functions from the library to implement intrinsics."
msgstr "Aktiveer generation van inline kode in plaas van oproepe na funksies van die biblioteek na implement intrinsics."

#: fortran/lang.opt:720
#, no-c-format
msgid "-finline-matmul-limit=<n>\tSpecify the size of the largest matrix for which matmul will be inlined."
msgstr "-finline-matmul-limit=<n>\tSpesifiseer die grootte van die largest matrix vir wat matmul sal wees geïnline."

#: fortran/lang.opt:724
#, no-c-format
msgid "-fmax-array-constructor=<n>\tMaximum number of objects in an array constructor."
msgstr "-fmax-array-constructor=<n>\tMaksimum aantal objekte in 'n skikking konstruktor."

#: fortran/lang.opt:728
#, no-c-format
msgid "-fmax-identifier-length=<n>\tMaximum identifier length."
msgstr "-fmax-identifier-length=<n>\tMaksimum identifiseerder lengte."

#: fortran/lang.opt:732
#, no-c-format
msgid "-fmax-subrecord-length=<n>\tMaximum length for subrecords."
msgstr "-fmax-subrecord-length=<n>\tMaksimum lengte vir subrecords."

#: fortran/lang.opt:736
#, no-c-format
msgid "-fmax-stack-var-size=<n>\tSize in bytes of the largest array that will be put on the stack."
msgstr "-fmax-stack-var-size=<n>\tGrootte in grepe van die largest skikking wat sal wees put op die stapel."

#: fortran/lang.opt:740
#, no-c-format
msgid "Put all local arrays on stack."
msgstr "Put alle plaaslike skikkings op stapel."

#: fortran/lang.opt:744
#, no-c-format
msgid "Set default accessibility of module entities to PRIVATE."
msgstr "Stel verstek accessibility van module entities na PRIVATE."

#: fortran/lang.opt:764
#, no-c-format
msgid "Handle OpenMP allocators for allocatables and pointers."
msgstr "Handle OpenMP allocators vir allocatables en wysers."

#: fortran/lang.opt:768
#, no-c-format
msgid "Try to lay out derived types as compactly as possible."
msgstr "Probeer na lay buite afgeleide tipes as compactly as moontlike."

#: fortran/lang.opt:776
#, no-c-format
msgid "Protect parentheses in expressions."
msgstr "Protect hakies in expressions."

#: fortran/lang.opt:780
#, no-c-format
msgid "Path to header file that should be pre-included before each compilation unit."
msgstr "Pad na koplêer lêer wat moet wees pre-included voor elke kompilering eenheid."

#: fortran/lang.opt:784
#, no-c-format
msgid "Enable range checking during compilation."
msgstr "Aktiveer bestek kontrolering tydens kompilering."

#: fortran/lang.opt:788
#, no-c-format
msgid "Interpret any REAL(4) as a REAL(8)."
msgstr "Interpret enige REËLE(4) as a REËLE(8)."

#: fortran/lang.opt:792
#, no-c-format
msgid "Interpret any REAL(4) as a REAL(10)."
msgstr "Interpret enige REËLE(4) as a REËLE(10)."

#: fortran/lang.opt:796
#, no-c-format
msgid "Interpret any REAL(4) as a REAL(16)."
msgstr "Interpret enige REËLE(4) as a REËLE(16)."

#: fortran/lang.opt:800
#, no-c-format
msgid "Interpret any REAL(8) as a REAL(4)."
msgstr "Interpret enige REËLE(8) as a REËLE(4)."

#: fortran/lang.opt:804
#, no-c-format
msgid "Interpret any REAL(8) as a REAL(10)."
msgstr "Interpret enige REËLE(8) as a REËLE(10)."

#: fortran/lang.opt:808
#, no-c-format
msgid "Interpret any REAL(8) as a REAL(16)."
msgstr "Interpret enige REËLE(8) as a REËLE(16)."

#: fortran/lang.opt:812
#, no-c-format
msgid "Reallocate the LHS in assignments."
msgstr "Reallocate die LHS in assignments."

#: fortran/lang.opt:816
#, no-c-format
msgid "Use a 4-byte record marker for unformatted files."
msgstr "Gebruik a 4-greep rekord marker vir ongeformateerde lêers."

#: fortran/lang.opt:820
#, no-c-format
msgid "Use an 8-byte record marker for unformatted files."
msgstr "Gebruik 'n 8-greep rekord marker vir ongeformateerde lêers."

#: fortran/lang.opt:824
#, no-c-format
msgid "Allocate local variables on the stack to allow indirect recursion."
msgstr "Wys toe plaaslike veranderlikes op die stapel na laat toe indirekte rekursie."

#: fortran/lang.opt:828
#, no-c-format
msgid "Copy array sections into a contiguous block on procedure entry."
msgstr "Kopie skikking sections in a aaneenlopende blok op prosedure inskrywing."

#: fortran/lang.opt:832
#, no-c-format
msgid "Experimental unsigned numbers."
msgstr "Experimental ongetekende numbers."

#: fortran/lang.opt:836
#, no-c-format
msgid "-fcoarray=<none|single|lib>\tSpecify which coarray parallelization should be used."
msgstr "-fcoarray=<geen|enkele|lib>\tSpesifiseer wat ko-skikking parallelization moet wees gebruik."

#: fortran/lang.opt:852 algol68/lang.opt:81
#, no-c-format
msgid "-fcheck=[...]\tSpecify which runtime checks are to be performed."
msgstr "-fcheck=[...]\tSpesifiseer wat looptyd checks is na wees uitgevoer."

#: fortran/lang.opt:856
#, no-c-format
msgid "Append a second underscore if the name already contains an underscore."
msgstr "Append a tweede underscore as die naam reeds bevat 'n underscore."

#: fortran/lang.opt:864
#, no-c-format
msgid "Apply negative sign to zero values."
msgstr "Pas toe negatiewe teken na nul waardes."

#: fortran/lang.opt:871
#, no-c-format
msgid "Disallow tail call optimization when a calling routine may have omitted character lengths."
msgstr "Disallow stert oproep optimering wanneer a oproep roetine mag het weggelaat karakter lengths."

#: fortran/lang.opt:875
#, no-c-format
msgid "Append underscores to externally visible names."
msgstr "Append underscores na externally visible name."

#: fortran/lang.opt:919
#, no-c-format
msgid "Statically link the GNU Fortran helper library (libgfortran)."
msgstr "Statically skakel die GNU Fortran helper biblioteek (libgfortran)."

#: fortran/lang.opt:923
#, no-c-format
msgid "Statically link the GCC Quad-Precision Math Library (libquadmath)."
msgstr "Statically skakel die GCC Quad-Precision Math Biblioteek (libquadmath)."

#: fortran/lang.opt:927
#, no-c-format
msgid "Conform to the ISO Fortran 2003 standard."
msgstr "Conform na die ISO Fortran 2003 standaard."

#: fortran/lang.opt:931
#, no-c-format
msgid "Conform to the ISO Fortran 2008 standard."
msgstr "Conform na die ISO Fortran 2008 standaard."

#: fortran/lang.opt:935
#, no-c-format
msgid "Conform to the ISO Fortran 2008 standard including TS 29113."
msgstr "Conform na die ISO Fortran 2008 standaard insluitend TS 29113."

#: fortran/lang.opt:939
#, no-c-format
msgid "Conform to the ISO Fortran 2018 standard."
msgstr "Conform na die ISO Fortran 2018 standaard."

#: fortran/lang.opt:943
#, no-c-format
msgid "Conform to the ISO Fortran 2023 standard."
msgstr "Conform na die ISO Fortran 2023 standaard."

#: fortran/lang.opt:947
#, no-c-format
msgid "Enable experimental Fortran 202y features."
msgstr "Aktiveer experimental Fortran 202y kenmerke."

#: fortran/lang.opt:951
#, no-c-format
msgid "Conform to the ISO Fortran 95 standard."
msgstr "Conform na die ISO Fortran 95 standaard."

#: fortran/lang.opt:955
#, no-c-format
msgid "Conform to nothing in particular."
msgstr "Conform na nothing in particular."

#: fortran/lang.opt:959
#, no-c-format
msgid "Accept extensions to support legacy code."
msgstr "Aanvaar uitbreidings na ondersteun legacy kode."

#: go/lang.opt:42
#, no-c-format
msgid "-fgo-c-header=<file>\tWrite Go struct definitions to file as C code."
msgstr "-fgo-c-header=<lêer>\tSkryf Go struktuur definitions na lêer as C kode."

#: go/lang.opt:46
#, no-c-format
msgid "Add explicit checks for division by zero."
msgstr "Voeg by eksplisiete checks vir deling deur nul."

#: go/lang.opt:50
#, no-c-format
msgid "Add explicit checks for division overflow in INT_MIN / -1."
msgstr "Voeg by eksplisiete checks vir deling oorloop in INT_MIN / -1."

#: go/lang.opt:54
#, no-c-format
msgid "Apply special rules for compiling runtime package."
msgstr "Pas toe special reëls vir compiling looptyd package."

#: go/lang.opt:58
#, no-c-format
msgid "-fgo-dump-<type>\tDump Go frontend internal information."
msgstr "-fgo-dump-<tipe>\tStort Go frontend interne inligting."

#: go/lang.opt:62
#, no-c-format
msgid "-fgo-embedcfg=<file>\tList embedded files via go:embed."
msgstr "-fgo-embedcfg=<lêer>\tLys embedded lêers via Go:embed."

#: go/lang.opt:66
#, no-c-format
msgid "-fgo-importcfg=<file>\tProvide file that tells where to find imports."
msgstr "-fgo-importcfg=<lêer>\tVerskaf lêer wat tells waar na vind imports."

#: go/lang.opt:70
#, no-c-format
msgid "-fgo-optimize-<type>\tTurn on optimization passes in the frontend."
msgstr "-fgo-optimize-<tipe>\tTurn op optimering passes in die frontend."

#: go/lang.opt:74
#, no-c-format
msgid "-fgo-pkgpath=<string>\tSet Go package path."
msgstr "-fgo-pkgpath=<string>\tStel Go package pad."

#: go/lang.opt:78
#, no-c-format
msgid "-fgo-prefix=<string>\tSet package-specific prefix for exported Go names."
msgstr "-fgo-prefix=<string>\tStel package-specific voorvoegsel vir exported Go name."

#: go/lang.opt:82
#, no-c-format
msgid "-fgo-relative-import-path=<path>\tTreat a relative import as relative to path."
msgstr "-fgo-relative-import-path=<pad>\tTreat a relatiewe import as relatiewe na pad."

#: go/lang.opt:86
#, no-c-format
msgid "Functions which return values must end with return statements."
msgstr "Funksies wat terugkeer waardes moet einde met terugkeer stellings."

#: go/lang.opt:90
#, no-c-format
msgid "Emit debugging information related to the escape analysis pass when run with -fgo-optimize-allocs."
msgstr "Genereer ontfouting inligting related na die escape analysis gee deur wanneer run met -fgo-optimize-allocs."

#: go/lang.opt:94
#, no-c-format
msgid "-fgo-debug-escape-hash=<string>\tHash value to debug escape analysis."
msgstr "-fgo-debug-escape-hash=<string>\tHash waarde na ontfout escape analysis."

#: go/lang.opt:98
#, no-c-format
msgid "Emit optimization diagnostics."
msgstr "Genereer optimering diagnostics."

#: params.opt:27
#, no-c-format
msgid "Loops iterating at least selected number of iterations get loop alignment."
msgstr "Lusse iterating minstens selected aantal iterations get lus belyning."

#: params.opt:31
#, no-c-format
msgid "Select fraction of the maximal frequency of executions of basic block in function given basic block get alignment."
msgstr "Select fraction van die maximal frequency van executions van basic blok in funksie gegee basic blok get belyning."

#: params.opt:35
#, no-c-format
msgid "Enable asan globals protection."
msgstr "Aktiveer asan globals protection."

#: params.opt:39
#, no-c-format
msgid "Enable asan allocas/VLAs protection."
msgstr "Aktiveer asan allocas/VLAs protection."

#: params.opt:43
#, no-c-format
msgid "Enable asan load operations protection."
msgstr "Aktiveer asan laai bewerkings protection."

#: params.opt:47
#, no-c-format
msgid "Enable asan store operations protection."
msgstr "Aktiveer asan stoor bewerkings protection."

#: params.opt:51
#, no-c-format
msgid "Use callbacks instead of inline code if number of accesses in function becomes greater or equal to this number."
msgstr "Gebruik callbacks in plaas van inline kode as aantal accesses in funksie becomes greater of gelyk aan hierdie getal."

#: params.opt:55
#, no-c-format
msgid "Prefix calls to memcpy, memset and memmove with __asan_ or __hwasan_ for -fsanitize=kernel-address or -fsanitize=kernel-hwaddress."
msgstr "Voorvoegsel oproepe na memcpy, memset en memmove met __asan_ of __hwasan_ vir -fsanitize=kernel-address of -fsanitize=kernel-hwaddress."

#: params.opt:59
#, no-c-format
msgid "Enable asan builtin functions protection."
msgstr "Aktiveer asan ingeboude funksies protection."

#: params.opt:63
#, no-c-format
msgid "Enable asan stack protection."
msgstr "Aktiveer asan stapel protection."

#: params.opt:67
#, no-c-format
msgid "Enable asan detection of use-after-return bugs."
msgstr "Aktiveer asan detection van use-after-return bugs."

#: params.opt:71
#, no-c-format
msgid "Build basic block profile using auto profile."
msgstr "Build basic blok profiel gebruik outomaties profiel."

#: params.opt:75
#, no-c-format
msgid "Enable only function reordering with auto-profile."
msgstr "Aktiveer slegs funksie reordering met auto-profile."

#: params.opt:79
#, no-c-format
msgid "Whether the scheduling description is mostly a cycle-accurate model of the target processor and is likely to spill aggressively to fill any pipeline bubbles."
msgstr "Of die skedulering beskrywing is mostly a cycle-accurate model van die teiken processor en is likely na stort aggressively na fill enige pipeline bubbles."

#: params.opt:83
#, no-c-format
msgid "Enable hwasan instrumentation of statically-sized stack-allocated variables."
msgstr "Aktiveer hwasan instrumentation van statically-sized stack-allocated veranderlikes."

#: params.opt:87
#, no-c-format
msgid "Use random base tag for each frame, as opposed to base always zero."
msgstr "Gebruik random basis tag vir elke raam, as opposed na basis altyd nul."

#: params.opt:91
#, no-c-format
msgid "Enable hwasan instrumentation of allocas/VLAs."
msgstr "Aktiveer hwasan instrumentation van allocas/VLAs."

#: params.opt:95
#, no-c-format
msgid "Enable hwasan instrumentation of load operations."
msgstr "Aktiveer hwasan instrumentation van laai bewerkings."

#: params.opt:99
#, no-c-format
msgid "Enable hwasan instrumentation of store operations."
msgstr "Aktiveer hwasan instrumentation van stoor bewerkings."

#: params.opt:103
#, no-c-format
msgid "Enable hwasan instrumentation of builtin functions."
msgstr "Aktiveer hwasan instrumentation van ingeboude funksies."

#: params.opt:107
#, no-c-format
msgid "When sanitizing using MTE instructions, add checks for all stack allocas."
msgstr "Wanneer sanitizing gebruik MTE instruksies, voeg by checks vir alle stapel allocas."

#: params.opt:111
#, no-c-format
msgid "When sanitizing using MTE instructions, include builtin functions."
msgstr "Wanneer sanitizing gebruik MTE instruksies, sluit in ingeboude funksies."

#: params.opt:115
#, no-c-format
msgid "Average number of iterations of a loop."
msgstr "Gemiddelde aantal iterations van a lus."

#: params.opt:119
#, no-c-format
msgid "Maximum number of bits for which we avoid creating FMAs."
msgstr "Maksimum aantal bisse vir wat ons avoid creating FMAs."

#: params.opt:123
#, no-c-format
msgid "Set the estimated probability in percentage for builtin expect. The default value is 90% probability."
msgstr "Stel die estimated probability in persentasie vir ingeboude verwag. Die verstek waarde is 90% probability."

#: params.opt:127
#, no-c-format
msgid "The maximum length of a constant string for a builtin string comparison call eligible for inlining. The default value is 3."
msgstr "Die maksimum lengte van a konstant string vir a ingeboude string vergelyking oproep geskik vir inlining. Die verstek waarde is 3."

#: params.opt:131
#, no-c-format
msgid "The smallest number of different values for which it is best to use a jump-table instead of a tree of conditional branches.  If 0, use the default for the machine."
msgstr "Die smallest aantal verskillende waardes vir wat dit is beste na gebruik a jump-table in plaas van a tree van voorwaardelike branches. As 0, gebruik die verstek vir die machine."

#: params.opt:135
#, no-c-format
msgid "Probability that COMDAT function is shared with a different compilation unit."
msgstr "Probability wat COMDAT funksie is gedeelde met a verskillende kompilering eenheid."

#: params.opt:139
#, no-c-format
msgid "Maximum number of namespaces to search for alternatives when name lookup fails."
msgstr "Maksimum aantal namespaces na soek vir alternatives wanneer naam soek op fails."

#: params.opt:143
#, no-c-format
msgid "Maximum number of queries into the alias oracle per store."
msgstr "Maksimum aantal queries in die alias oracle per stoor."

#: params.opt:147
#, no-c-format
msgid "Maximum size (in bytes) of objects tracked bytewise by dead store elimination."
msgstr "Maksimum grootte (in grepe) van objekte tracked bytewise deur dead stoor elimination."

#: params.opt:151
#, no-c-format
msgid "Maximal estimated growth of function body caused by early inlining of single call."
msgstr "Maximal estimated groei van funksie body caused deur early inlining van enkele oproep."

#: params.opt:155
#, no-c-format
msgid "Maximum number of files in the file cache."
msgstr "Maksimum aantal lêers in die lêer kas."

#: params.opt:159
#, no-c-format
msgid "Maximum number of lines to index into file cache. When 0 this is automatically sized."
msgstr "Maksimum aantal lines na indeks in lêer kas. Wanneer 0 dit is outomaties sized."

#: params.opt:163
#, no-c-format
msgid "Scale factor to apply to the number of statements in a threading path crossing a loop back edge when comparing to max-jump-thread-duplication-stmts."
msgstr "Skaal faktor na pas toe na die aantal stellings in a threading pad crossing a lus back edge wanneer comparing na max-jump-thread-duplication-stmts."

#: params.opt:167
#, no-c-format
msgid "Whether the target fully pipelines FMA instructions.  If non-zero, reassociation considers the benefit of parallelizing FMA's multiplication part and addition part, assuming FMUL and FMA use the same units that can also do FADD."
msgstr "Of die teiken ten volle pipelines FMA instruksies. As nie-nul, reassociation considers die benefit van parallelizing FMA's vermenigvuldiging deel en addition deel, met die aanname FMUL en FMA gebruik die dieselfde units wat kan ook doen FADD nie."

#: params.opt:174
#, no-c-format
msgid "The threshold ratio of critical edges execution count that permit performing redundancy elimination after reload."
msgstr "Die drempel verhouding van critical edges uitvoering telling wat permit uitvoer van redundancy elimination ná herlaai."

#: params.opt:178
#, no-c-format
msgid "The threshold ratio for performing partial redundancy elimination after reload."
msgstr "Die drempel verhouding vir uitvoer van gedeeltelike redundancy elimination ná herlaai."

#: params.opt:182
#, no-c-format
msgid "Scaling factor in calculation of maximum distance an expression can be moved by GCSE optimizations."
msgstr "Scaling faktor in berekening van maksimum distance 'n uitdrukking kan wees geskuif deur GCSE optimizations."

#: params.opt:186
#, no-c-format
msgid "Cost at which GCSE optimizations does not constrain the distance an expression can travel."
msgstr "Koste by wat GCSE optimizations doen nie constrain die distance 'n uitdrukking kan travel nie."

#: params.opt:190
#, no-c-format
msgid "Minimum heap expansion to trigger garbage collection, as a percentage of the total size of the heap."
msgstr "Minimum hoop uitbreiding na trigger garbage collection, as a persentasie van die totale grootte van die hoop."

#: params.opt:194
#, no-c-format
msgid "Minimum heap size before we start collecting garbage, in kilobytes."
msgstr "Minimum hoop grootte voor ons begin collecting garbage, in kilobytes."

#: params.opt:198
#, no-c-format
msgid "The number of executions of a basic block which is considered hot. The parameter is used only in GIMPLE FE."
msgstr "Die aantal executions van a basic blok wat is oorweeg hot. Die parameter is gebruik slegs in GIMPLE FE."

#: params.opt:202
#, no-c-format
msgid "Whether codegen errors should be ICEs when -fchecking."
msgstr "Of codegen foute moet wees ICEs wanneer -fchecking."

#: params.opt:206
#, no-c-format
msgid "Maximum number of arrays per SCoP."
msgstr "Maksimum aantal skikkings per SCoP."

#: params.opt:210
#, no-c-format
msgid "Maximum number of parameters in a SCoP."
msgstr "Maksimum aantal parameters in a SCoP."

#: params.opt:214
#, no-c-format
msgid "Maximum number of blocks for -fharden-control-flow-redundancy."
msgstr "Maksimum aantal blokke vir -fharden-control-flow-redundancy."

#: params.opt:218
#, no-c-format
msgid "Maximum number of blocks for in-line -fharden-control-flow-redundancy."
msgstr "Maksimum aantal blokke vir in-line -fharden-control-flow-redundancy."

#: params.opt:222
#, no-c-format
msgid "The number of elements for which hash table verification is done for each searched element."
msgstr "Die aantal elemente vir wat hash tabel verification is done vir elke searched element."

#: params.opt:226
#, no-c-format
msgid "The denominator n of fraction 1/n of the maximal execution count of a basic block in the entire program that a basic block needs to at least have in order to be considered hot (used in non-LTO mode)."
msgstr "Die denominator n van fraction 1/n van die maximal uitvoering telling van a basic blok in die entire program wat a basic blok benodig na minstens het om te wees oorweeg hot (gebruik in non-LTO modus)."

#: params.opt:230
#, no-c-format
msgid "The number of most executed permilles of the profiled execution of the entire program to which the execution count of a basic block must be part of in order to be considered hot (used in LTO mode)."
msgstr "Die aantal most uitgevoer permilles van die profiled uitvoering van die entire program na wat die uitvoering telling van a basic blok moet wees deel van om te wees oorweeg hot (gebruik in LTO modus)."

#: params.opt:234
#, no-c-format
msgid "The denominator n of fraction 1/n of the execution frequency of the entry block of a function that a basic block of this function needs to at least have in order to be considered hot."
msgstr "Die denominator n van fraction 1/n van die uitvoering frequency van die inskrywing blok van a funksie wat a basic blok van hierdie funksie benodig na minstens het om te wees oorweeg hot."

#: params.opt:238
#, no-c-format
msgid "The scale (as a percentage) applied to inline-insns-single and auto limits when heuristics hints that inlining is very profitable."
msgstr "Die skaal (as a persentasie) toegepas na inline-insns-single en outomaties limits wanneer heuristics hints wat inlining is baie profitable."

#: params.opt:242
#, no-c-format
msgid "The minimal estimated speedup allowing inliner to ignore inline-insns-single and inline-insns-auto."
msgstr "Die minimal estimated speedup allowing inliner na ignoreer inline-insns-single en inline-insns-auto."

#: params.opt:246
#, no-c-format
msgid "How much can given compilation unit grow because of the inlining (as a percentage)."
msgstr "How much kan gegee kompilering eenheid groei weens die inlining (as a persentasie)."

#: params.opt:250
#, no-c-format
msgid "The upper bound for sharing integer constants."
msgstr "Die boonste gebonde vir sharing heelgetal konstantes."

#: params.opt:254
#, no-c-format
msgid "Threshold ipa-cp opportunity evaluation that is still considered beneficial to clone."
msgstr "Drempel ipa-cp opportunity evaluering wat is steeds oorweeg beneficial na kloon."

#: params.opt:258
#, no-c-format
msgid "Compile-time bonus IPA-CP assigns to candidates which make loop bounds or strides known."
msgstr "Kompileertyd bonus IPA-CP assigns na kandidate wat make lus grense of strides known."

#: params.opt:262
#, no-c-format
msgid "Maximum depth of recursive cloning for self-recursive function."
msgstr "Maksimum diepte van rekursiewe cloning vir self-recursive funksie."

#: params.opt:266
#, no-c-format
msgid "Recursive cloning only when the probability of call being executed exceeds the parameter."
msgstr "Rekursiewe cloning slegs wanneer die probability van oproep besig om te uitgevoer oorskry die parameter."

#: params.opt:270
#, no-c-format
msgid "When propagating IPA-CP effect estimates, multiply frequencies of recursive edges that bring back an unchanged value by this factor."
msgstr "Wanneer propagating IPA-CP effek estimates, multiply frequencies van rekursiewe edges wat bring back 'n unchanged waarde deur hierdie faktor."

#: params.opt:274
#, no-c-format
msgid "Percentage penalty recursive functions receive when they are evaluated for cloning."
msgstr "Persentasie penalty rekursiewe funksies ontvang wanneer hulle is geëvalueer vir cloning."

#: params.opt:278
#, no-c-format
msgid "Percentage penalty functions containing a single call to another function receive when they are evaluated for cloning."
msgstr "Persentasie penalty funksies containing a enkele oproep na nog 'n funksie ontvang wanneer hulle is geëvalueer vir cloning."

#: params.opt:282
#, no-c-format
msgid "The number of times the interprocedural constant propagation traverses all functions to make cloning decisions."
msgstr "Die aantal keer die interprocedural konstant propagation traverses alle funksies na make cloning decisions."

#: params.opt:286
#, no-c-format
msgid "How much can given compilation unit grow because of the interprocedural constant propagation (as a percentage)."
msgstr "How much kan gegee kompilering eenheid groei weens die interprocedural konstant propagation (as a persentasie)."

#: params.opt:290
#, no-c-format
msgid "The size of translation unit that IPA-CP pass considers large."
msgstr "Die grootte van translation eenheid wat IPA-CP gee deur considers groot."

#: params.opt:294
#, no-c-format
msgid "Maximum size of a list of values associated with each parameter for interprocedural constant propagation."
msgstr "Maksimum grootte van a lys van waardes geassosieer met elke parameter vir interprocedural konstant propagation."

#: params.opt:298
#, no-c-format
msgid "Maximum number of statements visited during jump function offset discovery."
msgstr "Maksimum aantal stellings visited tydens jump funksie verplasing discovery."

#: params.opt:302
#, no-c-format
msgid "Maximum number of statements that are visited by IPA formal parameter analysis based on alias analysis in any given function."
msgstr "Maksimum aantal stellings wat is visited deur IPA formal parameter analysis based op alias analysis in enige gegee funksie."

#: params.opt:306
#, no-c-format
msgid "Maximum number of aggregate content items for a parameter in jump functions and lattices."
msgstr "Maksimum aantal aggregate content items vir a parameter in jump funksies en lattices."

#: params.opt:310
#, no-c-format
msgid "Maximum number of operations in a parameter expression that can be handled by IPA analysis."
msgstr "Maksimum aantal bewerkings in a parameter uitdrukking wat kan wees handled deur IPA analysis."

#: params.opt:314
#, no-c-format
msgid "Maximum number of different predicates used to track properties of loops in IPA analysis."
msgstr "Maksimum aantal verskillende predicates gebruik na track properties van lusse in IPA analysis."

#: params.opt:318
#, no-c-format
msgid "Maximal number of boundary endpoints of case ranges of switch statement used during IPA function summary generation."
msgstr "Maximal aantal boundary endpoints van geval ranges van skakelaar stelling gebruik tydens IPA funksie summary generation."

#: params.opt:322
#, no-c-format
msgid "Minimum probability (as a percentage) of dereferencing of a function pointer parameter for it to be considered for replacement with simple values."
msgstr "Minimum probability (as a persentasie) van dereferencing van a funksie wyser parameter vir dit na wees oorweeg vir vervanging met simple waardes."

#: params.opt:326
#, no-c-format
msgid "Maximum pieces that IPA-SRA tracks per formal parameter, as a consequence, also the maximum number of replacements of a formal parameter."
msgstr "Maksimum pieces wat IPA-SRA tracks per formal parameter, as a consequence, ook die maksimum aantal replacements van a formal parameter."

#: params.opt:330
#, no-c-format
msgid "Maximum allowed growth of total size of new parameters that ipa-sra replaces a pointer to an aggregate with."
msgstr "Maksimum toegelaat groei van totale grootte van nuwe parameters wat ipa-sra replaces a wyser na 'n aggregate met."

#: params.opt:334
#, no-c-format
msgid "Additional maximum allowed growth of total size of new parameters that ipa-sra replaces a pointer to an aggregate with, if it points to a local variable that the caller only writes to and passes it as an argument to functions."
msgstr "Additional maksimum toegelaat groei van totale grootte van nuwe parameters wat ipa-sra replaces a wyser na 'n aggregate met, as dit points na a plaaslike veranderlike wat die caller slegs writes na en passes dit as 'n argument na funksies."

#: params.opt:338
#, no-c-format
msgid "The number of registers in each class kept unused by loop invariant motion."
msgstr "Die aantal registers in elke klas kept ongebruikte deur lus invariant motion."

#: params.opt:342
#, no-c-format
msgid "Maximum size of conflict table in MB."
msgstr "Maksimum grootte van botsing tabel in MB."

#: params.opt:346
#, no-c-format
msgid "Approximate function insn number in 1K units triggering simple local RA."
msgstr "Approximate funksie insn getal in 1K units triggering simple plaaslike RA."

#: params.opt:350
#, no-c-format
msgid "Maximum number of loops for regional RA."
msgstr "Maksimum aantal lusse vir regional RA."

#: params.opt:354
#, no-c-format
msgid "Control IRA to consider matching constraint (duplicated operand number) heavily in all available alternatives for preferred register class.  If it is set as zero, it means IRA only respects the matching constraint when it's in the only available alternative with an appropriate register class.  Otherwise, it means IRA checks all available alternatives for preferred register class even if it has found some choice with an appropriate register class and respect the found qualified matching constraint."
msgstr "Beheer IRA na oorweeg passing beperking (duplicated operand getal) heavily in alle beskikbaar alternatives vir preferred register klas. As dit is stel as nul, dit means IRA slegs respects die passing beperking wanneer it's in die slegs beskikbaar alternative met 'n toepaslik register klas. Andersins, dit means IRA checks alle beskikbaar alternatives vir preferred register klas even as dit het gevind some choice met 'n toepaslik register klas en respect die gevind gekwalifiseerde passing beperking."

#: params.opt:358
#, no-c-format
msgid "If number of candidates in the set is smaller, we always try to remove unused induction variables during its optimization."
msgstr "As aantal kandidate in die stel is smaller, ons altyd probeer na verwyder ongebruikte induction veranderlikes tydens sy optimering."

#: params.opt:362
#, no-c-format
msgid "Bound on number of candidates below that all candidates are considered in induction variable optimizations."
msgstr "Gebonde op aantal kandidate hieronder wat alle kandidate is oorweeg in induction veranderlike optimizations."

#: params.opt:366
#, no-c-format
msgid "Bound on number of induction variable uses in loop optimized in IV optimizations."
msgstr "Gebonde op aantal induction veranderlike gebruik in lus geoptimeer in IV optimizations."

#: params.opt:370
#, no-c-format
msgid "The maximum code size growth ratio when expanding into a jump table (as a percentage).  The parameter is used when optimizing for size."
msgstr "Die maksimum kode grootte groei verhouding wanneer expanding in a jump tabel (as a persentasie). Die parameter is gebruik wanneer optimizing vir grootte."

#: params.opt:374
#, no-c-format
msgid "The maximum code size growth ratio when expanding into a jump table (as a percentage).  The parameter is used when optimizing for speed."
msgstr "Die maksimum kode grootte groei verhouding wanneer expanding in a jump tabel (as a persentasie). Die parameter is gebruik wanneer optimizing vir speed."

#: params.opt:378
#, no-c-format
msgid "The size of L1 cache line."
msgstr "Die grootte van L1 kas reël."

#: params.opt:382
#, no-c-format
msgid "The minimum recommended offset between two concurrently-accessed objects to avoid additional performance degradation due to contention introduced by the implementation.  Typically the L1 cache line size, but can be larger to accommodate a variety of target processors with different cache line sizes. C++17 code might use this value in structure layout, but is strongly discouraged from doing so in public ABIs."
msgstr "Die minimum recommended verplasing tussen two concurrently-accessed objekte na avoid additional performance degradation due na contention introduced deur die implementering. Tipies die L1 kas reël grootte, maar kan wees larger na accommodate a variety van teiken processors met verskillende kas reël sizes. C++17 kode mag gebruik hierdie waarde in structure layout, maar is strongly discouraged van doing so in publieke ABIs."

#: params.opt:391
#, no-c-format
msgid "The maximum recommended size of contiguous memory occupied by two objects accessed with temporal locality by concurrent threads.  Typically the L1 cache line size, but can be smaller to accommodate a variety of target processors with different cache line sizes."
msgstr "Die maksimum recommended grootte van aaneenlopende geheue occupied deur two objekte accessed met temporal locality deur concurrent threads. Tipies die L1 kas reël grootte, maar kan wees smaller na accommodate a variety van teiken processors met verskillende kas reël sizes."

#: params.opt:398
#, no-c-format
msgid "The size of L1 cache."
msgstr "Die grootte van L1 kas."

#: params.opt:402
#, no-c-format
msgid "The size of L2 cache."
msgstr "Die grootte van L2 kas."

#: params.opt:406
#, no-c-format
msgid "Maximal growth due to inlining of large function (as a percentage)."
msgstr "Maximal groei due na inlining van groot funksie (as a persentasie)."

#: params.opt:410
#, no-c-format
msgid "The size of function body to be considered large."
msgstr "Die grootte van funksie body na wees oorweeg groot."

#: params.opt:414
#, no-c-format
msgid "The size of stack frame to be considered large."
msgstr "Die grootte van stapel raam na wees oorweeg groot."

#: params.opt:418
#, no-c-format
msgid "Maximal stack frame growth due to inlining (as a percentage)."
msgstr "Maximal stapel raam groei due na inlining (as a persentasie)."

#: params.opt:422
#, no-c-format
msgid "The size of translation unit to be considered large."
msgstr "Die grootte van translation eenheid na wees oorweeg groot."

#: params.opt:426
#, no-c-format
msgid "Maximum number of concurrently open C++ module files when lazy loading."
msgstr "Maksimum aantal concurrently maak oop C++ module lêers wanneer lui loading."

#: params.opt:430
#, no-c-format
msgid "The minimum cost of an expensive expression in the loop invariant motion."
msgstr "Die minimum koste van 'n expensive uitdrukking in die lus invariant motion."

#: params.opt:434
#, no-c-format
msgid "True if a non-short-circuit operation is optimal."
msgstr "Waar as a non-short-circuit bewerking is optimal."

#: params.opt:438
#, no-c-format
msgid "Size of tiles for loop blocking."
msgstr "Grootte van tiles vir lus blocking."

#: params.opt:442
#, no-c-format
msgid "The maximum number of stmts in loop nest for loop interchange."
msgstr "Die maksimum aantal stmts in lus nest vir lus interchange."

#: params.opt:446
#, no-c-format
msgid "The minimum stride ratio for loop interchange to be profitable."
msgstr "Die minimum stap verhouding vir lus interchange na wees profitable."

#: params.opt:450
#, no-c-format
msgid "Max basic blocks number in loop for loop invariant motion."
msgstr "Max basic blokke getal in lus vir lus invariant motion."

#: params.opt:454
#, no-c-format
msgid "Maximum number of datarefs in loop for building loop data dependencies."
msgstr "Maksimum aantal datarefs in lus vir building lus data dependencies."

#: params.opt:458
#, no-c-format
msgid "The maximum number of instructions in an inner loop that is being considered for versioning."
msgstr "Die maksimum aantal instruksies in 'n binneste lus wat is besig om te oorweeg vir versioning."

#: params.opt:462
#, no-c-format
msgid "The maximum number of instructions in an outer loop that is being considered for versioning, on top of the instructions in inner loops."
msgstr "Die maksimum aantal instruksies in 'n buitenste lus wat is besig om te oorweeg vir versioning, op top van die instruksies in binneste lusse."

#: params.opt:466
#, no-c-format
msgid "Minimal fall-through edge probability as a percentage, used to add BB to inheritance EBB in LRA."
msgstr "Minimal fall-through edge probability as a persentasie, gebruik na voeg by BB na oorerwing EBB in LRA."

#: params.opt:470
#, no-c-format
msgid "The max number of reload pseudos which are considered during spilling a non-reload pseudo."
msgstr "Die max aantal herlaai pseudos wat is oorweeg tydens spilling a non-reload pseudo."

#: params.opt:474
#, no-c-format
msgid "The maximum log2(number of reload pseudos * number of program points) threshold when preferences for other reload pseudos are still considered. Taking these preferences into account helps to improve register allocation. However, for very large functions, a large value can result in significant compilation time and memory consumption. The default value is 30."
msgstr "Die maksimum log2(aantal herlaai pseudos * aantal program points) drempel wanneer preferences vir ander herlaai pseudos is steeds oorweeg. Taking hierdie preferences in account helps na improve register toewysing. Egter, vir baie groot funksies, a groot waarde kan resultaat in significant kompilering tyd en geheue consumption. Die verstek waarde is 30."

#: params.opt:482
#, no-c-format
msgid "Maximal size of a partition for LTO (in estimated instructions)."
msgstr "Maximal grootte van a partisie vir LTO (in estimated instruksies)."

#: params.opt:486
#, no-c-format
msgid "Maximal number of LTO partitions streamed in parallel."
msgstr "Maximal aantal LTO partitions streamed in parallelle."

#: params.opt:490
#, no-c-format
msgid "Minimal size of a partition for LTO (in estimated instructions)."
msgstr "Minimal grootte van a partisie vir LTO (in estimated instruksies)."

#: params.opt:494
#, no-c-format
msgid "Number of partitions the program should be split to."
msgstr "aantal partitions die program moet wees split na."

#: params.opt:513
#, no-c-format
msgid "The denominator n of fraction 1/n of the execution frequency of callee to be cloned for a particular caller. Special value of 0 dictates to always clone without a cut-off."
msgstr "Die denominator n van fraction 1/n van die uitvoering frequency van callee na wees gekloon vir a particular caller. Special waarde van 0 dictates na altyd kloon sonder a cut-off."

#: params.opt:517
#, no-c-format
msgid "Size cut-off for callee including inlined calls to be cloned for a particular caller."
msgstr "Grootte cut-off vir callee insluitend geïnline oproepe na wees gekloon vir a particular caller."

#: params.opt:521
#, no-c-format
msgid "Maximal size of a locality partition for LTO (in estimated instructions). Value of 0 results in default value being used."
msgstr "Maximal grootte van a locality partisie vir LTO (in estimated instruksies). Waarde van 0 resultate in verstek waarde besig om te gebruik."

#: params.opt:531
#, no-c-format
msgid "Choose static heuristics for locality layout. Option cpp_template groups by C++ template instantiation type."
msgstr "Choose statiese heuristics vir locality layout. Opsie cpp_sjabloon groups deur C++ sjabloon instansiëring tipe."

#: params.opt:535
#, no-c-format
msgid "The maximum number of instructions to consider to unroll in a loop on average."
msgstr "Die maksimum aantal instruksies na oorweeg na rol uit in a lus op gemiddelde."

#: params.opt:539
#, no-c-format
msgid "The maximum number of insns combine tries to combine."
msgstr "Die maksimum aantal insns combine tries na combine."

#: params.opt:543
#, no-c-format
msgid "The maximum number of instructions that combine searches in order to find the next use of a particular register."
msgstr "Die maksimum aantal instruksies wat combine searches om te vind die volgende gebruik van a particular register."

#: params.opt:547
#, no-c-format
msgid "The maximum depth of a loop nest we completely peel."
msgstr "Die maksimum diepte van a lus nest ons heeltemal peel."

#: params.opt:551
#, no-c-format
msgid "The maximum number of peelings of a single loop that is peeled completely."
msgstr "Die maksimum aantal peelings van a enkele lus wat is peeled heeltemal."

#: params.opt:555
#, no-c-format
msgid "The maximum number of insns of a completely peeled loop."
msgstr "Die maksimum aantal insns van a heeltemal peeled lus."

#: params.opt:559
#, no-c-format
msgid "The maximum number of incoming edges to consider for crossjumping."
msgstr "Die maksimum aantal incoming edges na oorweeg vir crossjumping."

#: params.opt:563
#, no-c-format
msgid "The maximum instructions CSE process before flushing."
msgstr "Die maksimum instruksies CSE process voor flushing."

#: params.opt:567
#, no-c-format
msgid "The maximum length of path considered in cse."
msgstr "Die maksimum lengte van pad oorweeg in cse."

#: params.opt:571
#, no-c-format
msgid "The maximum memory locations recorded by cselib."
msgstr "Die maksimum geheue locations recorded deur cselib."

#: params.opt:575
#, no-c-format
msgid "Maximum count of debug markers to expand or inline."
msgstr "Maksimum telling van ontfout markers na brei uit of inline."

#: params.opt:579
#, no-c-format
msgid "The maximum number of instructions to consider to fill a delay slot."
msgstr "Die maksimum aantal instruksies na oorweeg na fill a delay slot."

#: params.opt:583
#, no-c-format
msgid "The maximum number of instructions to consider to find accurate live register information."
msgstr "Die maksimum aantal instruksies na oorweeg na vind accurate live register inligting."

#: params.opt:587
#, no-c-format
msgid "Maximum number of active local stores in RTL dead store elimination."
msgstr "Maksimum aantal active plaaslike stores in RTL dead stoor elimination."

#: params.opt:591
#, no-c-format
msgid "Maximum number of targets to devirtualize."
msgstr "Maksimum aantal targets na devirtualize."

#: params.opt:595
#, no-c-format
msgid "The maximum number of nested indirect inlining performed by early inliner."
msgstr "Die maksimum aantal geneste indirekte inlining uitgevoer deur early inliner."

#: params.opt:599
#, no-c-format
msgid "Maximum number of fields in a structure before pointer analysis treats the structure as a single variable."
msgstr "Maksimum aantal velde in a structure voor wyser analysis treats die structure as a enkele veranderlike."

#: params.opt:603
#, no-c-format
msgid "Maximum number of instructions to copy when duplicating blocks on a finite state automaton jump thread path."
msgstr "Maksimum aantal instruksies na kopie wanneer duplicating blokke op a eindige state automaton jump draad pad."

#: params.opt:607
#, no-c-format
msgid "The maximum ratio of insertions to deletions of expressions in GCSE."
msgstr "Die maksimum verhouding van insertions na deletions van expressions in GCSE."

#: params.opt:611
#, no-c-format
msgid "The maximum amount of memory to be allocated by GCSE, in kilobytes."
msgstr "Die maksimum hoeveelheid van geheue na wees toegewys deur GCSE, in kilobytes."

#: params.opt:615
#, no-c-format
msgid "The maximum number of insns to duplicate when unfactoring computed gotos."
msgstr "Die maksimum aantal insns na duplikaat wanneer unfactoring bereken gotos."

#: params.opt:619
#, no-c-format
msgid "The maximum expansion factor when copying basic blocks."
msgstr "Die maksimum uitbreiding faktor wanneer copying basic blokke."

#: params.opt:623
#, no-c-format
msgid "Maximum depth of search in the dominator tree for expressions to hoist."
msgstr "Maksimum diepte van soek in die dominator tree vir expressions na hys."

#: params.opt:627
#, no-c-format
msgid "Maximum loop depth of a call which is considered for inlining functions called once."
msgstr "Maksimum lus diepte van a oproep wat is oorweeg vir inlining funksies opgeroep een keer."

#: params.opt:631
#, no-c-format
msgid "Maximum combined size of caller and callee which is inlined if callee is called once."
msgstr "Maksimum combined grootte van caller en callee wat is geïnline as callee is opgeroep een keer."

#: params.opt:635
#, no-c-format
msgid "The maximum number of instructions when automatically inlining."
msgstr "Die maksimum aantal instruksies wanneer outomaties inlining."

#: params.opt:639
#, no-c-format
msgid "The maximum number of instructions inline function can grow to via recursive inlining."
msgstr "Die maksimum aantal instruksies inline funksie kan groei na via rekursiewe inlining."

#: params.opt:643
#, no-c-format
msgid "The maximum number of instructions non-inline function can grow to via recursive inlining."
msgstr "Die maksimum aantal instruksies non-inline funksie kan groei na via rekursiewe inlining."

#: params.opt:647
#, no-c-format
msgid "The maximum number of instructions in a single function eligible for inlining."
msgstr "Die maksimum aantal instruksies in a enkele funksie geskik vir inlining."

#: params.opt:651
#, no-c-format
msgid "The maximum number of instructions when inlining for size."
msgstr "Die maksimum aantal instruksies wanneer inlining vir grootte."

#: params.opt:655
#, no-c-format
msgid "The maximum number of instructions when automatically inlining small functions."
msgstr "Die maksimum aantal instruksies wanneer outomaties inlining klein funksies."

#: params.opt:659
#, no-c-format
msgid "The maximum depth of recursive inlining for inline functions."
msgstr "Die maksimum diepte van rekursiewe inlining vir inline funksies."

#: params.opt:663
#, no-c-format
msgid "The maximum depth of recursive inlining for non-inline functions."
msgstr "Die maksimum diepte van rekursiewe inlining vir non-inline funksies."

#: params.opt:667
#, no-c-format
msgid "Maximum number of isl operations, 0 means unlimited."
msgstr "Maksimum aantal isl bewerkings, 0 means unlimited."

#: params.opt:671
#, no-c-format
msgid "Bound on the cost of an expression to compute the number of iterations."
msgstr "Gebonde op die koste van 'n uitdrukking na bereken die aantal iterations."

#: params.opt:675
#, no-c-format
msgid "Bound on the number of iterations the brute force # of iterations analysis algorithm evaluates."
msgstr "Gebonde op die aantal iterations die brute force # van iterations analysis algorithm evaluates."

#: params.opt:679
#, no-c-format
msgid "Maximum number of statements allowed in a block that needs to be duplicated when threading jumps."
msgstr "Maksimum aantal stellings toegelaat in a blok wat benodig na wees duplicated wanneer threading jumps."

#: params.opt:683
#, no-c-format
msgid "Search space limit for the backwards jump threader."
msgstr "Soek space limiet vir die backwards jump threader."

#: params.opt:687
#, no-c-format
msgid "The maximum number of RTL nodes that can be recorded as combiner's last value."
msgstr "Die maksimum aantal RTL nodes wat kan wees recorded as combiner's laaste waarde."

#: params.opt:691
#, no-c-format
msgid "The maximum number of insns in loop header duplicated by the copy loop headers pass."
msgstr "Die maksimum aantal insns in lus koplêer duplicated deur die kopie lus headers gee deur."

#: params.opt:695
#, no-c-format
msgid "The maximum number of backtrack attempts the scheduler should make when modulo scheduling a loop."
msgstr "Die maksimum aantal backtrack attempts die scheduler moet make wanneer modulo skedulering a lus."

#: params.opt:699
#, no-c-format
msgid "Minimum page size for warning purposes."
msgstr "Minimum page grootte vir waarskuwing purposes."

#: params.opt:703
#, no-c-format
msgid "Maximum length of partial antic set when performing tree pre optimization."
msgstr "Maksimum lengte van gedeeltelike antic stel wanneer uitvoer van tree pre optimering."

#: params.opt:707
#, no-c-format
msgid "The maximum number of branches on the path through the peeled sequence."
msgstr "Die maksimum aantal branches op die pad deur die peeled volgorde."

#: params.opt:711
#, no-c-format
msgid "The maximum number of peelings of a single loop."
msgstr "Die maksimum aantal peelings van a enkele lus."

#: params.opt:715
#, no-c-format
msgid "The maximum number of insns of a peeled loop."
msgstr "Die maksimum aantal insns van a peeled lus."

#: params.opt:719
#, no-c-format
msgid "The maximum length of scheduling's pending operations list."
msgstr "Die maksimum lengte van scheduling's hangende bewerkings lys."

#: params.opt:723 params.opt:767
#, no-c-format
msgid "The maximum number of blocks in a region to be considered for interblock scheduling."
msgstr "Die maksimum aantal blokke in a streek na wees oorweeg vir interblock skedulering."

#: params.opt:727 params.opt:771
#, no-c-format
msgid "The maximum number of insns in a region to be considered for interblock scheduling."
msgstr "Die maksimum aantal insns in a streek na wees oorweeg vir interblock skedulering."

#: params.opt:731
#, no-c-format
msgid "Maximum depth of sqrt chains to use when synthesizing exponentiation by a real constant."
msgstr "Maksimum diepte van sqrt chains na gebruik wanneer synthesizing exponentiation deur a reële konstant."

#: params.opt:735
#, no-c-format
msgid "The maximum number of loop iterations we predict statically."
msgstr "Die maksimum aantal lus iterations ons predict statically."

#: params.opt:739
#, no-c-format
msgid "The maximum number of instructions to search backward when looking for equivalent reload."
msgstr "Die maksimum aantal instruksies na soek backward wanneer looking vir equivalent herlaai."

#: params.opt:743
#, no-c-format
msgid "Maximum number of insns in a basic block to consider for RTL if-conversion."
msgstr "Maksimum aantal insns in a basic blok na oorweeg vir RTL if-omsetting."

#: params.opt:747
#, no-c-format
msgid "Maximum permissible cost for the sequence that would be generated by the RTL if-conversion pass for a branch that is considered predictable."
msgstr "Maksimum permissible koste vir die volgorde wat sou wees gegenereer deur die RTL if-omsetting gee deur vir a vertakking wat is oorweeg predictable."

#: params.opt:751
#, no-c-format
msgid "Maximum permissible cost for the sequence that would be generated by the RTL if-conversion pass for a branch that is considered unpredictable."
msgstr "Maksimum permissible koste vir die volgorde wat sou wees gegenereer deur die RTL if-omsetting gee deur vir a vertakking wat is oorweeg unpredictable."

#: params.opt:755
#, no-c-format
msgid "The maximum number of iterations through CFG to extend regions."
msgstr "Die maksimum aantal iterations deur CFG na brei uit regions."

#: params.opt:759
#, no-c-format
msgid "The maximum conflict delay for an insn to be considered for speculative motion."
msgstr "Die maksimum botsing delay vir 'n insn na wees oorweeg vir spekulatiewe motion."

#: params.opt:763
#, no-c-format
msgid "The maximum number of instructions ready to be issued to be considered by the scheduler during the first scheduling pass."
msgstr "Die maksimum aantal instruksies ready na wees issued na wees oorweeg deur die scheduler tydens die eerste skedulering gee deur."

#: params.opt:775
#, no-c-format
msgid "Maximum length of candidate scans for straight-line strength reduction."
msgstr "Maksimum lengte van kandidaat scans vir straight-line sterkte vermindering."

#: params.opt:779
#, no-c-format
msgid "Maximum number of may-defs visited when devirtualizing speculatively."
msgstr "Maksimum aantal may-defs visited wanneer devirtualizing speculatively."

#: params.opt:783
#, no-c-format
msgid "Maximum recursion depth allowed when querying a property of an SSA name."
msgstr "Maksimum rekursie diepte toegelaat wanneer querying a eienskap van 'n SSA naam."

#: params.opt:787
#, no-c-format
msgid "Maximum number of constant stores to merge in the store merging pass."
msgstr "Maksimum aantal konstant stores na saamvoeg in die stoor merging gee deur."

#: params.opt:791
#, no-c-format
msgid "Maximum number of conditional store pairs that can be sunk."
msgstr "Maksimum aantal voorwaardelike stoor pairs wat kan wees gesink."

#: params.opt:795 params.opt:799
#, no-c-format
msgid "Maximum number of store chains to track at the same time in the store merging pass."
msgstr "Maksimum aantal stoor chains na track by die dieselfde tyd in die stoor merging gee deur."

#: params.opt:803
#, no-c-format
msgid "Maximum amount of similar bbs to compare a bb with."
msgstr "Maksimum hoeveelheid van soortgelyke bbs na vergelyk a bb met."

#: params.opt:807
#, no-c-format
msgid "Maximum amount of iterations of the pass over a function."
msgstr "Maksimum hoeveelheid van iterations van die gee deur oor a funksie."

#: params.opt:811
#, no-c-format
msgid "Maximum number of strings for which strlen optimization pass tracks string lengths."
msgstr "Maksimum aantal strings vir wat strlen optimering gee deur tracks string lengths."

#: params.opt:815
#, no-c-format
msgid "Maximum number of arguments in a PHI supported by TREE if-conversion unless the loop is marked with simd pragma."
msgstr "Maksimum aantal argumente in a PHI ondersteun deur TREE if-omsetting tensy die lus is marked met SIMD pragma."

#: params.opt:819
#, no-c-format
msgid "The maximum number of unrollings of a single loop."
msgstr "Die maksimum aantal unrollings van a enkele lus."

#: params.opt:823
#, no-c-format
msgid "The maximum number of instructions to consider to unroll in a loop."
msgstr "Die maksimum aantal instruksies na oorweeg na rol uit in a lus."

#: params.opt:827
#, no-c-format
msgid "The maximum number of insns of an unswitched loop."
msgstr "Die maksimum aantal insns van 'n unswitched lus."

#: params.opt:831
#, no-c-format
msgid "The maximum depth of a loop nest to be unswitched."
msgstr "Die maksimum diepte van a lus nest na wees unswitched."

#: params.opt:835
#, no-c-format
msgid "If -fvariable-expansion-in-unroller is used, the maximum number of times that an individual variable is expanded during loop unrolling."
msgstr "As -fvariable-expansion-in-unroller is gebruik, die maksimum aantal keer wat 'n individual veranderlike is expanded tydens lus unrolling."

#: params.opt:839
#, no-c-format
msgid "Maximum recursion depth for expanding var tracking expressions."
msgstr "Maksimum rekursie diepte vir expanding var tracking expressions."

#: params.opt:843
#, no-c-format
msgid "Maximum size of loc list for which reverse ops should be added."
msgstr "Maksimum grootte van loc lys vir wat reverse ops moet wees bygevoeg."

#: params.opt:847
#, no-c-format
msgid "Maximum size of var tracking hash tables."
msgstr "Maksimum grootte van var tracking hash tables."

#: params.opt:851
#, no-c-format
msgid "Maximum number of VALUEs handled during a single find_base_term call."
msgstr "Maksimum aantal Waardes handled tydens a enkele vind_basis_term oproep."

#: params.opt:855
#, no-c-format
msgid "The minimum number of matching instructions to consider for crossjumping."
msgstr "Die minimum aantal passing instruksies na oorweeg vir crossjumping."

#: params.opt:859
#, no-c-format
msgid "Inline recursively only when the probability of call being executed exceeds the parameter."
msgstr "Inline recursively slegs wanneer die probability van oproep besig om te uitgevoer oorskry die parameter."

#: params.opt:863
#, no-c-format
msgid "Minimum ratio of insns to prefetches to enable prefetching for a loop with an unknown trip count."
msgstr "Minimum verhouding van insns na prefetches na aktiveer prefetching vir a lus met 'n onbekende trip telling."

#: params.opt:867
#, no-c-format
msgid "The minimum threshold for probability of semi-invariant condition statement to trigger loop split."
msgstr "Die minimum drempel vir probability van semi-invariant voorwaarde stelling na trigger lus split."

#: params.opt:871
#, no-c-format
msgid "The minimum UID to be used for a nondebug insn."
msgstr "Die minimum UID na wees gebruik vir a nondebug insn."

#: params.opt:875
#, no-c-format
msgid "The minimum size of variables taking part in stack slot sharing when not optimizing."
msgstr "Die minimum grootte van veranderlikes taking deel in stapel slot sharing wanneer nie optimizing nie."

#: params.opt:879
#, no-c-format
msgid "The minimum probability of reaching a source block for interblock speculative scheduling."
msgstr "Die minimum probability van reaching a bron blok vir interblock spekulatiewe skedulering."

#: params.opt:883
#, no-c-format
msgid "If -ftree-vectorize is used, the minimal loop bound of a loop to be considered for vectorization."
msgstr "As -ftree-vectorize is gebruik, die minimal lus gebonde van a lus na wees oorweeg vir vektorisering."

#: params.opt:887
#, no-c-format
msgid "--param=openacc-kernels=[decompose|parloops]\tSpecify mode of OpenACC 'kernels' constructs handling."
msgstr "--param=openacc-kernels=[decompose|parloops]\tSpesifiseer modus van OpenACC 'kernels' constructs handling."

#: params.opt:900
#, no-c-format
msgid "--param=openacc-privatization=[quiet|noisy]\tSpecify mode of OpenACC privatization diagnostics."
msgstr "--param=openacc-privatization=[stille|noisy]\tSpesifiseer modus van OpenACC privatization diagnostics."

#: params.opt:913
#, no-c-format
msgid "Chunk size of omp schedule for loops parallelized by parloops."
msgstr "Chunk grootte van OpenMP skeduleer vir lusse parallelized deur parloops."

#: params.opt:917
#, no-c-format
msgid "Minimum number of iterations per thread of an innermost parallelized loop."
msgstr "Minimum aantal iterations per draad van 'n innermost parallelized lus."

#: params.opt:921
#, no-c-format
msgid "--param=parloops-schedule=[static|dynamic|guided|auto|runtime]\tSchedule type of omp schedule for loops parallelized by parloops."
msgstr "--param=parloops-schedule=[statiese|dinamiese|guided|outomaties|looptyd]\tSkeduleer tipe van OpenMP skeduleer vir lusse parallelized deur parloops."

#: params.opt:943
#, no-c-format
msgid "Maximum probability of the entry BB of split region (as a percentage relative to entry BB of the function) to make partial inlining happen."
msgstr "Maksimum probability van die inskrywing BB van split streek (as a persentasie relatiewe na inskrywing BB van die funksie) na make gedeeltelike inlining happen."

#: params.opt:947
#, no-c-format
msgid "Maximum number of statements allowed between a defining statement and the end of the basic block before extending the live range is considered profitable."
msgstr "Maksimum aantal stellings toegelaat tussen a defining stelling en die einde van die basic blok voor extending die live bestek is oorweeg profitable."

#: params.opt:951
#, no-c-format
msgid "Maximal estimated outcome of branch considered predictable."
msgstr "Maximal estimated outcome van vertakking oorweeg predictable."

#: params.opt:955
#, no-c-format
msgid "Whether software prefetch hints should be issued for non-constant strides."
msgstr "Of software prefetch hints moet wees issued vir non-constant strides."

#: params.opt:959
#, no-c-format
msgid "The number of insns executed before prefetch is completed."
msgstr "Die aantal insns uitgevoer voor prefetch is completed."

#: params.opt:963
#, no-c-format
msgid "Minimum ratio of insns to mem ops to enable prefetching in a loop."
msgstr "Minimum verhouding van insns na mem ops na aktiveer prefetching in a lus."

#: params.opt:967
#, no-c-format
msgid "The minimum constant stride beyond which we should use prefetch hints for."
msgstr "Die minimum konstant stap beyond wat ons moet gebruik prefetch hints vir."

#: params.opt:971
#, no-c-format
msgid "Use internal function id in profile lookup."
msgstr "Gebruik interne funksie id in profiel soek op."

#: params.opt:975
#, no-c-format
msgid "--param=ranger-debug=[none|trace|gori|cache|tracegori|all] Specifies the output mode for debugging ranger."
msgstr "--param=ranger-debug=[geen|trace|gori|kas|tracegori|alle] Specifies die afvoer modus vir ontfouting ranger."

#: params.opt:1000
#, no-c-format
msgid "Maximum depth of logical expression evaluation ranger looks through when evaluating outgoing edge ranges."
msgstr "Maksimum diepte van logiese uitdrukking evaluering ranger looks deur wanneer evaluating outgoing edge ranges."

#: params.opt:1005
#, no-c-format
msgid "Maximum depth of instruction chains to consider for recomputation in the outgoing range calculator."
msgstr "Maksimum diepte van instruksie chains na oorweeg vir recomputation in die outgoing bestek calculator."

#: params.opt:1010
#, no-c-format
msgid "Maximum number of relations the oracle registers in a basic block."
msgstr "Maksimum aantal relations die oracle registers in a basic blok."

#: params.opt:1014
#, no-c-format
msgid "Work bound when discovering transitive relations from existing relations."
msgstr "Work gebonde wanneer discovering transitive relations van existing relations."

#: params.opt:1018
#, no-c-format
msgid "Maximum depth of a loop nest to fully value-number optimistically."
msgstr "Maksimum diepte van a lus nest na ten volle value-number optimistically."

#: params.opt:1022
#, no-c-format
msgid "Maximum number of disambiguations to perform per memory access."
msgstr "Maksimum aantal disambiguations na voer uit per geheue toegang."

#: params.opt:1026
#, no-c-format
msgid "Bound on the complexity of the expressions in the scalar evolutions analyzer."
msgstr "Gebonde op die complexity van die expressions in die skalaar evolutions analyzer."

#: params.opt:1030
#, no-c-format
msgid "Bound on size of expressions used in the scalar evolutions analyzer."
msgstr "Gebonde op grootte van expressions gebruik in die skalaar evolutions analyzer."

#: params.opt:1034
#, no-c-format
msgid "Hardware autoprefetcher scheduler model control flag.  Number of lookahead cycles the model looks into, at '0' only enable instruction sorting heuristic.  Disabled by default."
msgstr "Hardware autoprefetcher scheduler model beheer vlag. aantal lookahead cycles die model looks in, by '0' slegs aktiveer instruksie sorting heuristic. Gedeaktiveer deur verstek."

#: params.opt:1038
#, no-c-format
msgid "Minimal distance between possibly conflicting store and load."
msgstr "Minimal distance tussen moontlik botsende stoor en laai."

#: params.opt:1042
#, no-c-format
msgid "Which -fsched-pressure algorithm to apply."
msgstr "Wat -fsched-pressure algorithm na pas toe."

#: params.opt:1046
#, no-c-format
msgid "The minimal probability of speculation success (as a percentage), so that speculative insns are scheduled."
msgstr "Die minimal probability van spekulasie success (as a persentasie), so wat spekulatiewe insns is geskeduleer."

#: params.opt:1050
#, no-c-format
msgid "The minimum probability an edge must have for the scheduler to save its state across it."
msgstr "Die minimum probability 'n edge moet het vir die scheduler na bewaar sy state oor dit."

#: params.opt:1054
#, no-c-format
msgid "Maximum number of instructions in the ready list that are considered eligible for renaming."
msgstr "Maksimum aantal instruksies in die ready lys wat is oorweeg geskik vir renaming."

#: params.opt:1058
#, no-c-format
msgid "The maximum size of the lookahead window of selective scheduling."
msgstr "Die maksimum grootte van die lookahead window van selective skedulering."

#: params.opt:1062
#, no-c-format
msgid "Maximum number of times that an insn could be scheduled."
msgstr "Maksimum aantal keer wat 'n insn kon wees geskeduleer."

#: params.opt:1066
#, no-c-format
msgid "The number of prefetches that can run at the same time."
msgstr "Die aantal prefetches wat kan run by die dieselfde tyd."

#: params.opt:1070
#, no-c-format
msgid "Target block's relative execution frequency (as a percentage) required to sink a statement."
msgstr "Teiken block's relatiewe uitvoering frequency (as a persentasie) vereis na sink a stelling."

#: params.opt:1074
#, no-c-format
msgid "The number of cycles the swing modulo scheduler considers when checking conflicts using DFA."
msgstr "Die aantal cycles die swing modulo scheduler considers wanneer kontrolering bots gebruik DFA."

#: params.opt:1078
#, no-c-format
msgid "A threshold on the average loop count considered by the swing modulo scheduler."
msgstr "A drempel op die gemiddelde lus telling oorweeg deur die swing modulo scheduler."

#: params.opt:1082
#, no-c-format
msgid "A factor for tuning the upper bound that swing modulo scheduler uses for scheduling a loop."
msgstr "A faktor vir tuning die boonste gebonde wat swing modulo scheduler gebruik vir skedulering a lus."

#: params.opt:1086
#, no-c-format
msgid "The minimum value of stage count that swing modulo scheduler generates."
msgstr "Die minimum waarde van stage telling wat swing modulo scheduler generates."

#: params.opt:1090
#, no-c-format
msgid "Maximum size, in storage units, of an aggregate which should be considered for scalarization when compiling for size."
msgstr "Maksimum grootte, in berging units, van 'n aggregate wat moet wees oorweeg vir scalarization wanneer compiling vir grootte."

#: params.opt:1094
#, no-c-format
msgid "Maximum size, in storage units, of an aggregate which should be considered for scalarization when compiling for speed."
msgstr "Maksimum grootte, in berging units, van 'n aggregate wat moet wees oorweeg vir scalarization wanneer compiling vir speed."

#: params.opt:1098
#, no-c-format
msgid "Maximum number of artificial accesses to enable forward propagation that Scalar Replacement of Aggregates keeps for one local variable."
msgstr "Maksimum aantal artificial accesses na aktiveer forward propagation wat Skalaar Vervanging van Aggregates keeps vir one plaaslike veranderlike."

#: params.opt:1102
#, no-c-format
msgid "The maximum number of SSA_NAME assignments to follow in determining a value."
msgstr "Die maksimum aantal SSA_NAAM assignments na volg in determining a waarde."

#: params.opt:1106
#, no-c-format
msgid "The lower bound for a buffer to be considered for stack smashing protection."
msgstr "Die onderste gebonde vir a buffer na wees oorweeg vir stapel smashing protection."

#: params.opt:1110
#, no-c-format
msgid "Size of the stack guard expressed as a power of two in bytes."
msgstr "Grootte van die stapel wag expressed as a power van two in grepe."

#: params.opt:1114
#, no-c-format
msgid "Interval in which to probe the stack expressed as a power of two in bytes."
msgstr "Interval in wat na probe die stapel expressed as a power van two in grepe."

#: params.opt:1118
#, no-c-format
msgid "Allow the store merging pass to introduce unaligned stores if it is legal to do so."
msgstr "Laat toe die stoor merging gee deur na introduce unaligned stores as dit is legal na doen so."

#: params.opt:1122
#, no-c-format
msgid "Maximum size of a single store merging region in bytes."
msgstr "Maksimum grootte van a enkele stoor merging streek in grepe."

#: params.opt:1126
#, no-c-format
msgid "Maximum number of instruction distance that a small store forwarded to a larger load may stall. Value '0' disables the cost checks for the avoid-store-forwarding pass."
msgstr "Maksimum aantal instruksie distance wat a klein stoor forwarded na a larger laai mag stall. Waarde '0' disables die koste checks vir die avoid-store-forwarding gee deur."

#: params.opt:1130
#, no-c-format
msgid "The maximum ratio between array size and switch branches for a switch conversion to take place."
msgstr "Die maksimum verhouding tussen skikking grootte en skakelaar branches vir a skakelaar omskakeling na take place."

#: params.opt:1134
#, no-c-format
msgid "Maximum number of bases stored in each modref tree."
msgstr "Maksimum aantal bases gestoor in elke modref tree."

#: params.opt:1138
#, no-c-format
msgid "Maximum number of references stored in each modref base."
msgstr "Maksimum aantal references gestoor in elke modref basis."

#: params.opt:1142
#, no-c-format
msgid "Maximum number of accesses stored in each modref reference."
msgstr "Maksimum aantal accesses gestoor in elke modref verwysing."

#: params.opt:1146
#, no-c-format
msgid "Maximum number of tests performed by modref query."
msgstr "Maksimum aantal tests uitgevoer deur modref query."

#: params.opt:1150
#, no-c-format
msgid "Maximum depth of DFS walk used by modref escape analysis."
msgstr "Maksimum diepte van DFS walk gebruik deur modref escape analysis."

#: params.opt:1154
#, no-c-format
msgid "Maximum number of escape points tracked by modref per SSA-name."
msgstr "Maksimum aantal escape points tracked deur modref per SSA-name."

#: params.opt:1158
#, no-c-format
msgid "Maximum number of times a given range is adjusted during the dataflow."
msgstr "Maksimum aantal keer a gegee bestek is adjusted tydens die dataflow."

#: params.opt:1162
#, no-c-format
msgid "--param=threader-debug=[none|all] Enables verbose dumping of the threader solver."
msgstr "--param=threader-debug=[geen|alle] Enables verbose dumping van die threader solver."

#: params.opt:1175
#, no-c-format
msgid "Size in bytes after which thread-local aggregates should be instrumented with the logging functions instead of save/restore pairs."
msgstr "Grootte in grepe ná wat draad-lokaal aggregates moet wees instrumented met die logging funksies in plaas van bewaar/restore pairs."

#: params.opt:1179
#, no-c-format
msgid "The percentage of function, weighted by execution frequency, that must be covered by trace formation. Used when profile feedback is not available."
msgstr "Die persentasie van funksie, weighted deur uitvoering frequency, wat moet wees covered deur trace formation. Gebruik wanneer profiel feedback is nie beskikbaar nie."

#: params.opt:1183
#, no-c-format
msgid "The percentage of function, weighted by execution frequency, that must be covered by trace formation. Used when profile feedback is available."
msgstr "Die persentasie van funksie, weighted deur uitvoering frequency, wat moet wees covered deur trace formation. Gebruik wanneer profiel feedback is beskikbaar."

#: params.opt:1187
#, no-c-format
msgid "Maximal code growth caused by tail duplication (as a percentage)."
msgstr "Maximal kode groei caused deur stert duplication (as a persentasie)."

#: params.opt:1191
#, no-c-format
msgid "Stop forward growth if the probability of best edge is less than this threshold (as a percentage). Used when profile feedback is not available."
msgstr "Stop forward groei as die probability van beste edge is minder as hierdie drempel (as a persentasie). Gebruik wanneer profiel feedback is nie beskikbaar nie."

#: params.opt:1195
#, no-c-format
msgid "Stop forward growth if the probability of best edge is less than this threshold (as a percentage). Used when profile feedback is available."
msgstr "Stop forward groei as die probability van beste edge is minder as hierdie drempel (as a persentasie). Gebruik wanneer profiel feedback is beskikbaar."

#: params.opt:1199
#, no-c-format
msgid "Stop reverse growth if the reverse probability of best edge is less than this threshold (as a percentage)."
msgstr "Stop reverse groei as die reverse probability van beste edge is minder as hierdie drempel (as a persentasie)."

#: params.opt:1203
#, no-c-format
msgid "Set the maximum number of instructions executed in parallel in reassociated tree.  If 0, use the target-dependent heuristic."
msgstr "Stel die maksimum aantal instruksies uitgevoer in parallelle in reassociated tree. As 0, gebruik die target-dependent heuristic."

#: params.opt:1207
#, no-c-format
msgid "Emit special instrumentation for accesses to volatiles."
msgstr "Genereer special instrumentation vir accesses na volatiles."

#: params.opt:1211
#, no-c-format
msgid "Emit instrumentation calls to __tsan_func_entry() and __tsan_func_exit()."
msgstr "Genereer instrumentation oproepe na __tsan_func_inskrywing() en __tsan_func_verlaat()."

#: params.opt:1215
#, no-c-format
msgid "Maximum number of nested calls to search for control dependencies during uninitialized variable analysis."
msgstr "Maksimum aantal geneste oproepe na soek vir beheer dependencies tydens ongeïnisialiseerde veranderlike analysis."

#: params.opt:1219
#, no-c-format
msgid "Maximum number of predicates anded for each predicate ored in the normalized predicate chain."
msgstr "Maksimum aantal predicates anded vir elke predikaat ored in die genormaliseer predikaat chain."

#: params.opt:1224
#, no-c-format
msgid "Maximum number of predicates ored in the normalized predicate chain."
msgstr "Maksimum aantal predicates ored in die genormaliseer predikaat chain."

#: params.opt:1228
#, no-c-format
msgid "Maximum amount of work done to prune paths where the variable is always initialized."
msgstr "Maksimum hoeveelheid van work done na prune paaie waar die veranderlike is altyd geïnisialiseer."

#: params.opt:1232
#, no-c-format
msgid "Instruction accounted for function prologue, epilogue and other overhead."
msgstr "Instruksie accounted vir funksie prologue, epilogue en ander overhead."

#: params.opt:1236
#, no-c-format
msgid "Time accounted for function prologue, epilogue and other overhead."
msgstr "Tyd accounted vir funksie prologue, epilogue en ander overhead."

#: params.opt:1240
#, no-c-format
msgid "Instruction accounted for function thunk overhead."
msgstr "Instruksie accounted vir funksie thunk overhead."

#: params.opt:1244
#, no-c-format
msgid "Time accounted for function thunk overhead."
msgstr "Tyd accounted vir funksie thunk overhead."

#: params.opt:1248
#, no-c-format
msgid "The denominator n of fraction 1/n of the number of profiled runs of the entire program below which the execution count of a basic block must be in order for the basic block to be considered unlikely."
msgstr "Die denominator n van fraction 1/n van die aantal profiled runs van die entire program hieronder wat die uitvoering telling van a basic blok moet wees in volgorde vir die basic blok na wees oorweeg unlikely."

#: params.opt:1252
#, no-c-format
msgid "Maximum unroll factor for the unroll-and-jam transformation."
msgstr "Maksimum rol uit faktor vir die unroll-and-jam transformation."

#: params.opt:1256
#, no-c-format
msgid "Minimum percentage of memrefs that must go away for unroll-and-jam to be considered profitable."
msgstr "Minimum persentasie van memrefs wat moet Go away vir unroll-and-jam na wees oorweeg profitable."

#: params.opt:1260
#, no-c-format
msgid "Use direct poisoning/unpoisoning instructions for variables smaller or equal to this number."
msgstr "Gebruik direkte poisoning/unpoisoning instruksies vir veranderlikes smaller of gelyk aan hierdie getal."

#: params.opt:1264
#, no-c-format
msgid "Whether to use canonical types."
msgstr "Of na gebruik kanonieke tipes."

#: params.opt:1268
#, no-c-format
msgid "Enable loop epilogue vectorization using smaller vector size."
msgstr "Aktiveer lus epilogue vektorisering gebruik smaller vektor grootte."

#: params.opt:1272
#, no-c-format
msgid "Maximum number of possible vector layouts (such as permutations) to consider when optimizing to-be-vectorized code."
msgstr "Maksimum aantal moontlike vektor layouts (sulke as permutations) na oorweeg wanneer optimizing to-be-vectorized kode."

#: params.opt:1276
#, no-c-format
msgid "Maximum number of loop peels to enhance alignment of data references in a loop."
msgstr "Maksimum aantal lus peels na enhance belyning van data references in a lus."

#: params.opt:1280
#, no-c-format
msgid "Bound on number of runtime checks inserted by the vectorizer's loop versioning for alias check."
msgstr "Gebonde op aantal looptyd checks ingevoeg deur die vectorizer's lus versioning vir alias kontroleer."

#: params.opt:1284
#, no-c-format
msgid "Bound on number of runtime checks inserted by the vectorizer's loop versioning for alignment check."
msgstr "Gebonde op aantal looptyd checks ingevoeg deur die vectorizer's lus versioning vir belyning kontroleer."

#: params.opt:1288
#, no-c-format
msgid "Controls how loop vectorizer uses partial vectors.  0 means never, 1 means only for loops whose need to iterate can be removed, 2 means for all loops.  The default value is 2."
msgstr "Controls how lus vectorizer gebruik gedeeltelike vectors. 0 means nooit, 1 means slegs vir lusse wie se hoef na iterate kan wees verwyder, 2 means vir alle lusse. Die verstek waarde is 2."

#: params.opt:1292
#, no-c-format
msgid "The maximum factor which the loop vectorizer applies to the cost of statements in an inner loop relative to the loop being vectorized."
msgstr "Die maksimum faktor wat die lus vectorizer applies na die koste van stellings in 'n binneste lus relatiewe na die lus besig om te gevektoriseer."

#: params.opt:1296
#, no-c-format
msgid "Enable loop vectorization of floating point inductions."
msgstr "Aktiveer lus vektorisering van dryfpunt inductions."

#: params.opt:1300
#, no-c-format
msgid "Enable vectorization of loops that may not be profitable according to the cost model but still perform costing between vector modes."
msgstr "Aktiveer vektorisering van lusse wat mag nie wees profitable according na die koste model maar steeds voer uit costing tussen vektor modes nie."

#: params.opt:1304
#, no-c-format
msgid "Maximum number of basic blocks before VRP switches to a fast model with less memory requirements."
msgstr "Maksimum aantal basic blokke voor VRP switches na a fast model met less geheue requirements."

#: params.opt:1308
#, no-c-format
msgid "Maximum number of steps when inferring a value range from a load from a constant aggregate."
msgstr "Maksimum aantal steps wanneer inferring a waarde bestek van a laai van a konstant aggregate."

#: params.opt:1312
#, no-c-format
msgid "Maximum number of basic blocks before VRP uses a sparse bitmap cache."
msgstr "Maksimum aantal basic blokke voor VRP gebruik a sparse bitmap kas."

#: params.opt:1316
#, no-c-format
msgid "Maximum number of outgoing edges in a switch before VRP does not process it."
msgstr "Maksimum aantal outgoing edges in a skakelaar voor VRP doen nie process dit nie."

#: params.opt:1320
#, no-c-format
msgid "Maximum number of basic blocks for VRP to use a basic cache vector."
msgstr "Maksimum aantal basic blokke vir VRP na gebruik a basic kas vektor."

#: analyzer/analyzer.opt:27
#, no-c-format
msgid "The maximum number of 'after supernode' exploded nodes within the analyzer per supernode, before terminating analysis."
msgstr "Die maksimum aantal 'after supernode' exploded nodes binne die analyzer per supernode, voor terminating analysis."

#: analyzer/analyzer.opt:31
#, no-c-format
msgid "The maximum number of exploded nodes per program point within the analyzer, before terminating analysis of that point."
msgstr "Die maksimum aantal exploded nodes per program punt binne die analyzer, voor terminating analysis van wat punt."

#: analyzer/analyzer.opt:35
#, no-c-format
msgid "The maximum number of constraints per state."
msgstr "Die maksimum aantal constraints per state."

#: analyzer/analyzer.opt:39
#, no-c-format
msgid "The maximum number of infeasible edges to reject before declaring a diagnostic as infeasible."
msgstr "Die maksimum aantal infeasible edges na verwerp voor declaring a diagnostic as infeasible."

#: analyzer/analyzer.opt:43
#, no-c-format
msgid "The maximum number of times a callsite can appear in a call stack within the analyzer, before terminating analysis of a call that would recurse deeper."
msgstr "Die maksimum aantal keer a callsite kan appear in a oproep stapel binne die analyzer, voor terminating analysis van a oproep wat sou recurse deeper."

#: analyzer/analyzer.opt:47
#, no-c-format
msgid "The maximum depth of a symbolic value, before approximating the value as unknown."
msgstr "Die maksimum diepte van a simboliese waarde, voor approximating die waarde as onbekende."

#: analyzer/analyzer.opt:51
#, no-c-format
msgid "The minimum number of supernodes within a function for the analyzer to consider summarizing its effects at call sites."
msgstr "Die minimum aantal supernodes binne a funksie vir die analyzer na oorweeg summarizing sy effekte by oproep sites."

#: analyzer/analyzer.opt:55
#, no-c-format
msgid "The maximum depth of exploded nodes that should appear in a dot dump before switching to a less verbose format."
msgstr "Die maksimum diepte van exploded nodes wat moet appear in a dot stort voor switching na a less verbose formaat."

#: analyzer/analyzer.opt:59
#, no-c-format
msgid "The number of bytes at which to ellipsize string literals in analyzer text art diagrams."
msgstr "Die aantal grepe by wat na ellipsize string literals in analyzer teks art diagrams."

#: analyzer/analyzer.opt:63
#, no-c-format
msgid "The number of literal bytes to show at the head of a string literal in text art when ellipsizing it."
msgstr "Die aantal letterlik grepe na show by die head van a stringletterlik in teks art wanneer ellipsizing dit."

#: analyzer/analyzer.opt:67
#, no-c-format
msgid "The number of literal bytes to show at the tail of a string literal in text art when ellipsizing it."
msgstr "Die aantal letterlik grepe na show by die stert van a stringletterlik in teks art wanneer ellipsizing dit."

#: analyzer/analyzer.opt:71
#, no-c-format
msgid "The ideal width in characters of text art diagrams generated by the analyzer."
msgstr "Die ideal breedte in karakters van teks art diagrams gegenereer deur die analyzer."

#: analyzer/analyzer.opt:75
#, no-c-format
msgid "Warn about code paths in which a pointer to a buffer is assigned to an incompatible type."
msgstr "waarsku oor kode paaie in wat a wyser na a buffer is assigned na 'n onversoenbaar tipe."

#: analyzer/analyzer.opt:79
#, no-c-format
msgid "Warn about code paths in which a pointer is checked for NULL after it has already been dereferenced."
msgstr "waarsku oor kode paaie in wat a wyser is checked vir NULL ná dit het reeds gewees dereferenced."

#: analyzer/analyzer.opt:83
#, no-c-format
msgid "Warn about code paths in which a stdio FILE can be closed more than once."
msgstr "waarsku oor kode paaie in wat a stdio LÊER kan wees toegemaak meer as een keer."

#: analyzer/analyzer.opt:87
#, no-c-format
msgid "Warn about code paths in which a pointer can be freed more than once."
msgstr "waarsku oor kode paaie in wat a wyser kan wees vrygestel meer as een keer."

#: analyzer/analyzer.opt:91
#, no-c-format
msgid "Warn about code paths in which sensitive data is written to a file."
msgstr "waarsku oor kode paaie in wat sensitive data is written na a lêer."

#: analyzer/analyzer.opt:95
#, no-c-format
msgid "Warn about code paths in which sensitive data is copied across a security boundary."
msgstr "waarsku oor kode paaie in wat sensitive data is copied oor a security boundary."

#: analyzer/analyzer.opt:99
#, no-c-format
msgid "Warn about code paths in which read on a write-only file descriptor is attempted, or vice versa."
msgstr "waarsku oor kode paaie in wat lees op a write-only lêer beskrywer is attempted, of vice versa."

#: analyzer/analyzer.opt:103
#, no-c-format
msgid "Warn about code paths in which a file descriptor can be closed more than once."
msgstr "waarsku oor kode paaie in wat a lêer beskrywer kan wees toegemaak meer as een keer."

#: analyzer/analyzer.opt:107
#, no-c-format
msgid "Warn about code paths in which a file descriptor is not closed."
msgstr "waarsku oor kode paaie in wat a lêer beskrywer is nie toegemaak nie."

#: analyzer/analyzer.opt:111
#, no-c-format
msgid "Warn about code paths in which an operation is attempted in the wrong phase of a file descriptor's lifetime."
msgstr "waarsku oor kode paaie in wat 'n bewerking is attempted in die verkeerde phase van a lêer descriptor's lewensduur."

#: analyzer/analyzer.opt:115
#, no-c-format
msgid "Warn about code paths in which an operation is attempted on the wrong type of file descriptor."
msgstr "waarsku oor kode paaie in wat 'n bewerking is attempted op die verkeerde tipe van lêer beskrywer."

#: analyzer/analyzer.opt:119
#, no-c-format
msgid "Warn about code paths in which a read or write is performed on a closed file descriptor."
msgstr "waarsku oor kode paaie in wat a lees of skryf is uitgevoer op a toegemaak lêer beskrywer."

#: analyzer/analyzer.opt:123
#, no-c-format
msgid "Warn about code paths in which a file descriptor is used without being checked for validity."
msgstr "waarsku oor kode paaie in wat a lêer beskrywer is gebruik sonder besig om te checked vir validity."

#: analyzer/analyzer.opt:127
#, no-c-format
msgid "Warn about code paths in which a stdio FILE is not closed."
msgstr "waarsku oor kode paaie in wat a stdio LÊER is nie toegemaak nie."

#: analyzer/analyzer.opt:131
#, no-c-format
msgid "Warn about code paths in which a non-heap pointer is freed."
msgstr "waarsku oor kode paaie in wat a non-heap wyser is vrygestel."

#: analyzer/analyzer.opt:135
#, no-c-format
msgid "Warn about code paths in which floating-point arithmetic is used in locations where precise computation is needed."
msgstr "waarsku oor kode paaie in wat dryfpunt rekenkundige is gebruik in locations waar precise computation is benodig."

#: analyzer/analyzer.opt:139
#, no-c-format
msgid "Warn about code paths which appear to lead to an infinite loop."
msgstr "waarsku oor kode paaie wat appear na lead na 'n oneindige lus."

#: analyzer/analyzer.opt:143
#, no-c-format
msgid "Warn about code paths which appear to lead to infinite recursion."
msgstr "waarsku oor kode paaie wat appear na lead na oneindige rekursie."

#: analyzer/analyzer.opt:147
#, no-c-format
msgid "Warn about code paths in which a NULL function pointer is called."
msgstr "waarsku oor kode paaie in wat a NULL funksie wyser is opgeroep."

#: analyzer/analyzer.opt:151
#, no-c-format
msgid "Warn about code paths in which a heap-allocated pointer leaks."
msgstr "waarsku oor kode paaie in wat a heap-allocated wyser leaks."

#: analyzer/analyzer.opt:155
#, no-c-format
msgid "Warn about code paths in which the wrong deallocation function is called."
msgstr "waarsku oor kode paaie in wat die verkeerde vrystelling funksie is opgeroep."

#: analyzer/analyzer.opt:159
#, no-c-format
msgid "Warn about code paths in which a write or read to a buffer is out-of-bounds."
msgstr "waarsku oor kode paaie in wat a skryf of lees na a buffer is out-of-bounds."

#: analyzer/analyzer.opt:163
#, no-c-format
msgid "Warn about code paths in which undefined behavior would occur due to overlapping buffers."
msgstr "waarsku oor kode paaie in wat ongedefinieerde gedrag sou occur due na overlapping buffers."

#: analyzer/analyzer.opt:167
#, no-c-format
msgid "Warn about code paths in which a possibly-NULL value is passed to a must-not-be-NULL function argument."
msgstr "waarsku oor kode paaie in wat a possibly-NULL waarde is deurgegee na a must-not-be-NULL funksie argument."

#: analyzer/analyzer.opt:171
#, no-c-format
msgid "Warn about code paths in which a possibly-NULL pointer is dereferenced."
msgstr "waarsku oor kode paaie in wat a possibly-nullwyser is dereferenced."

#: analyzer/analyzer.opt:175
#, no-c-format
msgid "Warn about code paths in which an async-signal-unsafe function is called from a signal handler."
msgstr "waarsku oor kode paaie in wat 'n async-signal-unsafe funksie is opgeroep van a sein hanteerder."

#: analyzer/analyzer.opt:179
#, no-c-format
msgid "Warn about code paths in which NULL is passed to a must-not-be-NULL function argument."
msgstr "waarsku oor kode paaie in wat NULL is deurgegee na a must-not-be-NULL funksie argument."

#: analyzer/analyzer.opt:183
#, no-c-format
msgid "Warn about code paths in which a NULL pointer is dereferenced."
msgstr "waarsku oor kode paaie in wat a nullwyser is dereferenced."

#: analyzer/analyzer.opt:187
#, no-c-format
msgid "Warn about code paths in which an on-stack buffer is passed to putenv."
msgstr "waarsku oor kode paaie in wat 'n on-stack buffer is deurgegee na putenv."

#: analyzer/analyzer.opt:191
#, no-c-format
msgid "Warn about code paths in which a shift with negative count is attempted."
msgstr "waarsku oor kode paaie in wat a verskuiwing met negatiewe telling is attempted."

#: analyzer/analyzer.opt:195
#, no-c-format
msgid "Warn about code paths in which a shift with count >= width of type is attempted."
msgstr "waarsku oor kode paaie in wat a verskuiwing met telling >= breedte van tipe is attempted."

#: analyzer/analyzer.opt:199
#, no-c-format
msgid "Warn about code paths in which a longjmp rewinds to a jmp_buf saved in a stack frame that has returned."
msgstr "waarsku oor kode paaie in wat a longjmp rewinds na a jmp_buf saved in a stapel raam wat het teruggegee."

#: analyzer/analyzer.opt:203
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as an allocation size."
msgstr "waarsku oor kode paaie in wat 'n unsanitized waarde is gebruik as 'n toewysing grootte."

#: analyzer/analyzer.opt:207
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as an array index."
msgstr "waarsku oor kode paaie in wat 'n unsanitized waarde is gebruik as 'n skikking indeks."

#: analyzer/analyzer.opt:211
#, no-c-format
msgid "Warn about code paths in which an 'assert()' is made involving an unsanitized value."
msgstr "waarsku oor kode paaie in wat 'n 'assert()' is made involving 'n unsanitized waarde."

#: analyzer/analyzer.opt:215
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as a divisor."
msgstr "waarsku oor kode paaie in wat 'n unsanitized waarde is gebruik as a divisor."

#: analyzer/analyzer.opt:219
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as a pointer offset."
msgstr "waarsku oor kode paaie in wat 'n unsanitized waarde is gebruik as a wyser verplasing."

#: analyzer/analyzer.opt:223
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as a size."
msgstr "waarsku oor kode paaie in wat 'n unsanitized waarde is gebruik as a grootte."

#: analyzer/analyzer.opt:227
#, no-c-format
msgid "Warn about code paths in which an exception of unexpected type is thrown."
msgstr "waarsku oor kode paaie in wat 'n uitsondering van onverwagte tipe is thrown."

#: analyzer/analyzer.opt:231
#, no-c-format
msgid "Warn about code paths in which pointer subtraction involves undefined behavior."
msgstr "waarsku oor kode paaie in wat wyser subtraction involves ongedefinieerde gedrag."

#: analyzer/analyzer.opt:235
#, no-c-format
msgid "Warn about code paths in which a call is made to strtok with undefined behavior."
msgstr "waarsku oor kode paaie in wat a oproep is made na strtok met ongedefinieerde gedrag."

#: analyzer/analyzer.opt:239
#, no-c-format
msgid "Warn about code paths in which a freed value is used."
msgstr "waarsku oor kode paaie in wat a vrygestel waarde is gebruik."

#: analyzer/analyzer.opt:243
#, no-c-format
msgid "Warn about code paths in which a pointer to a stale stack frame is used."
msgstr "waarsku oor kode paaie in wat a wyser na a stale stapel raam is gebruik."

#: analyzer/analyzer.opt:247
#, no-c-format
msgid "Warn about code paths in which va_arg uses the wrong type."
msgstr "waarsku oor kode paaie in wat va_arg gebruik die verkeerde tipe."

#: analyzer/analyzer.opt:251
#, no-c-format
msgid "Warn about code paths in which va_arg is used too many times on a va_list."
msgstr "waarsku oor kode paaie in wat va_arg is gebruik te veel keer op a va_lys."

#: analyzer/analyzer.opt:255
#, no-c-format
msgid "Warn about code paths in which va_start or va_copy is used without a corresponding va_end."
msgstr "waarsku oor kode paaie in wat va_begin of va_kopie is gebruik sonder a ooreenstemmende va_einde."

#: analyzer/analyzer.opt:259
#, no-c-format
msgid "Warn about code paths in which a va_list is used after va_end."
msgstr "waarsku oor kode paaie in wat a va_lys is gebruik ná va_einde."

#: analyzer/analyzer.opt:263
#, no-c-format
msgid "Warn about code paths which attempt to write to a const object."
msgstr "waarsku oor kode paaie wat attempt na skryf na a const objek."

#: analyzer/analyzer.opt:267
#, no-c-format
msgid "Warn about code paths which attempt to write to a string literal."
msgstr "waarsku oor kode paaie wat attempt na skryf na a stringletterlik."

#: analyzer/analyzer.opt:271
#, no-c-format
msgid "Warn about code paths in which an uninitialized value is used."
msgstr "waarsku oor kode paaie in wat 'n ongeïnisialiseerde waarde is gebruik."

#: analyzer/analyzer.opt:275
#, no-c-format
msgid "Warn if expressions are too complicated for the analyzer to fully track."
msgstr "waarsku as expressions is te complicated vir die analyzer na ten volle track."

#: analyzer/analyzer.opt:279
#, no-c-format
msgid "Warn if the code is too complicated for the analyzer to fully explore."
msgstr "waarsku as die kode is te complicated vir die analyzer na ten volle explore."

#: analyzer/analyzer.opt:283
#, no-c-format
msgid "Assume that no function calls can throw exceptions."
msgstr "Neem aan wat geen funksie oproepe kan gooi uitsonderings."

#: analyzer/analyzer.opt:287
#, no-c-format
msgid "Restrict the analyzer to run just the named checker."
msgstr "Restrict die analyzer na run net die benoemde checker."

#: analyzer/analyzer.opt:291
#, no-c-format
msgid "Add extra annotations to diagrams."
msgstr "Voeg by ekstra annotations na diagrams."

#: analyzer/analyzer.opt:299
#, no-c-format
msgid "Verify that paths are feasible when emitting diagnostics."
msgstr "Verify wat paaie is feasible wanneer emitting diagnostics."

#: analyzer/analyzer.opt:303
#, no-c-format
msgid "Issue a note when diagnostics are deduplicated."
msgstr "Issue a nota wanneer diagnostics is deduplicated."

#: analyzer/analyzer.opt:307
#, no-c-format
msgid "Simplify the supergraph before analyzing it."
msgstr "Vereenvoudig die supergraph voor analyzing dit."

#: analyzer/analyzer.opt:311
#, no-c-format
msgid "Purge unneeded state during analysis."
msgstr "Purge unneeded state tydens analysis."

#: analyzer/analyzer.opt:315
#, no-c-format
msgid "Merge similar-enough states during analysis."
msgstr "Saamvoeg similar-enough states tydens analysis."

#: analyzer/analyzer.opt:319
#, no-c-format
msgid "Stop exploring an execution path after certain diagnostics."
msgstr "Stop exploring 'n uitvoering pad ná certain diagnostics."

#: analyzer/analyzer.opt:323
#, no-c-format
msgid "Enable transitivity of constraints during analysis."
msgstr "Aktiveer transitivity van constraints tydens analysis."

#: analyzer/analyzer.opt:327
#, no-c-format
msgid "Show events within system headers in analyzer execution paths."
msgstr "Show events binne stelsel headers in analyzer uitvoering paaie."

#: analyzer/analyzer.opt:331
#, no-c-format
msgid "Approximate the effect of function calls to simplify analysis."
msgstr "Approximate die effek van funksie oproepe na vereenvoudig analysis."

#: analyzer/analyzer.opt:335
#, no-c-format
msgid "Try to reconstruct function calls and returns after inlining."
msgstr "Probeer na reconstruct funksie oproepe en returns ná inlining."

#: analyzer/analyzer.opt:339
#, no-c-format
msgid "Emit more verbose descriptions of control flow in diagnostics."
msgstr "Genereer more verbose descriptions van beheer flow in diagnostics."

#: analyzer/analyzer.opt:343
#, no-c-format
msgid "Emit more verbose descriptions of state changes in diagnostics."
msgstr "Genereer more verbose descriptions van state changes in diagnostics."

#: analyzer/analyzer.opt:347
#, no-c-format
msgid "Control which events are displayed in diagnostic paths."
msgstr "Beheer wat events is displayed in diagnostic paaie."

#: analyzer/analyzer.opt:351
#, no-c-format
