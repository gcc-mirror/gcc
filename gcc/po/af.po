#, no-c-format
msgid "Warn if a comparison always evaluates to true or false."
msgstr "waarsku as a vergelyking altyd evaluates na waar of onwaar."

#: common.opt:837
#, no-c-format
msgid "Warn whenever a trampoline is generated."
msgstr "Waarsku whenever a trampoline is gegenereer."

#: common.opt:841
#, no-c-format
msgid "Warn about cases where -ftrivial-auto-var-init cannot initialize an auto variable."
msgstr "waarsku oor cases waar -ftrivial-auto-var-init kan nie inisialiseer 'n outomaties veranderlike nie."

#: common.opt:845
#, no-c-format
msgid "Warn if a comparison is always true or always false due to the limited range of the data type."
msgstr "waarsku as a vergelyking is altyd waar of altyd onwaar due na die limited bestek van die datatipe."

#: common.opt:849
#, no-c-format
msgid "Warn about uninitialized automatic variables."
msgstr "waarsku oor ongeïnisialiseerde outomatiese veranderlikes."

#: common.opt:853
#, no-c-format
msgid "Warn about maybe uninitialized automatic variables."
msgstr "waarsku oor dalk ongeïnisialiseerde outomatiese veranderlikes."

