msgstr "Norādīt OS atbalsta bibliotēku, ko ielādēt pēc libc."

#: config/picolibc.opt:33
#, no-c-format
msgid "Specify an alternate startup file."
msgstr "Norādīt alternatīvu starta failu."

#: config/picolibc.opt:40
#, no-c-format
