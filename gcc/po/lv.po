#: config/rx/rx.opt:139
#, no-c-format
msgid "Enables or disables the use of the SMOVF, SMOVB, SMOVU, SUNTIL, SWHILE and RMPA instructions.  Enabled by default."
msgstr "Iespējo vai atspējo SMOVF, SMOVB, SMOVU, SUNTIL, SWHILE un RMPA instrukciju izmantošanu. Pēc noklusējuma iespējots."

#: config/rx/rx.opt:145
#, no-c-format
msgid "Always use JSR, never BSR, for calls."
msgstr "Izsaukumiem vienmēr izmantot JSR, nekad BSR."

#: m2/lang.opt:35
#, no-c-format
msgid "Case statement label compile time checking when using an expression of an enum type."
msgstr "case priekšraksta etiķešu pārbaude kompilēšanas laikā, ja tiek izmantota enum tipa izteiksme."

#: m2/lang.opt:39
#, no-c-format
msgid "Check definition module procedure parameter names match their implementation module counterpart."
msgstr "Pārbaudīt, vai definīciju moduļa procedūru parametru nosaukumi atbilst attiecīgajiem implementācijas moduļa nosaukumiem."

#: m2/lang.opt:43
#, no-c-format
msgid "Warn if a cast is being used on types of differing sizes."
msgstr "Brīdināt, ja tipu pārveidošana tiek lietota dažāda izmēra tipiem."

#: m2/lang.opt:47
#, no-c-format
msgid "Inform user which parameters will be passed by reference."
msgstr "Informēt lietotāju, kuri parametri tiks nodoti ar atsauci."

#: m2/lang.opt:51
#, no-c-format
msgid "Semantic checking to catch poor programming style."
msgstr "Semantiskā pārbaude slikta programmēšanas stila konstatēšanai."

#: m2/lang.opt:55
#, no-c-format
msgid "Compile time analysis in the first basic block of a procedure detecting access to uninitialized data."
msgstr "Kompilēšanas laika analīze procedūras pirmajā pamatblokā, kas konstatē piekļuvi neinicializētiem datiem."

#: m2/lang.opt:59
#, no-c-format
msgid "Compile time analysis to detect access to uninitialized variables, the checking can be specified by: known,cond,all."
msgstr "Kompilēšanas laika analīze piekļuves neinicializētiem mainīgajiem konstatēšanai; pārbaudi var norādīt ar: known,cond,all."

#: m2/lang.opt:63
#, no-c-format
msgid "Automatically initializes all pointers to NIL."
msgstr "Automātiski inicializē visus rādītājus ar NIL."

#: m2/lang.opt:67
#, no-c-format
msgid "Runtime subrange, array index and indirection via NIL pointer checking."
msgstr "Izpildlaika apakšdiapazona, masīva indeksa un NIL rādītāja netiešās adresācijas pārbaude."

#: m2/lang.opt:71
#, no-c-format
msgid "Runtime checking to check whether a CASE statement requires an ELSE clause when one was not specified."
msgstr "Izpildlaika pārbaude, vai CASE priekšrakstam ir nepieciešama ELSE klauzula, ja tā nav norādīta."

#: m2/lang.opt:75
#, no-c-format
msgid "Preprocess the module using cpp."
msgstr "Priekšapstrādāt moduli ar cpp."

#: m2/lang.opt:79 m2/lang.opt:83
#, no-c-format
msgid "Passed to the preprocessor if -fcpp is used (internal switch)."
msgstr "Tiek nodots priekšprocesoram, ja izmanto -fcpp (iekšējs slēdzis)."

#: m2/lang.opt:87
#, no-c-format
msgid "Call a real function, rather than the builtin equivalent."
msgstr "Izsaukt reālu funkciju, nevis iebūvēto ekvivalentu."

#: m2/lang.opt:91
#, no-c-format
msgid "Internal debugging of the compiler (internal switch)."
msgstr "Kompilatora iekšējā atkļūdošana (iekšējs slēdzis)."

#: m2/lang.opt:95
#, no-c-format
msgid "Trace procedure line numbers (internal switch)."
msgstr "Procedūru rindu numuru izsekošana (iekšējs slēdzis)."

#: m2/lang.opt:99
#, no-c-format
msgid "Recognize the specified suffix as a definition module filename."
msgstr "Atpazīt norādīto piedēkli kā definīciju moduļa faila nosaukumu."

#: m2/lang.opt:103
#, no-c-format
msgid "Display all inbuilt system items."
msgstr "Parādīt visus iebūvētos sistēmas elementus."

#: m2/lang.opt:107
#, no-c-format
msgid "Allows opaque types to be implemented as any type (a GNU Modula-2 extension)."
msgstr "Ļauj necaurspīdīgos tipus ieviest kā jebkuru tipu (GNU Modula-2 paplašinājums)."

#: m2/lang.opt:111
#, no-c-format
msgid "Runtime checking to check whether a floating point number will exceed range."
msgstr "Izpildlaika pārbaude, vai peldošā komata skaitlis pārsniegs diapazonu."

#: m2/lang.opt:115
#, no-c-format
msgid "Create a topologically sorted module list from all dependent modules used in the application."
msgstr "Izveidot topoloģiski sakārtotu moduļu sarakstu no visiem lietojumprogrammā izmantotajiem atkarīgajiem moduļiem."

#: m2/lang.opt:119
#, no-c-format
msgid "Range checking for numerical values."
msgstr "Skaitlisko vērtību diapazona pārbaude."

#: m2/lang.opt:123
#, no-c-format
msgid "ISO dialect of Modula-2."
msgstr "Modula-2 ISO dialekts."

#: m2/lang.opt:127
#, no-c-format
msgid "Specify the library order, the libraries may be specified by a comma separated abbreviation: log,min,pim,iso or by directory names: m2log,m2min,m2pim,m2iso."
msgstr "Norādīt bibliotēku secību; bibliotēkas var norādīt ar komatiem atdalītiem saīsinājumiem: log,min,pim,iso vai ar direktoriju nosaukumiem: m2log,m2min,m2pim,m2iso."

#: m2/lang.opt:131
#, no-c-format
msgid "Set all location values to a specific value (internal switch)."
msgstr "Iestatīt visas atrašanās vietas vērtības uz konkrētu vērtību (iekšējs slēdzis)."

#: m2/lang.opt:135
#, no-c-format
msgid "Internal debug tracing for quad,token,line,all (internal switch)."
msgstr "Iekšējā atkļūdošanas izsekošana quad,token,line,all (iekšējs slēdzis)."

#: m2/lang.opt:139
#, no-c-format
msgid "Dump Modula-2 internal intemediate representation specified by: all,quad,decl,gimple."
msgstr "Izmest Modula-2 iekšējo starpreprezentāciju, kas norādīta ar: all,quad,decl,gimple."

#: m2/lang.opt:143
#, no-c-format
msgid "Dump Modula-2 decls to the filename stem specified."
msgstr "Izmest Modula-2 deklarācijas failos ar norādīto nosaukuma pamatu."

#: m2/lang.opt:147
#, no-c-format
msgid "Dump Modula-2 gimple to the filename stem specified."
msgstr "Izmest Modula-2 gimple failos ar norādīto nosaukuma pamatu."

#: m2/lang.opt:151
#, no-c-format
msgid "Dump Modula-2 quads to the filename stem specified."
msgstr "Izmest Modula-2 quad ierakstus failos ar norādīto nosaukuma pamatu."

#: m2/lang.opt:155
#, no-c-format
msgid "Filter the language dump using a comma separated list of procedures and modules."
msgstr "Filtrēt valodas izmeti, izmantojot ar komatiem atdalītu procedūru un moduļu sarakstu."

#: m2/lang.opt:159
#, no-c-format
msgid "Override the default 64 bit definition of SYSTEM.COFF_T with the argument specified."
msgstr "Pārrakstīt noklusējuma 64 bitu SYSTEM.COFF_T definīciju ar norādīto argumentu."

#: m2/lang.opt:163
#, no-c-format
msgid "Generate extra nops to improve debugging, producing an instruction for every code related keyword."
msgstr "Ģenerēt papildu nop instrukcijas atkļūdošanas uzlabošanai, izveidojot instrukciju katram ar kodu saistītam atslēgvārdam."

#: m2/lang.opt:167
#, no-c-format
msgid "Generate error messages which render keywords in lower case."
msgstr "Ģenerēt kļūdas ziņojumus, kuros atslēgvārdi tiek atveidoti ar mazajiem burtiem."

#: m2/lang.opt:171
#, no-c-format
msgid "Specify the module mangled prefix name for all modules in the following include paths."
msgstr "Norādīt moduļa sagrozīto (mangled) priedēkļa nosaukumu visiem moduļiem nākamajos iekļaušanas ceļos."

#: m2/lang.opt:179
#, no-c-format
msgid "Add include paths for all the library names in -flibs= to this directory root."
msgstr "Pievienot šai direktorijas saknei iekļaušanas ceļus visiem -flibs= norādītajiem bibliotēku nosaukumiem."

#: m2/lang.opt:187
#, no-c-format
msgid "Insert plugin to identify runtime errors at compiletime."
msgstr "Ievietot spraudni izpildlaika kļūdu identificēšanai kompilēšanas laikā."

#: m2/lang.opt:191
#, no-c-format
msgid "Specify the module mangled prefix name."
msgstr "Norādīt moduļa sagrozīto (mangled) priedēkļa nosaukumu."

#: m2/lang.opt:195
#, no-c-format
msgid "Display statistics about the amount of source lines compiled and symbols used."
msgstr "Parādīt statistiku par kompilēto pirmkoda rindu un izmantoto simbolu skaitu."

#: m2/lang.opt:199
#, no-c-format
msgid "Experimental flag to turn on the new strict type checker."
msgstr "Eksperimentāls karogs jaunā stingrā tipu pārbaudītāja ieslēgšanai."

#: m2/lang.opt:203
#, no-c-format
msgid "Provides more detail why the types are incompatible."
msgstr "Sniedz sīkāku informāciju, kāpēc tipi ir nesaderīgi."

#: m2/lang.opt:207
#, no-c-format
msgid "Compile all implementation modules and program module at once."
msgstr "Kompilēt visus implementācijas moduļus un programmas moduli uzreiz."

#: m2/lang.opt:215
#, no-c-format
msgid "Recognize the specified suffix as implementation and module filenames."
msgstr "Atpazīt norādīto piedēkli kā implementācijas un moduļu failu nosaukumu."

#: m2/lang.opt:219
#, no-c-format
msgid "Runtime checking to detect accessing data through a NIL value pointer."
msgstr "Izpildlaika pārbaude piekļuves datiem caur NIL vērtības rādītāju konstatēšanai."

#: m2/lang.opt:223
#, no-c-format
msgid "PIM [234] dialect of Modula-2."
msgstr "Modula-2 PIM [234] dialekts."

#: m2/lang.opt:227
#, no-c-format
msgid "PIM 2 dialect of Modula-2."
msgstr "Modula-2 PIM 2 dialekts."

#: m2/lang.opt:231
#, no-c-format
msgid "PIM 3 dialect of Modula-2."
msgstr "Modula-2 PIM 3 dialekts."

#: m2/lang.opt:235
#, no-c-format
msgid "PIM 4 dialect of Modula-2."
msgstr "Modula-2 PIM 4 dialekts."

#: m2/lang.opt:239
#, no-c-format
msgid "Force positive result from MOD and DIV result floor."
msgstr "Piespiest pozitīvu rezultātu no MOD un DIV rezultāta noapaļošanas uz leju (floor)."

#: m2/lang.opt:243
#, no-c-format
msgid "Link against the pthread library (default on)."
msgstr "Saistīt ar pthread bibliotēku (pēc noklusējuma ieslēgts)."

#: m2/lang.opt:247
#, no-c-format
msgid "Internal compiler debugging information, dump the list of quadruples."
msgstr "Kompilatora iekšējā atkļūdošanas informācija, četrinieku (quadruples) saraksta izmešana."

#: m2/lang.opt:251
#, no-c-format
msgid "Runtime range checking for numerical values."
msgstr "Skaitlisko vērtību izpildlaika diapazona pārbaude."

#: m2/lang.opt:255
#, no-c-format
msgid "Runtime checking for functions which finish without executing a RETURN statement."
msgstr "Izpildlaika pārbaude funkcijām, kas beidzas, neizpildot RETURN priekšrakstu."

#: m2/lang.opt:259
#, no-c-format
msgid "Specify the list of runtime modules and their initialization order."
msgstr "Norādīt izpildlaika moduļu sarakstu un to inicializācijas secību."

#: m2/lang.opt:263
#, no-c-format
msgid "Modules are initialized dynamically, determined by M2RTS and application dependencies."
msgstr "Moduļi tiek inicializēti dinamiski atbilstoši M2RTS un lietojumprogrammas atkarībām."

#: m2/lang.opt:267
#, no-c-format
msgid "Generate a C source scaffold for the current module being compiled."
msgstr "Ģenerēt pašreizējā kompilējamā moduļa C pirmkoda sastatnes."

#: m2/lang.opt:271
#, no-c-format
msgid "Generate a C++ source scaffold for the current module being compiled."
msgstr "Ģenerēt pašreizējā kompilējamā moduļa C++ pirmkoda sastatnes."

#: m2/lang.opt:275
#, no-c-format
msgid "Generate the main function."
msgstr "Ģenerēt funkciju main."

#: m2/lang.opt:279
#, no-c-format
msgid "Generate static scaffold initialization and finalization for every module inside main."
msgstr "Ģenerēt statisku sastatņu inicializāciju un finalizāciju katram modulim funkcijā main."

#: m2/lang.opt:283
#, no-c-format
msgid "Generate a shared library from the module."
msgstr "Ģenerēt koplietojamo bibliotēku no moduļa."

#: m2/lang.opt:287
#, no-c-format
msgid "All software runtime checking (an abbreviation for -fnil -frange -findex -fwholediv -fcase -freturn -fwholevalue -ffloatvalue)."
msgstr "Visas programmatūras izpildlaika pārbaudes (saīsinājums opcijām -fnil -frange -findex -fwholediv -fcase -freturn -fwholevalue -ffloatvalue)."

#: m2/lang.opt:291
#, no-c-format
msgid "Display the location of module source files as they are compiled."
msgstr "Parādīt moduļu pirmkoda failu atrašanās vietu to kompilēšanas laikā."

#: m2/lang.opt:295
#, no-c-format
msgid "Create a swig interface file for the module."
msgstr "Izveidot SWIG saskarnes failu modulim."

#: m2/lang.opt:303
#, no-c-format
msgid "Optimize non var unbounded parameters by passing it by reference, providing it is not written to within the callee procedure."
msgstr "Optimizēt ne-var neierobežotos parametrus, nododot tos ar atsauci, ja izsauktajā procedūrā tajos netiek rakstīts."

#: m2/lang.opt:307
#, no-c-format
msgid "Order the initialization/finalizations for scaffold-static or force linking of modules if scaffold-dynamic."
msgstr "Sakārtot inicializāciju/finalizāciju scaffold-static gadījumā vai piespiest moduļu saistīšanu scaffold-dynamic gadījumā."

#: m2/lang.opt:315
#, no-c-format
msgid "Link against the module M2WIDESET to perform the wideset operator, the negative version of this option will generate a warning if this module is required."
msgstr "Saistīt ar moduli M2WIDESET, lai īstenotu wideset operatoru; šīs opcijas negatīvā versija ģenerēs brīdinājumu, ja šis modulis ir nepieciešams."

#: m2/lang.opt:319
#, no-c-format
msgid "Runtime checking of all division and modulus by zero checking for ordinal values."
msgstr "Izpildlaika pārbaude visām dalīšanām un atlikuma operācijām ar nulli ordinālām vērtībām."

#: m2/lang.opt:323
#, no-c-format
msgid "Runtime checking for whole numbers."
msgstr "Veselo skaitļu izpildlaika pārbaude."

#: m2/lang.opt:327
#, no-c-format
msgid "Link the standard Modula-2 libraries statically in the compilation."
msgstr "Kompilējot statiski saistīt standarta Modula-2 bibliotēkas."

#: m2/lang.opt:472 m2/lang.opt:476
#, no-c-format
msgid "save temporary preprocessed files."
msgstr "saglabāt pagaidu priekšapstrādātos failus."

#: fortran/lang.opt:146
#, no-c-format
msgid "-J<directory>\tPut MODULE files in 'directory'."
msgstr "-J<directory>\tIevietot MODULE failus direktorijā 'directory'."

#: fortran/lang.opt:198
#, no-c-format
msgid "Warn about possible aliasing of dummy arguments."
msgstr "Brīdināt par iespējamu fiktīvo argumentu pārklāšanos (aliasing)."

#: fortran/lang.opt:202
#, no-c-format
msgid "Warn about alignment of COMMON blocks."
msgstr "Brīdināt par COMMON bloku izlīdzināšanu."

#: fortran/lang.opt:206
#, no-c-format
msgid "Warn about missing ampersand in continued character constants."
msgstr "Brīdināt par trūkstošu & zīmi turpinātās rakstzīmju konstantēs."

#: fortran/lang.opt:210
#, no-c-format
msgid "Warn about creation of array temporaries."
msgstr "Brīdināt par pagaidu masīvu izveidi."

#: fortran/lang.opt:218
#, no-c-format
msgid "Warn if the type of a variable might be not interoperable with C."
msgstr "Brīdināt, ja mainīgā tips varētu nebūt sadarbspējīgs ar C."

#: fortran/lang.opt:226
#, no-c-format
msgid "Warn about truncated character expressions."
msgstr "Brīdināt par saīsinātām rakstzīmju izteiksmēm."

#: fortran/lang.opt:230
#, no-c-format
msgid "Warn about equality comparisons involving REAL or COMPLEX expressions."
msgstr "Brīdināt par vienādības salīdzinājumiem, kuros iesaistītas REAL vai COMPLEX izteiksmes."

#: fortran/lang.opt:238
#, no-c-format
msgid "Warn about most implicit conversions."
msgstr "Brīdināt par lielāko daļu netiešo konversiju."

#: fortran/lang.opt:246
#, no-c-format
msgid "Warn about possibly incorrect subscripts in do loops."
msgstr "Brīdināt par iespējami nepareiziem indeksiem DO ciklos."

#: fortran/lang.opt:250
#, no-c-format
msgid "Warn when arguments of external procedures do not match."
msgstr "Brīdināt, ja ārējo procedūru argumenti neatbilst."

#: fortran/lang.opt:258
#, no-c-format
msgid "Warn if loops have been interchanged."
msgstr "Brīdināt, ja cikli ir apmainīti."

#: fortran/lang.opt:262
#, no-c-format
msgid "Warn about function call elimination."
msgstr "Brīdināt par funkciju izsaukumu elimināciju."

#: fortran/lang.opt:266
#, no-c-format
msgid "Warn about calls with implicit interface."
msgstr "Brīdināt par izsaukumiem ar netiešu saskarni."

#: fortran/lang.opt:270
#, no-c-format
msgid "Warn about called procedures not explicitly declared."
msgstr "Brīdināt par izsauktām procedūrām, kas nav eksplicīti deklarētas."

#: fortran/lang.opt:274
#, no-c-format
msgid "Warn about constant integer divisions with truncated results."
msgstr "Brīdināt par konstantu veselo skaitļu dalīšanām ar nogrieztiem rezultātiem."

#: fortran/lang.opt:278
#, no-c-format
msgid "Warn about truncated source lines."
msgstr "Brīdināt par saīsinātām pirmkoda rindām."

#: fortran/lang.opt:282
#, no-c-format
msgid "Warn on intrinsics not part of the selected standard."
msgstr "Brīdināt par iekšējām procedūrām, kas nav izvēlētā standarta daļa."

#: fortran/lang.opt:294
#, no-c-format
msgid "Warn about USE statements that have no ONLY qualifier."
msgstr "Brīdināt par USE priekšrakstiem bez ONLY kvalifikatora."

#: fortran/lang.opt:310
#, no-c-format
msgid "Warn that -fno-automatic may break recursion."
msgstr "Brīdināt, ka -fno-automatic var pārtraukt rekursiju."

#: fortran/lang.opt:318
#, no-c-format
msgid "Warn about real-literal-constants with 'q' exponent-letter."
msgstr "Brīdināt par reālo literāļu konstantēm ar eksponentes burtu 'q'."

#: fortran/lang.opt:322
#, no-c-format
msgid "Warn when a left-hand-side array variable is reallocated."
msgstr "Brīdināt, ja kreisās puses masīva mainīgais tiek pārdalīts."

#: fortran/lang.opt:326
#, no-c-format
msgid "Warn when a left-hand-side variable is reallocated."
msgstr "Brīdināt, ja kreisās puses mainīgais tiek pārdalīts."

#: fortran/lang.opt:330
#, no-c-format
msgid "Warn if the pointer in a pointer assignment might outlive its target."
msgstr "Brīdināt, ja rādītāja piešķiršanā rādītājs var pārdzīvot savu mērķi."

#: fortran/lang.opt:338
#, no-c-format
msgid "Warn about \"suspicious\" constructs."
msgstr "Brīdināt par \"aizdomīgām\" konstrukcijām."

#: fortran/lang.opt:342
#, no-c-format
msgid "Permit nonconforming uses of the tab character."
msgstr "Atļaut neatbilstošu tabulācijas rakstzīmes lietojumu."

#: fortran/lang.opt:346
#, no-c-format
msgid "Warn about an invalid DO loop."
msgstr "Brīdināt par nederīgu DO ciklu."

#: fortran/lang.opt:350
#, no-c-format
msgid "Warn about underflow of numerical constant expressions."
msgstr "Brīdināt par skaitlisku konstantu izteiksmju zempildi."

#: fortran/lang.opt:358
#, no-c-format
msgid "Warn if a user-procedure has the same name as an intrinsic."
msgstr "Brīdināt, ja lietotāja procedūrai ir tāds pats nosaukums kā iekšējai procedūrai."

#: fortran/lang.opt:366
#, no-c-format
msgid "Warn about unused dummy arguments."
msgstr "Brīdināt par neizmantotiem fiktīvajiem argumentiem."

#: fortran/lang.opt:370
#, no-c-format
msgid "Warn about zero-trip DO loops."
msgstr "Brīdināt par DO cikliem ar nulle iterācijām."

#: fortran/lang.opt:374
#, no-c-format
msgid "Enable preprocessing."
msgstr "Iespējot priekšapstrādi."

#: fortran/lang.opt:382
#, no-c-format
msgid "Disable preprocessing."
msgstr "Atspējot priekšapstrādi."

#: fortran/lang.opt:390
#, no-c-format
msgid "Accept argument mismatches in procedure calls."
msgstr "Pieņemt argumentu neatbilstības procedūru izsaukumos."

#: fortran/lang.opt:394
#, no-c-format
msgid "Eliminate multiple function invocations also for impure functions."
msgstr "Novērst daudzkārtējus funkciju izsaukumus arī ne-pure funkcijām."

#: fortran/lang.opt:398
#, no-c-format
msgid "Enable alignment of COMMON blocks."
msgstr "Iespējot COMMON bloku izlīdzināšanu."

#: fortran/lang.opt:402
#, no-c-format
msgid "All intrinsics procedures are available regardless of selected standard."
msgstr "Visas iekšējās procedūras ir pieejamas neatkarīgi no izvēlētā standarta."

#: fortran/lang.opt:406
#, no-c-format
msgid "Allow a BOZ literal constant to appear in an invalid context and with X instead of Z."
msgstr "Atļaut BOZ literāļa konstantei parādīties nederīgā kontekstā un ar X Z vietā."

#: fortran/lang.opt:414
#, no-c-format
msgid "Do not treat local variables and COMMON blocks as if they were named in SAVE statements."
msgstr "Neuzskatīt lokālos mainīgos un COMMON blokus tā, it kā tie būtu nosaukti SAVE priekšrakstos."

#: fortran/lang.opt:418
#, no-c-format
msgid "Specify that backslash in string introduces an escape character."
msgstr "Norādīt, ka atpakaļvērstā slīpsvītra virknē sāk atsoļa (escape) rakstzīmi."

#: fortran/lang.opt:422
#, no-c-format
msgid "Produce a backtrace when a runtime error is encountered."
msgstr "Izvadīt atpakaļizsekojumu (backtrace), ja rodas izpildlaika kļūda."

#: fortran/lang.opt:426
#, no-c-format
msgid "-fblas-matmul-limit=<n>\tSize of the smallest matrix for which matmul will use BLAS."
msgstr "-fblas-matmul-limit=<n>\tMazākās matricas izmērs, kurai matmul izmantos BLAS."

#: fortran/lang.opt:437
#, no-c-format
msgid "Produce a warning at runtime if a array temporary has been created for a procedure argument."
msgstr "Izpildlaikā izvadīt brīdinājumu, ja procedūras argumentam ir izveidots pagaidu masīvs."

#: fortran/lang.opt:441
#, no-c-format
msgid "-fconvert=<big-endian|little-endian|native|swap|r16_ieee|r16_ibm>\tThe endianness used for unformatted files."
msgstr "-fconvert=<big-endian|little-endian|native|swap|r16_ieee|r16_ibm>\tNeformatētiem failiem izmantotā baitu secība (endianness)."

#: fortran/lang.opt:466
#, no-c-format
msgid "Use the Cray Pointer extension."
msgstr "Izmantot Cray Pointer paplašinājumu."

#: fortran/lang.opt:470
#, no-c-format
msgid "Generate C prototypes from BIND(C) declarations."
msgstr "Ģenerēt C prototipus no BIND(C) deklarācijām."

#: fortran/lang.opt:474
#, no-c-format
msgid "Generate C prototypes from non-BIND(C) external procedure definitions."
msgstr "Ģenerēt C prototipus no ārējo procedūru definīcijām, kas nav BIND(C)."

#: fortran/lang.opt:478
#, no-c-format
msgid "Ignore 'D' in column one in fixed form."
msgstr "Ignorēt 'D' pirmajā kolonnā fiksētajā formā."

#: fortran/lang.opt:482
#, no-c-format
msgid "Treat lines with 'D' in column one as comments."
msgstr "Rindas ar 'D' pirmajā kolonnā uzskatīt par komentāriem."

#: fortran/lang.opt:486
#, no-c-format
msgid "Issue debug information for compiler-generated auxiliary variables."
msgstr "Izvadīt atkļūdošanas informāciju par kompilatora ģenerētajiem palīgmainīgajiem."

#: fortran/lang.opt:490
#, no-c-format
msgid "Enable all DEC language extensions."
msgstr "Iespējot visus DEC valodas paplašinājumus."

#: fortran/lang.opt:494
#, no-c-format
msgid "Enable the use of blank format items in format strings."
msgstr "Iespējot tukšu formāta elementu izmantošanu formāta virknēs."

#: fortran/lang.opt:498
#, no-c-format
msgid "Enable the use of character literals in assignments and data statements for non-character variables."
msgstr "Iespējot rakstzīmju literāļu izmantošanu piešķiršanās un DATA priekšrakstos mainīgajiem, kas nav rakstzīmju tipa."

#: fortran/lang.opt:503
#, no-c-format
msgid "Enable legacy parsing of INCLUDE as statement."
msgstr "Iespējot novecojušo INCLUDE parsēšanu kā priekšrakstu."

#: fortran/lang.opt:507
#, no-c-format
msgid "Enable default widths for i, f and g format specifiers."
msgstr "Iespējot noklusējuma platumus i, f un g formāta specifikatoriem."

#: fortran/lang.opt:511
#, no-c-format
msgid "Enable kind-specific variants of integer intrinsic functions."
msgstr "Iespējot veselo skaitļu iekšējo funkciju variantus, kas specifiski veidam (kind)."

#: fortran/lang.opt:515
#, no-c-format
msgid "Enable legacy math intrinsics for compatibility."
msgstr "Saderībai iespējot novecojušās matemātikas iekšējās funkcijas."

#: fortran/lang.opt:519
#, no-c-format
msgid "Enable support for DEC STRUCTURE/RECORD."
msgstr "Iespējot DEC STRUCTURE/RECORD atbalstu."

#: fortran/lang.opt:523
#, no-c-format
msgid "Enable DEC-style STATIC and AUTOMATIC attributes."
msgstr "Iespējot DEC stila STATIC un AUTOMATIC atribūtus."

#: fortran/lang.opt:527
#, no-c-format
msgid "Set the default double precision kind to an 8 byte wide type."
msgstr "Iestatīt noklusējuma dubultās precizitātes veidu uz 8 baitu platu tipu."

#: fortran/lang.opt:531
#, no-c-format
msgid "Set the default integer kind to an 8 byte wide type."
msgstr "Iestatīt noklusējuma veselu skaitļu veidu uz 8 baitu platu tipu."

#: fortran/lang.opt:535
#, no-c-format
msgid "Set the default real kind to an 8 byte wide type."
msgstr "Iestatīt noklusējuma reālo veidu uz 8 baitu platu tipu."

#: fortran/lang.opt:539
#, no-c-format
msgid "Set the default real kind to an 10 byte wide type."
msgstr "Iestatīt noklusējuma reālo veidu uz 10 baitu platu tipu."

#: fortran/lang.opt:543
#, no-c-format
msgid "Set the default real kind to an 16 byte wide type."
msgstr "Iestatīt noklusējuma reālo veidu uz 16 baitu platu tipu."

#: fortran/lang.opt:547
#, no-c-format
msgid "Allow dollar signs in entity names."
msgstr "Atļaut dolāra zīmes entītiju nosaukumos."

#: fortran/lang.opt:555
#, no-c-format
msgid "Display the code tree after parsing."
msgstr "Parādīt koda koku pēc parsēšanas."

#: fortran/lang.opt:559
#, no-c-format
msgid "Display the code tree after front end optimization."
msgstr "Parādīt koda koku pēc priekšējās daļas optimizācijas."

#: fortran/lang.opt:563
#, no-c-format
msgid "Display the global symbol table after parsing."
msgstr "Parādīt globālo simbolu tabulu pēc parsēšanas."

#: fortran/lang.opt:567
#, no-c-format
msgid "Display the code tree after parsing; deprecated option."
msgstr "Parādīt koda koku pēc parsēšanas; novecojusi opcija."

#: fortran/lang.opt:571
#, no-c-format
msgid "Specify that an external BLAS library should be used for matmul calls on large-size arrays."
msgstr "Norādīt, ka liela izmēra masīvu matmul izsaukumiem jāizmanto ārēja BLAS bibliotēka."

#: fortran/lang.opt:575
#, no-c-format
msgid "Use an external BLAS library with 64-bit indexing for matmul on large-size arrays."
msgstr "Izmantot ārēju BLAS bibliotēku ar 64 bitu indeksēšanu matmul izsaukumiem uz liela izmēra masīviem."

#: fortran/lang.opt:579
#, no-c-format
msgid "Use f2c calling convention."
msgstr "Izmantot f2c izsaukšanas konvenciju."

#: fortran/lang.opt:583 cobol/lang.opt:352
#, no-c-format
msgid "Assume that the source file is fixed form."
msgstr "Pieņemt, ka pirmkoda failam ir fiksētā forma."

#: fortran/lang.opt:587
#, no-c-format
msgid "Force creation of temporary to test infrequently-executed forall code."
msgstr "Piespiest pagaidu objekta izveidi, lai testētu reti izpildītu forall kodu."

#: fortran/lang.opt:591
#, no-c-format
msgid "Interpret any INTEGER(4) as an INTEGER(8)."
msgstr "Interpretēt jebkuru INTEGER(4) kā INTEGER(8)."

#: fortran/lang.opt:595 fortran/lang.opt:599
#, no-c-format
msgid "Specify where to find the compiled intrinsic modules."
msgstr "Norādīt, kur atrast kompilētos iekšējos moduļus."

#: fortran/lang.opt:603
#, no-c-format
msgid "Allow arbitrary character line width in fixed mode."
msgstr "Fiksētā režīmā atļaut patvaļīgu rakstzīmju rindas platumu."

#: fortran/lang.opt:607
#, no-c-format
msgid "-ffixed-line-length-<n>\tUse n as character line width in fixed mode."
msgstr "-ffixed-line-length-<n>\tIzmantot n kā rakstzīmju rindas platumu fiksētā režīmā."

#: fortran/lang.opt:611
#, no-c-format
msgid "Pad shorter fixed form lines to line width with spaces."
msgstr "Īsākas fiksētas formas rindas aizpildīt ar atstarpēm līdz rindas platumam."

#: fortran/lang.opt:615
#, no-c-format
msgid "-ffpe-trap=[...]\tStop on following floating point exceptions."
msgstr "-ffpe-trap=[...]\tApturēt izpildi pie šādiem peldošā komata izņēmumiem."

#: fortran/lang.opt:619
#, no-c-format
msgid "-ffpe-summary=[...]\tPrint summary of floating point exceptions."
msgstr "-ffpe-summary=[...]\tIzdrukāt peldošā komata izņēmumu kopsavilkumu."

#: fortran/lang.opt:623 cobol/lang.opt:356
#, no-c-format
msgid "Assume that the source file is free form."
msgstr "Pieņemt, ka pirmkoda failam ir brīvā forma."

#: fortran/lang.opt:627
#, no-c-format
msgid "Allow arbitrary character line width in free mode."
msgstr "Atļaut patvaļīgu rakstzīmju rindas platumu brīvajā režīmā."

#: fortran/lang.opt:631
#, no-c-format
msgid "-ffree-line-length-<n>\tUse n as character line width in free mode."
msgstr "-ffree-line-length-<n>\tIzmantot n kā rakstzīmju rindas platumu brīvajā režīmā."

#: fortran/lang.opt:635
#, no-c-format
msgid "Try to interchange loops if profitable."
msgstr "Mēģināt apmainīt ciklus, ja tas ir izdevīgi."

#: fortran/lang.opt:639
#, no-c-format
msgid "Enable front end optimization."
msgstr "Iespējot priekšējās daļas optimizāciju."

#: fortran/lang.opt:643
#, no-c-format
msgid "Specify that no implicit typing is allowed, unless overridden by explicit IMPLICIT statements."
msgstr "Norādīt, ka netiešā tipizācija nav atļauta, ja vien to neatceļ eksplicīti IMPLICIT priekšraksti."

#: fortran/lang.opt:647
#, no-c-format
msgid "-finit-character=<n>\tInitialize local character variables to ASCII value n."
msgstr "-finit-character=<n>\tInicializēt lokālos rakstzīmju mainīgos ar ASCII vērtību n."

#: fortran/lang.opt:651
#, no-c-format
msgid "Initialize components of derived type variables according to other init flags."
msgstr "Inicializēt atvasinātā tipa mainīgo komponentus atbilstoši citiem init karogiem."

#: fortran/lang.opt:655
#, no-c-format
msgid "-finit-integer=<n>\tInitialize local integer variables to n."
msgstr "-finit-integer=<n>\tInicializēt lokālos veselo skaitļu mainīgos ar n."

#: fortran/lang.opt:659
#, no-c-format
msgid "Initialize local variables to zero (from g77)."
msgstr "Inicializēt lokālos mainīgos ar nulli (no g77)."

#: fortran/lang.opt:663
#, no-c-format
msgid "-finit-logical=<true|false>\tInitialize local logical variables."
msgstr "-finit-logical=<true|false>\tInicializēt lokālos loģiskos mainīgos."

#: fortran/lang.opt:667
#, no-c-format
msgid "-finit-real=<zero|snan|nan|inf|-inf>\tInitialize local real variables."
msgstr "-finit-real=<zero|snan|nan|inf|-inf>\tInicializēt lokālos reālos mainīgos."

#: fortran/lang.opt:689
#, no-c-format
msgid "-finline-arg-packing\tPerform argument packing inline."
msgstr "-finline-arg-packing\tVeikt argumentu pakošanu iekļauti."

#: fortran/lang.opt:699
#, no-c-format
msgid "Enable generation of inline code instead of calls to functions from the library to implement intrinsics."
msgstr "Iekšējo funkciju īstenošanai bibliotēkas funkciju izsaukumu vietā ģenerēt iekļautu kodu."

#: fortran/lang.opt:720
#, no-c-format
msgid "-finline-matmul-limit=<n>\tSpecify the size of the largest matrix for which matmul will be inlined."
msgstr "-finline-matmul-limit=<n>\tNorādīt lielākās matricas izmēru, kurai matmul tiks iekļauts."

#: fortran/lang.opt:724
#, no-c-format
msgid "-fmax-array-constructor=<n>\tMaximum number of objects in an array constructor."
msgstr "-fmax-array-constructor=<n>\tMaksimālais objektu skaits masīva konstruktorā."

#: fortran/lang.opt:728
#, no-c-format
msgid "-fmax-identifier-length=<n>\tMaximum identifier length."
msgstr "-fmax-identifier-length=<n>\tMaksimālais identifikatora garums."

#: fortran/lang.opt:732
#, no-c-format
msgid "-fmax-subrecord-length=<n>\tMaximum length for subrecords."
msgstr "-fmax-subrecord-length=<n>\tMaksimālais apakšierakstu garums."

#: fortran/lang.opt:736
#, no-c-format
msgid "-fmax-stack-var-size=<n>\tSize in bytes of the largest array that will be put on the stack."
msgstr "-fmax-stack-var-size=<n>\tLielākā stekā izvietojamā masīva izmērs baitos."

#: fortran/lang.opt:740
#, no-c-format
msgid "Put all local arrays on stack."
msgstr "Izvietot visus lokālos masīvus stekā."

#: fortran/lang.opt:744
#, no-c-format
msgid "Set default accessibility of module entities to PRIVATE."
msgstr "Iestatīt moduļa entītiju noklusējuma pieejamību uz PRIVATE."

#: fortran/lang.opt:764
#, no-c-format
msgid "Handle OpenMP allocators for allocatables and pointers."
msgstr "Apstrādāt OpenMP piešķīrējus allocatable objektiem un rādītājiem."

#: fortran/lang.opt:768
#, no-c-format
msgid "Try to lay out derived types as compactly as possible."
msgstr "Mēģināt izvietot atvasinātos tipus pēc iespējas kompaktāk."

#: fortran/lang.opt:776
#, no-c-format
msgid "Protect parentheses in expressions."
msgstr "Aizsargāt iekavas izteiksmēs."

#: fortran/lang.opt:780
#, no-c-format
msgid "Path to header file that should be pre-included before each compilation unit."
msgstr "Ceļš uz galvenes failu, kas jāiekļauj pirms katras kompilēšanas vienības."

#: fortran/lang.opt:784
#, no-c-format
msgid "Enable range checking during compilation."
msgstr "Iespējot diapazona pārbaudi kompilēšanas laikā."

#: fortran/lang.opt:788
#, no-c-format
msgid "Interpret any REAL(4) as a REAL(8)."
msgstr "Interpretēt jebkuru REAL(4) kā REAL(8)."

#: fortran/lang.opt:792
#, no-c-format
msgid "Interpret any REAL(4) as a REAL(10)."
msgstr "Interpretēt jebkuru REAL(4) kā REAL(10)."

#: fortran/lang.opt:796
#, no-c-format
msgid "Interpret any REAL(4) as a REAL(16)."
msgstr "Interpretēt jebkuru REAL(4) kā REAL(16)."

#: fortran/lang.opt:800
#, no-c-format
msgid "Interpret any REAL(8) as a REAL(4)."
msgstr "Interpretēt jebkuru REAL(8) kā REAL(4)."

#: fortran/lang.opt:804
#, no-c-format
msgid "Interpret any REAL(8) as a REAL(10)."
msgstr "Interpretēt jebkuru REAL(8) kā REAL(10)."

#: fortran/lang.opt:808
#, no-c-format
msgid "Interpret any REAL(8) as a REAL(16)."
msgstr "Interpretēt jebkuru REAL(8) kā REAL(16)."

#: fortran/lang.opt:812
#, no-c-format
msgid "Reallocate the LHS in assignments."
msgstr "Pārdalīt piešķiršanas kreiso pusi (LHS)."

#: fortran/lang.opt:816
#, no-c-format
msgid "Use a 4-byte record marker for unformatted files."
msgstr "Neformatētiem failiem izmantot 4 baitu ieraksta marķieri."

#: fortran/lang.opt:820
#, no-c-format
msgid "Use an 8-byte record marker for unformatted files."
msgstr "Neformatētiem failiem izmantot 8 baitu ieraksta marķieri."

#: fortran/lang.opt:824
#, no-c-format
msgid "Allocate local variables on the stack to allow indirect recursion."
msgstr "Izvietot lokālos mainīgos stekā, lai atļautu netiešu rekursiju."

#: fortran/lang.opt:828
#, no-c-format
msgid "Copy array sections into a contiguous block on procedure entry."
msgstr "Procedūras sākumā kopēt masīva sekcijas nepārtrauktā blokā."

#: fortran/lang.opt:832
#, no-c-format
msgid "Experimental unsigned numbers."
msgstr "Eksperimentāli skaitļi bez zīmes."

#: fortran/lang.opt:836
#, no-c-format
msgid "-fcoarray=<none|single|lib>\tSpecify which coarray parallelization should be used."
msgstr "-fcoarray=<none|single|lib>\tNorādīt, kāda kopmasīvu paralelizācija jāizmanto."

#: fortran/lang.opt:852 algol68/lang.opt:81
#, no-c-format
msgid "-fcheck=[...]\tSpecify which runtime checks are to be performed."
msgstr "-fcheck=[...]\tNorādīt, kuras izpildlaika pārbaudes jāveic."

#: fortran/lang.opt:856
#, no-c-format
msgid "Append a second underscore if the name already contains an underscore."
msgstr "Pievienot otru apakšsvītru, ja nosaukumā jau ir apakšsvītra."

#: fortran/lang.opt:864
#, no-c-format
msgid "Apply negative sign to zero values."
msgstr "Nulles vērtībām piemērot negatīvu zīmi."

#: fortran/lang.opt:871
#, no-c-format
msgid "Disallow tail call optimization when a calling routine may have omitted character lengths."
msgstr "Aizliegt astes izsaukuma optimizāciju, ja izsaucošā rutīna var būt izlaidusi rakstzīmju garumus."

#: fortran/lang.opt:875
#, no-c-format
msgid "Append underscores to externally visible names."
msgstr "Ārēji redzamajiem nosaukumiem pievienot apakšsvītras."

#: fortran/lang.opt:919
#, no-c-format
msgid "Statically link the GNU Fortran helper library (libgfortran)."
msgstr "Statiski saistīt GNU Fortran palīgbibliotēku (libgfortran)."

#: fortran/lang.opt:923
#, no-c-format
msgid "Statically link the GCC Quad-Precision Math Library (libquadmath)."
msgstr "Statiski saistīt GCC Quad-Precision Math Library (libquadmath)."

#: fortran/lang.opt:927
#, no-c-format
msgid "Conform to the ISO Fortran 2003 standard."
msgstr "Ievērot ISO Fortran 2003 standartu."

#: fortran/lang.opt:931
#, no-c-format
msgid "Conform to the ISO Fortran 2008 standard."
msgstr "Ievērot ISO Fortran 2008 standartu."

#: fortran/lang.opt:935
#, no-c-format
msgid "Conform to the ISO Fortran 2008 standard including TS 29113."
msgstr "Ievērot ISO Fortran 2008 standartu, ieskaitot TS 29113."

#: fortran/lang.opt:939
#, no-c-format
msgid "Conform to the ISO Fortran 2018 standard."
msgstr "Ievērot ISO Fortran 2018 standartu."

#: fortran/lang.opt:943
#, no-c-format
msgid "Conform to the ISO Fortran 2023 standard."
msgstr "Ievērot ISO Fortran 2023 standartu."

#: fortran/lang.opt:947
#, no-c-format
msgid "Enable experimental Fortran 202y features."
msgstr "Iespējot eksperimentālās Fortran 202y funkcijas."

#: fortran/lang.opt:951
#, no-c-format
msgid "Conform to the ISO Fortran 95 standard."
msgstr "Ievērot ISO Fortran 95 standartu."

#: fortran/lang.opt:955
#, no-c-format
msgid "Conform to nothing in particular."
msgstr "Neievērot nevienu konkrētu standartu."

#: fortran/lang.opt:959
#, no-c-format
msgid "Accept extensions to support legacy code."
msgstr "Pieņemt paplašinājumus, lai atbalstītu mantoto kodu."

#: go/lang.opt:42
#, no-c-format
msgid "-fgo-c-header=<file>\tWrite Go struct definitions to file as C code."
msgstr "-fgo-c-header=<file>\tIerakstīt Go struktūru definīcijas failā kā C kodu."

#: go/lang.opt:46
#, no-c-format
msgid "Add explicit checks for division by zero."
msgstr "Pievienot eksplicītas dalīšanas ar nulli pārbaudes."

#: go/lang.opt:50
#, no-c-format
msgid "Add explicit checks for division overflow in INT_MIN / -1."
msgstr "Pievienot eksplicītas dalīšanas pārpildes pārbaudes gadījumam INT_MIN / -1."

#: go/lang.opt:54
#, no-c-format
msgid "Apply special rules for compiling runtime package."
msgstr "Piemērot īpašus noteikumus izpildlaika pakotnes kompilēšanai."

#: go/lang.opt:58
#, no-c-format
msgid "-fgo-dump-<type>\tDump Go frontend internal information."
msgstr "-fgo-dump-<type>\tIzmest Go priekšējās daļas iekšējo informāciju."

#: go/lang.opt:62
#, no-c-format
msgid "-fgo-embedcfg=<file>\tList embedded files via go:embed."
msgstr "-fgo-embedcfg=<file>\tUzskaitīt iegultos failus, izmantojot go:embed."

#: go/lang.opt:66
#, no-c-format
msgid "-fgo-importcfg=<file>\tProvide file that tells where to find imports."
msgstr "-fgo-importcfg=<file>\tNorādīt failu, kas nosaka, kur atrast importus."

#: go/lang.opt:70
#, no-c-format
msgid "-fgo-optimize-<type>\tTurn on optimization passes in the frontend."
msgstr "-fgo-optimize-<type>\tIeslēgt optimizācijas gājienus priekšējā daļā."

#: go/lang.opt:74
#, no-c-format
msgid "-fgo-pkgpath=<string>\tSet Go package path."
msgstr "-fgo-pkgpath=<string>\tIestatīt Go pakotnes ceļu."

#: go/lang.opt:78
#, no-c-format
msgid "-fgo-prefix=<string>\tSet package-specific prefix for exported Go names."
msgstr "-fgo-prefix=<string>\tIestatīt pakotnei specifisku priedēkli eksportētajiem Go nosaukumiem."

#: go/lang.opt:82
#, no-c-format
msgid "-fgo-relative-import-path=<path>\tTreat a relative import as relative to path."
msgstr "-fgo-relative-import-path=<path>\tUzskatīt relatīvu importu par relatīvu attiecībā pret path."

#: go/lang.opt:86
#, no-c-format
msgid "Functions which return values must end with return statements."
msgstr "Funkcijām, kas atgriež vērtības, jābeidzas ar return priekšrakstiem."

#: go/lang.opt:90
#, no-c-format
msgid "Emit debugging information related to the escape analysis pass when run with -fgo-optimize-allocs."
msgstr "Izvadīt atkļūdošanas informāciju par izbēgšanas analīzes gājienu, ja palaists ar -fgo-optimize-allocs."

#: go/lang.opt:94
#, no-c-format
msgid "-fgo-debug-escape-hash=<string>\tHash value to debug escape analysis."
msgstr "-fgo-debug-escape-hash=<string>\tJaucējvērtība izbēgšanas analīzes atkļūdošanai."

#: go/lang.opt:98
#, no-c-format
msgid "Emit optimization diagnostics."
msgstr "Izvadīt optimizācijas diagnostiku."

#: params.opt:27
#, no-c-format
msgid "Loops iterating at least selected number of iterations get loop alignment."
msgstr "Cikli, kas veic vismaz izvēlēto iterāciju skaitu, tiek izlīdzināti."

#: params.opt:31
#, no-c-format
msgid "Select fraction of the maximal frequency of executions of basic block in function given basic block get alignment."
msgstr "Pamatbloka izpildes biežuma daļa no funkcijas maksimālā pamatbloku izpildes biežuma, pie kuras pamatbloks tiek izlīdzināts."

#: params.opt:35
#, no-c-format
msgid "Enable asan globals protection."
msgstr "Iespējot ASan globālo mainīgo aizsardzību."

#: params.opt:39
#, no-c-format
msgid "Enable asan allocas/VLAs protection."
msgstr "Iespējot ASan alloca/VLA aizsardzību."

#: params.opt:43
#, no-c-format
msgid "Enable asan load operations protection."
msgstr "Iespējot ASan ielādes operāciju aizsardzību."

#: params.opt:47
#, no-c-format
msgid "Enable asan store operations protection."
msgstr "Iespējot ASan saglabāšanas operāciju aizsardzību."

#: params.opt:51
#, no-c-format
msgid "Use callbacks instead of inline code if number of accesses in function becomes greater or equal to this number."
msgstr "Izmantot atpakaļizsaukumus iekļautā koda vietā, ja piekļuvju skaits funkcijā kļūst lielāks par šo skaitli vai vienāds ar to."

#: params.opt:55
#, no-c-format
msgid "Prefix calls to memcpy, memset and memmove with __asan_ or __hwasan_ for -fsanitize=kernel-address or -fsanitize=kernel-hwaddress."
msgstr "Pievienot memcpy, memset un memmove izsaukumiem priedēkli __asan_ vai __hwasan_ opcijām -fsanitize=kernel-address vai -fsanitize=kernel-hwaddress."

#: params.opt:59
#, no-c-format
msgid "Enable asan builtin functions protection."
msgstr "Iespējot ASan iebūvēto funkciju aizsardzību."

#: params.opt:63
#, no-c-format
msgid "Enable asan stack protection."
msgstr "Iespējot ASan steka aizsardzību."

#: params.opt:67
#, no-c-format
msgid "Enable asan detection of use-after-return bugs."
msgstr "Iespējot ASan izmantošanas pēc atgriešanās (use-after-return) kļūdu noteikšanu."

#: params.opt:71
#, no-c-format
msgid "Build basic block profile using auto profile."
msgstr "Būvēt pamatbloku profilu, izmantojot automātisko profilu."

#: params.opt:75
#, no-c-format
msgid "Enable only function reordering with auto-profile."
msgstr "Iespējot tikai funkciju pārkārtošanu ar automātisko profilēšanu."

#: params.opt:79
#, no-c-format
msgid "Whether the scheduling description is mostly a cycle-accurate model of the target processor and is likely to spill aggressively to fill any pipeline bubbles."
msgstr "Vai plānošanas apraksts lielākoties ir mērķa procesora ciklprecīzs modelis, kas, visticamāk, agresīvi izspiedīs reģistrus (spill), lai aizpildītu konveijera burbuļus."

#: params.opt:83
#, no-c-format
msgid "Enable hwasan instrumentation of statically-sized stack-allocated variables."
msgstr "Iespējot hwasan instrumentāciju stekā izvietotiem mainīgajiem ar statisku izmēru."

#: params.opt:87
#, no-c-format
msgid "Use random base tag for each frame, as opposed to base always zero."
msgstr "Katram kadram izmantot nejaušu bāzes birku, nevis vienmēr nulles bāzi."

#: params.opt:91
#, no-c-format
msgid "Enable hwasan instrumentation of allocas/VLAs."
msgstr "Iespējot alloca/VLA hwasan instrumentāciju."

#: params.opt:95
#, no-c-format
msgid "Enable hwasan instrumentation of load operations."
msgstr "Iespējot hwasan instrumentāciju ielādes operācijām."

#: params.opt:99
#, no-c-format
msgid "Enable hwasan instrumentation of store operations."
msgstr "Iespējot hwasan instrumentāciju saglabāšanas operācijām."

#: params.opt:103
#, no-c-format
msgid "Enable hwasan instrumentation of builtin functions."
msgstr "Iespējot hwasan iebūvēto funkciju instrumentēšanu."

#: params.opt:107
#, no-c-format
msgid "When sanitizing using MTE instructions, add checks for all stack allocas."
msgstr "Sanitizējot ar MTE instrukcijām, pievienot pārbaudes visām steka alloca izdalēm."

#: params.opt:111
#, no-c-format
msgid "When sanitizing using MTE instructions, include builtin functions."
msgstr "Sanitizējot ar MTE instrukcijām, iekļaut iebūvētās funkcijas."

#: params.opt:115
#, no-c-format
msgid "Average number of iterations of a loop."
msgstr "Vidējais cikla iterāciju skaits."

#: params.opt:119
#, no-c-format
msgid "Maximum number of bits for which we avoid creating FMAs."
msgstr "Maksimālais bitu skaits, kuram izvairās no FMA veidošanas."

#: params.opt:123
#, no-c-format
msgid "Set the estimated probability in percentage for builtin expect. The default value is 90% probability."
msgstr "Iestatīt aplēsto varbūtību procentos iebūvētajai funkcijai expect. Noklusējuma vērtība ir 90% varbūtība."

#: params.opt:127
#, no-c-format
msgid "The maximum length of a constant string for a builtin string comparison call eligible for inlining. The default value is 3."
msgstr "Maksimālais konstantas virknes garums iebūvētās virkņu salīdzināšanas izsaukumam, kas piemērots iekļaušanai. Noklusējuma vērtība ir 3."

#: params.opt:131
#, no-c-format
msgid "The smallest number of different values for which it is best to use a jump-table instead of a tree of conditional branches.  If 0, use the default for the machine."
msgstr "Mazākais dažādo vērtību skaits, kuram labāk izmantot lēcienu tabulu, nevis nosacītu zarošanos koku. Ja 0, izmanto mašīnas noklusējumu."

#: params.opt:135
#, no-c-format
msgid "Probability that COMDAT function is shared with a different compilation unit."
msgstr "Varbūtība, ka COMDAT funkcija ir kopīga ar citu kompilēšanas vienību."

#: params.opt:139
#, no-c-format
msgid "Maximum number of namespaces to search for alternatives when name lookup fails."
msgstr "Maksimālais nosaukumvietu skaits, kurās meklēt alternatīvas, ja nosaukuma uzmeklēšana neizdodas."

#: params.opt:143
#, no-c-format
msgid "Maximum number of queries into the alias oracle per store."
msgstr "Maksimālais vaicājumu skaits pārklāšanās (alias) orākulam uz vienu saglabāšanu."

#: params.opt:147
#, no-c-format
msgid "Maximum size (in bytes) of objects tracked bytewise by dead store elimination."
msgstr "Maksimālais to objektu izmērs (baitos), kurus pa baitiem izseko nevajadzīgo saglabāšanu (dead store) likvidēšana."

#: params.opt:151
#, no-c-format
msgid "Maximal estimated growth of function body caused by early inlining of single call."
msgstr "Funkcijas ķermeņa maksimālais aplēstais pieaugums, ko rada viena izsaukuma agrīna iekļaušana."

#: params.opt:155
#, no-c-format
msgid "Maximum number of files in the file cache."
msgstr "Maksimālais failu skaits failu kešatmiņā."

#: params.opt:159
#, no-c-format
msgid "Maximum number of lines to index into file cache. When 0 this is automatically sized."
msgstr "Maksimālais rindu skaits, ko indeksēt failu kešatmiņā. Ja 0, izmērs tiek noteikts automātiski."

#: params.opt:163
#, no-c-format
msgid "Scale factor to apply to the number of statements in a threading path crossing a loop back edge when comparing to max-jump-thread-duplication-stmts."
msgstr "Mēroga koeficients, ko piemēro priekšrakstu skaitam pavedināšanas (threading) ceļā, kas šķērso cikla atpakaļējošo šķautni, salīdzinot ar max-jump-thread-duplication-stmts."

#: params.opt:167
#, no-c-format
msgid "Whether the target fully pipelines FMA instructions.  If non-zero, reassociation considers the benefit of parallelizing FMA's multiplication part and addition part, assuming FMUL and FMA use the same units that can also do FADD."
msgstr "Vai mērķis pilnībā konveijerizē FMA instrukcijas. Ja vērtība nav nulle, reasociācija ņem vērā ieguvumu no FMA reizināšanas un saskaitīšanas daļas paralelizēšanas, pieņemot, ka FMUL un FMA izmanto tās pašas vienības, kas var veikt arī FADD."

#: params.opt:174
#, no-c-format
msgid "The threshold ratio of critical edges execution count that permit performing redundancy elimination after reload."
msgstr "Kritisko šķautņu izpildes skaita sliekšņa attiecība, kas ļauj veikt liekuma novēršanu pēc reload."

#: params.opt:178
#, no-c-format
msgid "The threshold ratio for performing partial redundancy elimination after reload."
msgstr "Sliekšņa attiecība daļējā liekuma novēršanas veikšanai pēc reload."

#: params.opt:182
#, no-c-format
msgid "Scaling factor in calculation of maximum distance an expression can be moved by GCSE optimizations."
msgstr "Mērogošanas koeficients maksimālā attāluma aprēķināšanā, par kādu GCSE optimizācijas var pārvietot izteiksmi."

#: params.opt:186
#, no-c-format
msgid "Cost at which GCSE optimizations does not constrain the distance an expression can travel."
msgstr "Izmaksas, pie kurām GCSE optimizācijas neierobežo attālumu, kādā izteiksme var tikt pārvietota."

#: params.opt:190
#, no-c-format
msgid "Minimum heap expansion to trigger garbage collection, as a percentage of the total size of the heap."
msgstr "Minimālais kaudzes paplašinājums, kas izraisa atkritumu savākšanu, procentos no kopējā kaudzes izmēra."

#: params.opt:194
#, no-c-format
msgid "Minimum heap size before we start collecting garbage, in kilobytes."
msgstr "Minimālais kaudzes izmērs kilobaitos, pirms sākt atkritumu savākšanu."

#: params.opt:198
#, no-c-format
msgid "The number of executions of a basic block which is considered hot. The parameter is used only in GIMPLE FE."
msgstr "Pamatbloka izpildījumu skaits, kas tiek uzskatīts par \"karstu\". Šo parametru izmanto tikai GIMPLE FE."

#: params.opt:202
#, no-c-format
msgid "Whether codegen errors should be ICEs when -fchecking."
msgstr "Vai koda ģenerēšanas kļūdām jābūt ICE, ja izmanto -fchecking."

#: params.opt:206
#, no-c-format
msgid "Maximum number of arrays per SCoP."
msgstr "Maksimālais masīvu skaits vienā SCoP."

#: params.opt:210
#, no-c-format
msgid "Maximum number of parameters in a SCoP."
msgstr "Maksimālais parametru skaits vienā SCoP."

#: params.opt:214
#, no-c-format
msgid "Maximum number of blocks for -fharden-control-flow-redundancy."
msgstr "Maksimālais bloku skaits opcijai -fharden-control-flow-redundancy."

#: params.opt:218
#, no-c-format
msgid "Maximum number of blocks for in-line -fharden-control-flow-redundancy."
msgstr "Maksimālais bloku skaits iekļautai (in-line) -fharden-control-flow-redundancy versijai."

#: params.opt:222
#, no-c-format
msgid "The number of elements for which hash table verification is done for each searched element."
msgstr "Elementu skaits, kuriem tiek veikta jaucējtabulas pārbaude katram meklētajam elementam."

#: params.opt:226
#, no-c-format
msgid "The denominator n of fraction 1/n of the maximal execution count of a basic block in the entire program that a basic block needs to at least have in order to be considered hot (used in non-LTO mode)."
msgstr "Daļas 1/n saucējs n no pamatbloka maksimālā izpildes skaita visā programmā, kas pamatblokam jāsasniedz, lai to uzskatītu par karstu (izmanto ne-LTO režīmā)."

#: params.opt:230
#, no-c-format
msgid "The number of most executed permilles of the profiled execution of the entire program to which the execution count of a basic block must be part of in order to be considered hot (used in LTO mode)."
msgstr "Visas programmas profilētās izpildes visvairāk izpildīto promiļu skaits, kurām jāpieder pamatbloka izpildes skaitam, lai to uzskatītu par karstu (izmanto LTO režīmā)."

#: params.opt:234
#, no-c-format
msgid "The denominator n of fraction 1/n of the execution frequency of the entry block of a function that a basic block of this function needs to at least have in order to be considered hot."
msgstr "Daļas 1/n saucējs n no funkcijas ieejas bloka izpildes biežuma, kas šīs funkcijas pamatblokam jāsasniedz, lai to uzskatītu par karstu."

#: params.opt:238
#, no-c-format
msgid "The scale (as a percentage) applied to inline-insns-single and auto limits when heuristics hints that inlining is very profitable."
msgstr "Mērogs (procentos), ko piemēro inline-insns-single un auto ierobežojumiem, ja heiristika norāda, ka iekļaušana ir ļoti izdevīga."

#: params.opt:242
#, no-c-format
msgid "The minimal estimated speedup allowing inliner to ignore inline-insns-single and inline-insns-auto."
msgstr "Minimālais aplēstais paātrinājums, kas ļauj iekļāvējam ignorēt inline-insns-single un inline-insns-auto."

#: params.opt:246
#, no-c-format
msgid "How much can given compilation unit grow because of the inlining (as a percentage)."
msgstr "Par cik (procentos) dotā kompilēšanas vienība var pieaugt iekļaušanas dēļ."

#: params.opt:250
#, no-c-format
msgid "The upper bound for sharing integer constants."
msgstr "Augšējā robeža veselo skaitļu konstanšu koplietošanai."

#: params.opt:254
#, no-c-format
msgid "Threshold ipa-cp opportunity evaluation that is still considered beneficial to clone."
msgstr "ipa-cp iespējas novērtējuma slieksnis, pie kura klonēšana joprojām tiek uzskatīta par izdevīgu."

#: params.opt:258
#, no-c-format
msgid "Compile-time bonus IPA-CP assigns to candidates which make loop bounds or strides known."
msgstr "Kompilēšanas laika bonuss, ko IPA-CP piešķir kandidātiem, kuri padara zināmas cikla robežas vai soļus."

#: params.opt:262
#, no-c-format
msgid "Maximum depth of recursive cloning for self-recursive function."
msgstr "Maksimālais rekursīvās klonēšanas dziļums pašrekursīvai funkcijai."

#: params.opt:266
#, no-c-format
msgid "Recursive cloning only when the probability of call being executed exceeds the parameter."
msgstr "Rekursīvā klonēšana tikai tad, ja izsaukuma izpildes varbūtība pārsniedz parametru."

#: params.opt:270
#, no-c-format
msgid "When propagating IPA-CP effect estimates, multiply frequencies of recursive edges that bring back an unchanged value by this factor."
msgstr "Izplatot IPA-CP efekta aplēses, reizināt rekursīvo šķautņu, kas atgriež nemainītu vērtību, biežumus ar šo koeficientu."

#: params.opt:274
#, no-c-format
msgid "Percentage penalty recursive functions receive when they are evaluated for cloning."
msgstr "Procentuālais sods, ko rekursīvās funkcijas saņem, kad tās tiek novērtētas klonēšanai."

#: params.opt:278
#, no-c-format
msgid "Percentage penalty functions containing a single call to another function receive when they are evaluated for cloning."
msgstr "Procentuālais sods, ko saņem funkcijas, kas satur vienu izsaukumu uz citu funkciju, kad tās tiek novērtētas klonēšanai."

#: params.opt:282
#, no-c-format
msgid "The number of times the interprocedural constant propagation traverses all functions to make cloning decisions."
msgstr "Reižu skaits, cik starpprocedūru konstanšu izplatīšana pārstaigā visas funkcijas, lai pieņemtu klonēšanas lēmumus."

#: params.opt:286
#, no-c-format
msgid "How much can given compilation unit grow because of the interprocedural constant propagation (as a percentage)."
msgstr "Par cik (procentos) dotā kompilēšanas vienība var pieaugt starpprocedūru konstanšu izplatīšanas dēļ."

#: params.opt:290
#, no-c-format
msgid "The size of translation unit that IPA-CP pass considers large."
msgstr "Translācijas vienības izmērs, ko IPA-CP gājiens uzskata par lielu."

#: params.opt:294
#, no-c-format
msgid "Maximum size of a list of values associated with each parameter for interprocedural constant propagation."
msgstr "Maksimālais ar katru parametru saistīto vērtību saraksta izmērs starpprocedūru konstanšu izplatīšanai."

#: params.opt:298
#, no-c-format
msgid "Maximum number of statements visited during jump function offset discovery."
msgstr "Maksimālais apmeklēto priekšrakstu skaits lēciena funkcijas nobīdes noteikšanas laikā."

#: params.opt:302
#, no-c-format
msgid "Maximum number of statements that are visited by IPA formal parameter analysis based on alias analysis in any given function."
msgstr "Maksimālais priekšrakstu skaits, ko jebkurā funkcijā apmeklē uz pārklāšanās (alias) analīzi balstītā IPA formālo parametru analīze."

#: params.opt:306
#, no-c-format
msgid "Maximum number of aggregate content items for a parameter in jump functions and lattices."
msgstr "Maksimālais agregāta satura elementu skaits parametram lēciena funkcijās un režģos."

#: params.opt:310
#, no-c-format
msgid "Maximum number of operations in a parameter expression that can be handled by IPA analysis."
msgstr "Maksimālais operāciju skaits parametra izteiksmē, ko var apstrādāt ar IPA analīzi."

#: params.opt:314
#, no-c-format
msgid "Maximum number of different predicates used to track properties of loops in IPA analysis."
msgstr "Maksimālais dažādo predikātu skaits, kas IPA analīzē izmantoti ciklu īpašību izsekošanai."

#: params.opt:318
#, no-c-format
msgid "Maximal number of boundary endpoints of case ranges of switch statement used during IPA function summary generation."
msgstr "Maksimālais switch priekšraksta case diapazonu robežpunktu skaits, ko izmanto IPA funkciju kopsavilkuma ģenerēšanā."

#: params.opt:322
#, no-c-format
msgid "Minimum probability (as a percentage) of dereferencing of a function pointer parameter for it to be considered for replacement with simple values."
msgstr "Minimālā varbūtība (procentos), ka funkcijas rādītāja parametrs tiks dereferencēts, lai to apsvērtu aizstāšanai ar vienkāršām vērtībām."

#: params.opt:326
#, no-c-format
msgid "Maximum pieces that IPA-SRA tracks per formal parameter, as a consequence, also the maximum number of replacements of a formal parameter."
msgstr "Maksimālais daļu skaits, ko IPA-SRA izseko katram formālajam parametram; tātad arī maksimālais formālā parametra aizstājēju skaits."

#: params.opt:330
#, no-c-format
msgid "Maximum allowed growth of total size of new parameters that ipa-sra replaces a pointer to an aggregate with."
msgstr "Maksimālais atļautais jauno parametru kopējā lieluma pieaugums, ar kuriem ipa-sra aizstāj rādītāju uz agregātu."

#: params.opt:334
#, no-c-format
msgid "Additional maximum allowed growth of total size of new parameters that ipa-sra replaces a pointer to an aggregate with, if it points to a local variable that the caller only writes to and passes it as an argument to functions."
msgstr "Papildu maksimālais atļautais jauno parametru kopējā lieluma pieaugums, ar kuru ipa-sra aizstāj rādītāju uz agregātu, ja tas norāda uz lokālo mainīgo, uz kuru izsaucējs tikai raksta un nodod to kā argumentu funkcijām."

#: params.opt:338
#, no-c-format
msgid "The number of registers in each class kept unused by loop invariant motion."
msgstr "Reģistru skaits katrā klasē, ko cikla invariantu pārvietošana atstāj neizmantotus."

#: params.opt:342
#, no-c-format
msgid "Maximum size of conflict table in MB."
msgstr "Konfliktu tabulas maksimālais izmērs MB."

#: params.opt:346
#, no-c-format
msgid "Approximate function insn number in 1K units triggering simple local RA."
msgstr "Aptuvenais funkcijas insn skaits 1K vienībās, kas izraisa vienkāršu lokālo RA."

#: params.opt:350
#, no-c-format
msgid "Maximum number of loops for regional RA."
msgstr "Maksimālais ciklu skaits apgabalu RA."

#: params.opt:354
#, no-c-format
msgid "Control IRA to consider matching constraint (duplicated operand number) heavily in all available alternatives for preferred register class.  If it is set as zero, it means IRA only respects the matching constraint when it's in the only available alternative with an appropriate register class.  Otherwise, it means IRA checks all available alternatives for preferred register class even if it has found some choice with an appropriate register class and respect the found qualified matching constraint."
msgstr "Likt IRA nopietni ņemt vērā atbilstības ierobežojumu (dublētu operanda numuru) visās pieejamajās alternatīvās vēlamajai reģistru klasei. Ja iestatīts uz nulli, IRA ievēro atbilstības ierobežojumu tikai tad, ja tas ir vienīgajā pieejamajā alternatīvā ar piemērotu reģistru klasi. Citādi IRA pārbauda visas pieejamās alternatīvas vēlamajai reģistru klasei arī tad, ja jau ir atradusi izvēli ar piemērotu reģistru klasi, un ievēro atrasto kvalificēto atbilstības ierobežojumu."

#: params.opt:358
#, no-c-format
msgid "If number of candidates in the set is smaller, we always try to remove unused induction variables during its optimization."
msgstr "Ja kandidātu skaits kopā ir mazāks, optimizācijas laikā vienmēr tiek mēģināts noņemt neizmantotos indukcijas mainīgos."

#: params.opt:362
#, no-c-format
msgid "Bound on number of candidates below that all candidates are considered in induction variable optimizations."
msgstr "Kandidātu skaita ierobežojums, zem kura visi kandidāti tiek ņemti vērā indukcijas mainīgo optimizācijās."

#: params.opt:366
#, no-c-format
msgid "Bound on number of induction variable uses in loop optimized in IV optimizations."
msgstr "Ierobežojums indukcijas mainīgo lietojumu skaitam ciklā, kas tiek optimizēts IV optimizācijās."

#: params.opt:370
#, no-c-format
msgid "The maximum code size growth ratio when expanding into a jump table (as a percentage).  The parameter is used when optimizing for size."
msgstr "Maksimālā koda izmēra pieauguma attiecība (procentos), izvēršot lēcienu tabulā. Parametru izmanto, optimizējot izmēram."

#: params.opt:374
#, no-c-format
msgid "The maximum code size growth ratio when expanding into a jump table (as a percentage).  The parameter is used when optimizing for speed."
msgstr "Maksimālā koda izmēra pieauguma attiecība (procentos), izvēršot lēcienu tabulā. Parametru izmanto, optimizējot ātrumam."

#: params.opt:378
#, no-c-format
msgid "The size of L1 cache line."
msgstr "L1 kešatmiņas rindas izmērs."

#: params.opt:382
#, no-c-format
msgid "The minimum recommended offset between two concurrently-accessed objects to avoid additional performance degradation due to contention introduced by the implementation.  Typically the L1 cache line size, but can be larger to accommodate a variety of target processors with different cache line sizes. C++17 code might use this value in structure layout, but is strongly discouraged from doing so in public ABIs."
msgstr "Minimālā ieteicamā nobīde starp diviem vienlaicīgi piekļūstamiem objektiem, lai izvairītos no papildu veiktspējas pasliktināšanās implementācijas radītās sāncensības dēļ. Parasti tas ir L1 kešatmiņas rindas izmērs, bet var būt lielāks, lai piemērotos dažādiem mērķa procesoriem ar atšķirīgiem kešatmiņas rindu izmēriem. C++17 kods var izmantot šo vērtību struktūru izkārtojumā, taču publiskās ABI to darīt stingri neiesaka."

#: params.opt:391
#, no-c-format
msgid "The maximum recommended size of contiguous memory occupied by two objects accessed with temporal locality by concurrent threads.  Typically the L1 cache line size, but can be smaller to accommodate a variety of target processors with different cache line sizes."
msgstr "Maksimālais ieteicamais nepārtrauktas atmiņas izmērs, ko aizņem divi objekti, kuriem vienlaicīgi pavedieni piekļūst ar laika lokalitāti. Parasti tas ir L1 kešatmiņas rindas izmērs, bet var būt mazāks, lai piemērotos dažādiem mērķa procesoriem ar atšķirīgiem kešatmiņas rindu izmēriem."

#: params.opt:398
#, no-c-format
msgid "The size of L1 cache."
msgstr "L1 kešatmiņas izmērs."

#: params.opt:402
#, no-c-format
msgid "The size of L2 cache."
msgstr "L2 kešatmiņas izmērs."

#: params.opt:406
#, no-c-format
msgid "Maximal growth due to inlining of large function (as a percentage)."
msgstr "Maksimālais pieaugums (procentos) lielas funkcijas iekļaušanas dēļ."

#: params.opt:410
#, no-c-format
msgid "The size of function body to be considered large."
msgstr "Funkcijas ķermeņa izmērs, kas tiek uzskatīts par lielu."

#: params.opt:414
#, no-c-format
msgid "The size of stack frame to be considered large."
msgstr "Steka kadra izmērs, kas tiek uzskatīts par lielu."

#: params.opt:418
#, no-c-format
msgid "Maximal stack frame growth due to inlining (as a percentage)."
msgstr "Maksimālais steka kadra pieaugums (procentos) iekļaušanas dēļ."

#: params.opt:422
#, no-c-format
msgid "The size of translation unit to be considered large."
msgstr "Translācijas vienības izmērs, kas tiek uzskatīts par lielu."

#: params.opt:426
#, no-c-format
msgid "Maximum number of concurrently open C++ module files when lazy loading."
msgstr "Maksimālais vienlaikus atvērto C++ moduļu failu skaits atliktās ielādes laikā."

#: params.opt:430
#, no-c-format
msgid "The minimum cost of an expensive expression in the loop invariant motion."
msgstr "Dārgas izteiksmes minimālās izmaksas cikla invariantu pārvietošanā."

#: params.opt:434
#, no-c-format
msgid "True if a non-short-circuit operation is optimal."
msgstr "Patiess, ja optimāla ir operācija bez īsās shēmas (non-short-circuit)."

#: params.opt:438
#, no-c-format
msgid "Size of tiles for loop blocking."
msgstr "Ciklu bloķēšanas flīžu izmērs."

#: params.opt:442
#, no-c-format
msgid "The maximum number of stmts in loop nest for loop interchange."
msgstr "Maksimālais priekšrakstu skaits ciklu ligzdā ciklu apmaiņai."

#: params.opt:446
#, no-c-format
msgid "The minimum stride ratio for loop interchange to be profitable."
msgstr "Minimālā soļa attiecība, pie kuras ciklu apmaiņa ir izdevīga."

#: params.opt:450
#, no-c-format
msgid "Max basic blocks number in loop for loop invariant motion."
msgstr "Maksimālais pamatbloku skaits ciklā cikla invariantu pārvietošanai."

#: params.opt:454
#, no-c-format
msgid "Maximum number of datarefs in loop for building loop data dependencies."
msgstr "Maksimālais datu atsauču (dataref) skaits ciklā cikla datu atkarību veidošanai."

#: params.opt:458
#, no-c-format
msgid "The maximum number of instructions in an inner loop that is being considered for versioning."
msgstr "Maksimālais instrukciju skaits iekšējā ciklā, ko apsvērt versiju veidošanai."

#: params.opt:462
#, no-c-format
msgid "The maximum number of instructions in an outer loop that is being considered for versioning, on top of the instructions in inner loops."
msgstr "Maksimālais instrukciju skaits ārējā ciklā, ko apsvērt versiju veidošanai, papildus iekšējo ciklu instrukcijām."

#: params.opt:466
#, no-c-format
msgid "Minimal fall-through edge probability as a percentage, used to add BB to inheritance EBB in LRA."
msgstr "Minimālā caurkrišanas (fall-through) šķautnes varbūtība procentos, ko izmanto, lai LRA pievienotu BB mantošanas EBB."

#: params.opt:470
#, no-c-format
msgid "The max number of reload pseudos which are considered during spilling a non-reload pseudo."
msgstr "Maksimālais reload pseidoreģistru skaits, ko ņem vērā, izspiežot (spill) ne-reload pseidoreģistru."

#: params.opt:474
#, no-c-format
msgid "The maximum log2(number of reload pseudos * number of program points) threshold when preferences for other reload pseudos are still considered. Taking these preferences into account helps to improve register allocation. However, for very large functions, a large value can result in significant compilation time and memory consumption. The default value is 30."
msgstr "Maksimālais log2(reload pseidoreģistru skaits * programmas punktu skaits) slieksnis, līdz kuram vēl tiek ņemtas vērā citu reload pseidoreģistru preferences. Šo preferenču ievērošana palīdz uzlabot reģistru piešķiršanu. Tomēr ļoti lielām funkcijām liela vērtība var izraisīt ievērojamu kompilēšanas laiku un atmiņas patēriņu. Noklusējuma vērtība ir 30."

#: params.opt:482
#, no-c-format
msgid "Maximal size of a partition for LTO (in estimated instructions)."
msgstr "LTO nodalījuma maksimālais izmērs (aplēstās instrukcijās)."

#: params.opt:486
#, no-c-format
msgid "Maximal number of LTO partitions streamed in parallel."
msgstr "Maksimālais paralēli straumēto LTO nodalījumu skaits."

#: params.opt:490
#, no-c-format
msgid "Minimal size of a partition for LTO (in estimated instructions)."
msgstr "LTO nodalījuma minimālais izmērs (aplēstās instrukcijās)."

#: params.opt:494
#, no-c-format
msgid "Number of partitions the program should be split to."
msgstr "Nodalījumu skaits, kuros programma jāsadala."

#: params.opt:513
#, no-c-format
msgid "The denominator n of fraction 1/n of the execution frequency of callee to be cloned for a particular caller. Special value of 0 dictates to always clone without a cut-off."
msgstr "Daļas 1/n saucējs n no izsaucamās funkcijas izpildes biežuma, pie kura to klonēt konkrētam izsaucējam. Īpašā vērtība 0 nosaka vienmēr klonēt bez ierobežojuma."

#: params.opt:517
#, no-c-format
msgid "Size cut-off for callee including inlined calls to be cloned for a particular caller."
msgstr "Izmēra ierobežojums izsaucamajai funkcijai (ieskaitot iekļautos izsaukumus), ko klonēt konkrētam izsaucējam."

#: params.opt:521
#, no-c-format
msgid "Maximal size of a locality partition for LTO (in estimated instructions). Value of 0 results in default value being used."
msgstr "LTO lokalitātes nodalījuma maksimālais izmērs (aplēstās instrukcijās). Vērtība 0 nozīmē, ka tiek izmantota noklusējuma vērtība."

#: params.opt:531
#, no-c-format
msgid "Choose static heuristics for locality layout. Option cpp_template groups by C++ template instantiation type."
msgstr "Izvēlēties statisku heiristiku lokalitātes izkārtojumam. Opcija cpp_template grupē pēc C++ veidnes instancēšanas tipa."

#: params.opt:535
#, no-c-format
msgid "The maximum number of instructions to consider to unroll in a loop on average."
msgstr "Maksimālais instrukciju skaits, ko vidēji apsvērt cikla izvēršanai."

#: params.opt:539
#, no-c-format
msgid "The maximum number of insns combine tries to combine."
msgstr "Maksimālais insn skaits, ko combine mēģina apvienot."

#: params.opt:543
#, no-c-format
msgid "The maximum number of instructions that combine searches in order to find the next use of a particular register."
msgstr "Maksimālais instrukciju skaits, ko combine pārmeklē, lai atrastu nākamo konkrētā reģistra lietojumu."

#: params.opt:547
#, no-c-format
msgid "The maximum depth of a loop nest we completely peel."
msgstr "Maksimālais ciklu ligzdas dziļums, ko pilnībā nolobīt (peel)."

#: params.opt:551
#, no-c-format
msgid "The maximum number of peelings of a single loop that is peeled completely."
msgstr "Maksimālais viena pilnībā nolobāma cikla nolobīšanas reižu skaits."

#: params.opt:555
#, no-c-format
msgid "The maximum number of insns of a completely peeled loop."
msgstr "Pilnībā nolobīta cikla maksimālais insn skaits."

#: params.opt:559
#, no-c-format
msgid "The maximum number of incoming edges to consider for crossjumping."
msgstr "Maksimālais ienākošo šķautņu skaits, ko apsvērt krustlēcieniem (crossjumping)."

#: params.opt:563
#, no-c-format
msgid "The maximum instructions CSE process before flushing."
msgstr "Maksimālais instrukciju skaits, ko CSE apstrādā pirms izskalošanas."

#: params.opt:567
#, no-c-format
msgid "The maximum length of path considered in cse."
msgstr "Maksimālais ceļa garums, kas ņemts vērā CSE."

#: params.opt:571
#, no-c-format
msgid "The maximum memory locations recorded by cselib."
msgstr "Maksimālais atmiņas vietu skaits, ko ieraksta cselib."

#: params.opt:575
#, no-c-format
msgid "Maximum count of debug markers to expand or inline."
msgstr "Maksimālais atkļūdošanas marķieru skaits, ko izvērst vai iekļaut."

#: params.opt:579
#, no-c-format
msgid "The maximum number of instructions to consider to fill a delay slot."
msgstr "Maksimālais instrukciju skaits, ko apsvērt aiztures slota aizpildīšanai."

#: params.opt:583
#, no-c-format
msgid "The maximum number of instructions to consider to find accurate live register information."
msgstr "Maksimālais instrukciju skaits, ko apsvērt, lai iegūtu precīzu informāciju par dzīvajiem reģistriem."

#: params.opt:587
#, no-c-format
msgid "Maximum number of active local stores in RTL dead store elimination."
msgstr "Maksimālais aktīvo lokālo saglabāšanu skaits RTL nevajadzīgo saglabāšanu likvidēšanā."

#: params.opt:591
#, no-c-format
msgid "Maximum number of targets to devirtualize."
msgstr "Maksimālais mērķu skaits, ko devirtualizēt."

#: params.opt:595
#, no-c-format
msgid "The maximum number of nested indirect inlining performed by early inliner."
msgstr "Maksimālais ligzdotās netiešās iekļaušanas skaits, ko veic agrīnais iekļāvējs."

#: params.opt:599
#, no-c-format
msgid "Maximum number of fields in a structure before pointer analysis treats the structure as a single variable."
msgstr "Maksimālais lauku skaits struktūrā, pirms rādītāju analīze uzskata struktūru par vienu mainīgo."

#: params.opt:603
#, no-c-format
msgid "Maximum number of instructions to copy when duplicating blocks on a finite state automaton jump thread path."
msgstr "Maksimālais kopējamo instrukciju skaits, dublējot blokus galīgā automāta lēcienu pavedināšanas ceļā."

#: params.opt:607
#, no-c-format
msgid "The maximum ratio of insertions to deletions of expressions in GCSE."
msgstr "Maksimālā izteiksmju ievietošanu un dzēšanu attiecība GCSE."

#: params.opt:611
#, no-c-format
msgid "The maximum amount of memory to be allocated by GCSE, in kilobytes."
msgstr "Maksimālais atmiņas apjoms kilobaitos, ko var piešķirt GCSE."

#: params.opt:615
#, no-c-format
msgid "The maximum number of insns to duplicate when unfactoring computed gotos."
msgstr "Maksimālais dublējamo insn skaits, atfaktorējot aprēķinātos goto."

#: params.opt:619
#, no-c-format
msgid "The maximum expansion factor when copying basic blocks."
msgstr "Maksimālais izvēršanas koeficients, kopējot pamatblokus."

#: params.opt:623
#, no-c-format
msgid "Maximum depth of search in the dominator tree for expressions to hoist."
msgstr "Maksimālais meklēšanas dziļums dominatoru kokā, meklējot paceļamās izteiksmes."

#: params.opt:627
#, no-c-format
msgid "Maximum loop depth of a call which is considered for inlining functions called once."
msgstr "Maksimālais izsaukuma ciklu dziļums, pie kura apsvērt vienreiz izsauktu funkciju iekļaušanu."

#: params.opt:631
#, no-c-format
msgid "Maximum combined size of caller and callee which is inlined if callee is called once."
msgstr "Maksimālais izsaucēja un izsaucamās funkcijas kopējais izmērs, pie kura tiek veikta iekļaušana, ja izsaucamā funkcija tiek izsaukta vienreiz."

#: params.opt:635
#, no-c-format
msgid "The maximum number of instructions when automatically inlining."
msgstr "Maksimālais instrukciju skaits automātiskajā iekļaušanā."

#: params.opt:639
#, no-c-format
msgid "The maximum number of instructions inline function can grow to via recursive inlining."
msgstr "Maksimālais instrukciju skaits, līdz kuram iekļaujama funkcija var pieaugt rekursīvās iekļaušanas rezultātā."

#: params.opt:643
#, no-c-format
msgid "The maximum number of instructions non-inline function can grow to via recursive inlining."
msgstr "Maksimālais instrukciju skaits, līdz kuram neiekļaujama funkcija var pieaugt rekursīvās iekļaušanas rezultātā."

#: params.opt:647
#, no-c-format
msgid "The maximum number of instructions in a single function eligible for inlining."
msgstr "Maksimālais instrukciju skaits vienā funkcijā, kas piemērota iekļaušanai."

#: params.opt:651
#, no-c-format
msgid "The maximum number of instructions when inlining for size."
msgstr "Maksimālais instrukciju skaits, iekļaujot izmēra optimizācijai."

#: params.opt:655
#, no-c-format
msgid "The maximum number of instructions when automatically inlining small functions."
msgstr "Maksimālais instrukciju skaits, automātiski iekļaujot mazas funkcijas."

#: params.opt:659
#, no-c-format
msgid "The maximum depth of recursive inlining for inline functions."
msgstr "Maksimālais rekursīvās iekļaušanas dziļums iekļaujamām funkcijām."

#: params.opt:663
#, no-c-format
msgid "The maximum depth of recursive inlining for non-inline functions."
msgstr "Maksimālais rekursīvās iekļaušanas dziļums neiekļaujamām funkcijām."

#: params.opt:667
#, no-c-format
msgid "Maximum number of isl operations, 0 means unlimited."
msgstr "Maksimālais isl operāciju skaits; 0 nozīmē neierobežotu."

#: params.opt:671
#, no-c-format
msgid "Bound on the cost of an expression to compute the number of iterations."
msgstr "Izteiksmes izmaksu ierobežojums iterāciju skaita aprēķināšanai."

#: params.opt:675
#, no-c-format
msgid "Bound on the number of iterations the brute force # of iterations analysis algorithm evaluates."
msgstr "Ierobežojums iterāciju skaitam, ko novērtē pilnās pārlases iterāciju skaita analīzes algoritms."

#: params.opt:679
#, no-c-format
msgid "Maximum number of statements allowed in a block that needs to be duplicated when threading jumps."
msgstr "Maksimālais atļautais priekšrakstu skaits blokā, kas jādublē lēcienu pavedināšanas laikā."

#: params.opt:683
#, no-c-format
msgid "Search space limit for the backwards jump threader."
msgstr "Meklēšanas telpas ierobežojums atpakaļvērstajam lēcienu pavedinātājam."

#: params.opt:687
#, no-c-format
msgid "The maximum number of RTL nodes that can be recorded as combiner's last value."
msgstr "Maksimālais RTL mezglu skaits, ko var ierakstīt kā kombinatora pēdējo vērtību."

#: params.opt:691
#, no-c-format
msgid "The maximum number of insns in loop header duplicated by the copy loop headers pass."
msgstr "Maksimālais insn skaits cikla galvenē, ko dublē ciklu galveņu kopēšanas gājiens."

#: params.opt:695
#, no-c-format
msgid "The maximum number of backtrack attempts the scheduler should make when modulo scheduling a loop."
msgstr "Maksimālais atkāpšanās (backtrack) mēģinājumu skaits, kas plānotājam jāveic, veicot cikla modulo plānošanu."

#: params.opt:699
#, no-c-format
msgid "Minimum page size for warning purposes."
msgstr "Minimālais lapas izmērs brīdinājuma nolūkiem."

#: params.opt:703
#, no-c-format
msgid "Maximum length of partial antic set when performing tree pre optimization."
msgstr "Daļējās antic kopas maksimālais garums, veicot koku PRE optimizāciju."

#: params.opt:707
#, no-c-format
msgid "The maximum number of branches on the path through the peeled sequence."
msgstr "Maksimālais zarošanos skaits ceļā caur nolobīto secību."

#: params.opt:711
#, no-c-format
msgid "The maximum number of peelings of a single loop."
msgstr "Viena cikla maksimālais nolobīšanas reižu skaits."

#: params.opt:715
#, no-c-format
msgid "The maximum number of insns of a peeled loop."
msgstr "Nolobīta cikla maksimālais insn skaits."

#: params.opt:719
#, no-c-format
msgid "The maximum length of scheduling's pending operations list."
msgstr "Plānošanas gaidošo operāciju saraksta maksimālais garums."

#: params.opt:723 params.opt:767
#, no-c-format
msgid "The maximum number of blocks in a region to be considered for interblock scheduling."
msgstr "Maksimālais bloku skaits apgabalā, ko apsvērt starpbloku plānošanai."

#: params.opt:727 params.opt:771
#, no-c-format
msgid "The maximum number of insns in a region to be considered for interblock scheduling."
msgstr "Maksimālais insn skaits apgabalā, ko apsvērt starpbloku plānošanai."

#: params.opt:731
#, no-c-format
msgid "Maximum depth of sqrt chains to use when synthesizing exponentiation by a real constant."
msgstr "Maksimālais kvadrātsakņu ķēžu dziļums, ko izmantot, sintezējot kāpināšanu ar reālu konstanti."

#: params.opt:735
#, no-c-format
msgid "The maximum number of loop iterations we predict statically."
msgstr "Maksimālais cikla iterāciju skaits, ko prognozē statiski."

#: params.opt:739
#, no-c-format
msgid "The maximum number of instructions to search backward when looking for equivalent reload."
msgstr "Maksimālais instrukciju skaits, ko pārmeklēt atpakaļ, meklējot ekvivalentu reload."

#: params.opt:743
#, no-c-format
msgid "Maximum number of insns in a basic block to consider for RTL if-conversion."
msgstr "Maksimālais insn skaits pamatblokā, ko apsvērt RTL if-konversijai."

#: params.opt:747
#, no-c-format
msgid "Maximum permissible cost for the sequence that would be generated by the RTL if-conversion pass for a branch that is considered predictable."
msgstr "Maksimālās pieļaujamās izmaksas secībai, ko RTL if-konversijas gājiens ģenerētu zarošanai, kas tiek uzskatīta par prognozējamu."

#: params.opt:751
#, no-c-format
msgid "Maximum permissible cost for the sequence that would be generated by the RTL if-conversion pass for a branch that is considered unpredictable."
msgstr "Maksimālās pieļaujamās izmaksas secībai, ko RTL if-konversijas gājiens ģenerētu zarošanai, kas tiek uzskatīta par neprognozējamu."

#: params.opt:755
#, no-c-format
msgid "The maximum number of iterations through CFG to extend regions."
msgstr "Maksimālais iterāciju skaits caur CFG apgabalu paplašināšanai."

#: params.opt:759
#, no-c-format
msgid "The maximum conflict delay for an insn to be considered for speculative motion."
msgstr "Maksimālā konflikta aizture, pie kuras insn var apsvērt spekulatīvai pārvietošanai."

#: params.opt:763
#, no-c-format
msgid "The maximum number of instructions ready to be issued to be considered by the scheduler during the first scheduling pass."
msgstr "Maksimālais izdošanai gatavo instrukciju skaits, ko plānotājs apsver pirmajā plānošanas gājienā."

#: params.opt:775
#, no-c-format
msgid "Maximum length of candidate scans for straight-line strength reduction."
msgstr "Maksimālais kandidātu skenēšanas garums taisnās līnijas stipruma samazināšanai (straight-line strength reduction)."

#: params.opt:779
#, no-c-format
msgid "Maximum number of may-defs visited when devirtualizing speculatively."
msgstr "Maksimālais apmeklēto may-def skaits, spekulatīvi devirtualizējot."

#: params.opt:783
#, no-c-format
msgid "Maximum recursion depth allowed when querying a property of an SSA name."
msgstr "Maksimālais atļautais rekursijas dziļums, vaicājot SSA nosaukuma īpašību."

#: params.opt:787
#, no-c-format
msgid "Maximum number of constant stores to merge in the store merging pass."
msgstr "Maksimālais konstanšu saglabāšanu skaits, ko apvienot saglabāšanu apvienošanas gājienā."

#: params.opt:791
#, no-c-format
msgid "Maximum number of conditional store pairs that can be sunk."
msgstr "Maksimālais nosacīto saglabāšanu pāru skaits, ko var nogremdēt."

#: params.opt:795 params.opt:799
#, no-c-format
msgid "Maximum number of store chains to track at the same time in the store merging pass."
msgstr "Maksimālais saglabāšanu ķēžu skaits, ko vienlaikus izsekot saglabāšanu apvienošanas gājienā."

#: params.opt:803
#, no-c-format
msgid "Maximum amount of similar bbs to compare a bb with."
msgstr "Maksimālais līdzīgu pamatbloku skaits, ar ko salīdzināt pamatbloku."

#: params.opt:807
#, no-c-format
msgid "Maximum amount of iterations of the pass over a function."
msgstr "Maksimālais gājiena iterāciju skaits vienai funkcijai."

#: params.opt:811
#, no-c-format
msgid "Maximum number of strings for which strlen optimization pass tracks string lengths."
msgstr "Maksimālais virkņu skaits, kurām strlen optimizācijas gājiens izseko virkņu garumus."

#: params.opt:815
#, no-c-format
msgid "Maximum number of arguments in a PHI supported by TREE if-conversion unless the loop is marked with simd pragma."
msgstr "Maksimālais argumentu skaits PHI, ko atbalsta TREE if-konversija, ja vien cikls nav atzīmēts ar simd pragmu."

#: params.opt:819
#, no-c-format
msgid "The maximum number of unrollings of a single loop."
msgstr "Viena cikla maksimālais izvēršanas reižu skaits."

#: params.opt:823
#, no-c-format
msgid "The maximum number of instructions to consider to unroll in a loop."
msgstr "Maksimālais instrukciju skaits, ko apsvērt cikla izvēršanai."

#: params.opt:827
#, no-c-format
msgid "The maximum number of insns of an unswitched loop."
msgstr "Atzarota (unswitched) cikla maksimālais insn skaits."

#: params.opt:831
#, no-c-format
msgid "The maximum depth of a loop nest to be unswitched."
msgstr "Atzarojamas (unswitch) ciklu ligzdas maksimālais dziļums."

#: params.opt:835
#, no-c-format
msgid "If -fvariable-expansion-in-unroller is used, the maximum number of times that an individual variable is expanded during loop unrolling."
msgstr "Ja izmanto -fvariable-expansion-in-unroller, maksimālais reižu skaits, cik atsevišķs mainīgais tiek izvērsts cikla izvēršanas laikā."

#: params.opt:839
#, no-c-format
msgid "Maximum recursion depth for expanding var tracking expressions."
msgstr "Maksimālais rekursijas dziļums mainīgo izsekošanas izteiksmju izvēršanai."

#: params.opt:843
#, no-c-format
msgid "Maximum size of loc list for which reverse ops should be added."
msgstr "Maksimālais atrašanās vietu (loc) saraksta izmērs, kuram vēl pievienot apgrieztās operācijas."

#: params.opt:847
#, no-c-format
msgid "Maximum size of var tracking hash tables."
msgstr "Maksimālais mainīgo izsekošanas jaucējtabulu izmērs."

#: params.opt:851
#, no-c-format
msgid "Maximum number of VALUEs handled during a single find_base_term call."
msgstr "Maksimālais VALUE skaits, kas tiek apstrādāts viena find_base_term izsaukuma laikā."

#: params.opt:855
#, no-c-format
msgid "The minimum number of matching instructions to consider for crossjumping."
msgstr "Minimālais sakrītošo instrukciju skaits, ko apsvērt krustlēcieniem."

#: params.opt:859
#, no-c-format
msgid "Inline recursively only when the probability of call being executed exceeds the parameter."
msgstr "Iekļaut rekursīvi tikai tad, ja izsaukuma izpildes varbūtība pārsniedz parametru."

#: params.opt:863
#, no-c-format
msgid "Minimum ratio of insns to prefetches to enable prefetching for a loop with an unknown trip count."
msgstr "Minimālā insn un priekšielāžu attiecība, lai iespējotu priekšielādi ciklam ar nezināmu iterāciju skaitu."

#: params.opt:867
#, no-c-format
msgid "The minimum threshold for probability of semi-invariant condition statement to trigger loop split."
msgstr "Minimālais daļēji invarianta nosacījuma priekšraksta varbūtības slieksnis, lai izraisītu cikla sadalīšanu."

#: params.opt:871
#, no-c-format
msgid "The minimum UID to be used for a nondebug insn."
msgstr "Minimālais UID, ko izmantot ne-atkļūdošanas insn."

#: params.opt:875
#, no-c-format
msgid "The minimum size of variables taking part in stack slot sharing when not optimizing."
msgstr "Minimālais to mainīgo izmērs, kas piedalās steka slotu koplietošanā, ja netiek optimizēts."

#: params.opt:879
#, no-c-format
msgid "The minimum probability of reaching a source block for interblock speculative scheduling."
msgstr "Minimālā varbūtība sasniegt avota bloku starpbloku spekulatīvai plānošanai."

#: params.opt:883
#, no-c-format
msgid "If -ftree-vectorize is used, the minimal loop bound of a loop to be considered for vectorization."
msgstr "Ja izmanto -ftree-vectorize, minimālā cikla robeža, lai ciklu apsvērtu vektorizācijai."

#: params.opt:887
#, no-c-format
msgid "--param=openacc-kernels=[decompose|parloops]\tSpecify mode of OpenACC 'kernels' constructs handling."
msgstr "--param=openacc-kernels=[decompose|parloops]\tNorādīt OpenACC 'kernels' konstrukciju apstrādes režīmu."

#: params.opt:900
#, no-c-format
msgid "--param=openacc-privatization=[quiet|noisy]\tSpecify mode of OpenACC privatization diagnostics."
msgstr "--param=openacc-privatization=[quiet|noisy]\tNorādīt OpenACC privatizācijas diagnostikas režīmu."

#: params.opt:913
#, no-c-format
msgid "Chunk size of omp schedule for loops parallelized by parloops."
msgstr "omp schedule gabala izmērs cikliem, ko paralelizē parloops."

#: params.opt:917
#, no-c-format
msgid "Minimum number of iterations per thread of an innermost parallelized loop."
msgstr "Minimālais iterāciju skaits uz pavedienu visiekšējam paralelizētajam ciklam."

#: params.opt:921
#, no-c-format
msgid "--param=parloops-schedule=[static|dynamic|guided|auto|runtime]\tSchedule type of omp schedule for loops parallelized by parloops."
msgstr "--param=parloops-schedule=[static|dynamic|guided|auto|runtime]\tomp schedule veids cikliem, ko paralelizē parloops."

#: params.opt:943
#, no-c-format
msgid "Maximum probability of the entry BB of split region (as a percentage relative to entry BB of the function) to make partial inlining happen."
msgstr "Sadalītā apgabala ieejas BB maksimālā varbūtība (procentos attiecībā pret funkcijas ieejas BB), lai notiktu daļēja iekļaušana."

#: params.opt:947
#, no-c-format
msgid "Maximum number of statements allowed between a defining statement and the end of the basic block before extending the live range is considered profitable."
msgstr "Maksimālais atļautais priekšrakstu skaits starp definējošo priekšrakstu un pamatbloka beigām, pirms dzīvības diapazona paplašināšana tiek uzskatīta par izdevīgu."

#: params.opt:951
#, no-c-format
msgid "Maximal estimated outcome of branch considered predictable."
msgstr "Maksimālais aplēstais zarošanās iznākums, ko uzskata par prognozējamu."

#: params.opt:955
#, no-c-format
msgid "Whether software prefetch hints should be issued for non-constant strides."
msgstr "Vai programmatūras priekšielādes norādes jāizdod nekonstantiem soļiem."

#: params.opt:959
#, no-c-format
msgid "The number of insns executed before prefetch is completed."
msgstr "Insn skaits, kas tiek izpildīts, pirms priekšielāde tiek pabeigta."

#: params.opt:963
#, no-c-format
msgid "Minimum ratio of insns to mem ops to enable prefetching in a loop."
msgstr "Minimālā insn un atmiņas operāciju attiecība, lai iespējotu priekšielādi ciklā."

#: params.opt:967
#, no-c-format
msgid "The minimum constant stride beyond which we should use prefetch hints for."
msgstr "Minimālais konstantais solis, virs kura izmantot priekšielādes norādes."

#: params.opt:971
#, no-c-format
msgid "Use internal function id in profile lookup."
msgstr "Profila uzmeklēšanā izmantot iekšējo funkcijas ID."

#: params.opt:975
#, no-c-format
msgid "--param=ranger-debug=[none|trace|gori|cache|tracegori|all] Specifies the output mode for debugging ranger."
msgstr "--param=ranger-debug=[none|trace|gori|cache|tracegori|all] Norāda ranger atkļūdošanas izvades režīmu."

#: params.opt:1000
#, no-c-format
msgid "Maximum depth of logical expression evaluation ranger looks through when evaluating outgoing edge ranges."
msgstr "Maksimālais loģiskās izteiksmes izvērtēšanas dziļums, ko ranger pārskata, izvērtējot izejošo šķautņu diapazonus."

#: params.opt:1005
#, no-c-format
msgid "Maximum depth of instruction chains to consider for recomputation in the outgoing range calculator."
msgstr "Maksimālais instrukciju ķēžu dziļums, ko apsvērt pārrēķināšanai izejošā diapazona aprēķinātājā."

#: params.opt:1010
#, no-c-format
msgid "Maximum number of relations the oracle registers in a basic block."
msgstr "Maksimālais attiecību skaits, ko orākuls reģistrē vienā pamatblokā."

#: params.opt:1014
#, no-c-format
msgid "Work bound when discovering transitive relations from existing relations."
msgstr "Darba ierobežojums, atklājot tranzitīvas attiecības no esošajām attiecībām."

#: params.opt:1018
#, no-c-format
msgid "Maximum depth of a loop nest to fully value-number optimistically."
msgstr "Maksimālais ciklu ligzdas dziļums pilnai optimistiskai vērtību numurēšanai."

#: params.opt:1022
#, no-c-format
msgid "Maximum number of disambiguations to perform per memory access."
msgstr "Maksimālais veicamo atšķiršanu (disambiguation) skaits uz vienu atmiņas piekļuvi."

#: params.opt:1026
#, no-c-format
msgid "Bound on the complexity of the expressions in the scalar evolutions analyzer."
msgstr "Ierobežojums izteiksmju sarežģītībai skalāro evolūciju analizatorā."

#: params.opt:1030
#, no-c-format
msgid "Bound on size of expressions used in the scalar evolutions analyzer."
msgstr "Ierobežojums izteiksmju izmēram skalāro evolūciju analizatorā."

#: params.opt:1034
#, no-c-format
msgid "Hardware autoprefetcher scheduler model control flag.  Number of lookahead cycles the model looks into, at '0' only enable instruction sorting heuristic.  Disabled by default."
msgstr "Aparatūras automātiskās priekšielādes plānotāja modeļa vadības karogs. Apskates uz priekšu ciklu skaits, ko modelis aplūko; ar '0' tiek iespējota tikai instrukciju kārtošanas heiristika. Pēc noklusējuma atspējots."

#: params.opt:1038
#, no-c-format
msgid "Minimal distance between possibly conflicting store and load."
msgstr "Minimālais attālums starp iespējami konfliktējošu saglabāšanu un ielādi."

#: params.opt:1042
#, no-c-format
msgid "Which -fsched-pressure algorithm to apply."
msgstr "Kuru -fsched-pressure algoritmu lietot."

#: params.opt:1046
#, no-c-format
msgid "The minimal probability of speculation success (as a percentage), so that speculative insns are scheduled."
msgstr "Minimālā spekulācijas veiksmes varbūtība (procentos), lai spekulatīvās insn tiktu ieplānotas."

#: params.opt:1050
#, no-c-format
msgid "The minimum probability an edge must have for the scheduler to save its state across it."
msgstr "Minimālā varbūtība, kāda jābūt šķautnei, lai plānotājs saglabātu savu stāvokli pāri tai."

#: params.opt:1054
#, no-c-format
msgid "Maximum number of instructions in the ready list that are considered eligible for renaming."
msgstr "Maksimālais instrukciju skaits gatavības sarakstā, ko uzskata par piemērotām pārdēvēšanai."

#: params.opt:1058
#, no-c-format
msgid "The maximum size of the lookahead window of selective scheduling."
msgstr "Selektīvās plānošanas apskates uz priekšu loga maksimālais izmērs."

#: params.opt:1062
#, no-c-format
msgid "Maximum number of times that an insn could be scheduled."
msgstr "Maksimālais reižu skaits, cik insn var tikt ieplānota."

#: params.opt:1066
#, no-c-format
msgid "The number of prefetches that can run at the same time."
msgstr "Vienlaikus izpildāmo priekšielāžu skaits."

#: params.opt:1070
#, no-c-format
msgid "Target block's relative execution frequency (as a percentage) required to sink a statement."
msgstr "Mērķa bloka relatīvais izpildes biežums (procentos), kas nepieciešams, lai nogremdētu priekšrakstu."

#: params.opt:1074
#, no-c-format
msgid "The number of cycles the swing modulo scheduler considers when checking conflicts using DFA."
msgstr "Ciklu skaits, ko swing modulo plānotājs ņem vērā, pārbaudot konfliktus ar DFA."

#: params.opt:1078
#, no-c-format
msgid "A threshold on the average loop count considered by the swing modulo scheduler."
msgstr "Vidējā cikla iterāciju skaita slieksnis, ko ņem vērā swing modulo plānotājs."

#: params.opt:1082
#, no-c-format
msgid "A factor for tuning the upper bound that swing modulo scheduler uses for scheduling a loop."
msgstr "Koeficients augšējās robežas noskaņošanai, ko swing modulo plānotājs izmanto cikla plānošanai."

#: params.opt:1086
#, no-c-format
msgid "The minimum value of stage count that swing modulo scheduler generates."
msgstr "Minimālā posmu skaita vērtība, ko ģenerē swing modulo plānotājs."

#: params.opt:1090
#, no-c-format
msgid "Maximum size, in storage units, of an aggregate which should be considered for scalarization when compiling for size."
msgstr "Maksimālais agregāta izmērs glabāšanas vienībās, ko apsvērt skalarizācijai, kompilējot izmēram."

#: params.opt:1094
#, no-c-format
msgid "Maximum size, in storage units, of an aggregate which should be considered for scalarization when compiling for speed."
msgstr "Maksimālais agregāta izmērs glabāšanas vienībās, ko apsvērt skalarizācijai, kompilējot ātrumam."

#: params.opt:1098
#, no-c-format
msgid "Maximum number of artificial accesses to enable forward propagation that Scalar Replacement of Aggregates keeps for one local variable."
msgstr "Maksimālais mākslīgo piekļuvju skaits tiešās izplatīšanas (forward propagation) iespējošanai, ko agregātu skalārā aizstāšana (SRA) uztur vienam lokālajam mainīgajam."

#: params.opt:1102
#, no-c-format
msgid "The maximum number of SSA_NAME assignments to follow in determining a value."
msgstr "Maksimālais SSA_NAME piešķīrumu skaits, kam sekot, nosakot vērtību."

#: params.opt:1106
#, no-c-format
msgid "The lower bound for a buffer to be considered for stack smashing protection."
msgstr "Bufera izmēra apakšējā robeža, lai to apsvērtu steka graušanas (stack smashing) aizsardzībai."

#: params.opt:1110
#, no-c-format
msgid "Size of the stack guard expressed as a power of two in bytes."
msgstr "Steka sarga izmērs baitos, izteikts kā divnieka pakāpe."

#: params.opt:1114
#, no-c-format
msgid "Interval in which to probe the stack expressed as a power of two in bytes."
msgstr "Steka zondēšanas intervāls baitos, izteikts kā divnieka pakāpe."

#: params.opt:1118
#, no-c-format
msgid "Allow the store merging pass to introduce unaligned stores if it is legal to do so."
msgstr "Atļaut saglabāšanu apvienošanas gājienam ieviest neizlīdzinātas saglabāšanas, ja tas ir pieļaujami."

#: params.opt:1122
#, no-c-format
msgid "Maximum size of a single store merging region in bytes."
msgstr "Viena saglabāšanu apvienošanas apgabala maksimālais izmērs baitos."

#: params.opt:1126
#, no-c-format
msgid "Maximum number of instruction distance that a small store forwarded to a larger load may stall. Value '0' disables the cost checks for the avoid-store-forwarding pass."
msgstr "Maksimālais instrukciju attālums, par kādu maza saglabāšana, kas pārsūtīta lielākai ielādei, var aizkavēt izpildi. Vērtība '0' atspējo izmaksu pārbaudes avoid-store-forwarding gājienam."

#: params.opt:1130
#, no-c-format
msgid "The maximum ratio between array size and switch branches for a switch conversion to take place."
msgstr "Maksimālā attiecība starp masīva izmēru un switch zarojumiem, lai notiktu switch pārveidošana."

#: params.opt:1134
#, no-c-format
msgid "Maximum number of bases stored in each modref tree."
msgstr "Maksimālais bāzu skaits, kas saglabāts katrā modref kokā."

#: params.opt:1138
#, no-c-format
msgid "Maximum number of references stored in each modref base."
msgstr "Maksimālais atsauču skaits, kas saglabāts katrā modref bāzē."

#: params.opt:1142
#, no-c-format
msgid "Maximum number of accesses stored in each modref reference."
msgstr "Maksimālais piekļuvju skaits, kas saglabāts katrā modref atsaucē."

#: params.opt:1146
#, no-c-format
msgid "Maximum number of tests performed by modref query."
msgstr "Maksimālais pārbaužu skaits, ko veic modref vaicājums."

#: params.opt:1150
#, no-c-format
msgid "Maximum depth of DFS walk used by modref escape analysis."
msgstr "Maksimālais DFS apstaigāšanas dziļums, ko izmanto modref izbēgšanas analīze."

#: params.opt:1154
#, no-c-format
msgid "Maximum number of escape points tracked by modref per SSA-name."
msgstr "Maksimālais izbēgšanas punktu skaits, ko modref izseko katram SSA nosaukumam."

#: params.opt:1158
#, no-c-format
msgid "Maximum number of times a given range is adjusted during the dataflow."
msgstr "Maksimālais reižu skaits, cik datu plūsmas laikā tiek koriģēts dotais diapazons."

#: params.opt:1162
#, no-c-format
msgid "--param=threader-debug=[none|all] Enables verbose dumping of the threader solver."
msgstr "--param=threader-debug=[none|all] Iespējo detalizētu pavedinātāja risinātāja izmešanu."

#: params.opt:1175
#, no-c-format
msgid "Size in bytes after which thread-local aggregates should be instrumented with the logging functions instead of save/restore pairs."
msgstr "Izmērs baitos, virs kura pavedienlokālie agregāti jāinstrumentē ar žurnalēšanas funkcijām, nevis saglabāšanas/atjaunošanas pāriem."

#: params.opt:1179
#, no-c-format
msgid "The percentage of function, weighted by execution frequency, that must be covered by trace formation. Used when profile feedback is not available."
msgstr "Funkcijas daļa procentos, svērta pēc izpildes biežuma, kas jāaptver trašu veidošanai. Izmanto, ja profila atgriezeniskā saite nav pieejama."

#: params.opt:1183
#, no-c-format
msgid "The percentage of function, weighted by execution frequency, that must be covered by trace formation. Used when profile feedback is available."
msgstr "Funkcijas daļa procentos, svērta pēc izpildes biežuma, kas jāaptver trašu veidošanai. Izmanto, ja profila atgriezeniskā saite ir pieejama."

#: params.opt:1187
#, no-c-format
msgid "Maximal code growth caused by tail duplication (as a percentage)."
msgstr "Maksimālais koda pieaugums (procentos), ko izraisa astes dublēšana."

#: params.opt:1191
#, no-c-format
msgid "Stop forward growth if the probability of best edge is less than this threshold (as a percentage). Used when profile feedback is not available."
msgstr "Pārtraukt augšanu uz priekšu, ja labākās šķautnes varbūtība ir mazāka par šo slieksni (procentos). Izmanto, ja profila atgriezeniskā saite nav pieejama."

#: params.opt:1195
#, no-c-format
msgid "Stop forward growth if the probability of best edge is less than this threshold (as a percentage). Used when profile feedback is available."
msgstr "Pārtraukt augšanu uz priekšu, ja labākās šķautnes varbūtība ir mazāka par šo slieksni (procentos). Izmanto, ja profila atgriezeniskā saite ir pieejama."

#: params.opt:1199
#, no-c-format
msgid "Stop reverse growth if the reverse probability of best edge is less than this threshold (as a percentage)."
msgstr "Pārtraukt augšanu atpakaļ, ja labākās šķautnes apgrieztā varbūtība ir mazāka par šo slieksni (procentos)."

#: params.opt:1203
#, no-c-format
msgid "Set the maximum number of instructions executed in parallel in reassociated tree.  If 0, use the target-dependent heuristic."
msgstr "Iestatīt maksimālo paralēli izpildāmo instrukciju skaitu reasociētajā kokā. Ja 0, izmanto no mērķa atkarīgu heiristiku."

#: params.opt:1207
#, no-c-format
msgid "Emit special instrumentation for accesses to volatiles."
msgstr "Izvadīt īpašu instrumentāciju piekļuvēm volatile mainīgajiem."

#: params.opt:1211
#, no-c-format
msgid "Emit instrumentation calls to __tsan_func_entry() and __tsan_func_exit()."
msgstr "Izvadīt instrumentācijas izsaukumus uz __tsan_func_entry() un __tsan_func_exit()."

#: params.opt:1215
#, no-c-format
msgid "Maximum number of nested calls to search for control dependencies during uninitialized variable analysis."
msgstr "Maksimālais ligzdoto izsaukumu skaits, kuros meklēt vadības atkarības neinicializēto mainīgo analīzē."

#: params.opt:1219
#, no-c-format
msgid "Maximum number of predicates anded for each predicate ored in the normalized predicate chain."
msgstr "Maksimālais ar UN apvienoto predikātu skaits katram ar VAI apvienotajam predikātam normalizētajā predikātu ķēdē."

#: params.opt:1224
#, no-c-format
msgid "Maximum number of predicates ored in the normalized predicate chain."
msgstr "Maksimālais ar VAI apvienoto predikātu skaits normalizētajā predikātu ķēdē."

#: params.opt:1228
#, no-c-format
msgid "Maximum amount of work done to prune paths where the variable is always initialized."
msgstr "Maksimālais darba apjoms, veicot ceļu apgriešanu, kuros mainīgais vienmēr ir inicializēts."

#: params.opt:1232
#, no-c-format
msgid "Instruction accounted for function prologue, epilogue and other overhead."
msgstr "Instrukcijas, ko pieskaita funkcijas prologam, epilogam un citām papildizmaksām."

#: params.opt:1236
#, no-c-format
msgid "Time accounted for function prologue, epilogue and other overhead."
msgstr "Laiks, ko pieskaita funkcijas prologam, epilogam un citām papildizmaksām."

#: params.opt:1240
#, no-c-format
msgid "Instruction accounted for function thunk overhead."
msgstr "Instrukcijas, ko pieskaita funkcijas thunk papildizmaksām."

#: params.opt:1244
#, no-c-format
msgid "Time accounted for function thunk overhead."
msgstr "Laiks, ko pieskaita funkcijas thunk papildizmaksām."

#: params.opt:1248
#, no-c-format
msgid "The denominator n of fraction 1/n of the number of profiled runs of the entire program below which the execution count of a basic block must be in order for the basic block to be considered unlikely."
msgstr "Daļas 1/n saucējs n no visas programmas profilēto izpildījumu skaita, zem kura jābūt pamatbloka izpildes skaitam, lai pamatbloku uzskatītu par maz ticamu."

#: params.opt:1252
#, no-c-format
msgid "Maximum unroll factor for the unroll-and-jam transformation."
msgstr "Maksimālais izvēršanas koeficients unroll-and-jam transformācijai."

#: params.opt:1256
#, no-c-format
msgid "Minimum percentage of memrefs that must go away for unroll-and-jam to be considered profitable."
msgstr "Minimālā memref daļa procentos, kam jāizzūd, lai unroll-and-jam tiktu uzskatīts par izdevīgu."

#: params.opt:1260
#, no-c-format
msgid "Use direct poisoning/unpoisoning instructions for variables smaller or equal to this number."
msgstr "Mainīgajiem, kas ir mazāki par šo skaitli vai vienādi ar to, izmantot tiešās saindēšanas/atsaindēšanas instrukcijas."

#: params.opt:1264
#, no-c-format
msgid "Whether to use canonical types."
msgstr "Vai izmantot kanoniskos tipus."

#: params.opt:1268
#, no-c-format
msgid "Enable loop epilogue vectorization using smaller vector size."
msgstr "Iespējot cikla epiloga vektorizāciju, izmantojot mazāku vektora izmēru."

#: params.opt:1272
#, no-c-format
msgid "Maximum number of possible vector layouts (such as permutations) to consider when optimizing to-be-vectorized code."
msgstr "Maksimālais iespējamo vektoru izkārtojumu (piemēram, permutāciju) skaits, kas jāņem vērā, optimizējot vektorizējamo kodu."

#: params.opt:1276
#, no-c-format
msgid "Maximum number of loop peels to enhance alignment of data references in a loop."
msgstr "Maksimālais cikla nolobīšanu skaits datu atsauču izlīdzinājuma uzlabošanai ciklā."

#: params.opt:1280
#, no-c-format
msgid "Bound on number of runtime checks inserted by the vectorizer's loop versioning for alias check."
msgstr "Ierobežojums izpildlaika pārbaužu skaitam, ko vektorizētāja cikla versiju veidošana ievieto pārklāšanās (alias) pārbaudei."

#: params.opt:1284
#, no-c-format
msgid "Bound on number of runtime checks inserted by the vectorizer's loop versioning for alignment check."
msgstr "Ierobežojums izpildlaika pārbaužu skaitam, ko vektorizētāja cikla versiju veidošana ievieto izlīdzinājuma pārbaudei."

#: params.opt:1288
#, no-c-format
msgid "Controls how loop vectorizer uses partial vectors.  0 means never, 1 means only for loops whose need to iterate can be removed, 2 means for all loops.  The default value is 2."
msgstr "Kontrolē, kā cikla vektorizētājs izmanto daļējus vektorus. 0 nozīmē nekad, 1 — tikai cikliem, kuru iterēšanas nepieciešamību var novērst, 2 — visiem cikliem. Noklusējuma vērtība ir 2."

#: params.opt:1292
#, no-c-format
msgid "The maximum factor which the loop vectorizer applies to the cost of statements in an inner loop relative to the loop being vectorized."
msgstr "Maksimālais koeficients, ko cikla vektorizētājs piemēro iekšējā cikla priekšrakstu izmaksām attiecībā pret vektorizējamo ciklu."

#: params.opt:1296
#, no-c-format
msgid "Enable loop vectorization of floating point inductions."
msgstr "Iespējot peldošā komata indukciju cikla vektorizāciju."

#: params.opt:1300
#, no-c-format
msgid "Enable vectorization of loops that may not be profitable according to the cost model but still perform costing between vector modes."
msgstr "Iespējot to ciklu vektorizāciju, kas saskaņā ar izmaksu modeli var nebūt izdevīga, bet joprojām veikt izmaksu salīdzināšanu starp vektoru režīmiem."

#: params.opt:1304
#, no-c-format
msgid "Maximum number of basic blocks before VRP switches to a fast model with less memory requirements."
msgstr "Maksimālais pamatbloku skaits, pirms VRP pārslēdzas uz ātru modeli ar mazākām atmiņas prasībām."

#: params.opt:1308
#, no-c-format
msgid "Maximum number of steps when inferring a value range from a load from a constant aggregate."
msgstr "Maksimālais soļu skaits, secinot vērtību diapazonu no konstanta agregāta ielādes."

#: params.opt:1312
#, no-c-format
msgid "Maximum number of basic blocks before VRP uses a sparse bitmap cache."
msgstr "Maksimālais pamatbloku skaits, pirms VRP izmanto retinātas bitkartes kešatmiņu."

#: params.opt:1316
#, no-c-format
msgid "Maximum number of outgoing edges in a switch before VRP does not process it."
msgstr "Maksimālais izejošo šķautņu skaits switch priekšrakstā, virs kura VRP to neapstrādā."

#: params.opt:1320
#, no-c-format
msgid "Maximum number of basic blocks for VRP to use a basic cache vector."
msgstr "Maksimālais pamatbloku skaits, līdz kuram VRP izmanto pamata kešatmiņas vektoru."

#: analyzer/analyzer.opt:27
#, no-c-format
msgid "The maximum number of 'after supernode' exploded nodes within the analyzer per supernode, before terminating analysis."
msgstr "Maksimālais 'after supernode' izvērsto mezglu skaits analizatorā vienam virsmezglam, pirms analīze tiek pārtraukta."

#: analyzer/analyzer.opt:31
#, no-c-format
msgid "The maximum number of exploded nodes per program point within the analyzer, before terminating analysis of that point."
msgstr "Maksimālais izvērsto mezglu skaits vienā programmas punktā analizatorā, pirms tiek pārtraukta šī punkta analīze."

#: analyzer/analyzer.opt:35
#, no-c-format
msgid "The maximum number of constraints per state."
msgstr "Maksimālais ierobežojumu skaits vienā stāvoklī."

#: analyzer/analyzer.opt:39
#, no-c-format
msgid "The maximum number of infeasible edges to reject before declaring a diagnostic as infeasible."
msgstr "Maksimālais neiespējamo šķautņu skaits, ko noraidīt, pirms diagnostika tiek pasludināta par neiespējamu."

#: analyzer/analyzer.opt:43
#, no-c-format
msgid "The maximum number of times a callsite can appear in a call stack within the analyzer, before terminating analysis of a call that would recurse deeper."
msgstr "Maksimālais reižu skaits, cik izsaukuma vieta var parādīties analizatora izsaukumu stekā, pirms tiek pārtraukta tāda izsaukuma analīze, kas rekursētu dziļāk."

#: analyzer/analyzer.opt:47
#, no-c-format
msgid "The maximum depth of a symbolic value, before approximating the value as unknown."
msgstr "Simboliskās vērtības maksimālais dziļums pirms vērtības aproksimēšanas par nezināmu."

#: analyzer/analyzer.opt:51
#, no-c-format
msgid "The minimum number of supernodes within a function for the analyzer to consider summarizing its effects at call sites."
msgstr "Minimālais virsmezglu skaits funkcijā, lai analizators varētu apsvērt tās ietekmes apkopošanu izsaukuma vietās."

#: analyzer/analyzer.opt:55
#, no-c-format
msgid "The maximum depth of exploded nodes that should appear in a dot dump before switching to a less verbose format."
msgstr "Maksimālais izvērsto mezglu dziļums, kas jārāda dot izmetē, pirms pārslēgties uz mazāk detalizētu formātu."

#: analyzer/analyzer.opt:59
#, no-c-format
msgid "The number of bytes at which to ellipsize string literals in analyzer text art diagrams."
msgstr "Baitu skaits, pēc kura virkņu literāļi analizatora teksta grafikas diagrammās tiek saīsināti ar daudzpunkti."

#: analyzer/analyzer.opt:63
#, no-c-format
msgid "The number of literal bytes to show at the head of a string literal in text art when ellipsizing it."
msgstr "Literāļa baitu skaits, ko rādīt virknes literāļa sākumā teksta grafikā, saīsinot to ar daudzpunkti."

#: analyzer/analyzer.opt:67
#, no-c-format
msgid "The number of literal bytes to show at the tail of a string literal in text art when ellipsizing it."
msgstr "Literāļa baitu skaits, ko rādīt virknes literāļa beigās teksta grafikā, saīsinot to ar daudzpunkti."

#: analyzer/analyzer.opt:71
#, no-c-format
msgid "The ideal width in characters of text art diagrams generated by the analyzer."
msgstr "Analizatora ģenerēto teksta grafikas diagrammu ideālais platums rakstzīmēs."

#: analyzer/analyzer.opt:75
#, no-c-format
msgid "Warn about code paths in which a pointer to a buffer is assigned to an incompatible type."
msgstr "Brīdināt par koda ceļiem, kuros bufera rādītājs tiek piešķirts nesaderīgam tipam."

#: analyzer/analyzer.opt:79
#, no-c-format
msgid "Warn about code paths in which a pointer is checked for NULL after it has already been dereferenced."
msgstr "Brīdināt par koda ceļiem, kuros rādītājs tiek pārbaudīts attiecībā uz NULL pēc tam, kad tas jau ir dereferencēts."

#: analyzer/analyzer.opt:83
#, no-c-format
msgid "Warn about code paths in which a stdio FILE can be closed more than once."
msgstr "Brīdināt par koda ceļiem, kuros stdio FILE var tikt aizvērts vairāk nekā vienu reizi."

#: analyzer/analyzer.opt:87
#, no-c-format
msgid "Warn about code paths in which a pointer can be freed more than once."
msgstr "Brīdināt par koda ceļiem, kuros rādītāju var atbrīvot vairāk nekā vienu reizi."

#: analyzer/analyzer.opt:91
#, no-c-format
msgid "Warn about code paths in which sensitive data is written to a file."
msgstr "Brīdināt par koda ceļiem, kuros sensitīvi dati tiek ierakstīti failā."

#: analyzer/analyzer.opt:95
#, no-c-format
msgid "Warn about code paths in which sensitive data is copied across a security boundary."
msgstr "Brīdināt par koda ceļiem, kuros sensitīvi dati tiek kopēti pāri drošības robežai."

#: analyzer/analyzer.opt:99
#, no-c-format
msgid "Warn about code paths in which read on a write-only file descriptor is attempted, or vice versa."
msgstr "Brīdināt par koda ceļiem, kuros tiek mēģināts lasīt no tikai rakstīšanai atvērta faila deskriptora vai otrādi."

#: analyzer/analyzer.opt:103
#, no-c-format
msgid "Warn about code paths in which a file descriptor can be closed more than once."
msgstr "Brīdināt par koda ceļiem, kuros faila deskriptors var tikt aizvērts vairāk nekā vienu reizi."

#: analyzer/analyzer.opt:107
#, no-c-format
msgid "Warn about code paths in which a file descriptor is not closed."
msgstr "Brīdināt par koda ceļiem, kuros faila deskriptors netiek aizvērts."

#: analyzer/analyzer.opt:111
#, no-c-format
msgid "Warn about code paths in which an operation is attempted in the wrong phase of a file descriptor's lifetime."
msgstr "Brīdināt par koda ceļiem, kuros operācija tiek mēģināta nepareizā faila deskriptora dzīves cikla fāzē."

#: analyzer/analyzer.opt:115
#, no-c-format
msgid "Warn about code paths in which an operation is attempted on the wrong type of file descriptor."
msgstr "Brīdināt par koda ceļiem, kuros tiek mēģināts veikt operāciju ar nepareiza tipa faila deskriptoru."

#: analyzer/analyzer.opt:119
#, no-c-format
msgid "Warn about code paths in which a read or write is performed on a closed file descriptor."
msgstr "Brīdināt par koda ceļiem, kuros lasīšana vai rakstīšana tiek veikta ar aizvērtu faila deskriptoru."

#: analyzer/analyzer.opt:123
#, no-c-format
msgid "Warn about code paths in which a file descriptor is used without being checked for validity."
msgstr "Brīdināt par koda ceļiem, kuros tiek izmantots faila deskriptors, nepārbaudot tā derīgumu."

#: analyzer/analyzer.opt:127
#, no-c-format
msgid "Warn about code paths in which a stdio FILE is not closed."
msgstr "Brīdināt par koda ceļiem, kuros stdio FILE netiek aizvērts."

#: analyzer/analyzer.opt:131
#, no-c-format
msgid "Warn about code paths in which a non-heap pointer is freed."
msgstr "Brīdināt par koda ceļiem, kuros tiek atbrīvots rādītājs, kas nav kaudzes rādītājs."

#: analyzer/analyzer.opt:135
#, no-c-format
msgid "Warn about code paths in which floating-point arithmetic is used in locations where precise computation is needed."
msgstr "Brīdināt par koda ceļiem, kuros peldošā komata aritmētika tiek izmantota vietās, kur nepieciešami precīzi aprēķini."

#: analyzer/analyzer.opt:139
#, no-c-format
msgid "Warn about code paths which appear to lead to an infinite loop."
msgstr "Brīdināt par koda ceļiem, kas, šķiet, noved pie bezgalīga cikla."

#: analyzer/analyzer.opt:143
#, no-c-format
msgid "Warn about code paths which appear to lead to infinite recursion."
msgstr "Brīdināt par koda ceļiem, kas, šķiet, noved pie bezgalīgas rekursijas."

#: analyzer/analyzer.opt:147
#, no-c-format
msgid "Warn about code paths in which a NULL function pointer is called."
msgstr "Brīdināt par koda ceļiem, kuros tiek izsaukts NULL funkcijas rādītājs."

#: analyzer/analyzer.opt:151
#, no-c-format
msgid "Warn about code paths in which a heap-allocated pointer leaks."
msgstr "Brīdināt par koda ceļiem, kuros notiek kaudzē izdalīta rādītāja noplūde."

#: analyzer/analyzer.opt:155
#, no-c-format
msgid "Warn about code paths in which the wrong deallocation function is called."
msgstr "Brīdināt par koda ceļiem, kuros tiek izsaukta nepareiza atbrīvošanas funkcija."

#: analyzer/analyzer.opt:159
#, no-c-format
msgid "Warn about code paths in which a write or read to a buffer is out-of-bounds."
msgstr "Brīdināt par koda ceļiem, kuros bufera rakstīšana vai lasīšana ir ārpus robežām."

#: analyzer/analyzer.opt:163
#, no-c-format
msgid "Warn about code paths in which undefined behavior would occur due to overlapping buffers."
msgstr "Brīdināt par koda ceļiem, kuros varētu rasties nedefinēta uzvedība buferu pārklāšanās dēļ."

#: analyzer/analyzer.opt:167
#, no-c-format
msgid "Warn about code paths in which a possibly-NULL value is passed to a must-not-be-NULL function argument."
msgstr "Brīdināt par koda ceļiem, kuros funkcijas argumentam, kas nedrīkst būt NULL, tiek nodota, iespējams, NULL vērtība."

#: analyzer/analyzer.opt:171
#, no-c-format
msgid "Warn about code paths in which a possibly-NULL pointer is dereferenced."
msgstr "Brīdināt par koda ceļiem, kuros tiek dereferencēts, iespējams, NULL rādītājs."

#: analyzer/analyzer.opt:175
#, no-c-format
msgid "Warn about code paths in which an async-signal-unsafe function is called from a signal handler."
msgstr "Brīdināt par koda ceļiem, kuros no signāla apstrādātāja tiek izsaukta asinhroniem signāliem nedroša funkcija."

#: analyzer/analyzer.opt:179
#, no-c-format
msgid "Warn about code paths in which NULL is passed to a must-not-be-NULL function argument."
msgstr "Brīdināt par koda ceļiem, kuros NULL tiek nodots funkcijas argumentam, kas nedrīkst būt NULL."

#: analyzer/analyzer.opt:183
#, no-c-format
msgid "Warn about code paths in which a NULL pointer is dereferenced."
msgstr "Brīdināt par koda ceļiem, kuros tiek dereferencēts NULL rādītājs."

#: analyzer/analyzer.opt:187
#, no-c-format
msgid "Warn about code paths in which an on-stack buffer is passed to putenv."
msgstr "Brīdināt par koda ceļiem, kuros funkcijai putenv tiek nodots stekā esošs buferis."

#: analyzer/analyzer.opt:191
#, no-c-format
msgid "Warn about code paths in which a shift with negative count is attempted."
msgstr "Brīdināt par koda ceļiem, kuros tiek mēģināts veikt bīdi par negatīvu skaitu."

#: analyzer/analyzer.opt:195
#, no-c-format
msgid "Warn about code paths in which a shift with count >= width of type is attempted."
msgstr "Brīdināt par koda ceļiem, kuros tiek mēģināts veikt bīdi par skaitu >= tipa platumu."

#: analyzer/analyzer.opt:199
#, no-c-format
msgid "Warn about code paths in which a longjmp rewinds to a jmp_buf saved in a stack frame that has returned."
msgstr "Brīdināt par koda ceļiem, kuros longjmp atgriežas pie jmp_buf, kas saglabāts jau atgriezušās funkcijas steka kadrā."

#: analyzer/analyzer.opt:203
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as an allocation size."
msgstr "Brīdināt par koda ceļiem, kuros nesanitizēta vērtība tiek izmantota kā piešķiršanas izmērs."

#: analyzer/analyzer.opt:207
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as an array index."
msgstr "Brīdināt par koda ceļiem, kuros nesanitizēta vērtība tiek izmantota kā masīva indekss."

#: analyzer/analyzer.opt:211
#, no-c-format
msgid "Warn about code paths in which an 'assert()' is made involving an unsanitized value."
msgstr "Brīdināt par koda ceļiem, kuros tiek veikts 'assert()' ar nesanitizētu vērtību."

#: analyzer/analyzer.opt:215
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as a divisor."
msgstr "Brīdināt par koda ceļiem, kuros kā dalītājs tiek izmantota nesanitizēta vērtība."

#: analyzer/analyzer.opt:219
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as a pointer offset."
msgstr "Brīdināt par koda ceļiem, kuros kā rādītāja nobīde tiek izmantota nesanitizēta vērtība."

#: analyzer/analyzer.opt:223
#, no-c-format
msgid "Warn about code paths in which an unsanitized value is used as a size."
msgstr "Brīdināt par koda ceļiem, kuros kā izmērs tiek izmantota nesanitizēta vērtība."

#: analyzer/analyzer.opt:227
#, no-c-format
msgid "Warn about code paths in which an exception of unexpected type is thrown."
msgstr "Brīdināt par koda ceļiem, kuros tiek izmests negaidīta tipa izņēmums."

#: analyzer/analyzer.opt:231
#, no-c-format
msgid "Warn about code paths in which pointer subtraction involves undefined behavior."
msgstr "Brīdināt par koda ceļiem, kuros rādītāju atņemšana rada nedefinētu uzvedību."

#: analyzer/analyzer.opt:235
#, no-c-format
msgid "Warn about code paths in which a call is made to strtok with undefined behavior."
msgstr "Brīdināt par koda ceļiem, kuros strtok izsaukums rada nedefinētu uzvedību."

#: analyzer/analyzer.opt:239
#, no-c-format
msgid "Warn about code paths in which a freed value is used."
msgstr "Brīdināt par koda ceļiem, kuros tiek izmantota atbrīvota vērtība."

#: analyzer/analyzer.opt:243
#, no-c-format
msgid "Warn about code paths in which a pointer to a stale stack frame is used."
msgstr "Brīdināt par koda ceļiem, kuros tiek izmantots rādītājs uz novecojušu steka kadru."

#: analyzer/analyzer.opt:247
#, no-c-format
msgid "Warn about code paths in which va_arg uses the wrong type."
msgstr "Brīdināt par koda ceļiem, kuros va_arg izmanto nepareizu tipu."

#: analyzer/analyzer.opt:251
#, no-c-format
msgid "Warn about code paths in which va_arg is used too many times on a va_list."
msgstr "Brīdināt par koda ceļiem, kuros va_arg tiek izmantots pārāk daudz reižu vienam va_list."

#: analyzer/analyzer.opt:255
#, no-c-format
msgid "Warn about code paths in which va_start or va_copy is used without a corresponding va_end."
msgstr "Brīdināt par koda ceļiem, kuros va_start vai va_copy tiek izmantots bez atbilstoša va_end."

#: analyzer/analyzer.opt:259
#, no-c-format
msgid "Warn about code paths in which a va_list is used after va_end."
msgstr "Brīdināt par koda ceļiem, kuros va_list tiek izmantots pēc va_end."

#: analyzer/analyzer.opt:263
#, no-c-format
msgid "Warn about code paths which attempt to write to a const object."
msgstr "Brīdināt par koda ceļiem, kas mēģina rakstīt const objektā."

#: analyzer/analyzer.opt:267
#, no-c-format
msgid "Warn about code paths which attempt to write to a string literal."
msgstr "Brīdināt par koda ceļiem, kas mēģina rakstīt virknes literālī."

#: analyzer/analyzer.opt:271
#, no-c-format
msgid "Warn about code paths in which an uninitialized value is used."
msgstr "Brīdināt par koda ceļiem, kuros tiek izmantota neinicializēta vērtība."

#: analyzer/analyzer.opt:275
#, no-c-format
msgid "Warn if expressions are too complicated for the analyzer to fully track."
msgstr "Brīdināt, ja izteiksmes ir pārāk sarežģītas, lai analizators tās varētu pilnībā izsekot."

#: analyzer/analyzer.opt:279
#, no-c-format
msgid "Warn if the code is too complicated for the analyzer to fully explore."
msgstr "Brīdināt, ja kods ir pārāk sarežģīts, lai analizators to varētu pilnībā izpētīt."

#: analyzer/analyzer.opt:283
#, no-c-format
msgid "Assume that no function calls can throw exceptions."
msgstr "Pieņemt, ka neviens funkcijas izsaukums nevar izmest izņēmumus."

#: analyzer/analyzer.opt:287
#, no-c-format
msgid "Restrict the analyzer to run just the named checker."
msgstr "Ierobežot analizatoru, lai tas palaistu tikai norādīto pārbaudītāju."

#: analyzer/analyzer.opt:291
#, no-c-format
msgid "Add extra annotations to diagrams."
msgstr "Pievienot diagrammām papildu anotācijas."

#: analyzer/analyzer.opt:299
#, no-c-format
msgid "Verify that paths are feasible when emitting diagnostics."
msgstr "Izvadot diagnostiku, pārbaudīt, vai ceļi ir iespējami."

#: analyzer/analyzer.opt:303
#, no-c-format
msgid "Issue a note when diagnostics are deduplicated."
msgstr "Izvadīt piezīmi, ja diagnostika tiek deduplicēta."

#: analyzer/analyzer.opt:307
#, no-c-format
msgid "Simplify the supergraph before analyzing it."
msgstr "Vienkāršot supergrafu pirms tā analīzes."

#: analyzer/analyzer.opt:311
#, no-c-format
msgid "Purge unneeded state during analysis."
msgstr "Analīzes laikā attīrīt nevajadzīgo stāvokli."

#: analyzer/analyzer.opt:315
#, no-c-format
msgid "Merge similar-enough states during analysis."
msgstr "Analīzes laikā apvienot pietiekami līdzīgus stāvokļus."

#: analyzer/analyzer.opt:319
#, no-c-format
msgid "Stop exploring an execution path after certain diagnostics."
msgstr "Pārtraukt izpildes ceļa izpēti pēc noteiktas diagnostikas."

#: analyzer/analyzer.opt:323
#, no-c-format
msgid "Enable transitivity of constraints during analysis."
msgstr "Analīzes laikā iespējot ierobežojumu tranzitivitāti."

#: analyzer/analyzer.opt:327
#, no-c-format
msgid "Show events within system headers in analyzer execution paths."
msgstr "Rādīt notikumus sistēmas galvenēs analizatora izpildes ceļos."

#: analyzer/analyzer.opt:331
#, no-c-format
msgid "Approximate the effect of function calls to simplify analysis."
msgstr "Aproksimēt funkciju izsaukumu ietekmi, lai vienkāršotu analīzi."

#: analyzer/analyzer.opt:335
#, no-c-format
msgid "Try to reconstruct function calls and returns after inlining."
msgstr "Mēģināt rekonstruēt funkciju izsaukumus un atgriešanos pēc iekļaušanas."

#: analyzer/analyzer.opt:339
#, no-c-format
msgid "Emit more verbose descriptions of control flow in diagnostics."
msgstr "Izvadīt detalizētākus vadības plūsmas aprakstus diagnostikā."

#: analyzer/analyzer.opt:343
#, no-c-format
msgid "Emit more verbose descriptions of state changes in diagnostics."
msgstr "Izvadīt detalizētākus stāvokļa izmaiņu aprakstus diagnostikā."

#: analyzer/analyzer.opt:347
#, no-c-format
msgid "Control which events are displayed in diagnostic paths."
msgstr "Kontrolēt, kuri notikumi tiek parādīti diagnostikas ceļos."

#: analyzer/analyzer.opt:351
#, no-c-format
msgid "Dump various analyzer internals to SRCFILE.analyzer.txt."
msgstr "Izmest dažādus analizatora iekšējos datus failā SRCFILE.analyzer.txt."

#: analyzer/analyzer.opt:355
#, no-c-format
msgid "Dump various analyzer internals to stderr."
msgstr "Izmest dažādus analizatora iekšējos datus uz stderr."

#: analyzer/analyzer.opt:363
#, no-c-format
msgid "Dump the analyzer exploded graph to a SRCFILE.eg.dot file."
msgstr "Izmest analizatora izvērsto grafu failā SRCFILE.eg.dot."

#: analyzer/analyzer.opt:367
#, no-c-format
msgid "Emit diagnostics showing the location of nodes in the exploded graph."
msgstr "Izvadīt diagnostiku, kas rāda mezglu atrašanās vietu izvērstajā grafā."

#: analyzer/analyzer.opt:371
#, no-c-format
msgid "Dump a textual representation of the exploded graph to SRCFILE.eg.txt."
msgstr "Izmest izvērstā grafa teksta attēlojumu failā SRCFILE.eg.txt."

#: analyzer/analyzer.opt:375
#, no-c-format
msgid "Dump a textual representation of the exploded graph to SRCFILE.eg-ID.txt."
msgstr "Izmest izvērstā grafa teksta attēlojumu failā SRCFILE.eg-ID.txt."

#: analyzer/analyzer.opt:379
#, no-c-format
msgid "Dump a textual representation of each diagnostic's exploded path to SRCFILE.IDX.KIND.epath.txt."
msgstr "Izmest katras diagnostikas izvērstā ceļa teksta attēlojumu failā SRCFILE.IDX.KIND.epath.txt."

#: analyzer/analyzer.opt:383
#, no-c-format
msgid "Dump various analyzer internals to SRCFILE.*.fg.dot and SRCFILE.*.tg.dot."
msgstr "Izmest dažādus analizatora iekšējos datus failos SRCFILE.*.fg.dot un SRCFILE.*.tg.dot."

#: analyzer/analyzer.opt:387
#, no-c-format
msgid "Dump various analyzer internals to SRCFILE.*.infinite-loop.dot."
msgstr "Izmest dažādus analizatora iekšējos datus failā SRCFILE.*.infinite-loop.dot."

#: analyzer/analyzer.opt:391
#, no-c-format
msgid "Dump analyzer-specific data to a SRCFILE.analyzer.json.gz file."
msgstr "Izmest analizatoram specifiskus datus failā SRCFILE.analyzer.json.gz."

#: analyzer/analyzer.opt:395
#, no-c-format
msgid "Dump state-purging information to a SRCFILE.state-purge.dot file."
msgstr "Izmest stāvokļa attīrīšanas informāciju failā SRCFILE.state-purge.dot."

#: analyzer/analyzer.opt:399
#, no-c-format
msgid "Dump the analyzer supergraph to a SRCFILE.supergraph.dot file."
msgstr "Izmest analizatora supergrafu failā SRCFILE.supergraph.dot."

#: analyzer/analyzer.opt:403
#, no-c-format
msgid "Emit custom warnings with internal details intended for analyzer developers."
msgstr "Izvadīt pielāgotus brīdinājumus ar iekšējo informāciju, kas paredzēta analizatora izstrādātājiem."

#: common.opt:234
#, no-c-format
msgid "Provide bash completion for options starting with provided string."
msgstr "Nodrošināt bash automātisko pabeigšanu opcijām, kas sākas ar norādīto virkni."

#: common.opt:286
#, no-c-format
msgid "Display this information."
msgstr "Parādīt šo informāciju."

#: common.opt:290
#, no-c-format
msgid "--help=<class>\tDisplay descriptions of a specific class of options.  <class> is one or more of optimizers, target, warnings, undocumented, params."
msgstr "--help=<class>\tParādīt konkrētas opciju klases aprakstus. <class> ir viena vai vairākas no: optimizers, target, warnings, undocumented, params."

#: common.opt:414
#, no-c-format
msgid "Display target specific command line options (including assembler and linker options)."
msgstr "Parādīt mērķim specifiskās komandrindas opcijas (ieskaitot asemblera un saistītāja opcijas)."

#: common.opt:463 common.opt:505 common.opt:509 common.opt:513 common.opt:517
#: common.opt:521 common.opt:525 common.opt:529 common.opt:945 common.opt:3863
#: common.opt:3961 common.opt:4075
#, no-c-format
msgid "Passed to the linker."
msgstr "Tiek nodots saistītājam."

#: common.opt:467
#, no-c-format
msgid "-O<number>\tSet optimization level to <number>."
msgstr "-O<number>\tIestatīt optimizācijas līmeni uz <number>."

#: common.opt:471
#, no-c-format
msgid "Optimize for space rather than speed."
msgstr "Optimizēt izmēram, nevis ātrumam."

#: common.opt:475
#, no-c-format
msgid "Optimize for speed disregarding exact standards compliance."
msgstr "Optimizēt ātrumam, neievērojot precīzu atbilstību standartiem."

#: common.opt:479
#, no-c-format
msgid "Optimize for debugging experience rather than speed or size."
msgstr "Optimizēt atkļūdošanas ērtībai, nevis ātrumam vai izmēram."

#: common.opt:483
#, no-c-format
msgid "Optimize for space aggressively rather than speed."
msgstr "Agresīvi optimizēt izmēram, nevis ātrumam."

#: common.opt:488
#, no-c-format
msgid "-Q --help prints what options are enabled.  Just -Q enables verbose messages."
msgstr "-Q --help izdrukā, kuras opcijas ir iespējotas. Tikai -Q iespējo detalizētus ziņojumus."

#: common.opt:501
#, no-c-format
msgid "Stop processing after generating assembly code; do not assemble."
msgstr "Pārtraukt apstrādi pēc asemblera koda ģenerēšanas; neveikt asemblēšanu."

#: common.opt:533
#, no-c-format
msgid "This switch is deprecated; use -Wextra instead."
msgstr "Šis slēdzis ir novecojis; tā vietā izmantojiet -Wextra."

#: common.opt:546
#, no-c-format
msgid "Warn about returning structures, unions or arrays."
msgstr "Brīdināt par struktūru, apvienojumu vai masīvu atgriešanu."

#: common.opt:550
#, no-c-format
msgid "Warn if a loop with constant number of iterations triggers undefined behavior."
msgstr "Brīdināt, ja cikls ar konstantu iterāciju skaitu izraisa nedefinētu uzvedību."

#: common.opt:557
#, no-c-format
msgid "Warn if an array is accessed out of bounds."
msgstr "Brīdināt, ja masīvam tiek piekļūts ārpus robežām."

#: common.opt:561
#, no-c-format
msgid "Warn about problems with auto-profile data."
msgstr "Brīdināt par problēmām ar automātiskās profilēšanas datiem."

#: common.opt:568
#, no-c-format
msgid "Warn for uses of pointers to deallocated storage."
msgstr "Brīdināt par rādītāju uz atbrīvotu atmiņu izmantošanu."

#: common.opt:572
#, no-c-format
msgid "Warn about inappropriate attribute usage."
msgstr "Brīdināt par neatbilstošu atribūtu lietošanu."

#: common.opt:576
#, no-c-format
msgid "Do not warn about specified attributes."
msgstr "Nebrīdināt par norādītajiem atribūtiem."

#: common.opt:580 common.opt:584
#, no-c-format
msgid "Warn about type safety and similar errors and mismatches in declarations with alias attributes."
msgstr "Brīdināt par tipu drošības un līdzīgām kļūdām un neatbilstībām deklarācijās ar alias atribūtiem."

#: common.opt:588
#, no-c-format
msgid "Warn when profiling instrumentation was requested, but could not be applied to a certain function."
msgstr "Brīdināt, ja tika pieprasīta profilēšanas instrumentācija, bet to neizdevās piemērot konkrētai funkcijai."

#: common.opt:593 common.opt:597
#, no-c-format
msgid "Warn about pointer casts which increase alignment."
msgstr "Brīdināt par rādītāju tipu pārveidošanu, kas palielina izlīdzinājumu."

#: common.opt:601
#, no-c-format
msgid "Complain when a command-line option is valid, but not applicable to the current front end."
msgstr "Ziņot, ja komandrindas opcija ir derīga, bet nav piemērojama pašreizējai priekšējai daļai."

#: common.opt:605
#, no-c-format
msgid "Warn when a #warning directive is encountered."
msgstr "Brīdināt, kad tiek sastapta #warning direktīva."

#: common.opt:609
#, no-c-format
msgid "Warn about uses of __attribute__((warning)) declarations."
msgstr "Brīdināt par __attribute__((warning)) deklarāciju izmantošanu."

#: common.opt:613
#, no-c-format
msgid "Warn if a deprecated compiler feature, class, method, or field is used."
msgstr "Brīdināt, ja tiek izmantots novecojis kompilatora līdzeklis, klase, metode vai lauks."

#: common.opt:617
#, no-c-format
msgid "Warn about uses of __attribute__((deprecated)) declarations."
msgstr "Brīdināt par __attribute__((deprecated)) deklarāciju izmantošanu."

#: common.opt:621
#, no-c-format
msgid "Warn when an optimization pass is disabled."
msgstr "Brīdināt, ja optimizācijas gājiens ir atspējots."

#: common.opt:625
#, no-c-format
msgid "Turn all warnings into errors."
msgstr "Visus brīdinājumus pārvērst par kļūdām."

#: common.opt:629
#, no-c-format
msgid "Turn the specified warning into an error."
msgstr "Norādīto brīdinājumu pārvērst par kļūdu."

#: common.opt:633
#, no-c-format
msgid "Print extra (possibly unwanted) warnings."
msgstr "Izdrukāt papildu (iespējams, nevēlamus) brīdinājumus."

#: common.opt:637
#, no-c-format
msgid "Exit on the first error occurred."
msgstr "Iziet pie pirmās radušās kļūdas."

#: common.opt:641
#, no-c-format
msgid "-Wframe-larger-than=<byte-size>\tWarn if a function's stack frame requires in excess of <byte-size>."
msgstr "-Wframe-larger-than=<byte-size>\tBrīdināt, ja funkcijas steka kadram nepieciešams vairāk par <byte-size>."

#: common.opt:645
#, no-c-format
msgid "Disable -Wframe-larger-than= warning.  Equivalent to -Wframe-larger-than=<SIZE_MAX> or larger."
msgstr "Atspējot -Wframe-larger-than= brīdinājumu.  Ekvivalents -Wframe-larger-than=<SIZE_MAX> vai lielākai vērtībai."

#: common.opt:649
#, no-c-format
msgid "Warn when attempting to free a non-heap object."
msgstr "Brīdināt, mēģinot atbrīvot objektu, kas nav kaudzes objekts."

#: common.opt:653
#, no-c-format
msgid "Warn when -fhardened did not enable an option from its set."
msgstr "Brīdināt, ja -fhardened neiespējoja kādu no savas kopas opcijām."

#: common.opt:664
#, no-c-format
msgid "Warn when a switch case falls through."
msgstr "Brīdināt, ja switch gadījumā izpilde pāriet uz nākamo (fall through)."

#: common.opt:668 rust/lang.opt:59 c-family/c.opt:919
#, no-c-format
msgid "Warn for infinitely recursive calls."
msgstr "Brīdināt par bezgalīgi rekursīviem izsaukumiem."

#: common.opt:672
#, no-c-format
msgid "Warn when an inlined function cannot be inlined."
msgstr "Brīdināt, ja iekļaujamo funkciju nevar iekļaut."

#: common.opt:676
#, no-c-format
msgid "Warn when an atomic memory model parameter is known to be outside the valid range."
msgstr "Brīdināt, ja ir zināms, ka atomārā atmiņas modeļa parametrs ir ārpus derīgā diapazona."

#: common.opt:683
#, no-c-format
msgid "-Wlarger-than=<byte-size>\tWarn if an object's size exceeds <byte-size>."
msgstr "-Wlarger-than=<byte-size>\tBrīdināt, ja objekta izmērs pārsniedz <byte-size>."

#: common.opt:687
#, no-c-format
msgid "Disable -Wlarger-than= warning.  Equivalent to -Wlarger-than=<SIZE_MAX> or larger."
msgstr "Atspējot -Wlarger-than= brīdinājumu.  Ekvivalents -Wlarger-than=<SIZE_MAX> vai lielākai vērtībai."

#: common.opt:691
#, no-c-format
msgid "Warn if comparing pointer parameter with nonnull attribute with NULL."
msgstr "Brīdināt, ja rādītāja parametrs ar atribūtu nonnull tiek salīdzināts ar NULL."

#: common.opt:695
#, no-c-format
msgid "Warn if dereferencing a NULL pointer may lead to erroneous or undefined behavior."
msgstr "Brīdināt, ja NULL rādītāja dereferencēšana var izraisīt kļūdainu vai nedefinētu uzvedību."

#: common.opt:706
#, no-c-format
msgid "Warn about passing a pointer/reference to a local or temporary variable to a musttail call argument."
msgstr "Brīdināt par rādītāja/atsauces uz lokālo vai pagaidu mainīgo nodošanu musttail izsaukuma argumentam."

#: common.opt:710
#, no-c-format
msgid "Warn about pointer/reference to a local or temporary variable possibly escaping to a musttail call."
msgstr "Brīdināt par rādītāja/atsauces uz lokālo vai pagaidu mainīgo iespējamu izbēgšanu uz musttail izsaukumu."

#: common.opt:714
#, no-c-format
msgid "Warn about some C++ One Definition Rule violations during link time optimization."
msgstr "Brīdināt par dažiem C++ vienas definīcijas noteikuma pārkāpumiem saistīšanas laika optimizācijas laikā."

#: common.opt:718
#, no-c-format
msgid "Warn about overflow in arithmetic expressions."
msgstr "Brīdināt par pārpildi aritmētiskās izteiksmēs."

#: common.opt:722
#, no-c-format
msgid "During link time optimization warn about mismatched types of global declarations."
msgstr "Saistīšanas laika optimizācijas laikā brīdināt par globālo deklarāciju neatbilstošiem tipiem."

#: common.opt:726
#, no-c-format
msgid "Warn when the packed attribute has no effect on struct layout."
msgstr "Brīdināt, ja 'packed' atribūtam nav ietekmes uz struktūras izkārtojumu."

#: common.opt:730
#, no-c-format
msgid "Warn when padding is required to align structure members."
msgstr "Brīdināt, ja struktūras locekļu izlīdzināšanai nepieciešams aizpildījums."

#: common.opt:734
#, no-c-format
msgid "Issue warnings needed for strict compliance to the standard."
msgstr "Izvadīt brīdinājumus, kas nepieciešami stingrai standarta ievērošanai."

#: common.opt:738
#, no-c-format
msgid "Warn about returning a pointer/reference to a local or temporary variable."
msgstr "Brīdināt par rādītāja/atsauces uz lokālo vai pagaidu mainīgo atgriešanu."

#: common.opt:742
#, no-c-format
msgid "Warn when one variable shadows another.  Same as -Wshadow=global."
msgstr "Brīdināt, ja viens mainīgais aizēno citu. Tas pats, kas -Wshadow=global."

#: common.opt:746
#, no-c-format
msgid "Warn when one variable shadows another (globally)."
msgstr "Brīdināt, ja viens mainīgais aizēno citu (globāli)."

#: common.opt:750
#, no-c-format
msgid "Warn when one local variable shadows another local variable or parameter."
msgstr "Brīdināt, ja viens lokālais mainīgais aizēno citu lokālo mainīgo vai parametru."

#: common.opt:757
#, no-c-format
msgid "Warn when one local variable shadows another local variable or parameter of compatible type."
msgstr "Brīdināt, ja viens lokālais mainīgais aizēno citu saderīga tipa lokālo mainīgo vai parametru."

#: common.opt:764
#, no-c-format
msgid "Warn when not issuing stack smashing protection for some reason."
msgstr "Brīdināt, ja kāda iemesla dēļ netiek nodrošināta steka graušanas aizsardzība."

#: common.opt:768
#, no-c-format
msgid "-Wstack-usage=<byte-size>\tWarn if stack usage might exceed <byte-size>."
msgstr "-Wstack-usage=<byte-size>\tBrīdināt, ja steka izmantošana var pārsniegt <byte-size>."

#: common.opt:772
#, no-c-format
msgid "Disable Wstack-usage= warning.  Equivalent to Wstack-usage=<SIZE_MAX> or larger."
msgstr "Atspējot -Wstack-usage= brīdinājumu. Ekvivalents -Wstack-usage=<SIZE_MAX> vai lielākai vērtībai."

#: common.opt:776 common.opt:780
#, no-c-format
msgid "Warn about code which might break strict aliasing rules."
msgstr "Brīdināt par kodu, kas var pārkāpt stingrās pārklāšanās (strict aliasing) noteikumus."

#: common.opt:784 common.opt:788
#, no-c-format
msgid "Warn about optimizations that assume that signed overflow is undefined."
msgstr "Brīdināt par optimizācijām, kas pieņem, ka skaitļu ar zīmi pārpilde ir nedefinēta."

#: common.opt:792
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((cold))."
msgstr "Brīdināt par funkcijām, kas varētu būt __attribute__((cold)) kandidāti."

#: common.opt:796
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((const))."
msgstr "Brīdināt par funkcijām, kas varētu būt __attribute__((const)) kandidāti."

#: common.opt:800
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((pure))."
msgstr "Brīdināt par funkcijām, kas varētu būt __attribute__((pure)) kandidāti."

#: common.opt:804
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((noreturn))."
msgstr "Brīdināt par funkcijām, kas varētu būt __attribute__((noreturn)) kandidāti."

#: common.opt:808
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((malloc))."
msgstr "Brīdināt par funkcijām, kas varētu būt __attribute__((malloc)) kandidāti."

#: common.opt:812
#, no-c-format
msgid "Warn about functions which might be candidates for __attribute__((returns_nonnull))."
msgstr "Brīdināt par funkcijām, kas varētu būt __attribute__((returns_nonnull)) kandidāti."

#: common.opt:816
#, no-c-format
msgid "Warn about C++ polymorphic types where adding final keyword would improve code quality."
msgstr "Brīdināt par C++ polimorfajiem tipiem, kuros atslēgvārda 'final' pievienošana uzlabotu koda kvalitāti."

#: common.opt:820
#, no-c-format
msgid "Warn about C++ virtual methods where adding final keyword would improve code quality."
msgstr "Brīdināt par C++ virtuālajām metodēm, kurās atslēgvārda 'final' pievienošana uzlabotu koda kvalitāti."

#: common.opt:824
#, no-c-format
msgid "Warn about statements between switch's controlling expression and the first case."
msgstr "Brīdināt par priekšrakstiem starp switch vadības izteiksmi un pirmo case."

#: common.opt:829
#, no-c-format
msgid "Do not suppress warnings from system headers."
msgstr "Neapspiest brīdinājumus no sistēmas galvenēm."

#: common.opt:833
#, no-c-format
msgid "Warn if a comparison always evaluates to true or false."
msgstr "Brīdināt, ja salīdzinājuma rezultāts vienmēr ir patiess vai nepatiess."

#: common.opt:837
#, no-c-format
msgid "Warn whenever a trampoline is generated."
msgstr "Brīdināt ikreiz, kad tiek ģenerēts trampolīns."

#: common.opt:841
#, no-c-format
msgid "Warn about cases where -ftrivial-auto-var-init cannot initialize an auto variable."
msgstr "Brīdināt par gadījumiem, kad -ftrivial-auto-var-init nevar inicializēt automātisko mainīgo."

#: common.opt:845
#, no-c-format
msgid "Warn if a comparison is always true or always false due to the limited range of the data type."
msgstr "Brīdināt, ja datu tipa ierobežotā diapazona dēļ salīdzinājums vienmēr ir patiess vai vienmēr nepatiess."

#: common.opt:849
#, no-c-format
msgid "Warn about uninitialized automatic variables."
msgstr "Brīdināt par neinicializētiem automātiskajiem mainīgajiem."

#: common.opt:853
#, no-c-format
msgid "Warn about maybe uninitialized automatic variables."
msgstr "Brīdināt par iespējami neinicializētiem automātiskajiem mainīgajiem."

#: common.opt:861
#, no-c-format
msgid "Enable all -Wunused- warnings."
msgstr "Iespējot visus -Wunused- brīdinājumus."

#: common.opt:868
#, no-c-format
msgid "Warn when a function parameter is only set, otherwise unused."
msgstr "Brīdināt, ja funkcijas parametram tikai tiek piešķirta vērtība, bet tas netiek izmantots."

#: common.opt:875
#, no-c-format
msgid "Warn when a variable is only set, otherwise unused."
msgstr "Brīdināt, ja mainīgajam tikai tiek piešķirta vērtība, bet tas netiek izmantots."

#: common.opt:879
#, no-c-format
msgid "Warn when a function is unused."
msgstr "Brīdināt, ja funkcija netiek izmantota."

#: common.opt:883
#, no-c-format
msgid "Warn when a label is unused."
msgstr "Brīdināt, ja etiķete netiek izmantota."

#: common.opt:887
#, no-c-format
msgid "Warn when a function parameter is unused."
msgstr "Brīdināt, ja funkcijas parametrs netiek izmantots."

#: common.opt:891
#, no-c-format
msgid "Warn when an expression value is unused."
msgstr "Brīdināt, ja izteiksmes vērtība netiek izmantota."

#: common.opt:895
#, no-c-format
msgid "Warn when a variable is unused."
msgstr "Brīdināt, ja mainīgais netiek izmantots."

#: common.opt:899
#, no-c-format
msgid "Warn in case profiles in -fprofile-use do not match."
msgstr "Brīdināt, ja -fprofile-use profili neatbilst."

#: common.opt:903
#, no-c-format
msgid "Warn in case a function ends earlier than it begins due to an invalid linenum macros."
msgstr "Brīdināt, ja funkcija nederīgu linenum makro dēļ beidzas agrāk, nekā sākas."

#: common.opt:907
#, no-c-format
msgid "Warn when a conditional has too many terms and condition coverage profiling gives up instrumenting the expression."
msgstr "Brīdināt, ja nosacījumā ir pārāk daudz locekļu un nosacījumu pārklājuma profilēšana atsakās instrumentēt izteiksmi."

#: common.opt:912
#, no-c-format
msgid "-fpath-coverage-limit=<number> Don't instrument functions path count exceeding <number>."
msgstr "-fpath-coverage-limit=<number> Neinstrumentēt funkcijas, kuru ceļu skaits pārsniedz <number>."

#: common.opt:917
#, no-c-format
msgid "Warn if a function exceeds the number of paths (controlled by -fpath-coverage-limit) and path coverage give up instrumenting the function. The limit is approximate and conservative and coverage might give up even if the actual number is slightly below the limit."
msgstr "Brīdināt, ja funkcija pārsniedz ceļu skaitu (ko kontrolē -fpath-coverage-limit) un ceļu pārklājums atsakās instrumentēt funkciju. Ierobežojums ir aptuvens un piesardzīgs, un pārklājums var atteikties arī tad, ja faktiskais skaits ir nedaudz zem ierobežojuma."

#: common.opt:924
#, no-c-format
msgid "Warn in case profiles in -fprofile-use do not exist."
msgstr "Brīdināt, ja -fprofile-use profili neeksistē."

#: common.opt:928
#, no-c-format
msgid "Warn when a vector operation is compiled outside the SIMD."
msgstr "Brīdināt, ja vektora operācija tiek kompilēta ārpus SIMD."

#: common.opt:932
#, no-c-format
msgid "Warn about unsupported features in ThreadSanitizer."
msgstr "Brīdināt par ThreadSanitizer neatbalstītiem līdzekļiem."

#: common.opt:949
#, no-c-format
msgid "-aux-info <file>\tEmit declaration information into <file>."
msgstr "-aux-info <file>\tIzvadīt deklarāciju informāciju failā <file>."

#: common.opt:962
#, no-c-format
msgid "-d<letters>\tEnable dumps from specific passes of the compiler."
msgstr "-d<letters>\tIespējot izmetes no konkrētiem kompilatora gājieniem."

#: common.opt:966
#, no-c-format
msgid "-dumpbase <file>\tSet the file basename to be used for dumps."
msgstr "-dumpbase <file>\tIestatīt faila pamatnosaukumu, ko izmantot izmetēm."

#: common.opt:970
#, no-c-format
msgid "-dumpbase-ext .<ext>    Drop a trailing .<ext> from the dump basename to name auxiliary output files."
msgstr "-dumpbase-ext .<ext>    Noņemt beigu .<ext> no izmetes pamatnosaukuma, veidojot palīgizvades failu nosaukumus."

#: common.opt:974
#, no-c-format
msgid "-dumpdir <dir>\tSet the directory name to be used for dumps."
msgstr "-dumpdir <dir>\tIestatīt direktorijas nosaukumu, ko izmantot izmetēm."

#: common.opt:1089
#, no-c-format
msgid "The version of the C++ ABI in use."
msgstr "Izmantotā C++ ABI versija."

#: common.opt:1093
#, no-c-format
msgid "Aggressively optimize loops using language constraints."
msgstr "Agresīvi optimizēt ciklus, izmantojot valodas ierobežojumus."

#: common.opt:1097
#, no-c-format
msgid "Align the start of functions."
msgstr "Izlīdzināt funkciju sākumu."

#: common.opt:1104
#, no-c-format
msgid "Align labels which are only reached by jumping."
msgstr "Izlīdzināt etiķetes, kuras tiek sasniegtas tikai ar lēcienu."

#: common.opt:1111
#, no-c-format
msgid "Align all labels."
msgstr "Izlīdzināt visas etiķetes."

#: common.opt:1118
#, no-c-format
msgid "Align the start of loops."
msgstr "Izlīdzināt ciklu sākumu."

#: common.opt:1125
#, no-c-format
msgid "Allow the compiler to introduce new data races on stores."
msgstr "Ļaut kompilatoram ieviest jaunas datu sacensības saglabāšanās."

#: common.opt:1129
#, no-c-format
msgid "Enable static analysis pass."
msgstr "Iespējot statiskās analīzes gājienu."

#: common.opt:1149
#, no-c-format
msgid "Select what to sanitize."
msgstr "Izvēlēties, ko sanitizēt."

#: common.opt:1153
#, no-c-format
msgid "Select type of coverage sanitization."
msgstr "Izvēlēties pārklājuma sanitizācijas veidu."

#: common.opt:1166
#, no-c-format
msgid "-fasan-shadow-offset=<number>\tUse custom shadow memory offset."
msgstr "-fasan-shadow-offset=<number>\tIzmantot pielāgotu ēnu atmiņas nobīdi."

#: common.opt:1170
#, no-c-format
msgid "-fsanitize-sections=<sec1,sec2,...>\tSanitize global variables in user-defined sections."
msgstr "-fsanitize-sections=<sec1,sec2,...>\tSanitizēt globālos mainīgos lietotāja definētās sekcijās."

#: common.opt:1175
#, no-c-format
msgid "After diagnosing undefined behavior attempt to continue execution."
msgstr "Pēc nedefinētas uzvedības diagnosticēšanas mēģināt turpināt izpildi."

#: common.opt:1179
#, no-c-format
msgid "This switch is deprecated; use -fsanitize-recover= instead."
msgstr "Šis slēdzis ir novecojis; tā vietā izmantojiet -fsanitize-recover=."

#: common.opt:1183
#, no-c-format
msgid "Use traps instead of diagnostics of undefined behavior sanitizers."
msgstr "Nedefinētas uzvedības sanitizētāju diagnostikas vietā izmantot slazdus."

#: common.opt:1193
#, no-c-format
msgid "This switch is deprecated; use -fsanitize-trap= instead."
msgstr "Šis slēdzis ir novecojis; tā vietā izmantojiet -fsanitize-trap=."

#: common.opt:1197
#, no-c-format
msgid "Generate unwind tables that are exact at each instruction boundary."
msgstr "Ģenerēt attīšanas tabulas, kas ir precīzas katrā instrukciju robežā."

#: common.opt:1201
#, no-c-format
msgid "Generate auto-inc/dec instructions."
msgstr "Ģenerēt automātiskās inkrementēšanas/dekrementēšanas instrukcijas."

#: common.opt:1205
#, no-c-format
msgid "Use sample profile information for call graph node weights. The default profile file is fbdata.afdo in 'pwd'."
msgstr "Izmantot paraugu profila informāciju izsaukumu grafa mezglu svariem. Noklusējuma profila fails ir fbdata.afdo pašreizējā direktorijā ('pwd')."

#: common.opt:1210
#, no-c-format
msgid "Use sample profile information for call graph node weights. The profile file is specified in the argument."
msgstr "Izmantot paraugu profila informāciju izsaukumu grafa mezglu svariem. Profila fails ir norādīts argumentā."

#: common.opt:1215
#, no-c-format
msgid "Perform inlining using auto-profile."
msgstr "Veikt iekļaušanu, izmantojot automātisko profilu."

#: common.opt:1223
#, no-c-format
msgid "Generate code to check bounds before indexing arrays."
msgstr "Ģenerēt kodu, lai pārbaudītu robežas pirms masīvu indeksēšanas."

#: common.opt:1227
#, no-c-format
msgid "Replace add, compare, branch with branch on count register."
msgstr "Aizstāt add, compare, branch ar branch on count register."

#: common.opt:1231
#, no-c-format
msgid "Use profiling information for branch probabilities."
msgstr "Izmantot profilēšanas informāciju zarošanās varbūtībām."

#: common.opt:1247
#, no-c-format
msgid "Output callgraph information on a per-file basis."
msgstr "Izvadīt izsaukumu grafa informāciju katram failam atsevišķi."

#: common.opt:1251
#, no-c-format
msgid "Output callgraph information on a per-file basis with decorations."
msgstr "Izvadīt izsaukumu grafa informāciju katram failam atsevišķi ar dekorācijām."

#: common.opt:1255
#, no-c-format
msgid "-fcall-saved-<register>\tMark <register> as being preserved across functions."
msgstr "-fcall-saved-<register>\tAtzīmēt <register> kā tādu, kas tiek saglabāts pāri funkciju izsaukumiem."

#: common.opt:1259
#, no-c-format
msgid "-fcall-used-<register>\tMark <register> as being corrupted by function calls."
msgstr "-fcall-used-<register>\tAtzīmēt <register> kā tādu, ko funkciju izsaukumi pārraksta."

#: common.opt:1266
#, no-c-format
msgid "Save registers around function calls."
msgstr "Saglabāt reģistrus ap funkciju izsaukumiem."

#: common.opt:1270
#, no-c-format
msgid "This switch is deprecated; do not use."
msgstr "Šis slēdzis ir novecojis; neizmantojiet to."

#: common.opt:1274
#, no-c-format
msgid "Check the return value of new in C++."
msgstr "Pārbaudīt new atgriezto vērtību C++ valodā."

#: common.opt:1278 common.opt:1282
#, no-c-format
msgid "Perform internal consistency checkings."
msgstr "Veikt iekšējās konsekvences pārbaudes."

#: common.opt:1286
#, no-c-format
msgid "For -f*-prefix-map= options compare canonicalized pathnames rather than just strings."
msgstr "Opcijas -f*-prefix-map= gadījumā salīdzināt kanonizētus ceļu nosaukumus, nevis tikai virknes."

#: common.opt:1290
#, no-c-format
msgid "Enable code hoisting."
msgstr "Iespējot koda pacelšanu."

#: common.opt:1294
#, no-c-format
msgid "Looks for opportunities to reduce stack adjustments and stack references."
msgstr "Meklēt iespējas samazināt steka korekcijas un steka atsauces."

#: common.opt:1298
#, no-c-format
msgid "Put uninitialized globals in the common section."
msgstr "Ievietot neinicializētos globālos mainīgos common sekcijā."

#: common.opt:1306
#, no-c-format
msgid "-fcompare-debug[=<opts>]\tCompile with and without e.g. -gtoggle, and compare the final-insns dump."
msgstr "-fcompare-debug[=<opts>]\tKompilēt ar un bez, piemēram, -gtoggle un salīdzināt final-insns izmeti."

#: common.opt:1310
#, no-c-format
msgid "Run only the second compilation of -fcompare-debug."
msgstr "Palaist tikai otro -fcompare-debug kompilāciju."

#: common.opt:1314
#, no-c-format
msgid "Perform comparison elimination after register allocation has finished."
msgstr "Veikt salīdzinājumu likvidēšanu pēc reģistru piešķiršanas pabeigšanas."

#: common.opt:1318
#, no-c-format
msgid "Do not perform optimizations increasing noticeably stack usage."
msgstr "Neveikt optimizācijas, kas ievērojami palielina steka izmantošanu."

#: common.opt:1322
#, no-c-format
msgid "Perform a register copy-propagation optimization pass."
msgstr "Veikt reģistru kopiju izplatīšanas optimizācijas gājienu."

#: common.opt:1326
#, no-c-format
msgid "Fold instructions calculating memory offsets to the memory access instruction if possible."
msgstr "Ja iespējams, iekļaut atmiņas nobīdes aprēķinošās instrukcijas atmiņas piekļuves instrukcijā."

#: common.opt:1330
#, no-c-format
msgid "Perform cross-jumping optimization."
msgstr "Veikt krustlēcienu optimizāciju."

#: common.opt:1334
#, no-c-format
msgid "When running CSE, follow jumps to their targets."
msgstr "Izpildot CSE, sekot lēcieniem līdz to mērķiem."

#: common.opt:1360
#, no-c-format
msgid "Omit range reduction step when performing complex division."
msgstr "Izlaist diapazona samazināšanas soli, veicot komplekso dalīšanu."

#: common.opt:1364
#, no-c-format
msgid "Complex multiplication and division follow Fortran rules."
msgstr "Kompleksā reizināšana un dalīšana ievēro Fortran noteikumus."

#: common.opt:1368
#, no-c-format
msgid "Place data items into their own section."
msgstr "Ievietot datu elementus atsevišķās sekcijās."

#: common.opt:1372
#, no-c-format
msgid "List all available debugging counters with their limits and counts."
msgstr "Uzskaitīt visus pieejamos atkļūdošanas skaitītājus ar to ierobežojumiem un vērtībām."

#: common.opt:1376
#, no-c-format
msgid "-fdbg-cnt=<counter>[:<lower_limit1>-]<upper_limit1>[:<lower_limit2>-<upper_limit2>:...][,<counter>:...]\tSet the debug counter limit."
msgstr "-fdbg-cnt=<counter>[:<lower_limit1>-]<upper_limit1>[:<lower_limit2>-<upper_limit2>:...][,<counter>:...]\tIestatīt atkļūdošanas skaitītāja limitu."

#: common.opt:1380
#, no-c-format
msgid "-fdebug-prefix-map=<old>=<new>\tMap one directory name to another in debug information."
msgstr "-fdebug-prefix-map=<old>=<new>\tAtkļūdošanas informācijā aizstāt vienu direktorijas nosaukumu ar citu."

#: common.opt:1384
#, no-c-format
msgid "-ffile-prefix-map=<old>=<new>\tMap one directory name to another in compilation result."
msgstr "-ffile-prefix-map=<old>=<new>\tKompilēšanas rezultātā aizstāt vienu direktorijas nosaukumu ar citu."

#: common.opt:1388
#, no-c-format
msgid "Output .debug_types section when using DWARF v4 debuginfo."
msgstr "Izvadīt .debug_types sekciju, ja izmanto DWARF v4 atkļūdošanas informāciju."

#: common.opt:1394
#, no-c-format
msgid "Defer popping functions args from stack until later."
msgstr "Atlikt funkciju argumentu izņemšanu no steka uz vēlāku laiku."

#: common.opt:1398
#, no-c-format
msgid "Attempt to fill delay slots of branch instructions."
msgstr "Mēģināt aizpildīt zarošanās instrukciju aiztures slotus."

#: common.opt:1402
#, no-c-format
msgid "Delete dead instructions that may throw exceptions."
msgstr "Dzēst nevajadzīgās instrukcijas, kas var izmest izņēmumus."

#: common.opt:1406
#, no-c-format
msgid "Delete useless null pointer checks."
msgstr "Dzēst nevajadzīgas null rādītāja pārbaudes."

#: common.opt:1410
#, no-c-format
msgid "Issue defining instructions back to back with their single uses, provided they are macro-fusible in the target microarchitecture."
msgstr "Izdot definējošās instrukcijas tieši pirms to vienīgajiem lietojumiem, ja mērķa mikroarhitektūrā tās var makrosapludināt."

#: common.opt:1414
#, no-c-format
msgid "Stream extra data to support more aggressive devirtualization in LTO local transformation mode."
msgstr "Straumēt papildu datus, lai atbalstītu agresīvāku devirtualizāciju LTO lokālās transformācijas režīmā."

#: common.opt:1418
#, no-c-format
msgid "Perform speculative devirtualization."
msgstr "Veikt spekulatīvu devirtualizāciju."

#: common.opt:1422
#, no-c-format
msgid "Try to convert virtual calls to direct ones."
msgstr "Mēģināt pārveidot virtuālos izsaukumus par tiešiem."

#: common.opt:1426
#, no-c-format
msgid "-fdiagnostics-show-location=[once|every-line]\tHow often to emit source location at the beginning of line-wrapped diagnostics."
msgstr "-fdiagnostics-show-location=[once|every-line]\tCik bieži izvadīt pirmkoda atrašanās vietu diagnostikas, kas tiek dalīta vairākās rindās, sākumā."

#: common.opt:1443
#, no-c-format
msgid "Show the source line with a caret indicating the column."
msgstr "Rādīt pirmkoda rindu ar zīmi ^, kas norāda kolonnu."

#: common.opt:1447
#, no-c-format
msgid "Show lines linking related events in diagnostic paths."
msgstr "Rādīt līnijas, kas savieno saistītos notikumus diagnostikas ceļos."

#: common.opt:1451
#, no-c-format
msgid "Show labels annotating ranges of source code when showing source."
msgstr "Rādot pirmkodu, rādīt etiķetes, kas anotē pirmkoda diapazonus."

#: common.opt:1455
#, no-c-format
msgid "Show line numbers in the left margin when showing source."
msgstr "Rādot pirmkodu, rādīt rindu numurus kreisajā malā."

#: common.opt:1463
#, no-c-format
msgid "-fdiagnostics-color=[never|always|auto]\tColorize diagnostics."
msgstr "-fdiagnostics-color=[never|always|auto]\tIzkrāsot diagnostiku."

#: common.opt:1483
#, no-c-format
msgid "Enable formatting of JSON output."
msgstr "Iespējot JSON izvades formatēšanu."

#: common.opt:1487
#, no-c-format
msgid "-fdiagnostics-urls=[never|always|auto]\tEmbed URLs in diagnostics."
msgstr "-fdiagnostics-urls=[never|always|auto]\tIegult diagnostikā URL."

#: common.opt:1507
#, no-c-format
msgid "-fdiagnostics-column-unit=[display|byte]\tSelect whether column numbers are output as display columns (default) or raw bytes."
msgstr "-fdiagnostics-column-unit=[display|byte]\tIzvēlēties, vai kolonnu numuri tiks izvadīti kā displeja kolonnas (noklusējums) vai kā neapstrādāti baiti."

#: common.opt:1511
#, no-c-format
msgid "-fdiagnostics-column-origin=<number>\tSet the number of the first column.  The default is 1-based as per GNU style, but some utilities may expect 0-based, for example."
msgstr "-fdiagnostics-column-origin=<number>\tIestatīt pirmās kolonnas numuru. Noklusējums ir 1 atbilstoši GNU stilam, taču dažas utilītas var sagaidīt, piemēram, 0."

#: common.opt:1515
#, no-c-format
msgid "-fdiagnostics-format=[text|sarif-stderr|sarif-file]\tSelect output format."
msgstr "-fdiagnostics-format=[text|sarif-stderr|sarif-file]\tIzvēlēties izvades formātu."

#: common.opt:1519
#, no-c-format
msgid "Add output format."
msgstr "Pievienot izvades formātu."

#: common.opt:1523
#, no-c-format
msgid "Set output format."
msgstr "Iestatīt izvades formātu."

#: common.opt:1527
#, no-c-format
msgid "-fdiagnostics-escape-format=[unicode|bytes]\tSelect how to escape non-printable-ASCII bytes in the source for diagnostics that suggest it."
msgstr "-fdiagnostics-escape-format=[unicode|bytes]\tIzvēlēties, kā attēlot pirmkodā esošos nedrukājamos ASCII baitus diagnostikā, kas to iesaka."

#: common.opt:1565
#, no-c-format
msgid "Print fix-it hints in machine-readable form."
msgstr "Izdrukāt labošanas ieteikumus mašīnlasāmā formā."

#: common.opt:1569
#, no-c-format
msgid "Print fix-it hints to stderr in unified diff format."
msgstr "Izdrukāt labošanas ieteikumus uz stderr unificētā diff formātā."

#: common.opt:1573
#, no-c-format
msgid "Amend appropriate diagnostic messages with the command line option that controls them."
msgstr "Papildināt atbilstošos diagnostikas ziņojumus ar komandrindas opciju, kas tos kontrolē."

#: common.opt:1577
#, no-c-format
msgid "Print CWE identifiers for diagnostic messages, where available."
msgstr "Izdrukāt diagnostikas ziņojumiem CWE identifikatorus, ja tie ir pieejami."

#: common.opt:1581
#, no-c-format
msgid "Print any rules associated with diagnostic messages."
msgstr "Izdrukāt visus ar diagnostikas ziņojumiem saistītos noteikumus."

#: common.opt:1585
#, no-c-format
msgid "Use color within diagnostic messages to highlight pertinent information."
msgstr "Izmantot krāsu diagnostikas ziņojumos, lai izceltu būtisku informāciju."

#: common.opt:1589
#, no-c-format
msgid "Specify how to print any control-flow path associated with a diagnostic."
msgstr "Norādīt, kā izdrukāt ar diagnostiku saistīto vadības plūsmas ceļu."

#: common.opt:1593
#, no-c-format
msgid "Turn off any diagnostics features that complicate the output, such as line numbers, color, and warning URLs."
msgstr "Izslēgt visus diagnostikas līdzekļus, kas sarežģī izvadi, piemēram, rindu numurus, krāsas un brīdinājumu URL."

#: common.opt:1597
#, no-c-format
msgid "-ftabstop=<number>      Distance between tab stops for column reporting."
msgstr "-ftabstop=<number>      Attālums starp tabulācijas pozīcijām kolonnu ziņošanai."

#: common.opt:1613
#, no-c-format
msgid "Show stack depths of events in paths."
msgstr "Rādīt notikumu steka dziļumus ceļos."

#: common.opt:1617
#, no-c-format
msgid "-fdiagnostics-text-art-charset=[none|ascii|unicode|emoji]\tDetermine which characters to use in text arg diagrams."
msgstr "-fdiagnostics-text-art-charset=[none|ascii|unicode|emoji]\tNoteikt, kādas rakstzīmes izmantot teksta grafikas diagrammās."

#: common.opt:1636
#, no-c-format
msgid "Set minimum width of left margin of source code when showing source."
msgstr "Rādot pirmkodu, iestatīt pirmkoda kreisās malas minimālo platumu."

#: common.opt:1640
#, no-c-format
msgid "Use indentation to show nesting of diagnostics in text output."
msgstr "Izmantot atkāpes, lai parādītu diagnostikas ligzdojumu teksta izvadē."

#: common.opt:1644
#, no-c-format
msgid "Show location information when showing nested diagnostics."
msgstr "Rādīt atrašanās vietas informāciju, kad tiek rādīta ligzdota diagnostika."

#: common.opt:1648
#, no-c-format
msgid "Show nesting levels as numbers when showing nested diagnostics."
msgstr "Rādīt ligzdojuma līmeņus kā skaitļus, kad tiek rādīta ligzdota diagnostika."

#: common.opt:1655
#, no-c-format
msgid "Collect and print more context information for diagnostics."
msgstr "Apkopot un izdrukāt vairāk konteksta informācijas diagnostikai."

#: common.opt:1659
#, no-c-format
msgid "-fdisable-[tree|rtl|ipa]-<pass>=range1+range2\tDisable an optimization pass."
msgstr "-fdisable-[tree|rtl|ipa]-<pass>=range1+range2\tAtspējot optimizācijas gājienu."

#: common.opt:1663
#, no-c-format
msgid "-fenable-[tree|rtl|ipa]-<pass>=range1+range2\tEnable an optimization pass."
msgstr "-fenable-[tree|rtl|ipa]-<pass>=range1+range2\tIespējot optimizācijas gājienu."

#: common.opt:1667
#, no-c-format
msgid "-fdump-<type>\tDump various compiler internals to a file."
msgstr "-fdump-<type>\tIzmest dažādus kompilatora iekšējos datus failā."

#: common.opt:1674
#, no-c-format
msgid "-fdump-final-insns=filename\tDump to filename the insns at the end of translation."
msgstr "-fdump-final-insns=filename\tTranslācijas beigās izmest insn failā filename."

#: common.opt:1678
#, no-c-format
msgid "-fdump-go-spec=filename\tWrite all declarations to file as Go code."
msgstr "-fdump-go-spec=filename\tIerakstīt visas deklarācijas failā kā Go kodu."

#: common.opt:1682
#, no-c-format
msgid "Suppress output of addresses in debugging dumps."
msgstr "Neizvadīt adreses atkļūdošanas izmetēs."

#: common.opt:1686
#, no-c-format
msgid "Collect and dump debug information into temporary file if ICE in C/C++ compiler occurred."
msgstr "Apkopot un izmest atkļūdošanas informāciju pagaidu failā, ja C/C++ kompilatorā radās ICE."

#: common.opt:1691
#, no-c-format
msgid "Dump detailed information on GCC's internal representation of source code locations."
msgstr "Izmest detalizētu informāciju par GCC iekšējo pirmkoda atrašanās vietu attēlojumu."

#: common.opt:1695
#, no-c-format
msgid "Dump optimization passes."
msgstr "Izmest optimizācijas gājienus."

#: common.opt:1699
#, no-c-format
msgid "Suppress output of instruction numbers, line number notes and addresses in debugging dumps."
msgstr "Neizvadīt instrukciju numurus, rindu numuru piezīmes un adreses atkļūdošanas izmetēs."

#: common.opt:1703
#, no-c-format
msgid "Suppress output of previous and next insn numbers in debugging dumps."
msgstr "Neizvadīt iepriekšējās un nākamās insn numurus atkļūdošanas izmetēs."

#: common.opt:1707
#, no-c-format
msgid "Enable CFI tables via GAS assembler directives."
msgstr "Iespējot CFI tabulas, izmantojot GAS asemblera direktīvas."

#: common.opt:1711
#, no-c-format
msgid "Perform early inlining."
msgstr "Veikt agrīno iekļaušanu."

#: common.opt:1719
#, no-c-format
msgid "Perform interprocedural reduction of aggregates."
msgstr "Veikt agregātu starpprocedūru redukciju."

#: common.opt:1723
#, no-c-format
msgid "Perform unused symbol elimination in debug info."
msgstr "Veikt neizmantoto simbolu likvidēšanu atkļūdošanas informācijā."

#: common.opt:1727
#, no-c-format
msgid "Perform unused type elimination in debug info."
msgstr "Veikt neizmantoto tipu likvidēšanu atkļūdošanas informācijā."

#: common.opt:1731
#, no-c-format
msgid "Do not suppress C++ class debug information."
msgstr "Neapspiest C++ klašu atkļūdošanas informāciju."

#: common.opt:1735
#, no-c-format
msgid "Enable exception handling."
msgstr "Iespējot izņēmumu apstrādi."

#: common.opt:1739
#, no-c-format
msgid "Perform a number of minor, expensive optimizations."
msgstr "Veikt vairākas nelielas, dārgas optimizācijas."

#: common.opt:1743
#, no-c-format
msgid "-fexcess-precision=[fast|standard|16]\tSpecify handling of excess floating-point precision."
msgstr "-fexcess-precision=[fast|standard|16]\tNorādīt pārmērīgas peldošā komata precizitātes apstrādi."

#: common.opt:1761
#, no-c-format
msgid "-fpermitted-flt-eval-methods=[c11|ts-18661]\tSpecify which values of FLT_EVAL_METHOD are permitted."
msgstr "-fpermitted-flt-eval-methods=[c11|ts-18661]\tNorādīt, kuras FLT_EVAL_METHOD vērtības ir atļautas."

#: common.opt:1777
#, no-c-format
msgid "Output lto objects containing both the intermediate language and binary output."
msgstr "Izvadīt LTO objektus, kas satur gan starpvalodu, gan bināro izvadi."

#: common.opt:1781
#, no-c-format
msgid "Assume no NaNs or infinities are generated."
msgstr "Pieņemt, ka netiek ģenerēti NaN vai bezgalības."

#: common.opt:1785
#, no-c-format
msgid "Assume that loops with an exit will terminate and not loop indefinitely."
msgstr "Pieņemt, ka cikli ar izeju beigsies un neturpināsies bezgalīgi."

#: common.opt:1789
#, no-c-format
msgid "-ffixed-<register>\tMark <register> as being unavailable to the compiler."
msgstr "-ffixed-<register>\tAtzīmēt <register> kā kompilatoram nepieejamu."

#: common.opt:1793
#, no-c-format
msgid "Don't allocate floats and doubles in extended-precision registers."
msgstr "Neizvietot float un double vērtības paplašinātas precizitātes reģistros."

#: common.opt:1801
#, no-c-format
msgid "Perform a forward propagation pass on RTL."
msgstr "Veikt RTL tiešās izplatīšanas gājienu."

#: common.opt:1805
#, no-c-format
msgid "-ffp-contract=[off|on|fast]\tPerform floating-point expression contraction."
msgstr "-ffp-contract=[off|on|fast]\tVeikt peldošā komata izteiksmju savilkšanu (contraction)."

#: common.opt:1821
#, no-c-format
msgid "Allow built-in functions ceil, floor, round, trunc to raise \"inexact\" exceptions."
msgstr "Atļaut iebūvētajām funkcijām ceil, floor, round, trunc radīt \"inexact\" izņēmumus."

#: common.opt:1828
#, no-c-format
msgid "Allow function addresses to be held in registers."
msgstr "Atļaut funkciju adreses glabāt reģistros."

#: common.opt:1832
#, no-c-format
msgid "Place each function into its own section."
msgstr "Ievietot katru funkciju atsevišķā sekcijā."

#: common.opt:1836
#, no-c-format
msgid "Allow limited optimization of operations with volatile memory access."
msgstr "Atļaut ierobežotu tādu operāciju optimizāciju, kas piekļūst volatile atmiņai."

#: common.opt:1840
#, no-c-format
msgid "Perform global common subexpression elimination."
msgstr "Veikt globālo kopīgo apakšizteiksmju likvidēšanu."

#: common.opt:1844
#, no-c-format
msgid "Perform enhanced load motion during global common subexpression elimination."
msgstr "Veikt uzlabotu ielāžu pārvietošanu globālo kopīgo apakšizteiksmju likvidēšanas laikā."

#: common.opt:1848
#, no-c-format
msgid "Perform store motion after global common subexpression elimination."
msgstr "Veikt saglabāšanu pārvietošanu pēc globālo kopīgo apakšizteiksmju likvidēšanas."

#: common.opt:1852
#, no-c-format
msgid "Try to avoid store forwarding."
msgstr "Mēģināt izvairīties no saglabāšanas pārsūtīšanas."

#: common.opt:1856
#, no-c-format
msgid "Perform redundant load after store elimination in global common subexpression elimination."
msgstr "Globālo kopīgo apakšizteiksmju likvidēšanā veikt liekas ielādes pēc saglabāšanas likvidēšanu."

#: common.opt:1861
#, no-c-format
msgid "Perform global common subexpression elimination after register allocation has finished."
msgstr "Pēc reģistru piešķiršanas pabeigšanas veikt globālo kopīgo apakšizteiksmju likvidēšanu."

#: common.opt:1878
#, no-c-format
msgid "-fgnat-encodings=[all|gdb|minimal]\tSelect the balance between GNAT encodings and standard DWARF emitted in the debug information."
msgstr "-fgnat-encodings=[all|gdb|minimal]\tIzvēlēties līdzsvaru starp GNAT kodējumiem un standarta DWARF, kas tiek izvadīts atkļūdošanas informācijā."

#: common.opt:1883
#, no-c-format
msgid "Enable in and out of Graphite representation."
msgstr "Iespējot pārveidošanu uz Graphite attēlojumu un atpakaļ."

#: common.opt:1887
#, no-c-format
msgid "Enable Graphite Identity transformation."
msgstr "Iespējot Graphite identitātes transformāciju."

#: common.opt:1891
#, no-c-format
msgid "Enable hoisting adjacent loads to encourage generating conditional move instructions."
msgstr "Iespējot blakus esošu ielāžu pacelšanu, lai veicinātu nosacītās pārvietošanas instrukciju ģenerēšanu."

#: common.opt:1904
#, no-c-format
msgid "Run two instruction combination passes late in the pass pipeline; one before register allocation and one after."
msgstr "Palaist divus instrukciju kombinēšanas gājienus gājienu konveijera beigās: vienu pirms reģistru piešķiršanas un vienu pēc tās."

#: common.opt:1909
#, no-c-format
msgid "Mark all loops as parallel."
msgstr "Atzīmēt visus ciklus kā paralēlus."

#: common.opt:1913 common.opt:1921 common.opt:3319
#, no-c-format
msgid "Enable loop nest transforms.  Same as -floop-nest-optimize."
msgstr "Iespējot ciklu ligzdu transformācijas. Tas pats, kas -floop-nest-optimize."

#: common.opt:1917
#, no-c-format
msgid "Enable loop interchange on trees."
msgstr "Iespējot ciklu apmaiņu kokos."

#: common.opt:1925
#, no-c-format
msgid "Perform unroll-and-jam on loops."
msgstr "Veikt cikliem unroll-and-jam."

#: common.opt:1929
#, no-c-format
msgid "Enable support for GNU transactional memory."
msgstr "Iespējot atbalstu GNU transakciju atmiņai."

#: common.opt:1933
#, no-c-format
msgid "Use STB_GNU_UNIQUE if supported by the assembler."
msgstr "Izmantot STB_GNU_UNIQUE, ja to atbalsta asembleris."

#: common.opt:1941
#, no-c-format
msgid "Enable the loop nest optimizer."
msgstr "Iespējot ciklu ligzdu optimizētāju."

#: common.opt:1945
#, no-c-format
msgid "Turn indirect calls of pointers loaded from structures to speculative calls if there is one known candidate."
msgstr "Pārvērst netiešos izsaukumus uz rādītājiem, kas ielādēti no struktūrām, par spekulatīviem izsaukumiem, ja ir viens zināms kandidāts."

#: common.opt:1949
#, no-c-format
msgid "Force bitfield accesses to match their type width."
msgstr "Piespiest bitu lauku piekļuves atbilstoši to tipa platumam."

#: common.opt:1953
#, no-c-format
msgid "Merge adjacent stores."
msgstr "Apvienot blakus esošās saglabāšanas."

#: common.opt:1957
#, no-c-format
msgid "Enable guessing of branch probabilities."
msgstr "Iespējot zarošanās varbūtību minēšanu."

#: common.opt:1961
#, no-c-format
msgid "Enable various security-relevant flags."
msgstr "Iespējot dažādus ar drošību saistītus karogus."

#: common.opt:1965
#, no-c-format
msgid "Harden conditionals not used in branches, checking reversed conditions."
msgstr "Nostiprināt nosacījumus, kas netiek izmantoti zarošanās instrukcijās, pārbaudot apgrieztos nosacījumus."

#: common.opt:1969
#, no-c-format
msgid "Harden conditional branches by checking reversed conditions."
msgstr "Nostiprināt nosacītās zarošanās, pārbaudot apgrieztos nosacījumus."

#: common.opt:1973
#, no-c-format
msgid "Harden control flow by recording and checking execution paths."
msgstr "Nostiprināt vadības plūsmu, reģistrējot un pārbaudot izpildes ceļus."

#: common.opt:1977
#, no-c-format
msgid "Disable CFR in leaf functions."
msgstr "Atspējot CFR lapas funkcijās."

#: common.opt:1981
#, no-c-format
msgid "Check CFR execution paths also before calls followed by returns of their results."
msgstr "Pārbaudīt CFR izpildes ceļus arī pirms izsaukumiem, kam seko to rezultātu atgriešana."

#: common.opt:1985
#, no-c-format
msgid "Check CFR execution paths also when exiting a function through an exception."
msgstr "Pārbaudīt CFR izpildes ceļus arī tad, kad funkcija tiek pamesta izņēmuma dēļ."

#: common.opt:1989
#, no-c-format
msgid "-fhardcfr-check-noreturn-calls=[always|no-xthrow|nothrow|never]\tCheck CFR execution paths also before calling noreturn functions."
msgstr "-fhardcfr-check-noreturn-calls=[always|no-xthrow|nothrow|never]\tPārbaudīt CFR izpildes ceļus arī pirms noreturn funkciju izsaukšanas."

#: common.opt:2010
#, no-c-format
msgid "Emit .ident assembler directives."
msgstr "Izvadīt .ident asemblera direktīvas."

#: common.opt:2014
#, no-c-format
msgid "Perform conversion of conditional jumps to branchless equivalents."
msgstr "Veikt nosacīto lēcienu pārveidošanu par ekvivalentiem bez zarošanās."

#: common.opt:2018
#, no-c-format
msgid "Perform conversion of conditional jumps to conditional execution."
msgstr "Veikt nosacīto lēcienu pārveidošanu par nosacītu izpildi."

#: common.opt:2022
#, no-c-format
msgid "-fstack-reuse=[all|named_vars|none]\tSet stack reuse level for local variables."
msgstr "-fstack-reuse=[all|named_vars|none]\tIestatīt steka atkārtotas izmantošanas līmeni lokālajiem mainīgajiem."

#: common.opt:2038
#, no-c-format
msgid "Convert conditional jumps in innermost loops to branchless equivalents."
msgstr "Pārveidot nosacītos lēcienus visiekšējos ciklos par ekvivalentiem bez zarošanās."

#: common.opt:2050
#, no-c-format
msgid "Do not generate .size directives."
msgstr "Neģenerēt .size direktīvas."

#: common.opt:2054
#, no-c-format
msgid "Perform indirect inlining."
msgstr "Veikt netiešo iekļaušanu."

#: common.opt:2060
#, no-c-format
msgid "Enable inlining of function declared \"inline\", disabling disables all inlining."
msgstr "Iespējot kā \"inline\" deklarēto funkciju iekļaušanu; atspējojot tiek atspējota jebkāda iekļaušana."

#: common.opt:2064
#, no-c-format
msgid "Integrate functions into their callers when code size is known not to grow."
msgstr "Iekļaut funkcijas to izsaucējos, ja zināms, ka koda izmērs nepieaugs."

#: common.opt:2068
#, no-c-format
msgid "Integrate functions not declared \"inline\" into their callers when profitable."
msgstr "Iekļaut funkcijas, kas nav deklarētas kā \"inline\", to izsaucējos, ja tas ir izdevīgi."

#: common.opt:2072
#, no-c-format
msgid "Integrate functions only required by their single caller."
msgstr "Iekļaut funkcijas, kuras nepieciešamas tikai to vienīgajam izsaucējam."

#: common.opt:2079
#, no-c-format
msgid "-finline-limit=<number>\tLimit the size of inlined functions to <number>."
msgstr "-finline-limit=<number>\tIerobežot iekļauto funkciju izmēru līdz <number>."

#: common.opt:2083
#, no-c-format
msgid "Inline __atomic operations when a lock free instruction sequence is available."
msgstr "Iekļaut __atomic operācijas, ja ir pieejama bezbloķēšanas instrukciju secība."

#: common.opt:2093
#, no-c-format
msgid "-finline-stringops[=memcmp|memcpy|memmove|memset] Expand supported mem/str operations inline, even if against optimization."
msgstr "-finline-stringops[=memcmp|memcpy|memmove|memset] Izvērst atbalstītās mem/str operācijas iekļauti, pat ja tas ir pretrunā optimizācijai."

#: common.opt:2121
#, no-c-format
msgid "Equivalent to -fcf-protection=full."
msgstr "Ekvivalents -fcf-protection=full."

#: common.opt:2125
#, no-c-format
msgid "-fcf-protection=[full|branch|return|none|check]\tInstrument functions with checks to verify jump/call/return control-flow transfer instructions have valid targets."
msgstr "-fcf-protection=[full|branch|return|none|check]\tInstrumentēt funkcijas ar pārbaudēm, kas pārliecinās, ka lēciena/izsaukuma/atgriešanās vadības nodošanas instrukcijām ir derīgi mērķi."

#: common.opt:2148
#, no-c-format
msgid "Instrument function entry and exit with profiling calls."
msgstr "Instrumentēt funkciju ieeju un izeju ar profilēšanas izsaukumiem."

#: common.opt:2152
#, no-c-format
msgid "Instrument function entry and exit with profiling calls invoked once."
msgstr "Instrumentēt funkciju ieeju un izeju ar vienreiz izsauktiem profilēšanas izsaukumiem."

#: common.opt:2156
#, no-c-format
msgid "-finstrument-functions-exclude-function-list=name,...\tDo not instrument listed functions."
msgstr "-finstrument-functions-exclude-function-list=name,...\tNeinstrumentēt uzskaitītās funkcijas."

#: common.opt:2160
#, no-c-format
msgid "-finstrument-functions-exclude-file-list=filename,...\tDo not instrument functions listed in files."
msgstr "-finstrument-functions-exclude-file-list=filename,...\tNeinstrumentēt failos uzskaitītās funkcijas."

#: common.opt:2164
#, no-c-format
msgid "Perform interprocedural constant propagation."
msgstr "Veikt starpprocedūru konstanšu izplatīšanu."

#: common.opt:2168
#, no-c-format
msgid "Perform cloning to make Interprocedural constant propagation stronger."
msgstr "Veikt klonēšanu, lai pastiprinātu starpprocedūru konstanšu izplatīšanu."

#: common.opt:2176
#, no-c-format
msgid "Perform interprocedural bitwise constant propagation."
msgstr "Veikt starpprocedūru bitu konstanšu izplatīšanu."

#: common.opt:2180
#, no-c-format
msgid "Perform interprocedural modref analysis."
msgstr "Veikt starpprocedūru modref analīzi."

#: common.opt:2184
#, no-c-format
msgid "Perform reordering and cloning of functions to maximize locality."
msgstr "Veikt funkciju pārkārtošanu un klonēšanu, lai maksimizētu lokalitāti."

#: common.opt:2188
#, no-c-format
msgid "Perform interprocedural profile propagation."
msgstr "Veikt starpprocedūru profila izplatīšanu."

#: common.opt:2192
#, no-c-format
msgid "Perform interprocedural points-to analysis."
msgstr "Veikt starpprocedūru norāžu (points-to) analīzi."

#: common.opt:2196
#, no-c-format
msgid "Discover pure and const functions."
msgstr "Atklāt pure un const funkcijas."

#: common.opt:2200
#, no-c-format
msgid "Perform Identical Code Folding for functions and read-only variables."
msgstr "Veikt identiska koda apvienošanu (ICF) funkcijām un tikai lasāmiem mainīgajiem."

#: common.opt:2204
#, no-c-format
msgid "Perform Identical Code Folding for functions."
msgstr "Veikt identiska koda apvienošanu (ICF) funkcijām."

#: common.opt:2208
#, no-c-format
msgid "Perform Identical Code Folding for variables."
msgstr "Veikt identiska koda apvienošanu (ICF) mainīgajiem."

#: common.opt:2212
#, no-c-format
msgid "Discover read-only and non addressable static variables."
msgstr "Atklāt tikai lasāmos un neadresējamos statiskos mainīgos."

#: common.opt:2216
#, no-c-format
msgid "Discover read-only, write-only and non-addressable static variables."
msgstr "Atklāt tikai lasāmos, tikai rakstāmos un neadresējamos statiskos mainīgos."

#: common.opt:2220
#, no-c-format
msgid "Reduce stack alignment on call sites if possible."
msgstr "Ja iespējams, samazināt steka izlīdzinājumu izsaukumu vietās."

#: common.opt:2232
#, no-c-format
msgid "Perform IPA Value Range Propagation."
msgstr "Veikt IPA vērtību diapazona izplatīšanu."

#: common.opt:2236
#, no-c-format
msgid "-fira-algorithm=[CB|priority]\tSet the used IRA algorithm."
msgstr "-fira-algorithm=[CB|priority]\tIestatīt izmantojamo IRA algoritmu."

#: common.opt:2240
#, no-c-format
msgid "Assume strict aliasing rules apply across (uninlined) function boundaries."
msgstr "Pieņemt, ka stingrās pārklāšanās (strict aliasing) noteikumi ir spēkā arī pāri (neiekļautu) funkciju robežām."

#: common.opt:2253
#, no-c-format
msgid "-fira-region=[one|all|mixed]\tSet regions for IRA."
msgstr "-fira-region=[one|all|mixed]\tIestatīt IRA apgabalus."

#: common.opt:2269
#, no-c-format
msgid "Use IRA based register pressure calculation in RTL hoist optimizations."
msgstr "Izmantot uz IRA balstītu reģistru spiediena aprēķinu RTL pacelšanas optimizācijās."

#: common.opt:2274
#, no-c-format
msgid "Use IRA based register pressure calculation in RTL loop optimizations."
msgstr "Izmantot uz IRA balstītu reģistru spiediena aprēķinu RTL ciklu optimizācijās."

#: common.opt:2279
#, no-c-format
msgid "Share slots for saving different hard registers."
msgstr "Koplietot slotus dažādu aparatūras reģistru saglabāšanai."

#: common.opt:2283
#, no-c-format
msgid "Share stack slots for spilled pseudo-registers."
msgstr "Koplietot steka slotus izspiestajiem pseidoreģistriem."

#: common.opt:2287
#, no-c-format
msgid "-fira-verbose=<number>\tControl IRA's level of diagnostic messages."
msgstr "-fira-verbose=<number>\tKontrolēt IRA diagnostikas ziņojumu līmeni."

#: common.opt:2291
#, no-c-format
msgid "Optimize induction variables on trees."
msgstr "Optimizēt indukcijas mainīgos kokos."

#: common.opt:2295
#, no-c-format
msgid "Use jump tables for sufficiently large switch statements."
msgstr "Izmantot lēcienu tabulas pietiekami lieliem switch priekšrakstiem."

#: common.opt:2299
#, no-c-format
msgid "Use bit tests for sufficiently large switch statements."
msgstr "Izmantot bitu pārbaudes pietiekami lieliem switch priekšrakstiem."

#: common.opt:2303
#, no-c-format
msgid "Generate code for functions even if they are fully inlined."
msgstr "Ģenerēt kodu funkcijām arī tad, ja tās ir pilnībā iekļautas."

#: common.opt:2307
#, no-c-format
msgid "Generate code for static functions even if they are never called."
msgstr "Ģenerēt kodu statiskām funkcijām pat tad, ja tās nekad netiek izsauktas."

#: common.opt:2311
#, no-c-format
msgid "Emit static const variables even if they are not used."
msgstr "Izvadīt static const mainīgos arī tad, ja tie netiek izmantoti."

#: common.opt:2315
#, no-c-format
msgid "Give external symbols a leading underscore."
msgstr "Ārējiem simboliem pievienot sākuma apakšsvītru."

#: common.opt:2323
#, no-c-format
msgid "Do CFG-sensitive rematerialization in LRA."
msgstr "Veikt CFG jutīgu rematerializāciju LRA."

#: common.opt:2327
#, no-c-format
msgid "Enable link-time optimization."
msgstr "Iespējot saistīšanas laika optimizāciju."

#: common.opt:2331
#, no-c-format
msgid "Link-time optimization with number of parallel jobs or jobserver."
msgstr "Saistīšanas laika optimizācija ar paralēlo darbu skaitu vai darbu serveri (jobserver)."

#: common.opt:2335
#, no-c-format
msgid "Enable incremental LTO, with its cache in given directory."
msgstr "Iespējot inkrementālo LTO ar kešatmiņu norādītajā direktorijā."

#: common.opt:2339
#, no-c-format
msgid "Number of cache entries in incremental LTO after which to prune old entries."
msgstr "Kešatmiņas ierakstu skaits inkrementālajā LTO, pēc kura atmest vecos ierakstus."

#: common.opt:2364
#, no-c-format
msgid "Specify the algorithm to partition symbols and vars at linktime."
msgstr "Norādīt algoritmu simbolu un mainīgo sadalīšanai nodalījumos saistīšanas laikā."

#: common.opt:2368
#, no-c-format
msgid "Enable heuristics to recognize symbol identifiers in toplevel (not extended) assembly and prevent their mangling/deletion."
msgstr "Iespējot heiristiku simbolu identifikatoru atpazīšanai augstākā līmeņa (ne paplašinātajā) asemblerā un to sagrozīšanas/dzēšanas novēršanai."

#: common.opt:2373
#, no-c-format
msgid "Use zlib/zstd compression level <number> for IL."
msgstr "Izmantot zlib/zstd saspiešanas līmeni <number> IL."

#: common.opt:2381
#, no-c-format
msgid "Report various link-time optimization statistics."
msgstr "Ziņot dažādu saistīšanas laika optimizācijas statistiku."

#: common.opt:2385
#, no-c-format
msgid "Report various link-time optimization statistics for WPA only."
msgstr "Ziņot dažādu saistīšanas laika optimizācijas statistiku tikai WPA."

#: common.opt:2389
#, no-c-format
msgid "Set errno after built-in math functions."
msgstr "Iestatīt errno pēc iebūvētajām matemātikas funkcijām."

#: common.opt:2393
#, no-c-format
msgid "-fmax-errors=<number>\tMaximum number of errors to report."
msgstr "-fmax-errors=<number>\tMaksimālais ziņojamo kļūdu skaits."

#: common.opt:2397
#, no-c-format
msgid "Allow removal of malloc and free pairs when allocated block is unused."
msgstr "Atļaut malloc un free pāru noņemšanu, ja izdalītais bloks netiek izmantots."

#: common.opt:2404
#, no-c-format
msgid "Report on permanent memory allocation."
msgstr "Ziņot par pastāvīgās atmiņas piešķiršanu."

#: common.opt:2408
#, no-c-format
msgid "Report on permanent memory allocation in WPA only."
msgstr "Ziņot par pastāvīgās atmiņas piešķiršanu tikai WPA."

#: common.opt:2415
#, no-c-format
msgid "Attempt to merge identical constants and constant variables."
msgstr "Mēģināt apvienot identiskas konstantes un konstantus mainīgos."

#: common.opt:2419
#, no-c-format
msgid "Attempt to merge identical constants across compilation units."
msgstr "Mēģināt apvienot identiskas konstantes starp kompilēšanas vienībām."

#: common.opt:2423
#, no-c-format
msgid "Attempt to merge identical debug strings across compilation units."
msgstr "Mēģināt apvienot identiskas atkļūdošanas virknes starp kompilēšanas vienībām."

#: common.opt:2427
#, no-c-format
msgid "-fmessage-length=<number>\tLimit diagnostics to <number> characters per line.  0 suppresses line-wrapping."
msgstr "-fmessage-length=<number>\tIerobežot diagnostikas līdz <number> rakstzīmēm rindā.  0 atspējo rindu pārnešanu."

#: common.opt:2431
#, no-c-format
msgid "Align the start of every function."
msgstr "Izlīdzināt katras funkcijas sākumu."

#: common.opt:2435
#, no-c-format
msgid "Perform SMS based modulo scheduling before the first scheduling pass."
msgstr "Veikt uz SMS balstītu modulo plānošanu pirms pirmā plānošanas gājiena."

#: common.opt:2439
#, no-c-format
msgid "Perform SMS based modulo scheduling with register moves allowed."
msgstr "Veikt uz SMS balstītu modulo plānošanu, atļaujot reģistru pārvietošanu."

#: common.opt:2443
#, no-c-format
msgid "Move loop invariant computations out of loops."
msgstr "Iznest ciklu invariantos aprēķinus ārpus cikliem."

#: common.opt:2447
#, no-c-format
msgid "Move stores out of loops."
msgstr "Iznest saglabāšanas ārpus cikliem."

#: common.opt:2451
#, no-c-format
msgid "Building block for specs-based multilib-aware TFLAGS."
msgstr "Būvēšanas bloks uz specs balstītiem, multilib ņemošiem vērā TFLAGS."

#: common.opt:2455
#, no-c-format
msgid "Use the RTL dead code elimination pass."
msgstr "Izmantot RTL nedzīvā koda likvidēšanas gājienu."

#: common.opt:2459
#, no-c-format
msgid "Use the RTL dead store elimination pass."
msgstr "Izmantot RTL nevajadzīgo saglabāšanu likvidēšanas gājienu."

#: common.opt:2463
#, no-c-format
msgid "Enable/Disable the traditional scheduling in loops that already passed modulo scheduling."
msgstr "Iespējot/atspējot tradicionālo plānošanu ciklos, kuriem jau veikta modulo plānošana."

#: common.opt:2467
#, no-c-format
msgid "Support synchronous non-call exceptions."
msgstr "Atbalstīt sinhronos non-call izņēmumus."

#: common.opt:2474
#, no-c-format
msgid "-foffload-options=<targets>=<options>\tSpecify options for the offloading targets."
msgstr "-foffload-options=<targets>=<options>\tNorādīt opcijas pārnešanas (offload) mērķiem."

#: common.opt:2480
#, no-c-format
msgid "-foffload-abi=[lp64|ilp32]\tSet the ABI to use in an offload compiler."
msgstr "-foffload-abi=[lp64|ilp32]\tIestatīt ABI, ko izmantot pārnešanas kompilatorā."

#: common.opt:2495
#, no-c-format
msgid "-foffload-abi-host-opts=<options>\tSpecify host ABI options."
msgstr "-foffload-abi-host-opts=<options>\tNorādīt resursdatora ABI opcijas."

#: common.opt:2499
#, no-c-format
msgid "When possible do not generate stack frames."
msgstr "Ja iespējams, neģenerēt steka kadrus."

#: common.opt:2506
#, no-c-format
msgid "Generate SIMD clones for functions with the OpenMP declare target directive."
msgstr "Ģenerēt SIMD klonus funkcijām ar OpenMP declare target direktīvu."

#: common.opt:2525
#, no-c-format
msgid "Enable all optimization info dumps on stderr."
msgstr "Iespējot visas optimizācijas informācijas izmetes uz stderr."

#: common.opt:2529
#, no-c-format
msgid "-fopt-info[-<type>=filename]\tDump compiler optimization details."
msgstr "-fopt-info[-<type>=filename]\tIzmest kompilatora optimizāciju informāciju."

#: common.opt:2533
#, no-c-format
msgid "Write a SRCFILE.opt-record.json file detailing what optimizations were performed."
msgstr "Ierakstīt failu SRCFILE.opt-record.json ar informāciju par veiktajām optimizācijām."

#: common.opt:2537
#, no-c-format
msgid "Detect loops calculating CRC and replace with faster implementation. If the target supports CRC instruction and the CRC loop uses the same polynomial as the one used in the CRC instruction, directly replace with the corresponding CRC instruction. Otherwise, if the target supports carry-less-multiplication instruction, generate CRC using it. If neither case applies, generate table-based CRC."
msgstr "Noteikt ciklus, kas aprēķina CRC, un aizstāt tos ar ātrāku implementāciju. Ja mērķis atbalsta CRC instrukciju un CRC cikls izmanto to pašu polinomu, kas tiek izmantots CRC instrukcijā, tieši aizstāt ar atbilstošo CRC instrukciju. Pretējā gadījumā, ja mērķis atbalsta bezpārneses reizināšanas instrukciju, ģenerēt CRC, izmantojot to. Ja neviens no gadījumiem nav piemērojams, ģenerēt uz tabulām balstītu CRC."

#: common.opt:2551
#, no-c-format
msgid "Optimize sibling and tail recursive calls."
msgstr "Optimizēt sibling un astes rekursīvos izsaukumus."

#: common.opt:2555
#, no-c-format
msgid "Insert path profiling code."
msgstr "Ievietot ceļa profilēšanas kodu."

#: common.opt:2559
#, no-c-format
msgid "Perform partial inlining."
msgstr "Veikt daļēju iekļaušanu."

#: common.opt:2563
#, no-c-format
msgid "Report on memory allocation before interprocedural optimization."
msgstr "Ziņot par atmiņas piešķiršanu pirms starpprocedūru optimizācijas."

#: common.opt:2567
#, no-c-format
msgid "Report on memory allocation after interprocedural optimization."
msgstr "Ziņot par atmiņas piešķiršanu pēc starpprocedūru optimizācijas."

#: common.opt:2571
#, no-c-format
msgid "Pack structure members together without holes."
msgstr "Pakot struktūras locekļus kopā bez caurumiem."

#: common.opt:2575
#, no-c-format
msgid "-fpack-struct=<number>\tSet initial maximum structure member alignment."
msgstr "-fpack-struct=<number>\tIestatīt sākotnējo maksimālo struktūras locekļu izlīdzinājumu."

#: common.opt:2579
#, no-c-format
msgid "Return small aggregates in memory, not registers."
msgstr "Atgriezt mazus agregātus atmiņā, nevis reģistros."

#: common.opt:2583
#, no-c-format
msgid "Perform loop peeling."
msgstr "Veikt ciklu nolobīšanu (peeling)."

#: common.opt:2587
#, no-c-format
msgid "Enable machine specific peephole optimizations."
msgstr "Iespējot mašīnai specifiskas peephole optimizācijas."

#: common.opt:2591
#, no-c-format
msgid "Enable an RTL peephole pass before sched2."
msgstr "Iespējot RTL peephole gājienu pirms sched2."

#: common.opt:2595
#, no-c-format
msgid "Generate position-independent code if possible (large mode)."
msgstr "Ja iespējams, ģenerēt no pozīcijas neatkarīgu kodu (lielais režīms)."

#: common.opt:2599
#, no-c-format
msgid "Generate position-independent code for executables if possible (large mode)."
msgstr "Ja iespējams, ģenerēt no pozīcijas neatkarīgu kodu izpildāmajiem failiem (lielais režīms)."

#: common.opt:2603
#, no-c-format
msgid "Generate position-independent code if possible (small mode)."
msgstr "Ja iespējams, ģenerēt no pozīcijas neatkarīgu kodu (mazais režīms)."

#: common.opt:2607
#, no-c-format
msgid "Generate position-independent code for executables if possible (small mode)."
msgstr "Ja iespējams, ģenerēt no pozīcijas neatkarīgu kodu izpildāmajiem failiem (mazais režīms)."

#: common.opt:2611
#, no-c-format
msgid "Use PLT for PIC calls (-fno-plt: load the address from GOT at call site)."
msgstr "Izmantot PLT PIC izsaukumiem (-fno-plt: ielādēt adresi no GOT izsaukuma vietā)."

#: common.opt:2615
#, no-c-format
msgid "Specify a plugin to load."
msgstr "Norādīt ielādējamo spraudni."

#: common.opt:2619
#, no-c-format
msgid "-fplugin-arg-<name>-<key>[=<value>]\tSpecify argument <key>=<value> for plugin <name>."
msgstr "-fplugin-arg-<name>-<key>[=<value>]\tNorādīt argumentu <key>=<value> spraudnim <name>."

#: common.opt:2623
#, no-c-format
msgid "Run predictive commoning optimization."
msgstr "Palaist prognozējošās kopīgošanas (predictive commoning) optimizāciju."

#: common.opt:2627
#, no-c-format
msgid "Generate prefetch instructions, if available, for arrays in loops."
msgstr "Ģenerēt priekšielādes instrukcijas masīviem ciklos, ja tās ir pieejamas."

#: common.opt:2631
#, no-c-format
msgid "Enable basic program profiling code."
msgstr "Iespējot programmas pamata profilēšanas kodu."

#: common.opt:2635
#, no-c-format
msgid "Generate absolute source path names for gcov."
msgstr "Ģenerēt absolūtus pirmkoda ceļu nosaukumus gcov."

#: common.opt:2639
#, no-c-format
msgid "Insert arc-based program profiling code."
msgstr "Ievietot uz lokiem balstītu programmas profilēšanas kodu."

#: common.opt:2643
#, no-c-format
msgid "Insert condition coverage profiling code."
msgstr "Ievietot nosacījumu pārklājuma profilēšanas kodu."

#: common.opt:2647
#, no-c-format
msgid "Set the top-level directory for storing the profile data. The default is 'pwd'."
msgstr "Iestatīt augstākā līmeņa direktoriju profila datu glabāšanai. Noklusējums ir 'pwd'."

#: common.opt:2652
#, no-c-format
msgid "Select the name for storing the profile note file."
msgstr "Izvēlēties nosaukumu profila piezīmju failam."

#: common.opt:2656
#, no-c-format
msgid "Enable correction of flow inconsistent profile data input."
msgstr "Iespējot plūsmas ziņā nekonsekventu ievades profila datu labošanu."

#: common.opt:2660
#, no-c-format
msgid "-fprofile-update=[single|atomic|prefer-atomic]\tSet the profile update method."
msgstr "-fprofile-update=[single|atomic|prefer-atomic]\tIestatīt profila atjaunināšanas metodi."

#: common.opt:2664
#, no-c-format
msgid "Instrument only functions from files whose name matches any of the regular expressions (separated by semi-colons)."
msgstr "Instrumentēt tikai funkcijas no failiem, kuru nosaukums atbilst kādai no regulārajām izteiksmēm (atdalītām ar semikoliem)."

#: common.opt:2668
#, no-c-format
msgid "Instrument only functions from files whose name does not match any of the regular expressions (separated by semi-colons)."
msgstr "Instrumentēt tikai funkcijas no failiem, kuru nosaukums neatbilst nevienai no regulārajām izteiksmēm (atdalītām ar semikoliem)."

#: common.opt:2684
#, no-c-format
msgid "-fprofile-reproducible=[serial|parallel-runs|multithreaded]\tControl level of reproducibility of profile gathered by -fprofile-generate."
msgstr "-fprofile-reproducible=[serial|parallel-runs|multithreaded]\tKontrolēt ar -fprofile-generate savāktā profila reproducējamības līmeni."

#: common.opt:2700
#, no-c-format
msgid "Remove prefix from absolute path before mangling name for -fprofile-generate= and -fprofile-use=."
msgstr "Noņemt priedēkli no absolūtā ceļa pirms nosaukuma sagrozīšanas opcijām -fprofile-generate= un -fprofile-use=."

#: common.opt:2704
#, no-c-format
msgid "-fprofile-prefix-map=<old>=<new>\tMap one directory name to another in GCOV coverage result."
msgstr "-fprofile-prefix-map=<old>=<new>\tGCOV pārklājuma rezultātā aizstāt vienu direktorijas nosaukumu ar citu."

#: common.opt:2708
#, no-c-format
msgid "Enable common options for generating profile info for profile feedback directed optimizations."
msgstr "Iespējot kopīgās opcijas profila informācijas ģenerēšanai uz profila atgriezenisko saiti balstītām optimizācijām."

#: common.opt:2712
#, no-c-format
msgid "Enable common options for generating profile info for profile feedback directed optimizations, and set -fprofile-dir=."
msgstr "Iespējot kopīgās opcijas profila informācijas ģenerēšanai uz profila atgriezenisko saiti balstītām optimizācijām un iestatīt -fprofile-dir=."

#: common.opt:2716
#, no-c-format
msgid "Register the profile information in the .gcov_info section instead of using a constructor/destructor."
msgstr "Reģistrēt profila informāciju sekcijā .gcov_info, nevis izmantot konstruktoru/destruktoru."

#: common.opt:2720
#, no-c-format
msgid "Register the profile information in the specified section instead of using a constructor/destructor."
msgstr "Reģistrēt profila informāciju norādītajā sekcijā, nevis izmantot konstruktoru/destruktoru."

#: common.opt:2724
#, no-c-format
msgid "Do not assume that functions never executed during the train run are cold."
msgstr "Nepieņemt, ka funkcijas, kas apmācības palaišanas laikā nekad netika izpildītas, ir aukstas."

#: common.opt:2728
#, no-c-format
msgid "Enable common options for performing profile feedback directed optimizations."
msgstr "Iespējot kopīgās opcijas uz profila atgriezenisko saiti balstītu optimizāciju veikšanai."

#: common.opt:2732
#, no-c-format
msgid "Enable common options for performing profile feedback directed optimizations, and set -fprofile-dir=."
msgstr "Iespējot kopīgās opcijas uz profila atgriezenisko saiti balstītu optimizāciju veikšanai un iestatīt -fprofile-dir=."

#: common.opt:2736
#, no-c-format
msgid "Insert code to profile values of expressions."
msgstr "Ievietot kodu izteiksmju vērtību profilēšanai."

#: common.opt:2740
#, no-c-format
msgid "Report on consistency of profile."
msgstr "Ziņot par profila konsekvenci."

#: common.opt:2744
#, no-c-format
msgid "Enable function reordering that improves code placement."
msgstr "Iespējot funkciju pārkārtošanu, kas uzlabo koda izvietojumu."

#: common.opt:2748
#, no-c-format
msgid "Insert NOP instructions at each function entry."
msgstr "Ievietot NOP instrukcijas katras funkcijas sākumā."

#: common.opt:2755
#, no-c-format
msgid "-frandom-seed=<string>\tMake compile reproducible using <string>."
msgstr "-frandom-seed=<string>\tPadarīt kompilēšanu reproducējamu, izmantojot <string>."

#: common.opt:2765
#, no-c-format
msgid "Record gcc command line switches in the object file."
msgstr "Ierakstīt gcc komandrindas slēdžus objektfailā."

#: common.opt:2769
#, no-c-format
msgid "Return small aggregates in registers."
msgstr "Atgriezt mazus agregātus reģistros."

#: common.opt:2777
#, no-c-format
msgid "Tell DSE that the storage for a C++ object is dead when the constructor starts and when the destructor finishes."
msgstr "Paziņot DSE, ka C++ objekta glabātuve ir nedzīva, kad sākas konstruktors un kad beidzas destruktors."

#: common.opt:2791
#, no-c-format
msgid "-flive-patching=[inline-only-static|inline-clone]\tControl IPA optimizations to provide a safe compilation for live-patching.  At the same time, provides multiple-level control on the enabled IPA optimizations."
msgstr "-flive-patching=[inline-only-static|inline-clone]\tKontrolēt IPA optimizācijas, lai nodrošinātu drošu kompilēšanu labošanai darbības laikā (live patching).  Vienlaikus nodrošina daudzlīmeņu kontroli pār iespējotajām IPA optimizācijām."

#: common.opt:2806
#, no-c-format
msgid "Tell DCE to remove unused C++ allocations."
msgstr "Likt DCE noņemt neizmantotās C++ izdales."

#: common.opt:2810
#, no-c-format
msgid "Relief of register pressure through live range shrinkage."
msgstr "Reģistru spiediena mazināšana, saīsinot dzīvības diapazonus."

#: common.opt:2814
#, no-c-format
msgid "Perform a register renaming optimization pass."
msgstr "Veikt reģistru pārdēvēšanas optimizācijas gājienu."

#: common.opt:2818
#, no-c-format
msgid "Perform a target dependent instruction fusion optimization pass."
msgstr "Veikt no mērķa atkarīgu instrukciju sapludināšanas optimizācijas gājienu."

#: common.opt:2822
#, no-c-format
msgid "Reorder basic blocks to improve code placement."
msgstr "Pārkārtot pamatblokus, lai uzlabotu koda izvietojumu."

#: common.opt:2826
#, no-c-format
msgid "-freorder-blocks-algorithm=[simple|stc]\tSet the used basic block reordering algorithm."
msgstr "-freorder-blocks-algorithm=[simple|stc]\tIestatīt izmantoto pamatbloku pārkārtošanas algoritmu."

#: common.opt:2839
#, no-c-format
msgid "Reorder basic blocks and partition into hot and cold sections."
msgstr "Pārkārtot pamatblokus un sadalīt tos karstajās un aukstajās sekcijās."

#: common.opt:2843
#, no-c-format
msgid "Reorder functions to improve code placement."
msgstr "Pārkārtot funkcijas, lai uzlabotu koda izvietojumu."

#: common.opt:2847
#, no-c-format
msgid "Add a common subexpression elimination pass after loop optimizations."
msgstr "Pēc ciklu optimizācijām pievienot kopīgo apakšizteiksmju likvidēšanas gājienu."

#: common.opt:2855
#, no-c-format
msgid "Disable optimizations that assume default FP rounding behavior."
msgstr "Atspējot optimizācijas, kas pieņem noklusējuma FP noapaļošanas uzvedību."

#: common.opt:2859
#, no-c-format
msgid "Enable scheduling across basic blocks."
msgstr "Iespējot plānošanu starp pamatblokiem."

#: common.opt:2863
#, no-c-format
msgid "Enable register pressure sensitive insn scheduling."
msgstr "Iespējot reģistru spiedienjutīgu insn plānošanu."

#: common.opt:2867
#, no-c-format
msgid "Allow speculative motion of non-loads."
msgstr "Atļaut spekulatīvu ne-ielāžu pārvietošanu."

#: common.opt:2871
#, no-c-format
msgid "Allow speculative motion of some loads."
msgstr "Atļaut dažu ielāžu spekulatīvu pārvietošanu."

#: common.opt:2875
#, no-c-format
msgid "Allow speculative motion of more loads."
msgstr "Atļaut vairāku ielāžu spekulatīvu pārvietošanu."

#: common.opt:2879
#, no-c-format
msgid "-fsched-verbose=<number>\tSet the verbosity level of the scheduler."
msgstr "-fsched-verbose=<number>\tIestatīt plānotāja detalizācijas līmeni."

#: common.opt:2883
#, no-c-format
msgid "If scheduling post reload, do superblock scheduling."
msgstr "Ja plānošana notiek pēc reload, veikt superbloku plānošanu."

#: common.opt:2891
#, no-c-format
msgid "Reschedule instructions before register allocation."
msgstr "Pārplānot instrukcijas pirms reģistru piešķiršanas."

#: common.opt:2895
#, no-c-format
msgid "Reschedule instructions after register allocation."
msgstr "Pārplānot instrukcijas pēc reģistru piešķiršanas."

#: common.opt:2902
#, no-c-format
msgid "Schedule instructions using selective scheduling algorithm."
msgstr "Plānot instrukcijas, izmantojot selektīvās plānošanas algoritmu."

#: common.opt:2906
#, no-c-format
msgid "Run selective scheduling after reload."
msgstr "Palaist selektīvo plānošanu pēc reload."

#: common.opt:2910
#, no-c-format
msgid "Run self-tests, using the given path to locate test files."
msgstr "Palaist pašpārbaudes, izmantojot norādīto ceļu, lai atrastu testa failus."

#: common.opt:2914
#, no-c-format
msgid "Perform software pipelining of inner loops during selective scheduling."
msgstr "Selektīvās plānošanas laikā veikt iekšējo ciklu programmatūras konveijerizāciju."

#: common.opt:2918
#, no-c-format
msgid "Perform software pipelining of outer loops during selective scheduling."
msgstr "Selektīvās plānošanas laikā veikt ārējo ciklu programmatūras konveijerizāciju."

#: common.opt:2923
#, no-c-format
msgid "Reschedule pipelined regions without pipelining."
msgstr "Pārplānot konveijerizētos apgabalus bez konveijerizācijas."

#: common.opt:2927
#, no-c-format
msgid "Allow interposing function (or variables) by ones with different semantics (or initializer) respectively by dynamic linker."
msgstr "Atļaut dinamiskajam saistītājam aizstāt funkcijas (vai mainīgos) ar tādām, kurām ir atšķirīga semantika (vai inicializators)."

#: common.opt:2933
#, no-c-format
msgid "Allow premature scheduling of queued insns."
msgstr "Atļaut rindā esošo insn priekšlaicīgu plānošanu."

#: common.opt:2937
#, no-c-format
msgid "-fsched-stalled-insns=<number>\tSet number of queued insns that can be prematurely scheduled."
msgstr "-fsched-stalled-insns=<number>\tIestatīt rindā esošo insn skaitu, ko var plānot priekšlaicīgi."

#: common.opt:2945
#, no-c-format
msgid "Set dependence distance checking in premature scheduling of queued insns."
msgstr "Iestatīt atkarību attāluma pārbaudi rindā esošo insn priekšlaicīgajā plānošanā."

#: common.opt:2949
#, no-c-format
msgid "-fsched-stalled-insns-dep=<number>\tSet dependence distance checking in premature scheduling of queued insns."
msgstr "-fsched-stalled-insns-dep=<number>\tIestatīt atkarību attāluma pārbaudi rindā esošo insn priekšlaicīgajā plānošanā."

#: common.opt:2953
#, no-c-format
msgid "Enable the group heuristic in the scheduler."
msgstr "Iespējot grupu heiristiku plānotājā."

#: common.opt:2957
#, no-c-format
msgid "Enable the critical path heuristic in the scheduler."
msgstr "Iespējot kritiskā ceļa heiristiku plānotājā."

#: common.opt:2961
#, no-c-format
msgid "Enable the speculative instruction heuristic in the scheduler."
msgstr "Iespējot spekulatīvo instrukciju heiristiku plānotājā."

#: common.opt:2965
#, no-c-format
msgid "Enable the rank heuristic in the scheduler."
msgstr "Iespējot ranga heiristiku plānotājā."

#: common.opt:2969
#, no-c-format
msgid "Enable the last instruction heuristic in the scheduler."
msgstr "Iespējot pēdējās instrukcijas heiristiku plānotājā."

#: common.opt:2973
#, no-c-format
msgid "Enable the dependent count heuristic in the scheduler."
msgstr "Iespējot atkarīgo skaita heiristiku plānotājā."

#: common.opt:2977
#, no-c-format
msgid "Access data in the same section from shared anchor points."
msgstr "Piekļūt datiem tajā pašā sekcijā no koplietotiem enkurpunktiem."

#: common.opt:2989
#, no-c-format
msgid "Turn on Redundant Extensions Elimination pass."
msgstr "Ieslēgt lieko paplašināšanu likvidēšanas (REE) gājienu."

#: common.opt:2993
#, no-c-format
msgid "Show column numbers in diagnostics, when available.  Default on."
msgstr "Diagnostikā rādīt kolonnu numurus, ja pieejami. Pēc noklusējuma ieslēgts."

#: common.opt:2997
#, no-c-format
msgid "Emit function prologues only before parts of the function that need it, rather than at the top of the function."
msgstr "Izvadīt funkcijas prologus tikai pirms tām funkcijas daļām, kurām tie nepieciešami, nevis funkcijas sākumā."

#: common.opt:3002
#, no-c-format
msgid "Shrink-wrap parts of the prologue and epilogue separately."
msgstr "Atsevišķi veikt prologa un epiloga daļu shrink-wrap."

#: common.opt:3006
#, no-c-format
msgid "Disable optimizations observable by IEEE signaling NaNs."
msgstr "Atspējot optimizācijas, kuras var pamanīt pēc IEEE signalizējošajiem NaN."

#: common.opt:3010
#, no-c-format
msgid "Disable floating point optimizations that ignore the IEEE signedness of zero."
msgstr "Atspējot peldošā komata optimizācijas, kas ignorē IEEE nulles zīmi."

#: common.opt:3014
#, no-c-format
msgid "Convert floating point constants to single precision constants."
msgstr "Pārveidot peldošā komata konstantes par vienkāršās precizitātes konstantēm."

#: common.opt:3018
#, no-c-format
msgid "Split lifetimes of induction variables when loops are unrolled."
msgstr "Sadalīt indukcijas mainīgo dzīves ilgumus, kad cikli tiek izvērsti."

#: common.opt:3022
#, no-c-format
msgid "Generate discontiguous stack frames."
msgstr "Ģenerēt nesavienotus steka kadrus."

#: common.opt:3026
#, no-c-format
msgid "Split wide types into independent registers."
msgstr "Sadalīt platus tipus neatkarīgos reģistros."

#: common.opt:3030
#, no-c-format
msgid "Split wide types into independent registers earlier."
msgstr "Agrāk sadalīt platus tipus neatkarīgos reģistros."

#: common.opt:3034
#, no-c-format
msgid "Enable backward propagation of use properties at the SSA level."
msgstr "Iespējot lietojuma īpašību atpakaļvērstu izplatīšanu SSA līmenī."

#: common.opt:3038
#, no-c-format
msgid "Optimize conditional patterns using SSA PHI nodes."
msgstr "Optimizēt nosacītos šablonus, izmantojot SSA PHI mezglus."

#: common.opt:3042
#, no-c-format
msgid "Optimize amount of stdarg registers saved to stack at start of function."
msgstr "Optimizēt funkcijas sākumā stekā saglabāto stdarg reģistru daudzumu."

#: common.opt:3046
#, no-c-format
msgid "Apply variable expansion when loops are unrolled."
msgstr "Piemērot mainīgo izvērsumu, kad cikli tiek izvērsti."

#: common.opt:3050
#, no-c-format
msgid "-fstack-check=[no|generic|specific]\tInsert stack checking code into the program."
msgstr "-fstack-check=[no|generic|specific]\tIevietot steka pārbaudes kodu programmā."

#: common.opt:3054
#, no-c-format
msgid "Insert stack checking code into the program.  Same as -fstack-check=specific."
msgstr "Ievietot steka pārbaudes kodu programmā. Tas pats, kas -fstack-check=specific."

#: common.opt:3058
#, no-c-format
msgid "Insert code to probe each page of stack space as it is allocated to protect from stack-clash style attacks."
msgstr "Ievietot kodu, kas zondē katru steka lapu tās piešķiršanas brīdī, lai aizsargātu pret stack-clash tipa uzbrukumiem."

#: common.opt:3067
#, no-c-format
msgid "-fstack-limit-register=<register>\tTrap if the stack goes past <register>."
msgstr "-fstack-limit-register=<register>\tIzraisīt slazdu, ja steks pārsniedz <register>."

#: common.opt:3071
#, no-c-format
msgid "-fstack-limit-symbol=<name>\tTrap if the stack goes past symbol <name>."
msgstr "-fstack-limit-symbol=<name>\tIzraisīt slazdu, ja steks pārsniedz simbolu <name>."

#: common.opt:3075
#, no-c-format
msgid "Use propolice as a stack protection method."
msgstr "Izmantot propolice kā steka aizsardzības metodi."

#: common.opt:3079
#, no-c-format
msgid "Use a stack protection method for every function."
msgstr "Izmantot steka aizsardzības metodi katrai funkcijai."

#: common.opt:3083
#, no-c-format
msgid "Use a smart stack protection method for certain functions."
msgstr "Izmantot gudru steka aizsardzības metodi noteiktām funkcijām."

#: common.opt:3087
#, no-c-format
msgid "Use stack protection method only for functions with the stack_protect attribute."
msgstr "Izmantot steka aizsardzības metodi tikai funkcijām ar atribūtu stack_protect."

#: common.opt:3091
#, no-c-format
msgid "Output stack usage information on a per-function basis."
msgstr "Izvadīt steka izmantošanas informāciju katrai funkcijai atsevišķi."

#: common.opt:3103
#, no-c-format
msgid "Assume strict aliasing rules apply."
msgstr "Pieņemt, ka ir spēkā stingrās pārklāšanās (strict aliasing) noteikumi."

#: common.opt:3107
#, no-c-format
msgid "Treat signed overflow as undefined.  Negated as -fwrapv -fwrapv-pointer."
msgstr "Uzskatīt pārpildi skaitļiem ar zīmi par nedefinētu. Pretējais ir -fwrapv -fwrapv-pointer."

#: common.opt:3111
#, no-c-format
msgid "Disable stack scrub entirely, disregarding strub attributes."
msgstr "Pilnībā atspējot steka tīrīšanu, ignorējot strub atribūtus."

#: common.opt:3115
#, no-c-format
msgid "Enable stack scrub as per attributes, with strict call checking."
msgstr "Iespējot steka tīrīšanu atbilstoši atribūtiem, ar stingru izsaukumu pārbaudi."

#: common.opt:3124
#, no-c-format
msgid "Restore default strub mode: as per attributes, with relaxed checking."
msgstr "Atjaunot noklusējuma strub režīmu: atbilstoši atribūtiem, ar atvieglotu pārbaudi."

#: common.opt:3128
#, no-c-format
msgid "Enable stack scrubbing for all viable functions."
msgstr "Iespējot steka tīrīšanu visām piemērotajām funkcijām."

#: common.opt:3132
#, no-c-format
msgid "Enable at-calls stack scrubbing for all viable functions."
msgstr "Iespējot at-calls steka tīrīšanu visām piemērotajām funkcijām."

#: common.opt:3136
#, no-c-format
msgid "Enable internal stack scrubbing for all viable functions."
msgstr "Iespējot iekšējo steka tīrīšanu visām piemērotajām funkcijām."

#: common.opt:3140
#, no-c-format
msgid "Implement __atomic operations via libcalls to legacy __sync functions."
msgstr "Īstenot __atomic operācijas, izmantojot libcall izsaukumus uz novecojušajām __sync funkcijām."

#: common.opt:3144
#, no-c-format
msgid "Check for syntax errors, then stop."
msgstr "Pārbaudīt sintakses kļūdas un apstāties."

#: common.opt:3148
#, no-c-format
msgid "Create data files needed by \"gcov\"."
msgstr "Izveidot \"gcov\" nepieciešamos datu failus."

#: common.opt:3152
#, no-c-format
msgid "Perform jump threading optimizations."
msgstr "Veikt lēcienu pavedināšanas optimizācijas."

#: common.opt:3156
#, no-c-format
msgid "Report the time taken by each compiler pass."
msgstr "Ziņot katra kompilatora gājiena patērēto laiku."

#: common.opt:3160
#, no-c-format
msgid "Record times taken by sub-phases separately."
msgstr "Atsevišķi reģistrēt apakšfāžu patērēto laiku."

#: common.opt:3164
#, no-c-format
msgid "-ftls-model=[global-dynamic|local-dynamic|initial-exec|local-exec]\tSet the default thread-local storage code generation model."
msgstr "-ftls-model=[global-dynamic|local-dynamic|initial-exec|local-exec]\tIestatīt noklusējuma pavedienlokālās glabāšanas koda ģenerēšanas modeli."

#: common.opt:3183
#, no-c-format
msgid "Reorder top level functions, variables, and asms."
msgstr "Pārkārtot augstākā līmeņa funkcijas, mainīgos un asm."

#: common.opt:3187
#, no-c-format
msgid "Perform superblock formation via tail duplication."
msgstr "Veikt superbloku veidošanu, izmantojot astes dublēšanu."

#: common.opt:3191
#, no-c-format
msgid "For targets that normally need trampolines for nested functions, always generate them instead of using descriptors."
msgstr "Mērķiem, kuriem ligzdotajām funkcijām parasti nepieciešami trampolīni, vienmēr ģenerēt tos, nevis izmantot deskriptorus."

#: common.opt:3196
#, no-c-format
msgid "Whether trampolines are generated in executable memory rather than executable stack."
msgstr "Vai trampolīni tiek ģenerēti izpildāmā atmiņā, nevis izpildāmā stekā."

#: common.opt:3214
#, no-c-format
msgid "Assume floating-point operations can trap."
msgstr "Pieņemt, ka peldošā komata operācijas var izraisīt slazdu."

#: common.opt:3218
#, no-c-format
msgid "Trap for signed overflow in addition, subtraction and multiplication."
msgstr "Izraisīt slazdu pārpildes gadījumā skaitļiem ar zīmi saskaitīšanā, atņemšanā un reizināšanā."

#: common.opt:3222
#, no-c-format
msgid "Enable SSA-CCP optimization on trees."
msgstr "Iespējot SSA-CCP optimizāciju kokos."

#: common.opt:3226
#, no-c-format
msgid "Enable SSA-BIT-CCP optimization on trees."
msgstr "Iespējot SSA-BIT-CCP optimizāciju kokos."

#: common.opt:3234
#, no-c-format
msgid "Enable loop header copying on trees."
msgstr "Iespējot ciklu galveņu kopēšanu kokos."

#: common.opt:3242
#, no-c-format
msgid "Enable SSA coalescing of user variables."
msgstr "Iespējot lietotāja mainīgo SSA sapludināšanu (coalescing)."

#: common.opt:3250
#, no-c-format
msgid "Enable copy propagation on trees."
msgstr "Iespējot kopiju izplatīšanu kokos."

#: common.opt:3258
#, no-c-format
msgid "Transform condition stores into unconditional ones."
msgstr "Pārveidot nosacītās saglabāšanas par beznosacījuma saglabāšanām."

#: common.opt:3262
#, no-c-format
msgid "Perform conversions of switch initializations."
msgstr "Veikt switch inicializāciju pārveidošanu."

#: common.opt:3266
#, no-c-format
msgid "Enable SSA dead code elimination optimization on trees."
msgstr "Iespējot SSA nedzīvā koda likvidēšanas optimizāciju kokos."

#: common.opt:3270
#, no-c-format
msgid "Enable dominator optimizations."
msgstr "Iespējot dominatoru optimizācijas."

#: common.opt:3274
#, no-c-format
msgid "Enable tail merging on trees."
msgstr "Iespējot astes apvienošanu kokos."

#: common.opt:3278
#, no-c-format
msgid "Enable dead store elimination."
msgstr "Iespējot nevajadzīgo saglabāšanu likvidēšanu."

#: common.opt:3282
#, no-c-format
msgid "Enable forward propagation on trees."
msgstr "Iespējot tiešo izplatīšanu kokos."

#: common.opt:3286
#, no-c-format
msgid "Enable Full Redundancy Elimination (FRE) on trees."
msgstr "Iespējot pilnu liekuma likvidēšanu (FRE) kokos."

#: common.opt:3290
#, no-c-format
msgid "Enable string length optimizations on trees."
msgstr "Iespējot virkņu garuma optimizācijas kokos."

#: common.opt:3294
#, no-c-format
msgid "Detect paths that trigger erroneous or undefined behavior due to dereferencing a null pointer.  Isolate those paths from the main control flow and turn the statement with erroneous or undefined behavior into a trap."
msgstr "Atklāt ceļus, kas izraisa kļūdainu vai nedefinētu uzvedību null rādītāja dereferencēšanas dēļ. Izolēt šos ceļus no galvenās vadības plūsmas un pārvērst priekšrakstu ar kļūdainu vai nedefinētu uzvedību par slazdu."

#: common.opt:3300
#, no-c-format
msgid "Detect paths that trigger erroneous or undefined behavior due to a null value being used in a way forbidden by a returns_nonnull or nonnull attribute.  Isolate those paths from the main control flow and turn the statement with erroneous or undefined behavior into a trap."
msgstr "Atklāt ceļus, kas izraisa kļūdainu vai nedefinētu uzvedību, jo null vērtība tiek izmantota veidā, ko aizliedz atribūts returns_nonnull vai nonnull. Izolēt šos ceļus no galvenās vadības plūsmas un pārvērst priekšrakstu ar kļūdainu vai nedefinētu uzvedību par slazdu."

#: common.opt:3307
#, no-c-format
msgid "Enable loop distribution on trees."
msgstr "Iespējot ciklu sadalīšanu kokos."

#: common.opt:3311
#, no-c-format
msgid "Enable loop distribution for patterns transformed into a library call."
msgstr "Iespējot ciklu sadalīšanu šabloniem, kas tiek pārveidoti par bibliotēkas izsaukumu."

#: common.opt:3315
#, no-c-format
msgid "Enable loop invariant motion on trees."
msgstr "Iespējot ciklu invariantu pārvietošanu kokos."

#: common.opt:3323
#, no-c-format
msgid "Create canonical induction variables in loops."
msgstr "Izveidot kanoniskus indukcijas mainīgos ciklos."

#: common.opt:3327
#, no-c-format
msgid "Enable loop optimizations on tree level."
msgstr "Iespējot ciklu optimizācijas koku līmenī."

#: common.opt:3331
#, no-c-format
msgid "-ftree-parallelize-loops=<number>\tEnable automatic parallelization of loops."
msgstr "-ftree-parallelize-loops=<number>\tIespējot automātisku ciklu paralelizāciju."

#: common.opt:3335
#, no-c-format
msgid "Enable automatic parallelization of loops."
msgstr "Iespējot automātisku ciklu paralelizāciju."

#: common.opt:3339
#, no-c-format
msgid "Enable hoisting loads from conditional pointers."
msgstr "Iespējot ielāžu pacelšanu no nosacītiem rādītājiem."

#: common.opt:3343
#, no-c-format
msgid "Enable SSA-PRE optimization on trees."
msgstr "Iespējot SSA-PRE optimizāciju kokos."

#: common.opt:3347
#, no-c-format
msgid "In SSA-PRE optimization on trees, enable partial-partial redundancy elimination."
msgstr "SSA-PRE optimizācijā kokos iespējot daļēji-daļēja liekuma likvidēšanu."

#: common.opt:3351
#, no-c-format
msgid "Perform function-local points-to analysis on trees."
msgstr "Veikt funkcijas lokālu norāžu (points-to) analīzi kokos."

#: common.opt:3355
#, no-c-format
msgid "Enable reassociation on tree level."
msgstr "Iespējot reasociāciju koku līmenī."

#: common.opt:3363
#, no-c-format
msgid "Enable SSA code sinking on trees."
msgstr "Iespējot SSA koda nogremdēšanu kokos."

#: common.opt:3367
#, no-c-format
msgid "Perform straight-line strength reduction."
msgstr "Veikt taisnās līnijas stipruma samazināšanu."

#: common.opt:3371
#, no-c-format
msgid "Perform scalar replacement of aggregates."
msgstr "Veikt agregātu skalāro aizstāšanu."

#: common.opt:3375
#, no-c-format
msgid "Replace temporary expressions in the SSA->normal pass."
msgstr "Aizstāt pagaidu izteiksmes SSA->normal gājienā."

#: common.opt:3383
#, no-c-format
msgid "Perform Value Range Propagation on trees."
msgstr "Veikt vērtību diapazonu izplatīšanu kokos."

#: common.opt:3387
#, no-c-format
msgid "Split paths leading to loop backedges."
msgstr "Sadalīt ceļus, kas ved uz ciklu atpakaļvērstajām šķautnēm."

#: common.opt:3391
#, no-c-format
msgid "Assume common declarations may be overridden with ones with a larger trailing array."
msgstr "Pieņemt, ka kopīgās (common) deklarācijas var tikt pārrakstītas ar tādām, kurām ir lielāks beigu masīvs."

#: common.opt:3396
#, no-c-format
msgid "Compile whole compilation unit at a time."
msgstr "Kompilēt visu kompilēšanas vienību uzreiz."

#: common.opt:3400
#, no-c-format
msgid "Trap on __builtin_unreachable instead of using it for optimization."
msgstr "Izraisīt slazdu pie __builtin_unreachable, nevis izmantot to optimizācijai."

#: common.opt:3404
#, no-c-format
msgid "Perform loop unrolling when iteration count is known."
msgstr "Veikt ciklu izvēršanu, ja iterāciju skaits ir zināms."

#: common.opt:3408
#, no-c-format
msgid "Perform loop unrolling for all loops."
msgstr "Veikt ciklu izvēršanu visiem cikliem."

#: common.opt:3423
#, no-c-format
msgid "Allow optimization for floating-point arithmetic which may change the result of the operation due to rounding."
msgstr "Atļaut peldošā komata aritmētikas optimizāciju, kas noapaļošanas dēļ var mainīt operācijas rezultātu."

#: common.opt:3428
#, no-c-format
msgid "Same as -fassociative-math for expressions which include division."
msgstr "Tas pats, kas -fassociative-math izteiksmēm, kas ietver dalīšanu."

#: common.opt:3436
#, no-c-format
msgid "Allow math optimizations that may violate IEEE or ISO standards."
msgstr "Atļaut matemātiskās optimizācijas, kas var pārkāpt IEEE vai ISO standartus."

#: common.opt:3440
#, no-c-format
msgid "Perform loop unswitching."
msgstr "Veikt ciklu atzarošanu (unswitching)."

#: common.opt:3444
#, no-c-format
msgid "Perform loop splitting."
msgstr "Veikt ciklu sadalīšanu."

#: common.opt:3448
#, no-c-format
msgid "Version loops based on whether indices have a stride of one."
msgstr "Veidot ciklu versijas atkarībā no tā, vai indeksu solis ir viens."

#: common.opt:3452
#, no-c-format
msgid "Just generate unwind tables for exception handling."
msgstr "Ģenerēt tikai attīšanas tabulas izņēmumu apstrādei."

#: common.opt:3456
#, no-c-format
msgid "Use the bfd linker instead of the default linker."
msgstr "Noklusējuma saistītāja vietā izmantot bfd saistītāju."

#: common.opt:3460
#, no-c-format
msgid "Use the gold linker instead of the default linker."
msgstr "Noklusējuma saistītāja vietā izmantot gold saistītāju."

#: common.opt:3464
#, no-c-format
msgid "Use the lld LLVM linker instead of the default linker."
msgstr "Noklusējuma saistītāja vietā izmantot lld LLVM saistītāju."

#: common.opt:3468
#, no-c-format
msgid "Use the Modern linker (MOLD) linker instead of the default linker."
msgstr "Noklusējuma saistītāja vietā izmantot Modern linker (MOLD) saistītāju."

#: common.opt:3472
#, no-c-format
msgid "Use the Wild linker instead of the default linker."
msgstr "Noklusējuma saistītāja vietā izmantot Wild saistītāju."

#: common.opt:3479
#, no-c-format
msgid "Enable linking of libatomic."
msgstr "Iespējot saistīšanu ar libatomic."

#: common.opt:3486
#, no-c-format
msgid "Perform variable tracking."
msgstr "Veikt mainīgo izsekošanu."

#: common.opt:3493
#, no-c-format
msgid "Perform variable tracking by annotating assignments."
msgstr "Veikt mainīgo izsekošanu, anotējot piešķiršanas."

#: common.opt:3499
#, no-c-format
msgid "Toggle -fvar-tracking-assignments."
msgstr "Pārslēgt -fvar-tracking-assignments."

#: common.opt:3506
#, no-c-format
msgid "Perform variable tracking and also tag variables that are uninitialized."
msgstr "Veikt mainīgo izsekošanu un atzīmēt arī neinicializētos mainīgos."

#: common.opt:3511
#, no-c-format
msgid "Enable vectorization on trees."
msgstr "Iespējot vektorizāciju kokos."

#: common.opt:3519
#, no-c-format
msgid "Enable loop vectorization on trees."
msgstr "Iespējot ciklu vektorizāciju kokos."

#: common.opt:3523
#, no-c-format
msgid "Enable basic block vectorization (SLP) on trees."
msgstr "Iespējot pamatbloku vektorizāciju (SLP) kokos."

#: common.opt:3527
#, no-c-format
msgid "-fvect-cost-model=[unlimited|dynamic|cheap|very-cheap]\tSpecifies the cost model for vectorization."
msgstr "-fvect-cost-model=[unlimited|dynamic|cheap|very-cheap]\tNorāda vektorizācijas izmaksu modeli."

#: common.opt:3531
#, no-c-format
msgid "-fsimd-cost-model=[unlimited|dynamic|cheap|very-cheap]\tSpecifies the vectorization cost model for code marked with a simd directive."
msgstr "-fsimd-cost-model=[unlimited|dynamic|cheap|very-cheap]\tNorāda vektorizācijas izmaksu modeli kodam, kas atzīmēts ar simd direktīvu."

#: common.opt:3550
#, no-c-format
msgid "Enables the dynamic vectorizer cost model.  Preserved for backward compatibility."
msgstr "Iespējot dinamisko vektorizētāja izmaksu modeli. Saglabāts atpakaļsaderībai."

#: common.opt:3558
#, no-c-format
msgid "Enable copy propagation of scalar-evolution information."
msgstr "Iespējot skalārās evolūcijas informācijas kopiju izplatīšanu."

#: common.opt:3562
#, no-c-format
msgid "-ftrivial-auto-var-init=[uninitialized|pattern|zero]\tAdd initializations to automatic variables."
msgstr "-ftrivial-auto-var-init=[uninitialized|pattern|zero]\tPievienot inicializācijas automātiskajiem mainīgajiem."

#: common.opt:3584
#, no-c-format
msgid "Add extra commentary to assembler output."
msgstr "Pievienot papildu komentārus asemblera izvadei."

#: common.opt:3588
#, no-c-format
msgid "-fvisibility=[default|internal|hidden|protected]\tSet the default symbol visibility."
msgstr "-fvisibility=[default|internal|hidden|protected]\tIestatīt noklusējuma simbolu redzamību."

#: common.opt:3607
#, no-c-format
msgid "Validate vtable pointers before using them."
msgstr "Validēt vtable rādītājus pirms to izmantošanas."

#: common.opt:3623
#, no-c-format
msgid "Output vtable verification counters."
msgstr "Izvadīt vtable verifikācijas skaitītājus."

#: common.opt:3627
#, no-c-format
msgid "Output vtable verification pointer sets information."
msgstr "Izvadīt vtable verifikācijas rādītāju kopu informāciju."

#: common.opt:3631
#, no-c-format
msgid "Use expression value profiles in optimizations."
msgstr "Izmantot izteiksmes vērtību profilus optimizācijās."

#: common.opt:3635
#, no-c-format
msgid "Construct webs and split unrelated uses of single variable."
msgstr "Veidot tīklus (webs) un sadalīt viena mainīgā nesaistītos lietojumus."

#: common.opt:3639
#, no-c-format
msgid "Enable conditional dead code elimination for builtin calls."
msgstr "Iespējot nosacītu nedzīvā koda likvidēšanu iebūvēto funkciju izsaukumiem."

#: common.opt:3643
#, no-c-format
msgid "Perform whole program optimizations."
msgstr "Veikt visas programmas optimizācijas."

#: common.opt:3647
#, no-c-format
msgid "Assume pointer overflow wraps around."
msgstr "Pieņemt, ka rādītāju pārpilde notiek ar apvēršanos (wrap around)."

#: common.opt:3651
#, no-c-format
msgid "Assume signed arithmetic overflow wraps around."
msgstr "Pieņemt, ka aritmētikas ar zīmi pārpilde notiek ar apvēršanos (wrap around)."

#: common.opt:3655
#, no-c-format
msgid "Put zero initialized data in the bss section."
msgstr "Ievietot ar nullēm inicializētus datus bss sekcijā."

#: common.opt:3659
#, no-c-format
msgid "Clear call-used registers upon function return."
msgstr "Notīrīt izsaukumā izmantotos (call-used) reģistrus funkcijas atgriešanās brīdī."

#: common.opt:3663
#, no-c-format
msgid "-fzero-init-padding-bits=[standard|unions|all]\tZero padding bits in initializers."
msgstr "-fzero-init-padding-bits=[standard|unions|all]\tInicializatoros nullēt aizpildījuma bitus."

#: common.opt:3679
#, no-c-format
msgid "Generate debug information in default format."
msgstr "Ģenerēt atkļūdošanas informāciju noklusējuma formātā."

#: common.opt:3683
#, no-c-format
msgid "Assume assembler support for (DWARF2+) .loc directives."
msgstr "Pieņemt asemblera atbalstu (DWARF2+) .loc direktīvām."

#: common.opt:3687
#, no-c-format
msgid "Assume assembler support for view in (DWARF2+) .loc directives."
msgstr "Pieņemt asemblera atbalstu view (DWARF2+) .loc direktīvās."

#: common.opt:3691
#, no-c-format
msgid "Generate debug information in CodeView format."
msgstr "Ģenerēt atkļūdošanas informāciju CodeView formātā."

#: common.opt:3711
#, no-c-format
msgid "Record DW_AT_decl_column and DW_AT_call_column in DWARF."
msgstr "Ierakstīt DWARF informācijā DW_AT_decl_column un DW_AT_call_column."

#: common.opt:3717
#, no-c-format
msgid "Generate CTF debug information at default level."
msgstr "Ģenerēt CTF atkļūdošanas informāciju noklusējuma līmenī."

#: common.opt:3721
#, no-c-format
msgid "Generate BTF debug information at default level."
msgstr "Ģenerēt BTF atkļūdošanas informāciju noklusējuma līmenī."

#: common.opt:3725
#, no-c-format
msgid "Generate pruned BTF when emitting BTF info."
msgstr "Izvadot BTF informāciju, ģenerēt apgrieztu BTF."

#: common.opt:3729
#, no-c-format
msgid "Generate debug information in default version of DWARF format."
msgstr "Ģenerēt atkļūdošanas informāciju DWARF formāta noklusējuma versijā."

#: common.opt:3733
#, no-c-format
msgid "Generate debug information in DWARF v2 (or later) format."
msgstr "Ģenerēt atkļūdošanas informāciju DWARF v2 (vai jaunākā) formātā."

#: common.opt:3737
#, no-c-format
msgid "Use 32-bit DWARF format when emitting DWARF debug information."
msgstr "Izmantot 32 bitu DWARF formātu, izvadot DWARF atkļūdošanas informāciju."

#: common.opt:3741
#, no-c-format
msgid "Use 64-bit DWARF format when emitting DWARF debug information."
msgstr "Izmantot 64 bitu DWARF formātu, izvadot DWARF atkļūdošanas informāciju."

#: common.opt:3745
#, no-c-format
msgid "Generate debug information in default extended format."
msgstr "Ģenerēt atkļūdošanas informāciju noklusējuma paplašinātajā formātā."

#: common.opt:3749
#, no-c-format
msgid "Generate extended entry point information for inlined functions."
msgstr "Ģenerēt paplašinātu ieejas punktu informāciju iekļautajām funkcijām."

#: common.opt:3753
#, no-c-format
msgid "Compute locview reset points based on insn length estimates."
msgstr "Aprēķināt locview atiestatīšanas punktus, pamatojoties uz insn garuma aplēsēm."

#: common.opt:3761
#, no-c-format
msgid "Don't generate DWARF pubnames and pubtypes sections."
msgstr "Neģenerēt DWARF pubnames un pubtypes sekcijas."

#: common.opt:3765
#, no-c-format
msgid "Generate DWARF pubnames and pubtypes sections."
msgstr "Ģenerēt DWARF pubnames un pubtypes sekcijas."

#: common.opt:3769
#, no-c-format
msgid "Generate DWARF pubnames and pubtypes sections with GNU extensions."
msgstr "Ģenerēt DWARF pubnames un pubtypes sekcijas ar GNU paplašinājumiem."

#: common.opt:3773
#, no-c-format
msgid "Record gcc command line switches in DWARF DW_AT_producer."
msgstr "Ierakstīt gcc komandrindas slēdžus DWARF DW_AT_producer."

#: common.opt:3777
#, no-c-format
msgid "Generate debug information in separate .dwo files."
msgstr "Ģenerēt atkļūdošanas informāciju atsevišķos .dwo failos."

#: common.opt:3789
#, no-c-format
msgid "Emit progressive recommended breakpoint locations."
msgstr "Izvadīt progresīvas ieteicamās pārtraukumpunktu vietas."

#: common.opt:3793
#, no-c-format
msgid "Don't emit DWARF additions beyond selected version."
msgstr "Neizvadīt DWARF papildinājumus, kas pārsniedz izvēlēto versiju."

#: common.opt:3797
#, no-c-format
msgid "Add description attributes to some DWARF DIEs that have no name attribute."
msgstr "Pievienot apraksta atribūtus dažiem DWARF DIE, kuriem nav nosaukuma atribūta."

#: common.opt:3801
#, no-c-format
msgid "Toggle debug information generation."
msgstr "Pārslēgt atkļūdošanas informācijas ģenerēšanu."

#: common.opt:3805
#, no-c-format
msgid "Augment variable location lists with progressive views."
msgstr "Papildināt mainīgo atrašanās vietu sarakstus ar progresīviem skatiem."

#: common.opt:3812
#, no-c-format
msgid "Generate debug information in VMS format."
msgstr "Ģenerēt atkļūdošanas informāciju VMS formātā."

#: common.opt:3841
#, no-c-format
msgid "Generate compressed debug sections."
msgstr "Ģenerēt saspiestas atkļūdošanas sekcijas."

#: common.opt:3845
#, no-c-format
msgid "-gz=<format>\tGenerate compressed debug sections in format <format>."
msgstr "-gz=<format>\tĢenerēt saspiestas atkļūdošanas sekcijas formātā <format>."

#: common.opt:3852
#, no-c-format
msgid "-iplugindir=<dir>\tSet <dir> to be the default plugin directory."
msgstr "-iplugindir=<dir>\tIestatīt <dir> kā noklusējuma spraudņu direktoriju."

#: common.opt:3856
#, no-c-format
msgid "-imultiarch <dir>\tSet <dir> to be the multiarch include subdirectory."
msgstr "-imultiarch <dir>\tIestatīt <dir> kā multiarch iekļaušanas apakšdirektoriju."

#: common.opt:3885
#, no-c-format
msgid "-o <file>\tPlace output into <file>."
msgstr "-o <file>\tIevietot izvadi failā <file>."

#: common.opt:3889
#, no-c-format
msgid "Enable function profiling."
msgstr "Iespējot funkciju profilēšanu."

#: common.opt:3899
#, no-c-format
msgid "Like -pedantic but issue errors instead of warnings."
msgstr "Līdzīgi kā -pedantic, bet izvadīt kļūdas, nevis brīdinājumus."

#: common.opt:3943
#, no-c-format
msgid "Do not display functions compiled or elapsed time."
msgstr "Nerādīt kompilētās funkcijas vai patērēto laiku."

#: common.opt:3947
#, no-c-format
msgid "Produce a relocatable object as output."
msgstr "Izveidot pārvietojamu objektu kā izvadi."

#: common.opt:3951
#, no-c-format
msgid "Remove all symbol table and relocation information from the executable."
msgstr "Noņemt no izpildāmā faila visu simbolu tabulas un relokāciju informāciju."

#: common.opt:3978
#, no-c-format
msgid "Enable verbose output."
msgstr "Iespējot detalizētu izvadi."

#: common.opt:3982
#, no-c-format
msgid "Display the compiler's version."
msgstr "Parādīt kompilatora versiju."

#: common.opt:3986
#, no-c-format
msgid "Suppress warnings."
msgstr "Apspiest brīdinājumus."

#: common.opt:3996
#, no-c-format
msgid "Create a shared library."
msgstr "Izveidot koplietojamo bibliotēku."

#: common.opt:4063
#, no-c-format
msgid "Don't create a dynamically linked position independent executable."
msgstr "Neizveidot dinamiski saistītu no pozīcijas neatkarīgu izpildāmo failu."

#: common.opt:4067
#, no-c-format
msgid "Create a dynamically linked position independent executable."
msgstr "Izveidot dinamiski saistītu no pozīcijas neatkarīgu izpildāmo failu."

#: common.opt:4071
#, no-c-format
msgid "Create a static position independent executable."
msgstr "Izveidot statisku, no pozīcijas neatkarīgu izpildāmo failu."

#: common.opt:4079
#, no-c-format
msgid "Use caller save register across calls if possible."
msgstr "Ja iespējams, izmantot izsaucēja saglabājamos reģistrus pāri izsaukumiem."

#: common.opt:4083
#, no-c-format
msgid "Perform dead code elimination on zero and sign extensions with special dataflow analysis."
msgstr "Veikt nedzīvā koda likvidēšanu nulles un zīmes paplašinājumiem, izmantojot īpašu datu plūsmas analīzi."

#: algol68/lang.opt:37
#, no-c-format
msgid "Warn for usage of non-portable extensions of Algol 68."
msgstr "Brīdināt par Algol 68 nepārnesamu paplašinājumu izmantošanu."

#: algol68/lang.opt:41
#, no-c-format
msgid "Warn when voiding occurs."
msgstr "Brīdināt, ja notiek tukšošana (voiding)."

#: algol68/lang.opt:49
#, no-c-format
msgid "Warn for potential name scope violations."
msgstr "Brīdināt par potenciāliem nosaukumu tvēruma pārkāpumiem."

#: algol68/lang.opt:65
#, no-c-format
msgid "Warn about hidden declarations in inner scopes."
msgstr "Brīdināt par slēptām deklarācijām iekšējos tvērumos."

#: algol68/lang.opt:69
#, no-c-format
msgid "-Whidden-declarations=[none|prelude|all] Warn about declarations hidden in inner scopes."
msgstr "-Whidden-declarations=[none|prelude|all] Brīdināt par deklarācijām, kas paslēptas iekšējos tvērumos."

#: algol68/lang.opt:73
#, no-c-format
msgid "-fbrackets  \tConsider [ .. ] and { .. } as being equivalent to ( .. )."
msgstr "-fbrackets  \tUzskatīt [ .. ] un { .. } par ekvivalentiem ( .. )."

#: algol68/lang.opt:77 d/lang.opt:190
#, no-c-format
msgid "Generate code for assert contracts."
msgstr "Ģenerēt kodu assert kontraktiem."

#: algol68/lang.opt:88
#, no-c-format
msgid "Dump Algol 68 modes after parsing."
msgstr "Izmest Algol 68 režīmus (modes) pēc parsēšanas."

#: algol68/lang.opt:92
#, no-c-format
msgid "Dump Algol 68 parse tree after parsing."
msgstr "Izmest Algol 68 parsēšanas koku pēc parsēšanas."

#: algol68/lang.opt:96
#, no-c-format
msgid "Dump the interfaces of module definitions in the compiled packet."
msgstr "Izmest kompilētās paketes moduļu definīciju saskarnes."

#: algol68/lang.opt:100
#, no-c-format
msgid "Link the GNU Algol run-time library statically in the compilation."
msgstr "Kompilējot statiski saistīt GNU Algol izpildlaika bibliotēku."

#: algol68/lang.opt:104
#, no-c-format
msgid "Link the GNU Algol 68 run-time library dynamically in the compilation."
msgstr "Kompilējot dinamiski saistīt GNU Algol 68 izpildlaika bibliotēku."

#: algol68/lang.opt:108
#, no-c-format
msgid "Compile strict Algol 68 as defined by the Revised Report."
msgstr "Kompilēt stingro Algol 68, kā definēts Revised Report."

#: algol68/lang.opt:112
#, no-c-format
msgid "Accept GNU extensions to Algol 68."
msgstr "Pieņemt GNU paplašinājumus Algol 68 valodai."

#: algol68/lang.opt:118
#, no-c-format
msgid "-fstropping=[upper|supper]              Stropping regime to expect in Algol 68 programs."
msgstr "-fstropping=[upper|supper]              Algol 68 programmās sagaidāmais stropping režīms."

#: algol68/lang.opt:133 algol68/lang.opt:137
#, no-c-format
msgid "-fmodules-map=<mapstring>                 Association between module indicants and files."
msgstr "-fmodules-map=<mapstring>                 Moduļu indikantu un failu sasaiste."

#: algol68/lang.opt:141 algol68/lang.opt:145
#, no-c-format
msgid "-fmodules-map-file=<filename>              File containing modules map."
msgstr "-fmodules-map-file=<filename>              Fails, kas satur moduļu karti."

#: rust/lang.opt:47 rust/lang.opt:51 c-family/c.opt:1609 c-family/c.opt:1613
#, no-c-format
msgid "Warn when a const variable is unused."
msgstr "Brīdināt, ja const mainīgais netiek izmantots."

#: rust/lang.opt:55 c-family/c.opt:1625
#, no-c-format
msgid "Warn if a caller of a function, marked with attribute warn_unused_result, does not use its return value."
msgstr "Brīdināt, ja funkcijas, kas atzīmēta ar atribūtu warn_unused_result, izsaucējs neizmanto tās atgriezto vērtību."

#: rust/lang.opt:63
#, no-c-format
msgid "-frust-crate=<name>             Set the crate name for the compilation."
msgstr "-frust-crate=<name>             Iestatīt kompilējamā crate nosaukumu."

#: rust/lang.opt:67
#, no-c-format
msgid "-frust-crate-attr=<attr>        Inject an attribute within the current crate."
msgstr "-frust-crate-attr=<attr>        Ievietot atribūtu pašreizējā crate."

#: rust/lang.opt:71
#, no-c-format
msgid "-frust-extern=              Specify where an external library is located."
msgstr "-frust-extern=              Norādīt, kur atrodas ārējā bibliotēka."

#: rust/lang.opt:75
#, no-c-format
msgid "Dump various Rust front end internals."
msgstr "Izmest dažādus Rust priekšējās daļas iekšējos datus."

#: rust/lang.opt:79
#, no-c-format
msgid "-frust-dump-<type>              Dump Rust frontend internal information."
msgstr "-frust-dump-<type>              Izmest Rust priekšējās daļas iekšējo informāciju."

#: rust/lang.opt:83
#, no-c-format
msgid "Enable experimental compilation of Rust files at your own risk."
msgstr "Iespējot eksperimentālu Rust failu kompilēšanu uz savu risku."

#: rust/lang.opt:87
#, no-c-format
msgid "-frust-max-recursion-depth=<integer>."
msgstr "-frust-max-recursion-depth=<integer>."

#: rust/lang.opt:91
#, no-c-format
msgid "-frust-crate-type=[bin|lib|rlib|dylib|cdylib|staticlib|proc-macro]     Crate type to emit."
msgstr "-frust-crate-type=[bin|lib|rlib|dylib|cdylib|staticlib|proc-macro]     Izvadāmā crate tips."

#: rust/lang.opt:119
#, no-c-format
msgid "-frust-mangling=[legacy|v0]     Version to use for name mangling."
msgstr "-frust-mangling=[legacy|v0]     Nosaukumu sagrozīšanai (mangling) izmantojamā versija."

#: rust/lang.opt:132
#, no-c-format
msgid "-frust-cfg=<name>             Set a config expansion option."
msgstr "-frust-cfg=<name>             Iestatīt konfigurācijas izvēršanas opciju."

#: rust/lang.opt:136
#, no-c-format
msgid "-frust-edition=[2015|2018|2021]             Edition to use when compiling rust code."
msgstr "-frust-edition=[2015|2018|2021]             Izdevums (edition), ko izmantot, kompilējot Rust kodu."

#: rust/lang.opt:152
#, no-c-format
msgid "Enable embedding metadata directly into object files."
msgstr "Iespējot metadatu iegulšanu tieši objektfailos."

#: rust/lang.opt:156
#, no-c-format
msgid "-frust-metadata-output=<path.rox>  Path to output crate metadata."
msgstr "-frust-metadata-output=<path.rox>  Ceļš crate metadatu izvadei."

#: rust/lang.opt:164
#, no-c-format
msgid "-frust-compile-until=[ast|attributecheck|expansion|astvalidation|featuregating|nameresolution|lowering|typecheck|privacy|unsafety|const|borrowcheck|compilation|end]             The pipeline will run up until this stage when compiling Rust code."
msgstr "-frust-compile-until=[ast|attributecheck|expansion|astvalidation|featuregating|nameresolution|lowering|typecheck|privacy|unsafety|const|borrowcheck|compilation|end]             Kompilējot Rust kodu, konveijers darbosies līdz šim posmam."

#: rust/lang.opt:213
#, no-c-format
msgid "Use the temporary and experimental name resolution pipeline instead of the stable one."
msgstr "Izmantot pagaidu un eksperimentālo nosaukumu atrisināšanas konveijeru, nevis stabilo."

#: rust/lang.opt:217
#, no-c-format
msgid "Use the WIP borrow checker."
msgstr "Izmantot nepabeigto (WIP) aizņēmumu pārbaudītāju."

#: rust/lang.opt:221
#, no-c-format
msgid "-frust-edition=[unwind|abort]             Panic strategy to compile crate with."
msgstr "-frust-edition=[unwind|abort]             Panikas stratēģija, ar kuru kompilēt crate."

#: rust/lang.opt:234
#, no-c-format
msgid "Enable the overflow checks in code generation."
msgstr "Iespējot pārpildes pārbaudes koda ģenerēšanā."

#: rust/lang.opt:238
#, no-c-format
msgid "Define a built-in offset_of macro in the compiler and assume it is present."
msgstr "Definēt iebūvēto offset_of makro kompilatorā un pieņemt, ka tas ir pieejams."

#: rust/lang.opt:242
#, no-c-format
msgid "Use the new unused variable check implementation."
msgstr "Izmantot jauno neizmantoto mainīgo pārbaudes implementāciju."

#: ada/gcc-interface/lang.opt:57 c-family/c.opt:349
#, no-c-format
msgid "Enable most warning messages."
msgstr "Iespējot lielāko daļu brīdinājumu ziņojumu."

#: ada/gcc-interface/lang.opt:61
#, no-c-format
msgid "Dump Source Coverage Obligations."
msgstr "Izmest pirmkoda pārklājuma saistības (SCO)."

#: ada/gcc-interface/lang.opt:65
#, no-c-format
msgid "Synonym of -gnatk8."
msgstr "Sinonīms -gnatk8."

#: ada/gcc-interface/lang.opt:73
#, no-c-format
msgid "Do not look for object files in standard path."
msgstr "Nemeklēt objektfailus standarta ceļā."

#: ada/gcc-interface/lang.opt:77
#, no-c-format
msgid "Select the runtime."
msgstr "Izvēlēties izpildlaiku."

#: ada/gcc-interface/lang.opt:81 c-family/c.opt:2385
#, no-c-format
msgid "Use the narrowest integer type possible for enumeration types."
msgstr "Uzskaitījuma tipiem izmantot pēc iespējas šaurāko veselo skaitļu tipu."

#: ada/gcc-interface/lang.opt:85 c-family/c.opt:2397
#, no-c-format
msgid "Make \"char\" signed by default."
msgstr "Pēc noklusējuma padarīt \"char\" ar zīmi."

#: ada/gcc-interface/lang.opt:89 c-family/c.opt:2486
#, no-c-format
msgid "Make \"char\" unsigned by default."
msgstr "Pēc noklusējuma padarīt \"char\" bez zīmes."

#: ada/gcc-interface/lang.opt:93
#, no-c-format
msgid "Catch typos."
msgstr "Atklāt drukas kļūdas."

#: ada/gcc-interface/lang.opt:97
#, no-c-format
msgid "Set name of output ALI file (internal switch)."
msgstr "Iestatīt izvades ALI faila nosaukumu (iekšējs slēdzis)."

#: ada/gcc-interface/lang.opt:101
#, no-c-format
msgid "-gnat<options>\tSpecify options to GNAT."
msgstr "-gnat<options>\tNorādīt GNAT opcijas."

#: ada/gcc-interface/lang.opt:105
#, no-c-format
msgid "Ignored."
msgstr "Ignorēts."

#: c-family/c.opt:50
#, no-c-format
msgid "--compile-std-module\tCompile module units for <bits/stdc++.h>, std, and std.compat."
msgstr "--compile-std-module\tKompilēt moduļu vienības <bits/stdc++.h>, std un std.compat."

#: c-family/c.opt:75
#, no-c-format
msgid "--embed-dir=<dir>\tAdd <dir> to the #embed path."
msgstr "--embed-dir=<dir>\tPievienot <dir> #embed ceļam."

#: c-family/c.opt:198
#, no-c-format
msgid "-A<question>=<answer>\tAssert the <answer> to <question>.  Putting '-' before <question> disables the <answer> to <question>."
msgstr "-A<question>=<answer>\tApgalvot <answer> uz <question>.  Ievietojot '-' pirms <question>, tiek atspējota <answer> uz <question>."

#: c-family/c.opt:202
#, no-c-format
msgid "Do not discard comments."
msgstr "Neatmest komentārus."

#: c-family/c.opt:206
#, no-c-format
msgid "Do not discard comments in macro expansions."
msgstr "Neatmest komentārus makro izvērsumos."

#: c-family/c.opt:210
#, no-c-format
msgid "-D<macro>[=<val>]\tDefine a <macro> with <val> as its value.  If just <macro> is given, <val> is taken to be 1."
msgstr "-D<macro>[=<val>]\tDefinēt makro <macro> ar vērtību <val>.  Ja dots tikai <macro>, par <val> tiek pieņemts 1."

#: c-family/c.opt:217
#, no-c-format
msgid "-F <dir>\tAdd <dir> to the end of the main framework include path."
msgstr "-F <dir>\tPievienot <dir> galvenā ietvaru iekļaušanas ceļa beigām."

#: c-family/c.opt:221
#, no-c-format
msgid "Enable parsing GIMPLE."
msgstr "Iespējot GIMPLE parsēšanu."

#: c-family/c.opt:225
#, no-c-format
msgid "Print the name of header files as they are used."
msgstr "Izdrukāt galvenes failu nosaukumus, kad tie tiek izmantoti."

#: c-family/c.opt:229
#, no-c-format
msgid "-I <dir>\tAdd <dir> to the end of the main include path."
msgstr "-I <dir>\tPievienot <dir> galvenā iekļaušanas ceļa beigām."

#: c-family/c.opt:233
#, no-c-format
msgid "Generate make dependencies."
msgstr "Ģenerēt make atkarības."

#: c-family/c.opt:237
#, no-c-format
msgid "Generate make dependencies and compile."
msgstr "Ģenerēt make atkarības un kompilēt."

#: c-family/c.opt:241
#, no-c-format
msgid "-MF <file>\tWrite dependency output to the given file."
msgstr "-MF <file>\tIerakstīt atkarību izvadi norādītajā failā."

#: c-family/c.opt:245
#, no-c-format
msgid "Treat missing header files as generated files."
msgstr "Uzskatīt trūkstošos galvenes failus par ģenerētiem failiem."

#: c-family/c.opt:249
#, no-c-format
msgid "Like -M but ignore system header files."
msgstr "Līdzīgi kā -M, bet ignorēt sistēmas galvenes failus."

#: c-family/c.opt:253
#, no-c-format
msgid "Like -MD but ignore system header files."
msgstr "Līdzīgi kā -MD, bet ignorēt sistēmas galvenes failus."

#: c-family/c.opt:257
#, no-c-format
msgid "Generate C++ Module dependency information."
msgstr "Ģenerēt C++ moduļu atkarību informāciju."

#: c-family/c.opt:265
#, no-c-format
msgid "Generate phony targets for all headers."
msgstr "Ģenerēt fiktīvus (phony) mērķus visām galvenēm."

#: c-family/c.opt:269
#, no-c-format
msgid "-MQ <target>\tAdd a target that may require quoting."
msgstr "-MQ <target>\tPievienot mērķi, kuram var būt nepieciešama pēdiņošana."

#: c-family/c.opt:273
#, no-c-format
msgid "-MT <target>\tAdd a target that does not require quoting."
msgstr "-MT <target>\tPievienot mērķi, kuram nav nepieciešama pēdiņošana."

#: c-family/c.opt:277
#, no-c-format
msgid "Structured format for output dependency information.  Supported (\"p1689r5\")."
msgstr "Strukturēts formāts izvades atkarību informācijai. Atbalstīts (\"p1689r5\")."

#: c-family/c.opt:281
#, no-c-format
msgid "File for output dependency information."
msgstr "Fails izvades atkarību informācijai."

#: c-family/c.opt:285
#, no-c-format
msgid "-fdeps-target=obj.o Output file for the compile step."
msgstr "-fdeps-target=obj.o Kompilēšanas soļa izvades fails."

#: c-family/c.opt:289
#, no-c-format
msgid "Do not generate #line directives."
msgstr "Neģenerēt #line direktīvas."

#: c-family/c.opt:293
#, no-c-format
msgid "-U<macro>\tUndefine <macro>."
msgstr "-U<macro>\tAtcelt makro <macro> definīciju."

#: c-family/c.opt:297
#, no-c-format
msgid "Warn if the NSObject attribute is applied to a non-typedef."
msgstr "Brīdināt, ja atribūts NSObject tiek lietots kam citam, nevis typedef."

#: c-family/c.opt:301
#, no-c-format
msgid "Warn about things that will change when compiling with an ABI-compliant compiler."
msgstr "Brīdināt par lietām, kas mainīsies, kompilējot ar ABI atbilstošu kompilatoru."

#: c-family/c.opt:305
#, no-c-format
msgid "Warn about things that change between the current -fabi-version and the specified version."
msgstr "Brīdināt par lietām, kas mainās starp pašreizējo -fabi-version un norādīto versiju."

#: c-family/c.opt:309
#, no-c-format
msgid "Warn if a subobject has an abi_tag attribute that the complete object type does not have."
msgstr "Brīdināt, ja apakšobjektam ir abi_tag atribūts, kura nav pilnajam objekta tipam."

#: c-family/c.opt:313
#, no-c-format
msgid "Warn about code affected by incompatible psABI changes."
msgstr "Brīdināt par kodu, ko ietekmē nesaderīgas psABI izmaiņas."

#: c-family/c.opt:317
#, no-c-format
msgid "Warn on suspicious calls of standard functions computing absolute values."
msgstr "Brīdināt par aizdomīgiem standarta funkciju izsaukumiem, kas aprēķina absolūtās vērtības."

#: c-family/c.opt:321
#, no-c-format
msgid "Warn about suspicious uses of memory addresses."
msgstr "Brīdināt par aizdomīgu atmiņas adrešu izmantošanu."

#: c-family/c.opt:325
#, no-c-format
msgid "Warn when the address of packed member of struct or union is taken."
msgstr "Brīdināt, ja tiek ņemta struktūras vai apvienojuma pakota locekļa adrese."

#: c-family/c.opt:341
#, no-c-format
msgid "Warn about 'new' of type with extended alignment without -faligned-new."
msgstr "Brīdināt par 'new' tipam ar paplašinātu izlīdzinājumu bez -faligned-new."

#: c-family/c.opt:345
#, no-c-format
msgid "-Waligned-new=[none|global|all]\tWarn even if 'new' uses a class member allocation function."
msgstr "-Waligned-new=[none|global|all]\tBrīdināt arī tad, ja 'new' izmanto klases locekļa piešķiršanas funkciju."

#: c-family/c.opt:353
#, no-c-format
msgid "Warn on any use of alloca."
msgstr "Brīdināt par jebkādu alloca izmantošanu."

#: c-family/c.opt:357
#, no-c-format
msgid "Warn when allocating insufficient storage for the target type of the assigned pointer."
msgstr "Brīdināt, ja tiek izdalīts nepietiekami daudz atmiņas piešķirtā rādītāja mērķa tipam."

#: c-family/c.opt:361
#, no-c-format
msgid "-Walloc-size-larger-than=<bytes>\tWarn for calls to allocation functions that attempt to allocate objects larger than the specified number of bytes."
msgstr "-Walloc-size-larger-than=<bytes>\tBrīdināt par piešķiršanas funkciju izsaukumiem, kas mēģina izdalīt objektus, lielākus par norādīto baitu skaitu."

#: c-family/c.opt:366
#, no-c-format
msgid "Disable Walloc-size-larger-than= warning.  Equivalent to Walloc-size-larger-than=<SIZE_MAX> or larger."
msgstr "Atspējot Walloc-size-larger-than= brīdinājumu.  Ekvivalents Walloc-size-larger-than=<SIZE_MAX> vai lielākai vērtībai."

#: c-family/c.opt:370
#, no-c-format
msgid "Warn for calls to allocation functions that specify zero bytes."
msgstr "Brīdināt par piešķiršanas funkciju izsaukumiem, kuros norādīti nulle baitu."

#: c-family/c.opt:374
#, no-c-format
msgid "-Walloca-larger-than=<number>\tWarn on unbounded uses of alloca, and on bounded uses of alloca whose bound can be larger than <number> bytes."
msgstr "-Walloca-larger-than=<number>\tBrīdināt par neierobežotu alloca lietojumu un par ierobežotu alloca lietojumu, kura robeža var pārsniegt <number> baitus."

#: c-family/c.opt:380
#, no-c-format
msgid "Disable Walloca-larger-than= warning.  Equivalent to Walloca-larger-than=<SIZE_MAX> or larger."
msgstr "Atspējot Walloca-larger-than= brīdinājumu.  Ekvivalents Walloca-larger-than=<SIZE_MAX> vai lielākai vērtībai."

#: c-family/c.opt:384
#, no-c-format
msgid "Warn if conversion of the result of arithmetic might change the value even though converting the operands cannot."
msgstr "Brīdināt, ja aritmētikas rezultāta konversija var mainīt vērtību, lai gan operandu konversija to nevar."

#: c-family/c.opt:392
#, no-c-format
msgid "Warn about comparisons between two operands of array type."
msgstr "Brīdināt par salīdzinājumiem starp diviem masīva tipa operandiem."

#: c-family/c.opt:396 c-family/c.opt:400
#, no-c-format
msgid "Warn about mismatched declarations of array parameters and unsafe accesses to them."
msgstr "Brīdināt par neatbilstošām masīva parametru deklarācijām un nedrošu piekļuvi tiem."

#: c-family/c.opt:404
#, no-c-format
msgid "Warn whenever an Objective-C assignment is being intercepted by the garbage collector."
msgstr "Brīdināt ikreiz, kad Objective-C piešķiršanu pārtver atkritumu savācējs."

#: c-family/c.opt:408
#, no-c-format
msgid "Diagnose a placeholder type in a template argument in a function parameter type."
msgstr "Diagnosticēt viettura tipu veidnes argumentā funkcijas parametra tipā."

#: c-family/c.opt:412
#, no-c-format
msgid "Warn about casting functions to incompatible types."
msgstr "Brīdināt par funkciju tipa pārveidošanu uz nesaderīgiem tipiem."

#: c-family/c.opt:420
#, no-c-format
msgid "-Wbidi-chars=[none|unpaired|any|ucn] Warn about UTF-8 bidirectional control characters."
msgstr "-Wbidi-chars=[none|unpaired|any|ucn] Brīdināt par UTF-8 divvirzienu vadības rakstzīmēm."

#: c-family/c.opt:443
#, no-c-format
msgid "Warn about boolean expression compared with an integer value different from true/false."
msgstr "Brīdināt par Būla izteiksmēm, kas salīdzinātas ar veselu skaitli, kurš atšķiras no true/false."

#: c-family/c.opt:447
#, no-c-format
msgid "Warn about certain operations on boolean expressions."
msgstr "Brīdināt par noteiktām operācijām ar Būla izteiksmēm."

#: c-family/c.opt:451
#, no-c-format
msgid "Warn when a built-in function is declared with the wrong signature."
msgstr "Brīdināt, ja iebūvētā funkcija ir deklarēta ar nepareizu signatūru."

#: c-family/c.opt:455
#, no-c-format
msgid "Warn when a built-in preprocessor macro is undefined or redefined."
msgstr "Brīdināt, ja iebūvēts priekšprocesora makro tiek atdefinēts vai pārdefinēts."

#: c-family/c.opt:459
#, no-c-format
msgid "Warn about features not present in ISO C11, but present in ISO C23."
msgstr "Brīdināt par līdzekļiem, kas nav ISO C11, bet ir ISO C23."

#: c-family/c.opt:463
#, no-c-format
msgid "Deprecated in favor of -Wc11-c23-compat."
msgstr "Novecojis; tā vietā izmantojiet -Wc11-c23-compat."

#: c-family/c.opt:467
#, no-c-format
msgid "Warn about features not present in ISO C23, but present in ISO C2Y."
msgstr "Brīdināt par līdzekļiem, kas nav ISO C23, bet ir ISO C2Y."

#: c-family/c.opt:471
#, no-c-format
msgid "Warn about features not present in ISO C90, but present in ISO C99."
msgstr "Brīdināt par līdzekļiem, kas nav ISO C90, bet ir ISO C99."

#: c-family/c.opt:475
#, no-c-format
msgid "Warn about features not present in ISO C99, but present in ISO C11."
msgstr "Brīdināt par līdzekļiem, kas nav ISO C99, bet ir ISO C11."

#: c-family/c.opt:479
#, no-c-format
msgid "Warn about C constructs that are not in the common subset of C and C++."
msgstr "Brīdināt par C konstrukcijām, kas nav C un C++ kopīgajā apakškopā."

#: c-family/c.opt:486
#, no-c-format
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 1998 and ISO C++ 2011."
msgstr "Brīdināt par C++ konstrukcijām, kuru nozīme atšķiras starp ISO C++ 1998 un ISO C++ 2011."

#: c-family/c.opt:490
#, no-c-format
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 2011 and ISO C++ 2014."
msgstr "Brīdināt par C++ konstrukcijām, kuru nozīme atšķiras starp ISO C++ 2011 un ISO C++ 2014."

#: c-family/c.opt:497
#, no-c-format
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 2014 and ISO C++ 2017."
msgstr "Brīdināt par C++ konstrukcijām, kuru nozīme atšķiras starp ISO C++ 2014 un ISO C++ 2017."

#: c-family/c.opt:504
#, no-c-format
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 2017 and ISO C++ 2020."
msgstr "Brīdināt par C++ konstrukcijām, kuru nozīme atšķiras starp ISO C++ 2017 un ISO C++ 2020."

#: c-family/c.opt:508
#, no-c-format
msgid "Warn about C++ constructs whose meaning differs between ISO C++ 2023 and ISO C++ 2026."
msgstr "Brīdināt par C++ konstrukcijām, kuru nozīme atšķiras starp ISO C++ 2023 un ISO C++ 2026."

#: c-family/c.opt:512
#, no-c-format
msgid "Warn about C++11 constructs in code compiled with an older standard."
msgstr "Brīdināt par C++11 konstrukcijām kodā, kas kompilēts ar vecāku standartu."

#: c-family/c.opt:516
#, no-c-format
msgid "Warn about C++14 constructs in code compiled with an older standard."
msgstr "Brīdināt par C++14 konstrukcijām kodā, kas kompilēts ar vecāku standartu."

#: c-family/c.opt:520
#, no-c-format
msgid "Warn about C++17 constructs in code compiled with an older standard."
msgstr "Brīdināt par C++17 konstrukcijām kodā, kas kompilēts ar vecāku standartu."

#: c-family/c.opt:524
#, no-c-format
msgid "Warn about C++20 constructs in code compiled with an older standard."
msgstr "Brīdināt par C++20 konstrukcijām kodā, kas kompilēts ar vecāku standartu."

#: c-family/c.opt:528
#, no-c-format
msgid "Warn about C++23 constructs in code compiled with an older standard."
msgstr "Brīdināt par C++23 konstrukcijām kodā, kas kompilēts ar vecāku standartu."

#: c-family/c.opt:532
#, no-c-format
msgid "Warn about C++26 constructs in code compiled with an older standard."
msgstr "Brīdināt par C++26 konstrukcijām kodā, kas kompilēts ar vecāku standartu."

#: c-family/c.opt:536
#, no-c-format
msgid "Warn about suspicious calls to calloc-like functions where sizeof expression is the earlier size argument and not the latter."
msgstr "Brīdināt par aizdomīgiem calloc līdzīgu funkciju izsaukumiem, kuros sizeof izteiksme ir pirmais, nevis otrais izmēra arguments."

#: c-family/c.opt:540
#, no-c-format
msgid "Warn about casts between incompatible function types."
msgstr "Brīdināt par tipu pārveidošanu starp nesaderīgiem funkciju tipiem."

#: c-family/c.opt:544
#, no-c-format
msgid "Warn about casts which discard qualifiers."
msgstr "Brīdināt par tipu pārveidošanu, kas atmet kvalifikatorus."

#: c-family/c.opt:548
#, no-c-format
msgid "Warn about a cast to reference type that does not use a related user-defined conversion function."
msgstr "Brīdināt par pārveidošanu uz atsauces tipu, kas neizmanto saistītu lietotāja definētu konversijas funkciju."

#: c-family/c.opt:552 c-family/c.opt:556
#, no-c-format
msgid "Warn about catch handlers of non-reference type."
msgstr "Brīdināt par catch apstrādātājiem, kas nav atsauces tipa."

#: c-family/c.opt:560
#, no-c-format
msgid "Complain about a name being declared as a class member after a previous use of the same name."
msgstr "Ziņot, ja nosaukums tiek deklarēts kā klases loceklis pēc tam, kad tas pats nosaukums ir jau izmantots."

#: c-family/c.opt:564
#, no-c-format
msgid "Warn about subscripts whose type is \"char\"."
msgstr "Brīdināt par indeksiem, kuru tips ir \"char\"."

#: c-family/c.opt:572
#, no-c-format
msgid "Warn when a conversion function will never be called due to the type it converts to."
msgstr "Brīdināt, ja konversijas funkcija nekad netiks izsaukta tipa dēļ, uz kuru tā konvertē."

#: c-family/c.opt:576
#, no-c-format
msgid "Warn for unsafe raw memory writes to objects of class types."
msgstr "Brīdināt par nedrošu tiešu atmiņas rakstīšanu klases tipu objektos."

#: c-family/c.opt:580
#, no-c-format
msgid "Warn about variables that might be changed by \"longjmp\" or \"vfork\"."
msgstr "Brīdināt par mainīgajiem, kurus var mainīt \"longjmp\" vai \"vfork\"."

#: c-family/c.opt:584
#, no-c-format
msgid "Warn about uses of a comma operator within a subscripting expression."
msgstr "Brīdināt par komata operatora lietojumu indeksēšanas izteiksmē."

#: c-family/c.opt:588
#, no-c-format
msgid "Warn about possibly nested block comments, and C++ comments spanning more than one physical line."
msgstr "Brīdināt par iespējami ligzdotiem bloka komentāriem un C++ komentāriem, kas aptver vairāk nekā vienu fizisko rindu."

#: c-family/c.opt:592
#, no-c-format
msgid "Synonym for -Wcomment."
msgstr "Sinonīms -Wcomment."

#: c-family/c.opt:596
#, no-c-format
msgid "Warn for conditionally-supported constructs."
msgstr "Brīdināt par nosacīti atbalstītām konstrukcijām."

#: c-family/c.opt:600
#, no-c-format
msgid "Warn for implicit type conversions that may change a value."
msgstr "Brīdināt par netiešām tipu konversijām, kas var mainīt vērtību."

#: c-family/c.opt:604
#, no-c-format
msgid "Warn for converting NULL from/to a non-pointer type."
msgstr "Brīdināt par NULL pārveidošanu no tipa vai uz tipu, kas nav rādītājs."

#: c-family/c.opt:612
#, no-c-format
msgid "Warn when performing class template argument deduction on a type with no deduction guides."
msgstr "Brīdināt, ja tiek veikta klases veidnes argumentu dedukcija tipam bez dedukcijas norādēm (deduction guides)."

#: c-family/c.opt:617
#, no-c-format
msgid "Warn when all constructors and destructors are private."
msgstr "Brīdināt, ja visi konstruktori un destruktori ir privāti."

#: c-family/c.opt:621
#, no-c-format
msgid "Warn about dangling else."
msgstr "Brīdināt par karājošos else (dangling else)."

#: c-family/c.opt:625 c-family/c.opt:629
#, no-c-format
msgid "Warn for uses of pointers to auto variables whose lifetime has ended."
msgstr "Brīdināt par rādītāju uz automātiskajiem mainīgajiem, kuru dzīves ilgums ir beidzies, izmantošanu."

#: c-family/c.opt:633
#, no-c-format
msgid "Warn when a reference is bound to a temporary whose lifetime has ended."
msgstr "Brīdināt, ja atsauce ir piesaistīta pagaidu objektam, kura dzīves ilgums ir beidzies."

#: c-family/c.opt:637
#, no-c-format
msgid "Warn about __TIME__, __DATE__ and __TIMESTAMP__ usage."
msgstr "Brīdināt par __TIME__, __DATE__ un __TIMESTAMP__ izmantošanu."

#: c-family/c.opt:641
#, no-c-format
msgid "Warn when a declaration is found after a statement."
msgstr "Brīdināt, ja deklarācija atrodas pēc priekšraksta."

#: c-family/c.opt:645
#, no-c-format
msgid "Warn for missing parameter types in function declarations."
msgstr "Brīdināt par trūkstošiem parametru tipiem funkciju deklarācijās."

#: c-family/c.opt:649
#, no-c-format
msgid "Warn when an explicitly defaulted function is deleted."
msgstr "Brīdināt, ja eksplicīti noklusēta (defaulted) funkcija ir dzēsta."

#: c-family/c.opt:653
#, no-c-format
msgid "Warn when deleting a pointer to incomplete type."
msgstr "Brīdināt, dzēšot rādītāju uz nepilnīgu tipu."

#: c-family/c.opt:657
#, no-c-format
msgid "Warn about deleting polymorphic objects with non-virtual destructors."
msgstr "Brīdināt par tādu polimorfu objektu dzēšanu, kuriem ir nevirtuāli destruktori."

#: c-family/c.opt:665
#, no-c-format
msgid "Mark implicitly-declared copy operations as deprecated if the class has a user-provided copy operation."
msgstr "Atzīmēt netieši deklarētās kopēšanas operācijas kā novecojušas, ja klasei ir lietotāja nodrošināta kopēšanas operācija."

#: c-family/c.opt:670
#, no-c-format
msgid "Mark implicitly-declared copy operations as deprecated if the class has a user-provided copy operation or destructor."
msgstr "Atzīmēt netieši deklarētās kopēšanas operācijas kā novecojušas, ja klasei ir lietotāja nodrošināta kopēšanas operācija vai destruktors."

#: c-family/c.opt:675
#, no-c-format
msgid "Warn about deprecated arithmetic conversions on operands of enumeration types."
msgstr "Brīdināt par novecojušām aritmētiskajām konversijām uzskaitījuma tipu operandiem."

#: c-family/c.opt:679
#, no-c-format
msgid "Warn about deprecated arithmetic conversions on operands where one is of enumeration type and the other is of a floating-point type."
msgstr "Brīdināt par novecojušām aritmētiskajām konversijām operandiem, kur viens ir uzskaitījuma tipa, bet otrs — peldošā komata tipa."

#: c-family/c.opt:684
#, no-c-format
msgid "Warn about deprecated space between \"\" and suffix in a user-defined literal operator."
msgstr "Brīdināt par novecojušu atstarpi starp \"\" un piedēkli lietotāja definētā literāļa operatorā."

#: c-family/c.opt:688
#, no-c-format
msgid "Warn about calls with arguments to functions declared without parameters."
msgstr "Brīdināt par izsaukumiem ar argumentiem funkcijām, kas deklarētas bez parametriem."

#: c-family/c.opt:692
#, no-c-format
msgid "Warn about deprecated OpenMP code."
msgstr "Brīdināt par novecojušu OpenMP kodu."

#: c-family/c.opt:696
#, no-c-format
msgid "Warn about deprecated omission of comma before ... in varargs function declaration."
msgstr "Brīdināt par novecojušu komata izlaišanu pirms ... funkcijas ar mainīgu argumentu skaitu deklarācijā."

#: c-family/c.opt:700
#, no-c-format
msgid "Warn about positional initialization of structs requiring designated initializers."
msgstr "Brīdināt par pozicionālu struktūru inicializāciju, kurām nepieciešami nosauktie (designated) inicializatori."

#: c-family/c.opt:704
#, no-c-format
msgid "Warn if qualifiers on arrays which are pointer targets are discarded."
msgstr "Brīdināt, ja tiek atmesti kvalifikatori masīviem, kas ir rādītāju mērķi."

#: c-family/c.opt:708
#, no-c-format
msgid "Warn if type qualifiers on pointers are discarded."
msgstr "Brīdināt, ja tiek atmesti rādītāju tipu kvalifikatori."

#: c-family/c.opt:712
#, no-c-format
msgid "Warn about compile-time integer division by zero."
msgstr "Brīdināt par kompilēšanas laika veselo skaitļu dalīšanu ar nulli."

#: c-family/c.opt:716
#, no-c-format
msgid "Warn about implicit conversions from \"float\" to \"double\"."
msgstr "Brīdināt par netiešām konversijām no \"float\" uz \"double\"."

#: c-family/c.opt:720
#, no-c-format
msgid "Warn when a declaration has duplicate const, volatile, restrict or _Atomic specifier."
msgstr "Brīdināt, ja deklarācijā ir dublēts const, volatile, restrict vai _Atomic specifikators."

#: c-family/c.opt:724
#, no-c-format
msgid "Warn about duplicated branches in if-else statements."
msgstr "Brīdināt par dublētiem zariem if-else priekšrakstos."

#: c-family/c.opt:728
#, no-c-format
msgid "Warn about duplicated conditions in an if-else-if chain."
msgstr "Brīdināt par dublētiem nosacījumiem if-else-if ķēdē."

#: c-family/c.opt:732
#, no-c-format
msgid "Warn about violations of Effective C++ style rules."
msgstr "Brīdināt par Effective C++ stila noteikumu pārkāpumiem."

#: c-family/c.opt:736
#, no-c-format
msgid "Warn if an additional enum-base is used in an elaborated-type-specifier."
msgstr "Brīdināt, ja elaborated-type-specifier tiek izmantota papildu enum-base."

#: c-family/c.opt:740
#, no-c-format
msgid "Warn about an empty body in an if or else statement."
msgstr "Brīdināt par tukšu ķermeni if vai else priekšrakstā."

#: c-family/c.opt:744
#, no-c-format
msgid "Warn about stray tokens after #else and #endif."
msgstr "Brīdināt par liekiem marķieriem pēc #else un #endif."

#: c-family/c.opt:748
#, no-c-format
msgid "Warn about comparison of different enum types."
msgstr "Brīdināt par dažādu enum tipu salīdzināšanu."

#: c-family/c.opt:752
#, no-c-format
msgid "Warn about implicit conversion of enum types."
msgstr "Brīdināt par enum tipu netiešo konversiju."

#: c-family/c.opt:756
#, no-c-format
msgid "Warn about enum/integer type mismatches."
msgstr "Brīdināt par enum/integer tipu neatbilstībām."

#: c-family/c.opt:764
#, no-c-format
msgid "This switch is deprecated; use -Werror=implicit-function-declaration instead."
msgstr "Šis slēdzis ir novecojis; tā vietā izmantojiet -Werror=implicit-function-declaration."

#: c-family/c.opt:768
#, no-c-format
msgid "Warn when an exception handler is shadowed by another handler."
msgstr "Brīdināt, ja izņēmumu apstrādātāju aizsedz cits apstrādātājs."

#: c-family/c.opt:772
#, no-c-format
msgid "Warn if \"defined\" is used outside #if."
msgstr "Brīdināt, ja \"defined\" tiek izmantots ārpus #if."

#: c-family/c.opt:776
#, no-c-format
msgid "Warn about naming a TU-local entity declared in another translation unit."
msgstr "Brīdināt par citā translācijas vienībā deklarētas TU lokālas entītijas nosaukšanu."

#: c-family/c.opt:780
#, no-c-format
msgid "Warn when a module exposes a TU-local entity from the global module fragment."
msgstr "Brīdināt, ja modulis atklāj TU lokālu entītiju no globālā moduļa fragmenta."

#: c-family/c.opt:788
#, no-c-format
msgid "Warn about semicolon after in-class function definition."
msgstr "Brīdināt par semikolu pēc klases iekšējas funkcijas definīcijas."

#: c-family/c.opt:792
#, no-c-format
msgid "Warn when a structure containing a C99 flexible array member as the last field is not at the end of another structure."
msgstr "Brīdināt, ja struktūra, kuras pēdējais lauks ir C99 elastīgā masīva loceklis, neatrodas citas struktūras beigās."

#: c-family/c.opt:797
#, no-c-format
msgid "Warn for implicit type conversions that cause loss of floating point precision."
msgstr "Brīdināt par netiešām tipu konversijām, kas izraisa peldošā komata precizitātes zudumu."

#: c-family/c.opt:801
#, no-c-format
msgid "Warn if testing floating point numbers for equality."
msgstr "Brīdināt, ja tiek pārbaudīta peldošā komata skaitļu vienādība."

#: c-family/c.opt:805 c-family/c.opt:860
#, no-c-format
msgid "Warn about printf/scanf/strftime/strfmon format string anomalies."
msgstr "Brīdināt par printf/scanf/strftime/strfmon formāta virknes anomālijām."

#: c-family/c.opt:809
#, no-c-format
msgid "Warn about format strings that contain NUL bytes."
msgstr "Brīdināt par formāta virknēm, kas satur NUL baitus."

#: c-family/c.opt:813
#, no-c-format
msgid "Warn about GCC format strings with strings unsuitable for diagnostics."
msgstr "Brīdināt par GCC formāta virknēm ar diagnostikai nepiemērotām virknēm."

#: c-family/c.opt:817
#, no-c-format
msgid "Warn if passing too many arguments to a function for its format string."
msgstr "Brīdināt, ja funkcijai tiek nodots vairāk argumentu, nekā paredz tās formāta virkne."

#: c-family/c.opt:821
#, no-c-format
msgid "Warn about format strings that are not literals."
msgstr "Brīdināt par formāta virknēm, kas nav literāļi."

#: c-family/c.opt:825
#, no-c-format
msgid "Warn about function calls with format strings that write past the end of the destination region.  Same as -Wformat-overflow=1."
msgstr "Brīdināt par funkciju izsaukumiem ar formāta virknēm, kas raksta aiz mērķa apgabala beigām. Tas pats, kas -Wformat-overflow=1."

#: c-family/c.opt:830
#, no-c-format
msgid "Warn about function calls with format strings that write past the end of the destination region."
msgstr "Brīdināt par funkciju izsaukumiem ar formāta virknēm, kas raksta aiz mērķa apgabala beigām."

#: c-family/c.opt:835
#, no-c-format
msgid "Warn about possible security problems with format functions."
msgstr "Brīdināt par iespējamām drošības problēmām formāta funkcijās."

#: c-family/c.opt:839
#, no-c-format
msgid "Warn about sign differences with format functions."
msgstr "Brīdināt par zīmes atšķirībām formāta funkcijās."

#: c-family/c.opt:843
#, no-c-format
msgid "Warn about calls to snprintf and similar functions that truncate output. Same as -Wformat-truncation=1."
msgstr "Brīdināt par snprintf un līdzīgu funkciju izsaukumiem, kas saīsina izvadi. Tas pats, kas -Wformat-truncation=1."

#: c-family/c.opt:848
#, no-c-format
msgid "Warn about calls to snprintf and similar functions that truncate output."
msgstr "Brīdināt par snprintf un līdzīgu funkciju izsaukumiem, kas saīsina izvadi."

#: c-family/c.opt:852
#, no-c-format
msgid "Warn about strftime formats yielding 2-digit years."
msgstr "Brīdināt par strftime formātiem, kas dod gadu ar 2 cipariem."

#: c-family/c.opt:856
#, no-c-format
msgid "Warn about zero-length formats."
msgstr "Brīdināt par nulles garuma formātiem."

#: c-family/c.opt:864
#, no-c-format
msgid "Warn when __builtin_frame_address or __builtin_return_address is used unsafely."
msgstr "Brīdināt, ja __builtin_frame_address vai __builtin_return_address tiek izmantots nedroši."

#: c-family/c.opt:868
#, no-c-format
msgid "Warn about labels on declarations and at the end of compound statements."
msgstr "Brīdināt par etiķetēm pie deklarācijām un salikto priekšrakstu beigās."

#: c-family/c.opt:872
#, no-c-format
msgid "Warn about the global module fragment not containing only preprocessing directives."
msgstr "Brīdināt, ja globālā moduļa fragments satur ne tikai priekšapstrādes direktīvas."

#: c-family/c.opt:876
#, no-c-format
msgid "Warn when #ifndef of a header guard is followed by #define of a different macro with the header guard macro not defined at the end of header."
msgstr "Brīdināt, ja galvenes sarga #ifndef seko #define citam makro un galvenes sarga makro nav definēts galvenes beigās."

#: c-family/c.opt:880
#, no-c-format
msgid "Warn when the field in a struct is not aligned."
msgstr "Brīdināt, ja struktūras lauks nav izlīdzināts."

#: c-family/c.opt:884
#, no-c-format
msgid "Warn whenever type qualifiers are ignored."
msgstr "Brīdināt, ja tiek ignorēti tipa kvalifikatori."

#: c-family/c.opt:888
#, no-c-format
msgid "Warn whenever attributes are ignored."
msgstr "Brīdināt, ja atribūti tiek ignorēti."

#: c-family/c.opt:892
#, no-c-format
msgid "Warn about implicit declarations."
msgstr "Brīdināt par netiešām deklarācijām."

#: c-family/c.opt:900
#, no-c-format
msgid "Warn about implicit function declarations."
msgstr "Brīdināt par netiešām funkciju deklarācijām."

#: c-family/c.opt:904
#, no-c-format
msgid "Warn when a declaration does not specify a type."
msgstr "Brīdināt, ja deklarācijā nav norādīts tips."

#: c-family/c.opt:911
#, no-c-format
msgid "Warn when a base is inaccessible in derived due to ambiguity."
msgstr "Brīdināt, ja bāze atvasinātajā klasē nav pieejama neviennozīmības dēļ."

#: c-family/c.opt:915
#, no-c-format
msgid "Warn when there is a conversion between pointers that have incompatible types."
msgstr "Brīdināt, ja tiek veikta konversija starp nesaderīgu tipu rādītājiem."

#: c-family/c.opt:923
#, no-c-format
msgid "Warn about variables which are initialized to themselves."
msgstr "Brīdināt par mainīgajiem, kas ir inicializēti ar sevi pašiem."

#: c-family/c.opt:927
#, no-c-format
msgid "Warn about uses of std::initializer_list that can result in dangling pointers."
msgstr "Brīdināt par std::initializer_list lietojumiem, kas var radīt karājošos rādītājus."

#: c-family/c.opt:931
#, no-c-format
msgid "Warn about nonsensical values of --param destructive-interference-size or constructive-interference-size."
msgstr "Brīdināt par bezjēdzīgām --param destructive-interference-size vai constructive-interference-size vērtībām."

#: c-family/c.opt:936
#, no-c-format
msgid "Warn about C++11 inheriting constructors when the base has a variadic constructor."
msgstr "Brīdināt par C++11 mantotajiem konstruktoriem, ja bāzei ir konstruktors ar mainīgu argumentu skaitu."

#: c-family/c.opt:940
#, no-c-format
msgid "Warn about incompatible integer to pointer and pointer to integer conversions."
msgstr "Brīdināt par nesaderīgām konversijām no vesela skaitļa uz rādītāju un no rādītāja uz veselu skaitli."

#: c-family/c.opt:944
#, no-c-format
msgid "Warn for suspicious integer expressions in boolean context."
msgstr "Brīdināt par aizdomīgām veselo skaitļu izteiksmēm Būla kontekstā."

#: c-family/c.opt:948
#, no-c-format
msgid "Warn when there is a cast to a pointer from an integer of a different size."
msgstr "Brīdināt, ja tiek veikta tipa pārveidošana uz rādītāju no cita izmēra vesela skaitļa."

#: c-family/c.opt:952
#, no-c-format
msgid "Warn when a function never produces a constant expression."
msgstr "Brīdināt, ja funkcija nekad nerada konstantu izteiksmi."

#: c-family/c.opt:956
#, no-c-format
msgid "Warn about invalid uses of the \"offsetof\" macro."
msgstr "Brīdināt par nederīgu \"offsetof\" makro lietojumu."

#: c-family/c.opt:960
#, no-c-format
msgid "Warn about PCH files that are found but not used."
msgstr "Brīdināt par atrastiem, bet neizmantotiem PCH failiem."

#: c-family/c.opt:964
#, no-c-format
msgid "Warn about invalid UTF-8 characters."
msgstr "Brīdināt par nederīgām UTF-8 rakstzīmēm."

#: c-family/c.opt:968
#, no-c-format
msgid "Warn when a jump misses a variable initialization."
msgstr "Brīdināt, ja lēciens apiet mainīgā inicializāciju."

#: c-family/c.opt:987
#, no-c-format
msgid "Warn about defining or undefining macros with identifiers equal to keywords (or for C++ conditional keywords or standard attribute names)."
msgstr "Brīdināt par makro definēšanu vai atdefinēšanu ar identifikatoriem, kas sakrīt ar atslēgvārdiem (vai C++ nosacītajiem atslēgvārdiem vai standarta atribūtu nosaukumiem)."

#: c-family/c.opt:991
#, no-c-format
msgid "Warn about leading whitespace style issues on lines except when in raw string literals."
msgstr "Brīdināt par atstarpju stila problēmām rindu sākumā, izņemot neapstrādātās (raw) virkņu literāļos."

#: c-family/c.opt:995
#, no-c-format
msgid "Warn when a string or character literal is followed by a ud-suffix which does not begin with an underscore."
msgstr "Brīdināt, ja virknes vai rakstzīmes literālim seko ud-piedēklis, kas nesākas ar apakšsvītru."

#: c-family/c.opt:999
#, no-c-format
msgid "Warn when logical not is used on the left hand side operand of a comparison."
msgstr "Brīdināt, ja salīdzinājuma kreisās puses operandam tiek lietots loģiskais noliegums."

#: c-family/c.opt:1003
#, no-c-format
msgid "Warn when a logical operator is suspiciously always evaluating to true or false."
msgstr "Brīdināt, ja loģiskā operatora rezultāts aizdomīgi vienmēr ir true vai false."

#: c-family/c.opt:1007
#, no-c-format
msgid "Do not warn about using \"long long\" when -pedantic."
msgstr "Nebrīdināt par \"long long\" lietošanu, ja ir norādīts -pedantic."

#: c-family/c.opt:1011
#, no-c-format
msgid "Warn about suspicious declarations of \"main\"."
msgstr "Brīdināt par aizdomīgām \"main\" deklarācijām."

#: c-family/c.opt:1023
#, no-c-format
msgid "Warn about suspicious calls to memset where the third argument contains the number of elements not multiplied by the element size."
msgstr "Brīdināt par aizdomīgiem \"memset\" izsaukumiem, kuru trešais arguments satur elementu skaitu, kas nav reizināts ar elementa izmēru."

#: c-family/c.opt:1027
#, no-c-format
msgid "Warn about suspicious calls to memset where the third argument is constant literal zero and the second is not."
msgstr "Brīdināt par aizdomīgiem \"memset\" izsaukumiem, kuros trešais arguments ir konstanta literāļa nulle, bet otrais nav."

#: c-family/c.opt:1031
#, no-c-format
msgid "Warn when the indentation of the code does not reflect the block structure."
msgstr "Brīdināt, ja koda atkāpes neatspoguļo bloka struktūru."

#: c-family/c.opt:1035
#, no-c-format
msgid "Warn for deallocation calls with arguments returned from mismatched allocation functions."
msgstr "Brīdināt par atbrīvošanas izsaukumiem ar argumentiem, ko atgriezušas neatbilstošas piešķiršanas funkcijas."

#: c-family/c.opt:1040
#, no-c-format
msgid "Warn for mismatches between calls to operator new or delete and the corresponding call to the allocation or deallocation function."
msgstr "Brīdināt par neatbilstībām starp operatora new vai delete izsaukumiem un atbilstošo piešķiršanas vai atbrīvošanas funkcijas izsaukumu."

#: c-family/c.opt:1045
#, no-c-format
msgid "Warn when a class is redeclared or referenced using a mismatched class-key."
msgstr "Brīdināt, ja klase tiek atkārtoti deklarēta vai uz to atsaucas, izmantojot neatbilstošu klases atslēgvārdu (class-key)."

#: c-family/c.opt:1049
#, no-c-format
msgid "Warn about declarations of entities that may be missing attributes that related entities have been declared with."
msgstr "Brīdināt par tādu entītiju deklarācijām, kurām var trūkt atribūtu, ar kuriem deklarētas saistītās entītijas."

#: c-family/c.opt:1054
#, no-c-format
msgid "Warn about possibly missing braces around initializers."
msgstr "Brīdināt par iespējami trūkstošām figūriekavām ap inicializatoriem."

#: c-family/c.opt:1058
#, no-c-format
msgid "Warn about global functions without previous declarations."
msgstr "Brīdināt par globālām funkcijām bez iepriekšējām deklarācijām."

#: c-family/c.opt:1062
#, no-c-format
msgid "Warn about missing fields in struct initializers."
msgstr "Brīdināt par trūkstošiem laukiem struktūras inicializatoros."

#: c-family/c.opt:1070
#, no-c-format
msgid "Warn about user-specified include directories that do not exist."
msgstr "Brīdināt par lietotāja norādītām iekļaušanas direktorijām, kas neeksistē."

#: c-family/c.opt:1074
#, no-c-format
msgid "Warn about function definitions omitting parameter names."
msgstr "Brīdināt par funkciju definīcijām, kurās izlaisti parametru nosaukumi."

#: c-family/c.opt:1078
#, no-c-format
msgid "Warn about function parameters declared without a type specifier in K&R-style functions."
msgstr "Brīdināt par funkciju parametriem, kas K&R stila funkcijās deklarēti bez tipa specifikatora."

#: c-family/c.opt:1082
#, no-c-format
msgid "Warn about global functions without prototypes."
msgstr "Brīdināt par globālajām funkcijām bez prototipiem."

#: c-family/c.opt:1086
#, no-c-format
msgid "Warn about likely missing requires keyword."
msgstr "Brīdināt par iespējami trūkstošu atslēgvārdu requires."

#: c-family/c.opt:1090
#, no-c-format
msgid "Warn when the template keyword is missing after a member access token in a dependent member access expression if that member is a template."
msgstr "Brīdināt, ja atkarīgā locekļa piekļuves izteiksmē pēc locekļa piekļuves marķiera trūkst atslēgvārda template, ja šis loceklis ir veidne."

#: c-family/c.opt:1094
#, no-c-format
msgid "Warn about global variables without previous declarations."
msgstr "Brīdināt par globālajiem mainīgajiem bez iepriekšējām deklarācijām."

#: c-family/c.opt:1101
#, no-c-format
msgid "Warn about use of multi-character character constants."
msgstr "Brīdināt par vairākrakstzīmju rakstzīmju konstanšu lietošanu."

#: c-family/c.opt:1105
#, no-c-format
msgid "Warn on direct multiple inheritance."
msgstr "Brīdināt par tiešu daudzkārtēju mantošanu."

#: c-family/c.opt:1109
#, no-c-format
msgid "Warn for multiple lists of forward declarations of function parameters."
msgstr "Brīdināt par vairākiem funkciju parametru priekšdeklarāciju sarakstiem."

#: c-family/c.opt:1113
#, no-c-format
msgid "Warn about unsafe macros expanding to multiple statements used as a body of a clause such as if, else, while, switch, or for."
msgstr "Brīdināt par nedrošiem makro, kas izvēršas vairākos priekšrakstos un tiek izmantoti kā tādas klauzulas ķermenis kā if, else, while, switch vai for."

#: c-family/c.opt:1117
#, no-c-format
msgid "Warn on namespace definition."
msgstr "Brīdināt par nosaukumvietas definīciju."

#: c-family/c.opt:1121
#, no-c-format
msgid "Warn about narrowing conversions within { } that are ill-formed in C++11."
msgstr "Brīdināt par sašaurinošām konversijām { } iekšienē, kas C++11 nav korekti veidotas."

#: c-family/c.opt:1125
#, no-c-format
msgid "Warn about \"extern\" declarations not at file scope."
msgstr "Brīdināt par \"extern\" deklarācijām, kas nav faila tvērumā."

#: c-family/c.opt:1129
#, no-c-format
msgid "Warn when a noexcept expression evaluates to false even though the expression can't actually throw."
msgstr "Brīdināt, ja noexcept izteiksmes vērtība ir false, lai gan izteiksme faktiski nevar izmest izņēmumu."

#: c-family/c.opt:1133
#, no-c-format
msgid "Warn if C++17 noexcept function type will change the mangled name of a symbol."
msgstr "Brīdināt, ja C++17 noexcept funkcijas tips mainīs simbola sagrozīto nosaukumu."

#: c-family/c.opt:1137
#, no-c-format
msgid "Warn for non-C compatible unnamed classes with a typedef name for linkage purposes."
msgstr "Brīdināt par ar C nesaderīgām nenosauktām klasēm ar typedef nosaukumu saistīšanas nolūkiem."

#: c-family/c.opt:1141
#, no-c-format
msgid "Warn when non-templatized friend functions are declared within a template."
msgstr "Brīdināt, ja veidnē tiek deklarētas draugu funkcijas, kas nav veidnes."

#: c-family/c.opt:1145
#, no-c-format
msgid "Warn about non-virtual destructors."
msgstr "Brīdināt par nevirtuāliem destruktoriem."

#: c-family/c.opt:1149
#, no-c-format
msgid "Warn about NULL being passed to argument slots marked as requiring non-NULL."
msgstr "Brīdināt par NULL nodošanu argumentiem, kas atzīmēti kā tādi, kam nepieciešama ne-NULL vērtība."

#: c-family/c.opt:1165
#, no-c-format
msgid "-Wnormalized=[none|id|nfc|nfkc]\tWarn about non-normalized Unicode strings."
msgstr "-Wnormalized=[none|id|nfc|nfkc]\tBrīdināt par nenormalizētām Unicode virknēm."

#: c-family/c.opt:1188
#, no-c-format
msgid "Warn if a class interface has no superclass.  Root classes may use an attribute to suppress this warning."
msgstr "Brīdināt, ja klases saskarnei nav virsklases. Saknes klases var izmantot atribūtu, lai apspiestu šo brīdinājumu."

#: c-family/c.opt:1193
#, no-c-format
msgid "Warn if a C-style cast is used in a program."
msgstr "Brīdināt, ja programmā tiek izmantota C stila tipa pārveidošana."

#: c-family/c.opt:1197
#, no-c-format
msgid "Warn for obsolescent usage in a declaration."
msgstr "Brīdināt par novecojušu lietojumu deklarācijā."

#: c-family/c.opt:1201
#, no-c-format
msgid "Warn if an old-style parameter definition is used."
msgstr "Brīdināt, ja tiek izmantota vecā stila parametra definīcija."

#: c-family/c.opt:1205
#, no-c-format
msgid "Warn about potentially suboptimal choices related to OpenACC parallelism."
msgstr "Brīdināt par iespējami neoptimālām izvēlēm saistībā ar OpenACC paralēlismu."

#: c-family/c.opt:1209
#, no-c-format
msgid "Warn about suspicious OpenMP code."
msgstr "Brīdināt par aizdomīgu OpenMP kodu."

#: c-family/c.opt:1213
#, no-c-format
msgid "Warn if a simd directive is overridden by the vectorizer cost model."
msgstr "Brīdināt, ja vektorizētāja izmaksu modelis atceļ simd direktīvu."

#: c-family/c.opt:1217
#, no-c-format
msgid "Warn if a string is longer than the maximum portable length specified by the standard."
msgstr "Brīdināt, ja virkne ir garāka par standartā norādīto maksimālo pārnesamo garumu."

#: c-family/c.opt:1221 c-family/c.opt:1225
#, no-c-format
msgid "Warn about overloaded virtual function names."
msgstr "Brīdināt par pārslogotiem virtuālo funkciju nosaukumiem."

#: c-family/c.opt:1229
#, no-c-format
msgid "Warn about overriding initializers without side effects."
msgstr "Brīdināt par inicializatoru pārrakstīšanu bez blakusefektiem."

#: c-family/c.opt:1233
#, no-c-format
msgid "Warn about overriding initializers with side effects."
msgstr "Brīdināt par inicializatoru pārrakstīšanu ar blakusefektiem."

#: c-family/c.opt:1237
#, no-c-format
msgid "Warn if the named return value optimization is not performed although it is allowed."
msgstr "Brīdināt, ja nosauktās atgriežamās vērtības optimizācija (NRVO) netiek veikta, lai gan tā ir atļauta."

#: c-family/c.opt:1241
#, no-c-format
msgid "Warn about packed bit-fields whose offset changed in GCC 4.4."
msgstr "Brīdināt par pakotiem bitu laukiem, kuru nobīde mainījās GCC 4.4 versijā."

#: c-family/c.opt:1245
#, no-c-format
msgid "Warn when fields in a struct with the packed attribute are misaligned."
msgstr "Brīdināt, ja lauki struktūrā ar atribūtu packed ir nepareizi izlīdzināti."

#: c-family/c.opt:1249
#, no-c-format
msgid "Warn about possibly missing parentheses."
msgstr "Brīdināt par iespējami trūkstošām iekavām."

#: c-family/c.opt:1257
#, no-c-format
msgid "Warn about calling std::move on a local object in a return statement preventing copy elision."
msgstr "Brīdināt par std::move izsaukšanu lokālam objektam return priekšrakstā, kas novērš kopijas izlaišanu (copy elision)."

#: c-family/c.opt:1261 c-family/c.opt:1265
#, no-c-format
msgid "Warn for placement new expressions with undefined behavior."
msgstr "Brīdināt par placement new izteiksmēm ar nedefinētu uzvedību."

#: c-family/c.opt:1269
#, no-c-format
msgid "Warn when converting the type of pointers to member functions."
msgstr "Brīdināt, pārveidojot rādītāju uz locekļfunkcijām tipu."

#: c-family/c.opt:1273
#, no-c-format
msgid "Warn about function pointer arithmetic."
msgstr "Brīdināt par funkciju rādītāju aritmētiku."

#: c-family/c.opt:1277
#, no-c-format
msgid "Warn when a pointer differs in signedness in an assignment."
msgstr "Brīdināt, ja piešķiršanā rādītāji atšķiras pēc zīmes."

#: c-family/c.opt:1281
#, no-c-format
msgid "Warn when a pointer is compared with a zero character constant."
msgstr "Brīdināt, ja rādītājs tiek salīdzināts ar nulles rakstzīmes konstanti."

#: c-family/c.opt:1285
#, no-c-format
msgid "Warn when a pointer is cast to an integer of a different size."
msgstr "Brīdināt, ja rādītājs tiek pārveidots par cita izmēra veselu skaitli."

#: c-family/c.opt:1289
#, no-c-format
msgid "Warn about misuses of pragmas."
msgstr "Brīdināt par nepareizu pragmu lietošanu."

#: c-family/c.opt:1293
#, no-c-format
msgid "Warn about #pragma once outside of a header."
msgstr "Brīdināt par #pragma once ārpus galvenes."

#: c-family/c.opt:1297
#, no-c-format
msgid "Warn if constructor or destructors with priorities from 0 to 100 are used."
msgstr "Brīdināt, ja tiek izmantoti konstruktori vai destruktori ar prioritātēm no 0 līdz 100."

#: c-family/c.opt:1301
#, no-c-format
msgid "Warn if a property for an Objective-C object has no assign semantics specified."
msgstr "Brīdināt, ja Objective-C objekta īpašībai nav norādīta piešķiršanas semantika."

#: c-family/c.opt:1305
#, no-c-format
msgid "Warn if inherited methods are unimplemented."
msgstr "Brīdināt, ja mantotās metodes nav īstenotas."

#: c-family/c.opt:1309
#, no-c-format
msgid "Warn when a range-based for-loop is creating unnecessary copies."
msgstr "Brīdināt, ja uz diapazonu balstīts for cikls veido nevajadzīgas kopijas."

#: c-family/c.opt:1313
#, no-c-format
msgid "Warn about multiple declarations of the same object."
msgstr "Brīdināt par viena un tā paša objekta vairākkārtēju deklarēšanu."

#: c-family/c.opt:1317
#, no-c-format
msgid "Warn about redundant calls to std::move."
msgstr "Brīdināt par liekajiem std::move izsaukumiem."

#: c-family/c.opt:1321
#, no-c-format
msgid "Warn when a class or enumerated type is referenced using a redundant class-key."
msgstr "Brīdināt, ja uz klasi vai uzskaitījuma tipu atsaucas, izmantojot lieku klases atslēgvārdu (class-key)."

#: c-family/c.opt:1325
#, no-c-format
msgid "Warn about uses of register storage specifier."
msgstr "Brīdināt par register glabāšanas specifikatora lietojumiem."

#: c-family/c.opt:1329
#, no-c-format
msgid "Warn when the compiler reorders code."
msgstr "Brīdināt, ja kompilators pārkārto kodu."

#: c-family/c.opt:1333
#, no-c-format
msgid "Warn when an argument passed to a restrict-qualified parameter aliases with another argument."
msgstr "Brīdināt, ja arguments, kas nodots restrict kvalificētam parametram, pārklājas ar citu argumentu."

#: c-family/c.opt:1338
#, no-c-format
msgid "Warn whenever void-returning functions return a non-void expressions, or a return expression is missing in a function not returning void."
msgstr "Brīdināt ikreiz, kad funkcijas, kas atgriež void, atgriež ne-void izteiksmi vai kad funkcijā, kas neatgriež void, trūkst atgriežamās izteiksmes."

#: c-family/c.opt:1342
#, no-c-format
msgid "Warn whenever a function's return type defaults to \"int\" (C), or about inconsistent return types (C++)."
msgstr "Brīdināt ikreiz, kad funkcijas atgriešanas tips pēc noklusējuma ir \"int\" (C), vai par nekonsekventiem atgriešanas tipiem (C++)."

#: c-family/c.opt:1346
#, no-c-format
msgid "Warn on suspicious constructs involving reverse scalar storage order."
msgstr "Brīdināt par aizdomīgām konstrukcijām, kas ietver apgrieztu skalāro glabāšanas secību."

#: c-family/c.opt:1350
#, no-c-format
msgid "Warn if a selector has multiple methods."
msgstr "Brīdināt, ja selektoram ir vairākas metodes."

#: c-family/c.opt:1354
#, no-c-format
msgid "Warn when a value is moved to itself with std::move."
msgstr "Brīdināt, ja vērtība ar std::move tiek pārvietota uz sevi pašu."

#: c-family/c.opt:1358
#, no-c-format
msgid "Warn about possible violations of sequence point rules."
msgstr "Brīdināt par iespējamiem secības punktu noteikumu pārkāpumiem."

#: c-family/c.opt:1362 c-family/c.opt:1366
#, no-c-format
msgid "Warn about an incomplete type affecting semantics in a non-error context."
msgstr "Brīdināt par nepilnīgu tipu, kas ietekmē semantiku kontekstā, kur tas nav kļūda."

#: c-family/c.opt:1370
#, no-c-format
msgid "Warn if a local declaration hides an instance variable."
msgstr "Brīdināt, ja lokāla deklarācija slēpj instances mainīgo."

#: c-family/c.opt:1374 c-family/c.opt:1378
#, no-c-format
msgid "Warn if left shift of a signed value overflows."
msgstr "Brīdināt, ja vērtības ar zīmi bīde pa kreisi rada pārpildi."

#: c-family/c.opt:1382
#, no-c-format
msgid "Warn if shift count is negative."
msgstr "Brīdināt, ja bīdes skaits ir negatīvs."

#: c-family/c.opt:1386
#, no-c-format
msgid "Warn if shift count >= width of type."
msgstr "Brīdināt, ja bīdes skaits >= tipa platumu."

#: c-family/c.opt:1390
#, no-c-format
msgid "Warn if left shifting a negative value."
msgstr "Brīdināt, ja negatīva vērtība tiek bīdīta pa kreisi."

#: c-family/c.opt:1394
#, no-c-format
msgid "Warn about signed-unsigned comparisons."
msgstr "Brīdināt par salīdzinājumiem starp skaitļiem ar zīmi un bez zīmes."

#: c-family/c.opt:1402
#, no-c-format
msgid "Warn for implicit type conversions between signed and unsigned integers."
msgstr "Brīdināt par netiešām tipu konversijām starp veseliem skaitļiem ar zīmi un bez zīmes."

#: c-family/c.opt:1406
#, no-c-format
msgid "Warn when overload promotes from unsigned to signed."
msgstr "Brīdināt, ja pārslodze paaugstina tipu no bez zīmes uz ar zīmi."

#: c-family/c.opt:1410
#, no-c-format
msgid "Warn about missing sized deallocation functions."
msgstr "Brīdināt par trūkstošām atbrīvošanas funkcijām ar izmēru (sized deallocation)."

#: c-family/c.opt:1414
#, no-c-format
msgid "Warn about divisions of two sizeof operators when the first one is applied to an array and the divisor does not equal the size of the array element."
msgstr "Brīdināt par divu sizeof operatoru dalījumiem, ja pirmais no tiem tiek piemērots masīvam un dalītājs nav vienāds ar masīva elementa izmēru."

#: c-family/c.opt:1419
#, no-c-format
msgid "Warn when sizeof is applied on a parameter declared as an array."
msgstr "Brīdināt, ja parametram, kas deklarēts kā masīvs, tiek piemērots sizeof."

#: c-family/c.opt:1423
#, no-c-format
msgid "Warn about suspicious divisions of two sizeof expressions that don't work correctly with pointers."
msgstr "Brīdināt par aizdomīgām divu sizeof izteiksmju dalīšanām, kas nedarbojas pareizi ar rādītājiem."

#: c-family/c.opt:1427
#, no-c-format
msgid "Warn about suspicious length parameters to certain string functions if the argument uses sizeof."
msgstr "Brīdināt par aizdomīgiem garuma parametriem dažām virkņu funkcijām, ja arguments izmanto sizeof."

#: c-family/c.opt:1435
#, no-c-format
msgid "Warn about improper usages of flexible array members according to the level of -fstrict-flex-arrays."
msgstr "Brīdināt par nepareizu elastīgo masīvu locekļu lietojumu atbilstoši -fstrict-flex-arrays līmenim."

#: c-family/c.opt:1440
#, no-c-format
msgid "Warn about uncasted NULL used as sentinel."
msgstr "Brīdināt par NULL bez tipa pārveidošanas, kas tiek izmantots kā sargvērtība."

#: c-family/c.opt:1448
#, no-c-format
msgid "Warn about unprototyped function declarations."
msgstr "Brīdināt par funkciju deklarācijām bez prototipa."

#: c-family/c.opt:1452
#, no-c-format
msgid "Warn if type signatures of candidate methods do not match exactly."
msgstr "Brīdināt, ja kandidātmetožu tipu signatūras precīzi nesakrīt."

#: c-family/c.opt:1456
#, no-c-format
msgid "Warn about calls to strcmp and strncmp used in equality expressions that are necessarily true or false due to the length of one and size of the other argument."
msgstr "Brīdināt par strcmp un strncmp izsaukumiem vienādības izteiksmēs, kas noteikti ir patiesas vai nepatiesas viena argumenta garuma un otra izmēra dēļ."

#: c-family/c.opt:1462
#, no-c-format
msgid "Warn about buffer overflow in string manipulation functions like memcpy and strcpy."
msgstr "Brīdināt par bufera pārpildi virkņu manipulācijas funkcijās, piemēram, memcpy un strcpy."

#: c-family/c.opt:1467
#, no-c-format
msgid "Under the control of Object Size type, warn about buffer overflow in string manipulation functions like memcpy and strcpy."
msgstr "Atkarībā no Object Size tipa brīdināt par bufera pārpildi virkņu manipulācijas funkcijās, piemēram, memcpy un strcpy."

#: c-family/c.opt:1472
#, no-c-format
msgid "Warn about reading past the end of a source array in string manipulation functions like memchr and memcpy."
msgstr "Brīdināt par lasīšanu aiz avota masīva beigām virkņu manipulācijas funkcijās, piemēram, memchr un memcpy."

#: c-family/c.opt:1476
#, no-c-format
msgid "Warn about truncation in string manipulation functions like strncat and strncpy."
msgstr "Brīdināt par saīsināšanu virkņu manipulācijas funkcijās, piemēram, strncat un strncpy."

#: c-family/c.opt:1480
#, no-c-format
msgid "Warn if a class type has a base or a field whose type uses the anonymous namespace or depends on a type with no linkage."
msgstr "Brīdināt, ja klases tipam ir bāze vai lauks, kura tips izmanto anonīmo nosaukumvietu vai ir atkarīgs no tipa bez saistīšanas (linkage)."

#: c-family/c.opt:1484
#, no-c-format
msgid "Warn about functions which might be candidates for format attributes."
msgstr "Brīdināt par funkcijām, kas varētu būt formāta atribūtu kandidāti."

#: c-family/c.opt:1488
#, no-c-format
msgid "Suggest that the override keyword be used when the declaration of a virtual function overrides another."
msgstr "Ieteikt izmantot atslēgvārdu override, ja virtuālās funkcijas deklarācija pārraksta citu."

#: c-family/c.opt:1493
#, no-c-format
msgid "Warn about enumerated switches, with no default, missing a case."
msgstr "Brīdināt par switch ar uzskaitījuma tipu bez default, kam trūkst kāda case."

#: c-family/c.opt:1497
#, no-c-format
msgid "Warn about enumerated switches missing a \"default:\" statement."
msgstr "Brīdināt par switch ar uzskaitījuma tipu, kam trūkst \"default:\" priekšraksta."

#: c-family/c.opt:1501
#, no-c-format
msgid "Warn about all enumerated switches missing a specific case."
msgstr "Brīdināt par visiem switch ar uzskaitījuma tipu, kuriem trūkst konkrēta case."

#: c-family/c.opt:1505
#, no-c-format
msgid "Warn about switches with boolean controlling expression."
msgstr "Brīdināt par switch ar Būla vadības izteiksmi."

#: c-family/c.opt:1509
#, no-c-format
msgid "Warn about switch values that are outside of the switch's type range."
msgstr "Brīdināt par switch vērtībām, kas ir ārpus switch tipa diapazona."

#: c-family/c.opt:1513
#, no-c-format
msgid "Warn when __sync_fetch_and_nand and __sync_nand_and_fetch built-in functions are used."
msgstr "Brīdināt, ja tiek izmantotas iebūvētās funkcijas __sync_fetch_and_nand un __sync_nand_and_fetch."

#: c-family/c.opt:1525
#, no-c-format
msgid "Warn on primary template declaration."
msgstr "Brīdināt par primārās veidnes deklarāciju."

#: c-family/c.opt:1529
#, no-c-format
msgid "Diagnose errors when parsing a template."
msgstr "Diagnosticēt kļūdas, parsējot veidni."

#: c-family/c.opt:1533
#, no-c-format
msgid "Warn about simple-template-id in a constructor or destructor."
msgstr "Brīdināt par simple-template-id konstruktorā vai destruktorā."

#: c-family/c.opt:1537
#, no-c-format
msgid "Warn about templates naming TU-local entities in a module."
msgstr "Brīdināt par veidnēm, kas modulī nosauc TU lokālas entītijas."

#: c-family/c.opt:1541
#, no-c-format
msgid "Warn if a throw expression will always result in a call to terminate()."
msgstr "Brīdināt, ja throw izteiksme vienmēr izraisīs terminate() izsaukumu."

#: c-family/c.opt:1545
#, no-c-format
msgid "Warn about features not present in traditional C."
msgstr "Brīdināt par līdzekļiem, kas nav tradicionālajā C."

#: c-family/c.opt:1549
#, no-c-format
msgid "Warn of prototypes causing type conversions different from what would happen in the absence of prototype."
msgstr "Brīdināt par prototipiem, kas izraisa tipu konversijas, kuras atšķiras no tā, kas notiktu bez prototipa."

#: c-family/c.opt:1565
#, no-c-format
msgid "Warn about trailing whitespace on lines except when in raw string literals."
msgstr "Brīdināt par atstarpēm rindu beigās, izņemot neapstrādātos (raw) virkņu literāļos."

#: c-family/c.opt:1569
#, no-c-format
msgid "Warn about trailing whitespace on lines except when in raw string literals.   Equivalent to Wtrailing-whitespace=blanks when enabled or Wtrailing-whitespace=none when disabled."
msgstr "Brīdināt par atstarpēm rindu beigās, izņemot neapstrādātos (raw) virkņu literāļos.   Ekvivalents Wtrailing-whitespace=blanks, ja iespējots, vai Wtrailing-whitespace=none, ja atspējots."

#: c-family/c.opt:1573
#, no-c-format
msgid "Warn if trigraphs are encountered that might affect the meaning of the program."
msgstr "Brīdināt, ja tiek sastapti trigrāfi, kas var ietekmēt programmas nozīmi."

#: c-family/c.opt:1577
#, no-c-format
msgid "Warn about @selector()s without previously declared methods."
msgstr "Brīdināt par @selector() bez iepriekš deklarētām metodēm."

#: c-family/c.opt:1581
#, no-c-format
msgid "Warn if an undefined macro is used in an #if directive."
msgstr "Brīdināt, ja #if direktīvā tiek izmantots nedefinēts makro."

#: c-family/c.opt:1585
#, no-c-format
msgid "Warn about invalid forms of delimited or named escape sequences."
msgstr "Brīdināt par nederīgām norobežotu vai nosauktu atsoļa (escape) secību formām."

#: c-family/c.opt:1593
#, no-c-format
msgid "Warn about unrecognized pragmas."
msgstr "Brīdināt par neatpazītām pragmām."

#: c-family/c.opt:1597
#, no-c-format
msgid "Warn about unsuffixed float constants."
msgstr "Brīdināt par peldošā komata konstantēm bez piedēkļa."

#: c-family/c.opt:1601
#, no-c-format
msgid "Warn about character arrays initialized as unterminated character sequences with a string literal."
msgstr "Brīdināt par rakstzīmju masīviem, kas ar virknes literāli inicializēti kā nenoslēgtas rakstzīmju secības."

#: c-family/c.opt:1617
#, no-c-format
msgid "Warn when typedefs locally defined in a function are not used."
msgstr "Brīdināt, ja funkcijā lokāli definēti typedef netiek izmantoti."

#: c-family/c.opt:1621
#, no-c-format
msgid "Warn about macros defined in the main file that are not used."
msgstr "Brīdināt par galvenajā failā definētiem makro, kas netiek izmantoti."

#: c-family/c.opt:1641
#, no-c-format
msgid "Warn about useless casts."
msgstr "Brīdināt par bezjēdzīgām tipu pārveidošanām."

#: c-family/c.opt:1645
#, no-c-format
msgid "Warn about using variadic macros."
msgstr "Brīdināt par makro ar mainīgu argumentu skaitu lietošanu."

#: c-family/c.opt:1649
#, no-c-format
msgid "Warn about questionable usage of the macros used to retrieve variable arguments."
msgstr "Brīdināt par apšaubāmu to makro lietojumu, ko izmanto mainīgo argumentu iegūšanai."

#: c-family/c.opt:1653
#, no-c-format
msgid "Warn about the most vexing parse syntactic ambiguity."
msgstr "Brīdināt par most vexing parse sintaktisko neviennozīmību."

#: c-family/c.opt:1657
#, no-c-format
msgid "Warn if a virtual base has a non-trivial move assignment operator."
msgstr "Brīdināt, ja virtuālajai bāzei ir netriviāls pārvietošanas piešķiršanas operators."

#: c-family/c.opt:1661
#, no-c-format
msgid "Warn if a variable length array is used."
msgstr "Brīdināt, ja tiek izmantots mainīga garuma masīvs."

#: c-family/c.opt:1665
#, no-c-format
msgid "-Wvla-larger-than=<number>\tWarn on unbounded uses of variable-length arrays, and on bounded uses of variable-length arrays whose bound can be larger than <number> bytes."
msgstr "-Wvla-larger-than=<number>\tBrīdināt par neierobežotu mainīga garuma masīvu lietojumu un par ierobežotu mainīga garuma masīvu lietojumu, kuru robeža var pārsniegt <number> baitus."

#: c-family/c.opt:1671
#, no-c-format
msgid "Disable Wvla-larger-than= warning.  Equivalent to Wvla-larger-than=<SIZE_MAX> or larger."
msgstr "Atspējot Wvla-larger-than= brīdinājumu.  Ekvivalents Wvla-larger-than=<SIZE_MAX> vai lielākai vērtībai."

#: c-family/c.opt:1675
#, no-c-format
msgid "Warn about mismatched declarations of VLA parameters."
msgstr "Brīdināt par neatbilstošām VLA parametru deklarācijām."

#: c-family/c.opt:1679
#, no-c-format
msgid "Warn about deprecated uses of volatile qualifier."
msgstr "Brīdināt par novecojušiem volatile kvalifikatora lietojumiem."

#: c-family/c.opt:1683
#, no-c-format
msgid "Warn when a register variable is declared volatile."
msgstr "Brīdināt, ja reģistra mainīgais ir deklarēts kā volatile."

#: c-family/c.opt:1687
#, no-c-format
msgid "Warn on direct virtual inheritance."
msgstr "Brīdināt par tiešu virtuālo mantošanu."

#: c-family/c.opt:1691
#, no-c-format
msgid "In C++, nonzero means warn about deprecated conversion from string literals to 'char *'.  In C, similar warning, except that the conversion is of course not deprecated by the ISO C standard."
msgstr "C++ valodā nenulles vērtība nozīmē brīdināt par novecojušu konversiju no virkņu literāļiem uz 'char *'.  C valodā līdzīgs brīdinājums, tikai ISO C standarts šo konversiju, protams, nav atzinis par novecojušu."

#: c-family/c.opt:1695
#, no-c-format
msgid "Warn about xor operators where it appears the user meant exponentiation."
msgstr "Brīdināt par xor operatoriem, ja šķiet, ka lietotājs domājis kāpināšanu."

#: c-family/c.opt:1699
#, no-c-format
msgid "Warn when a literal '0' is used as null pointer."
msgstr "Brīdināt, ja literālis '0' tiek izmantots kā null rādītājs."

#: c-family/c.opt:1703
#, no-c-format
msgid "Warn about accesses to interior zero-length array members."
msgstr "Brīdināt par piekļuvi iekšējiem nulles garuma masīva locekļiem."

#: c-family/c.opt:1707
#, no-c-format
msgid "A synonym for -std=c89 (for C) or -std=c++98 (for C++)."
msgstr "Sinonīms -std=c89 (C valodai) vai -std=c++98 (C++ valodai)."

#: c-family/c.opt:1715
#, no-c-format
msgid "The version of the C++ ABI used for -Wabi warnings and link compatibility aliases."
msgstr "C++ ABI versija, ko izmanto -Wabi brīdinājumiem un saistīšanas saderības aizstājvārdiem."

#: c-family/c.opt:1719
#, no-c-format
msgid "Enforce class member access control semantics."
msgstr "Ievērot klases locekļu piekļuves kontroles semantiku."

#: c-family/c.opt:1723
#, no-c-format
msgid "-fada-spec-parent=unit\tDump Ada specs as child units of given parent."
msgstr "-fada-spec-parent=unit\tIzmest Ada specifikācijas kā norādītās vecāka vienības bērnvienības."

#: c-family/c.opt:1727
#, no-c-format
msgid "Support C++17 allocation of over-aligned types."
msgstr "Atbalstīt C++17 pārizlīdzinātu tipu piešķiršanu."

#: c-family/c.opt:1731
#, no-c-format
msgid "-faligned-new=<N>\tUse C++17 over-aligned type allocation for alignments greater than N."
msgstr "-faligned-new=<N>\tIzlīdzinājumiem, kas lielāki par N, izmantot C++17 pārizlīdzinātu tipu piešķiršanu."

#: c-family/c.opt:1742 c-family/c.opt:2089 c-family/c.opt:2506
#: c-family/c.opt:2510 c-family/c.opt:2526
#, no-c-format
msgid "No longer supported."
msgstr "Vairs netiek atbalstīts."

#: c-family/c.opt:1746
#, no-c-format
msgid "Recognize the \"asm\" keyword."
msgstr "Atpazīt atslēgvārdu \"asm\"."

#: c-family/c.opt:1750
#, no-c-format
msgid "Assume C++ replaceable global operators new, new[], delete, delete[] don't read or write visible global state."
msgstr "Pieņemt, ka C++ aizstājamie globālie operatori new, new[], delete, delete[] nelasa un neraksta redzamu globālo stāvokli."

#: c-family/c.opt:1758
#, no-c-format
msgid "Recognize built-in functions."
msgstr "Atpazīt iebūvētās funkcijas."

#: c-family/c.opt:1765
#, no-c-format
msgid "Where shorter, use canonicalized paths to systems headers."
msgstr "Ja tas ir īsāk, izmantot kanonizētus ceļus uz sistēmas galvenēm."

#: c-family/c.opt:1769
#, no-c-format
msgid "Enable the char8_t fundamental type and use it as the type for UTF-8 string and character literals."
msgstr "Iespējot pamattipu char8_t un izmantot to kā UTF-8 virknes un rakstzīmju literāļu tipu."

#: c-family/c.opt:1857
#, no-c-format
msgid "Removed in GCC 8.  This switch has no effect."
msgstr "Noņemts GCC 8.  Šim slēdzim nav ietekmes."

#: c-family/c.opt:1861
#, no-c-format
msgid "Enable support for C++ concepts."
msgstr "Iespējot C++ konceptu (concepts) atbalstu."

#: c-family/c.opt:1865
#, no-c-format
msgid "Removed in GCC 15.  This switch has no effect."
msgstr "Noņemts GCC 15.  Šim slēdzim nav ietekmes."

#: c-family/c.opt:1869
#, no-c-format
msgid "Specify maximum error replay depth during recursive diagnosis of a constraint satisfaction failure."
msgstr "Norādīt maksimālo kļūdu atkārtošanas dziļumu ierobežojumu neizpildes rekursīvajā diagnostikā."

#: c-family/c.opt:1873
#, no-c-format
msgid "Allow the arguments of the '?' operator to have different types."
msgstr "Atļaut '?' operatora argumentiem būt dažādiem tipiem."

#: c-family/c.opt:1881
#, no-c-format
msgid "-fconst-string-class=<name>\tUse class <name> for constant strings."
msgstr "-fconst-string-class=<name>\tKonstantām virknēm izmantot klasi <name>."

#: c-family/c.opt:1885
#, no-c-format
msgid "-fconstexpr-depth=<number>\tSpecify maximum constexpr recursion depth."
msgstr "-fconstexpr-depth=<number>\tNorādīt maksimālo constexpr rekursijas dziļumu."

#: c-family/c.opt:1889
#, no-c-format
msgid "-fconstexpr-cache-depth=<number>\tSpecify maximum constexpr recursion cache depth."
msgstr "-fconstexpr-cache-depth=<number>\tNorādīt maksimālo constexpr rekursijas kešatmiņas dziļumu."

#: c-family/c.opt:1893
#, no-c-format
msgid "Allow IEC559 floating point exceptions in constant expressions."
msgstr "Atļaut IEC559 peldošā komata izņēmumus konstantās izteiksmēs."

#: c-family/c.opt:1897
#, no-c-format
msgid "-fconstexpr-loop-limit=<number>\tSpecify maximum constexpr loop iteration count."
msgstr "-fconstexpr-loop-limit=<number>\tNorādīt maksimālo constexpr cikla iterāciju skaitu."

#: c-family/c.opt:1901
#, no-c-format
msgid "-fconstexpr-ops-limit=<number>\tSpecify maximum number of constexpr operations during a single constexpr evaluation."
msgstr "-fconstexpr-ops-limit=<number>\tNorādīt maksimālo constexpr operāciju skaitu vienā constexpr izvērtēšanā."

#: c-family/c.opt:1905
#, no-c-format
msgid "Enable features proposed for C++26 Contracts."
msgstr "Iespējot C++26 Contracts piedāvātos līdzekļus."

#: c-family/c.opt:1926
#, no-c-format
msgid "-fcontract-evaluation-semantic=[ignore|observe|enforce|quick_enforce]\tSelect the contract evaluation semantic (defaults to enforce)."
msgstr "-fcontract-evaluation-semantic=[ignore|observe|enforce|quick_enforce]\tIzvēlēties līguma izvērtēšanas semantiku (noklusējums ir enforce)."

#: c-family/c.opt:1930
#, no-c-format
msgid "-fcontracts-conservative-ipa\tDo not allow certain optimisations between functions in contract assertions."
msgstr "-fcontracts-conservative-ipa\tNeatļaut noteiktas starpfunkciju optimizācijas līguma apgalvojumos."

#: c-family/c.opt:1935
#, no-c-format
msgid "-fcontract-checks-outlined\tBuild contract checks using outlined functions."
msgstr "-fcontract-checks-outlined\tVeidot līgumu pārbaudes, izmantojot iznestas (outlined) funkcijas."

#: c-family/c.opt:1939
#, no-c-format
msgid "-fcontract-disable-optimized-checks\tDisable optimisation of contract checks."
msgstr "-fcontract-disable-optimized-checks\tAtspējot līguma pārbaužu optimizāciju."

#: c-family/c.opt:1955
#, no-c-format
msgid "-fcontracts-client-check=[none|pre|all] Select which contracts will be checked on the client side for non virtual functions."
msgstr "-fcontracts-client-check=[none|pre|all] Izvēlēties, kuri līgumi tiks pārbaudīti klienta pusē attiecībā uz ne-virtuālām funkcijām."

#: c-family/c.opt:1968
#, no-c-format
msgid "-fcontracts-definition-check=[on|off]\tEnable or disable contract checks on the definition side for all functions (default on)."
msgstr "-fcontracts-definition-check=[on|off]\tIespējot vai atspējot līgumu pārbaudes definīcijas pusē visām funkcijām (pēc noklusējuma ieslēgts)."

#: c-family/c.opt:1972
#, no-c-format
msgid "Enable C++ coroutines (experimental)."
msgstr "Iespējot C++ korutīnas (eksperimentāli)."

#: c-family/c.opt:1976
#, no-c-format
msgid "Emit debug annotations during preprocessing."
msgstr "Izvadīt atkļūdošanas anotācijas priekšapstrādes laikā."

#: c-family/c.opt:1984
#, no-c-format
msgid "Factor complex constructors and destructors to favor space over speed."
msgstr "Faktorizēt sarežģītus konstruktorus un destruktorus, dodot priekšroku izmēram, nevis ātrumam."

#: c-family/c.opt:1992
#, no-c-format
msgid "Print hierarchical comparisons when template types are mismatched."
msgstr "Izdrukāt hierarhiskus salīdzinājumus, ja veidņu tipi neatbilst."

#: c-family/c.opt:1996
#, no-c-format
msgid "Note all candidates during overload resolution failure."
msgstr "Pārslodzes atrisināšanas neveiksmes gadījumā norādīt visus kandidātus."

#: c-family/c.opt:2000
#, no-c-format
msgid "Preprocess directives only."
msgstr "Priekšapstrādāt tikai direktīvas."

#: c-family/c.opt:2004
#, no-c-format
msgid "Permit '$' as an identifier character."
msgstr "Atļaut '$' kā identifikatora rakstzīmi."

#: c-family/c.opt:2008
#, no-c-format
msgid "-fmacro-prefix-map=<old>=<new>\tMap one directory name to another in __FILE__, __BASE_FILE__, and __builtin_FILE()."
msgstr "-fmacro-prefix-map=<old>=<new>\tAizstāt vienu direktorijas nosaukumu ar citu __FILE__, __BASE_FILE__ un __builtin_FILE()."

#: c-family/c.opt:2012
#, no-c-format
msgid "Write all declarations as Ada code transitively."
msgstr "Tranzitīvi ierakstīt visas deklarācijas kā Ada kodu."

#: c-family/c.opt:2016
#, no-c-format
msgid "Write all declarations as Ada code for the given file only."
msgstr "Ierakstīt visas deklarācijas kā Ada kodu tikai norādītajam failam."

#: c-family/c.opt:2023
#, no-c-format
msgid "Do not elide common elements in template comparisons."
msgstr "Veidņu salīdzinājumos neizlaist kopīgos elementus."

#: c-family/c.opt:2027
#, no-c-format
msgid "Generate code to check exception specifications."
msgstr "Ģenerēt kodu izņēmumu specifikāciju pārbaudei."

#: c-family/c.opt:2034
#, no-c-format
msgid "-fexec-charset=<cset>\tConvert all strings and character constants to character set <cset>."
msgstr "-fexec-charset=<cset>\tPārveidot visas virknes un rakstzīmju konstantes uz rakstzīmju kopu <cset>."

#: c-family/c.opt:2038
#, no-c-format
msgid "Permit universal character names (\\u and \\U) in identifiers."
msgstr "Atļaut universālo rakstzīmju nosaukumus (\\u un \\U) identifikatoros."

#: c-family/c.opt:2042
#, no-c-format
msgid "-finput-charset=<cset>\tSpecify the default character set for source files."
msgstr "-finput-charset=<cset>\tNorādīt pirmkoda failu noklusējuma rakstzīmju kopu."

#: c-family/c.opt:2046
#, no-c-format
msgid "Support dynamic initialization of thread-local variables in a different translation unit."
msgstr "Atbalstīt pavedienlokālo mainīgo dinamisko inicializāciju citā translācijas vienībā."

#: c-family/c.opt:2053
#, no-c-format
msgid "Fold calls to simple inline functions."
msgstr "Salocīt (fold) vienkāršu iekļaujamo funkciju izsaukumus."

#: c-family/c.opt:2060
#, no-c-format
msgid "Do not assume that standard C libraries and \"main\" exist."
msgstr "Nepieņemt, ka eksistē standarta C bibliotēkas un \"main\"."

#: c-family/c.opt:2064
#, no-c-format
msgid "Recognize GNU-defined keywords."
msgstr "Atpazīt GNU definētos atslēgvārdus."

#: c-family/c.opt:2068
#, no-c-format
msgid "Generate code for GNU runtime environment."
msgstr "Ģenerēt kodu GNU izpildlaika videi."

#: c-family/c.opt:2072
#, no-c-format
msgid "Use traditional GNU semantics for inline functions."
msgstr "Izmantot tradicionālo GNU semantiku iekļaujamajām funkcijām."

#: c-family/c.opt:2085
#, no-c-format
msgid "Assume normal C execution environment."
msgstr "Pieņemt normālu C izpildes vidi."

#: c-family/c.opt:2093
#, no-c-format
msgid "Implement P2564 for consteval propagation."
msgstr "Īstenot P2564 consteval izplatīšanai."

#: c-family/c.opt:2097
#, no-c-format
msgid "Export functions even if they can be inlined."
msgstr "Eksportēt funkcijas arī tad, ja tās var iekļaut."

#: c-family/c.opt:2101
#, no-c-format
msgid "Make inline functions constexpr by default."
msgstr "Pēc noklusējuma padarīt iekļaujamās funkcijas par constexpr."

#: c-family/c.opt:2105
#, no-c-format
msgid "Emit implicit instantiations of inline templates."
msgstr "Izvadīt iekļaujamo veidņu netiešās instancēšanas."

#: c-family/c.opt:2109
#, no-c-format
msgid "Emit implicit instantiations of templates."
msgstr "Izvadīt veidņu netiešās instancēšanas."

#: c-family/c.opt:2113
#, no-c-format
msgid "Implement C++17 inheriting constructor semantics."
msgstr "Īstenot C++17 konstruktoru mantošanas semantiku."

#: c-family/c.opt:2120
#, no-c-format
msgid "Don't emit dllexported inline functions unless needed."
msgstr "Neizvadīt dllexport iekļaujamās funkcijas, ja tas nav nepieciešams."

#: c-family/c.opt:2127
#, no-c-format
msgid "Allow implicit conversions between vectors with differing numbers of subparts and/or differing element types."
msgstr "Atļaut netiešas konversijas starp vektoriem ar atšķirīgu apakšdaļu skaitu un/vai atšķirīgiem elementu tipiem."

#: c-family/c.opt:2131
#, no-c-format
msgid "Enable C++20 Modules (experimental)."
msgstr "Iespējot C++20 moduļus (eksperimentāli)."

#: c-family/c.opt:2139
#, no-c-format
msgid "Enable C++ header module (experimental)."
msgstr "Iespējot C++ galvenes moduli (eksperimentāli)."

#: c-family/c.opt:2146
#, no-c-format
msgid "Member functions defined within their class are inline in module purview."
msgstr "Savā klasē definētās locekļfunkcijas moduļa tvērumā ir iekļaujamas."

#: c-family/c.opt:2150
#, no-c-format
msgid "Only emit Compiled Module Interface."
msgstr "Izvadīt tikai kompilēto moduļa saskarni (CMI)."

#: c-family/c.opt:2154
#, no-c-format
msgid "Mapper for module to CMI files."
msgstr "Moduļu kartētājs uz CMI failiem."

#: c-family/c.opt:2158
#, no-c-format
msgid "Enable lazy module importing."
msgstr "Iespējot atlikto moduļu importēšanu."

#: c-family/c.opt:2166
#, no-c-format
msgid "Warn about macros that have conflicting header units definitions."
msgstr "Brīdināt par makro, kuriem ir konfliktējošas galvenes vienību definīcijas."

#: c-family/c.opt:2170
#, no-c-format
msgid "Warn if pointers of distinct types are compared without a cast."
msgstr "Brīdināt, ja dažādu tipu rādītāji tiek salīdzināti bez tipa pārveidošanas."

#: c-family/c.opt:2174
#, no-c-format
msgid "Note #include directives translated to import declarations."
msgstr "Norādīt #include direktīvas, kas pārveidotas par importēšanas deklarācijām."

#: c-family/c.opt:2178
#, no-c-format
msgid "Note #include directives not translated to import declarations, and not known to be textual."
msgstr "Norādīt #include direktīvas, kas nav pārveidotas par importēšanas deklarācijām un nav zināmas kā tekstuālas."

#: c-family/c.opt:2182
#, no-c-format
msgid "Note a #include translation of a specific header."
msgstr "Norādīt konkrētas galvenes #include pārveidošanu."

#: c-family/c.opt:2186
#, no-c-format
msgid "Note Compiled Module Interface pathnames."
msgstr "Norādīt kompilēto moduļu saskarņu (CMI) ceļu nosaukumus."

#: c-family/c.opt:2190
#, no-c-format
msgid "Note Compiled Module Interface pathname of a specific module or header-unit."
msgstr "Norādīt konkrēta moduļa vai galvenes vienības kompilētās moduļa saskarnes (CMI) ceļa nosaukumu."

#: c-family/c.opt:2194
#, no-c-format
msgid "fmax-include-depth=<number> Set the maximum depth of the nested #include."
msgstr "fmax-include-depth=<number> Iestatīt maksimālo ligzdoto #include dziļumu."

#: c-family/c.opt:2198
#, no-c-format
msgid "Don't warn about uses of Microsoft extensions."
msgstr "Nebrīdināt par Microsoft paplašinājumu izmantošanu."

#: c-family/c.opt:2217
#, no-c-format
msgid "Implement resolution of DR 150 for matching of template template arguments."
msgstr "Īstenot DR 150 risinājumu veidnes veidņu argumentu saskaņošanai."

#: c-family/c.opt:2221
#, no-c-format
msgid "Generate code for NeXT (Apple macOS) runtime environment."
msgstr "Ģenerēt kodu NeXT (Apple macOS) izpildlaika videi."

#: c-family/c.opt:2225
#, no-c-format
msgid "Assume that receivers of Objective-C messages may be nil."
msgstr "Pieņemt, ka Objective-C ziņojumu saņēmēji var būt nil."

#: c-family/c.opt:2229
#, no-c-format
msgid "Allow access to instance variables as if they were local declarations within instance method implementations."
msgstr "Atļaut piekļuvi instances mainīgajiem tā, it kā tie būtu lokālas deklarācijas instances metožu realizācijās."

#: c-family/c.opt:2233
#, no-c-format
msgid "-fvisibility=[private|protected|public|package]\tSet the default symbol visibility."
msgstr "-fvisibility=[private|protected|public|package]\tIestatīt noklusējuma simbola redzamību."

#: c-family/c.opt:2258
#, no-c-format
msgid "Treat a throw() exception specification as noexcept to improve code size."
msgstr "Uzskatīt throw() izņēmumu specifikāciju par noexcept, lai uzlabotu koda izmēru."

#: c-family/c.opt:2262
#, no-c-format
msgid "Specify which ABI to use for Objective-C family code and meta-data generation."
msgstr "Norādīt, kuru ABI izmantot Objective-C saimes koda un metadatu ģenerēšanai."

#: c-family/c.opt:2268
#, no-c-format
msgid "Generate special Objective-C methods to initialize/destroy non-POD C++ ivars, if needed."
msgstr "Ja nepieciešams, ģenerēt īpašas Objective-C metodes ne-POD C++ instances mainīgo (ivar) inicializēšanai/iznīcināšanai."

#: c-family/c.opt:2272
#, no-c-format
msgid "Allow fast jumps to the message dispatcher."
msgstr "Atļaut ātrus lēcienus uz ziņojumu dispečeru."

#: c-family/c.opt:2278
#, no-c-format
msgid "Enable Objective-C exception and synchronization syntax."
msgstr "Iespējot Objective-C izņēmumu un sinhronizācijas sintaksi."

#: c-family/c.opt:2282
#, no-c-format
msgid "Enable garbage collection (GC) in Objective-C/Objective-C++ programs."
msgstr "Iespējot atkritumu savākšanu (GC) Objective-C/Objective-C++ programmās."

#: c-family/c.opt:2286
#, no-c-format
msgid "Enable inline checks for nil receivers with the NeXT runtime and ABI version 2."
msgstr "Iespējot iekļautās pārbaudes nil saņēmējiem ar NeXT izpildlaiku un ABI 2. versiju."

#: c-family/c.opt:2291
#, no-c-format
msgid "Enable Objective-C setjmp exception handling runtime."
msgstr "Iespējot Objective-C setjmp izņēmumu apstrādes izpildlaiku."

#: c-family/c.opt:2295
#, no-c-format
msgid "Conform to the Objective-C 1.0 language as implemented in GCC 4.0."
msgstr "Ievērot Objective-C 1.0 valodu, kā tā ir īstenota GCC 4.0."

#: c-family/c.opt:2299
#, no-c-format
msgid "Enable OpenACC."
msgstr "Iespējot OpenACC."

#: c-family/c.opt:2303
#, no-c-format
msgid "Specify default OpenACC compute dimensions."
msgstr "Norādīt noklusējuma OpenACC skaitļošanas dimensijas."

#: c-family/c.opt:2307
#, no-c-format
msgid "Enable OpenMP (implies -frecursive in Fortran)."
msgstr "Iespējot OpenMP (ietver -frecursive Fortran valodā)."

#: c-family/c.opt:2311
#, no-c-format
msgid "Enable OpenMP's SIMD directives."
msgstr "Iespējot OpenMP SIMD direktīvas."

#: c-family/c.opt:2315
#, no-c-format
msgid "Recognize C++ keywords like \"compl\" and \"xor\"."
msgstr "Atpazīt tādus C++ atslēgvārdus kā \"compl\" un \"xor\"."

#: c-family/c.opt:2326
#, no-c-format
msgid "Look for and use PCH files even when preprocessing."
msgstr "Meklēt un izmantot PCH failus arī priekšapstrādes laikā."

#: c-family/c.opt:2330
#, no-c-format
msgid "Downgrade conformance errors to warnings."
msgstr "Pazemināt atbilstības kļūdas līdz brīdinājumiem."

#: c-family/c.opt:2334
#, no-c-format
msgid "Enable Plan 9 language extensions."
msgstr "Iespējot Plan 9 valodas paplašinājumus."

#: c-family/c.opt:2338
#, no-c-format
msgid "Treat the input file as already preprocessed."
msgstr "Uzskatīt ievades failu par jau priekšapstrādātu."

#: c-family/c.opt:2346
#, no-c-format
msgid "-ftrack-macro-expansion=<0|1|2>\tTrack locations of tokens coming from macro expansion and display them in error messages."
msgstr "-ftrack-macro-expansion=<0|1|2>\tIzsekot no makro izvēršanas cēlušos marķieru atrašanās vietas un rādīt tās kļūdu ziņojumos."

#: c-family/c.opt:2350
#, no-c-format
msgid "Do not pretty-print template specializations as the template signature followed by the arguments."
msgstr "Neattēlot veidņu specializācijas kā veidnes signatūru, kam seko argumenti."

#: c-family/c.opt:2354
#, no-c-format
msgid "Treat known sprintf return values as constants."
msgstr "Uzskatīt zināmās sprintf atgriešanas vērtības par konstantām."

#: c-family/c.opt:2358
#, no-c-format
msgid "Enable lifetime extension of range based for temporaries."
msgstr "Iespējot pagaidu objektu dzīves ilguma pagarināšanu uz diapazonu balstītā for."

#: c-family/c.opt:2362
#, no-c-format
msgid "Enable experimental C++26 Reflection."
msgstr "Iespējot eksperimentālo C++26 refleksiju (Reflection)."

#: c-family/c.opt:2366
#, no-c-format
msgid "Used in Fix-and-Continue mode to indicate that object files may be swapped in at runtime."
msgstr "Izmanto Fix-and-Continue režīmā, lai norādītu, ka objektfailus var aizstāt izpildlaikā."

#: c-family/c.opt:2370
#, no-c-format
msgid "Removed in GCC 10.  This switch has no effect."
msgstr "Noņemts GCC 10.  Šim slēdzim nav ietekmes."

#: c-family/c.opt:2374
#, no-c-format
msgid "Generate run time type descriptor information."
msgstr "Ģenerēt izpildlaika tipu deskriptoru informāciju."

#: c-family/c.opt:2378
#, no-c-format
msgid "Look for the main source file on the include path."
msgstr "Meklēt galveno pirmkoda failu iekļaušanas ceļā."

#: c-family/c.opt:2389
#, no-c-format
msgid "Force the underlying type for \"wchar_t\" to be \"unsigned short\"."
msgstr "Piespiest, lai \"wchar_t\" pamattips būtu \"unsigned short\"."

#: c-family/c.opt:2393
#, no-c-format
msgid "When \"signed\" or \"unsigned\" is not given make the bitfield signed."
msgstr "Ja nav norādīts \"signed\" vai \"unsigned\", padarīt bitu lauku ar zīmi."

#: c-family/c.opt:2401
#, no-c-format
msgid "Enable C++14 sized deallocation support."
msgstr "Iespējot C++14 atbrīvošanas ar izmēru (sized deallocation) atbalstu."

#: c-family/c.opt:2408
#, no-c-format
msgid "-fstrict-flex-arrays=<level>    Control when to treat the trailing array of a structure as a flexible array member for the purposes of accessing the elements of such an array. The default is treating all trailing arrays of structures as flexible array members."
msgstr "-fstrict-flex-arrays=<level>    Kontrolēt, kad struktūras beigu masīvu uzskatīt par elastīgā masīva locekli, piekļūstot šāda masīva elementiem. Pēc noklusējuma visi struktūru beigu masīvi tiek uzskatīti par elastīgo masīvu locekļiem."

#: c-family/c.opt:2415
#, no-c-format
msgid "-fsso-struct=[big-endian|little-endian|native]\tSet the default scalar storage order."
msgstr "-fsso-struct=[big-endian|little-endian|native]\tIestatīt noklusējuma skalāro glabāšanas secību."

#: c-family/c.opt:2431
#, no-c-format
msgid "Display statistics accumulated during compilation."
msgstr "Rādīt kompilēšanas laikā uzkrāto statistiku."

#: c-family/c.opt:2435
#, no-c-format
msgid "Assume that values of enumeration type are always within the minimum range of that type."
msgstr "Pieņemt, ka uzskaitījuma tipa vērtības vienmēr ir šī tipa minimālajā diapazonā."

#: c-family/c.opt:2442 c-family/c.opt:2447
#, no-c-format
msgid "Follow the C++17 evaluation order requirements for assignment expressions, shift, member function calls, etc."
msgstr "Ievērot C++17 izvērtēšanas secības prasības piešķiršanas izteiksmēm, bīdēm, locekļfunkciju izsaukumiem u. c."

#: c-family/c.opt:2464
#, no-c-format
msgid "Set the maximum number of template instantiation notes for a single warning or error."
msgstr "Iestatīt maksimālo veidnes instancēšanas piezīmju skaitu vienam brīdinājumam vai kļūdai."

#: c-family/c.opt:2471
#, no-c-format
msgid "-ftemplate-depth=<number>\tSpecify maximum template instantiation depth."
msgstr "-ftemplate-depth=<number>\tNorādīt maksimālo veidņu instancēšanas dziļumu."

#: c-family/c.opt:2478
#, no-c-format
msgid "-fno-threadsafe-statics\tDo not generate thread-safe code for initializing local statics."
msgstr "-fno-threadsafe-statics\tNeģenerēt pavedienu ziņā drošu kodu lokālo statisko mainīgo inicializēšanai."

#: c-family/c.opt:2482
#, no-c-format
msgid "When \"signed\" or \"unsigned\" is not given make the bitfield unsigned."
msgstr "Ja nav norādīts \"signed\" vai \"unsigned\", padarīt bitu lauku bez zīmes."

#: c-family/c.opt:2490
#, no-c-format
msgid "Use __cxa_atexit to register destructors."
msgstr "Izmantot __cxa_atexit, lai reģistrētu destruktorus."

#: c-family/c.opt:2494
#, no-c-format
msgid "Use __cxa_get_exception_ptr in exception handling."
msgstr "Izņēmumu apstrādē izmantot __cxa_get_exception_ptr."

#: c-family/c.opt:2498
#, no-c-format
msgid "Marks all inlined functions and methods as having hidden visibility."
msgstr "Atzīmēt visas iekļautās funkcijas un metodes kā tādas, kurām ir slēpta redzamība."

#: c-family/c.opt:2502
#, no-c-format
msgid "Changes visibility to match Microsoft Visual Studio by default."
msgstr "Pēc noklusējuma mainīt redzamību atbilstoši Microsoft Visual Studio."

#: c-family/c.opt:2514
#, no-c-format
msgid "Emit common-like symbols as weak symbols."
msgstr "Izvadīt common veida simbolus kā vājus simbolus."

#: c-family/c.opt:2518
#, no-c-format
msgid "-fwide-exec-charset=<cset>\tConvert all wide strings and character constants to character set <cset>."
msgstr "-fwide-exec-charset=<cset>\tPārveidot visas platās virknes un rakstzīmju konstantes uz rakstzīmju kopu <cset>."

#: c-family/c.opt:2522
#, no-c-format
msgid "Generate a #line directive pointing at the current working directory."
msgstr "Ģenerēt #line direktīvu, kas norāda uz pašreizējo darba direktoriju."

#: c-family/c.opt:2530
#, no-c-format
msgid "Generate lazy class lookup (via objc_getClass()) for use in Zero-Link mode."
msgstr "Ģenerēt atlikto klašu uzmeklēšanu (ar objc_getClass()) izmantošanai Zero-Link režīmā."

#: c-family/c.opt:2534
#, no-c-format
msgid "Dump declarations to a .decl file."
msgstr "Izmest deklarācijas .decl failā."

#: c-family/c.opt:2538
#, no-c-format
msgid "-femit-struct-debug-baseonly\tAggressive reduced debug info for structs."
msgstr "-femit-struct-debug-baseonly\tAgresīvi samazināta atkļūdošanas informācija struktūrām."

#: c-family/c.opt:2542
#, no-c-format
msgid "-femit-struct-debug-reduced\tConservative reduced debug info for structs."
msgstr "-femit-struct-debug-reduced\tPiesardzīgi samazināta atkļūdošanas informācija struktūrām."

#: c-family/c.opt:2546
#, no-c-format
msgid "-femit-struct-debug-detailed=<spec-list>\tDetailed reduced debug info for structs."
msgstr "-femit-struct-debug-detailed=<spec-list>\tDetalizēta samazināta atkļūdošanas informācija struktūrām."

#: c-family/c.opt:2550
#, no-c-format
msgid "Interpret imaginary, fixed-point, or other gnu number suffix as the corresponding number literal rather than a user-defined number literal."
msgstr "Interpretēt imagināro, fiksētā komata vai citu GNU skaitļa piedēkli kā atbilstošo skaitļa literāli, nevis lietotāja definētu skaitļa literāli."

#: c-family/c.opt:2555
#, no-c-format
msgid "-idirafter <dir>\tAdd <dir> to the end of the system include path."
msgstr "-idirafter <dir>\tPievienot <dir> sistēmas iekļaušanas ceļa beigām."

#: c-family/c.opt:2559
#, no-c-format
msgid "-imacros <file>\tAccept definition of macros in <file>."
msgstr "-imacros <file>\tPieņemt makro definīcijas no faila <file>."

#: c-family/c.opt:2563
#, no-c-format
msgid "-imultilib <dir>\tSet <dir> to be the multilib include subdirectory."
msgstr "-imultilib <dir>\tIestatīt <dir> kā multilib iekļaušanas apakšdirektoriju."

#: c-family/c.opt:2567
#, no-c-format
msgid "-include <file>\tInclude the contents of <file> before other files."
msgstr "-include <file>\tIekļaut faila <file> saturu pirms citiem failiem."

#: c-family/c.opt:2571
#, no-c-format
msgid "-iprefix <path>\tSpecify <path> as a prefix for next two options."
msgstr "-iprefix <path>\tNorādīt <path> kā priedēkli nākamajām divām opcijām."

#: c-family/c.opt:2575
#, no-c-format
msgid "-isysroot <dir>\tSet <dir> to be the system root directory."
msgstr "-isysroot <dir>\tIestatīt <dir> kā sistēmas saknes direktoriju."

#: c-family/c.opt:2579
#, no-c-format
msgid "-isystem <dir>\tAdd <dir> to the start of the system include path."
msgstr "-isystem <dir>\tPievienot <dir> sistēmas iekļaušanas ceļa sākumam."

#: c-family/c.opt:2583
#, no-c-format
msgid "-iquote <dir>\tAdd <dir> to the end of the quote include path."
msgstr "-iquote <dir>\tPievienot <dir> pēdiņu iekļaušanas ceļa beigām."

#: c-family/c.opt:2587
#, no-c-format
msgid "-iwithprefix <dir>\tAdd <dir> to the end of the system include path."
msgstr "-iwithprefix <dir>\tPievienot <dir> sistēmas iekļaušanas ceļa beigām."

#: c-family/c.opt:2591
#, no-c-format
msgid "-iwithprefixbefore <dir>\tAdd <dir> to the end of the main include path."
msgstr "-iwithprefixbefore <dir>\tPievienot <dir> galvenā iekļaušanas ceļa beigām."

#: c-family/c.opt:2601
#, no-c-format
msgid "Do not search standard system include directories (those specified with -isystem will still be used)."
msgstr "Nemeklēt standarta sistēmas iekļaušanas direktorijās (ar -isystem norādītās joprojām tiks izmantotas)."

#: c-family/c.opt:2605
#, no-c-format
msgid "Do not search standard system include directories for C++."
msgstr "Nemeklēt C++ standarta sistēmas iekļaušanas direktorijās."

#: c-family/c.opt:2617
#, no-c-format
msgid "Generate C header of platform-specific features."
msgstr "Ģenerēt C galveni ar platformai specifiskiem līdzekļiem."

#: c-family/c.opt:2621
#, no-c-format
msgid "Remap file names when including files."
msgstr "Iekļaujot failus, pārkartēt failu nosaukumus."

#: c-family/c.opt:2625 c-family/c.opt:2629
#, no-c-format
msgid "Conform to the ISO 1998 C++ standard revised by the 2003 technical corrigendum."
msgstr "Ievērot ISO 1998 C++ standartu, kas pārskatīts ar 2003. gada tehnisko labojumu."

