msgstr "Iespējot dubultās ielādes/saglabāšanas instrukcijas ARC HS."

#: config/arc/arc.opt:442
#, no-c-format
msgid "Specify the name of the target floating point configuration."
msgstr "Norādīt mērķa peldošā komata konfigurācijas nosaukumu."

#: config/arc/arc.opt:485
#, no-c-format
