#, no-c-format
msgid "Generate conditional move instructions."
msgstr "Ģenerēt nosacījuma pārvietošanas instrukcijas."

#: config/nds32/nds32.opt:123
#, no-c-format
msgid "Generate hardware abs instructions."
msgstr "Ģenerēt aparatūras abs instrukcijas."

#: config/nds32/nds32.opt:127
#, no-c-format
msgid "Generate performance extension instructions."
msgstr "Ģenerēt veiktspējas paplašinājuma instrukcijas."

#: config/nds32/nds32.opt:131
#, no-c-format
msgid "Generate performance extension version 2 instructions."
msgstr "Ģenerēt veiktspējas paplašinājuma 2. versijas instrukcijas."

#: config/nds32/nds32.opt:135
#, no-c-format
msgid "Generate string extension instructions."
msgstr "Ģenerēt virkņu paplašinājuma instrukcijas."

#: config/nds32/nds32.opt:139
#, no-c-format
msgid "Generate DSP extension instructions."
msgstr "Ģenerēt DSP paplašinājuma instrukcijas."

#: config/nds32/nds32.opt:143
#, no-c-format
msgid "Generate v3 push25/pop25 instructions."
msgstr "Ģenerēt v3 push25/pop25 instrukcijas."

#: config/nds32/nds32.opt:147
#, no-c-format
msgid "Generate 16-bit instructions."
msgstr "Ģenerēt 16 bitu instrukcijas."

#: config/nds32/nds32.opt:151
#, no-c-format
msgid "Insert relax hint for linker to do relaxation."
msgstr "Ievietot relaksācijas norādes saistītājam, lai tas veiktu relaksāciju."

#: config/nds32/nds32.opt:155
#, no-c-format
msgid "Enable Virtual Hosting support."
msgstr "Iespējot virtuālās mitināšanas atbalstu."

#: config/nds32/nds32.opt:159
#, no-c-format
msgid "Specify the size of each interrupt vector, which must be 4 or 16."
msgstr "Norādīt katra pārtraukumu vektora izmēru; tam jābūt 4 vai 16."

#: config/nds32/nds32.opt:163
#, no-c-format
msgid "Specify the security level of c-isr for the whole file."
msgstr "Norādīt c-isr drošības līmeni visam failam."

#: config/nds32/nds32.opt:167
#, no-c-format
msgid "Specify the size of each cache block, which must be a power of 2 between 4 and 512."
msgstr "Norādīt katra kešatmiņas bloka izmēru; tam jābūt divnieka pakāpei no 4 līdz 512."

#: config/nds32/nds32.opt:171 config/arm/arm.opt:84 config/m68k/m68k.opt:103
#: config/c6x/c6x.opt:67
#, no-c-format
msgid "Specify the name of the target architecture."
msgstr "Norādīt mērķa arhitektūras nosaukumu."

#: config/nds32/nds32.opt:175
#, no-c-format
msgid "Known arch types (for use with the -march= option):"
msgstr "Zināmie arhitektūras tipi (izmantošanai ar opciju -march=):"

#: config/nds32/nds32.opt:197
#, no-c-format
msgid "Specify the cpu for pipeline model."
msgstr "Norādīt CPU konveijera modelim."

#: config/nds32/nds32.opt:201
#, no-c-format
msgid "Known cpu types (for use with the -mcpu= option):"
msgstr "Zināmie CPU tipi (izmantošanai ar opciju -mcpu=):"

#: config/nds32/nds32.opt:361
#, no-c-format
msgid "Specify a FPU configuration value from 0 to 7; 0-3 is as FPU spec says, and 4-7 correspond to 0-3."
msgstr "Norādīt FPU konfigurācijas vērtību no 0 līdz 7; 0-3 atbilst FPU specifikācijai, un 4-7 atbilst 0-3."

#: config/nds32/nds32.opt:365
#, no-c-format
msgid "Known floating-point number of registers (for use with the -mconfig-fpu= option):"
msgstr "Zināmie peldošā komata reģistru skaiti (izmantošanai ar opciju -mconfig-fpu=):"

#: config/nds32/nds32.opt:393
#, no-c-format
msgid "Specify configuration of instruction mul: fast1, fast2 or slow. The default is fast1."
msgstr "Norādīt instrukcijas mul konfigurāciju: fast1, fast2 vai slow. Noklusējums ir fast1."

#: config/nds32/nds32.opt:412
#, no-c-format
msgid "Specify how many read/write ports for n9/n10 cores.  The value should be 3r2w or 2r1w."
msgstr "Norādīt lasīšanas/rakstīšanas portu skaitu n9/n10 kodoliem. Vērtībai jābūt 3r2w vai 2r1w."

#: config/nds32/nds32.opt:425
#, no-c-format
msgid "Enable constructor/destructor feature."
msgstr "Iespējot konstruktora/destruktora funkcionalitāti."

#: config/nds32/nds32.opt:429
#, no-c-format
msgid "Guide linker to relax instructions."
msgstr "Norādīt saistītājam veikt instrukciju relaksāciju."

#: config/nds32/nds32.opt:433
#, no-c-format
msgid "Generate floating-point multiply-accumulation instructions."
msgstr "Ģenerēt peldošā komata reizināšanas-uzkrāšanas instrukcijas."

#: config/nds32/nds32.opt:437
#, no-c-format
msgid "Generate single-precision floating-point instructions."
msgstr "Ģenerēt vienkāršās precizitātes peldošā komata instrukcijas."

#: config/nds32/nds32.opt:441
#, no-c-format
msgid "Generate double-precision floating-point instructions."
msgstr "Ģenerēt dubultās precizitātes peldošā komata instrukcijas."

#: config/nds32/nds32.opt:445
#, no-c-format
msgid "Force disable hardware loop, even use -mext-dsp."
msgstr "Piespiedu kārtā atspējot aparatūras ciklu, pat ja tiek izmantots -mext-dsp."

#: config/nds32/nds32.opt:449
#, no-c-format
msgid "Permit scheduling of a function's prologue and epilogue sequence."
msgstr "Atļaut funkcijas prologa un epiloga secības plānošanu."

#: config/nds32/nds32.opt:453
#, no-c-format
msgid "Generate return instruction in naked function."
msgstr "Ģenerēt atgriešanās instrukciju \"naked\" funkcijā."

#: config/nds32/nds32.opt:457
#, no-c-format
msgid "Always save $lp in the stack."
msgstr "Vienmēr saglabāt $lp stekā."

#: config/nds32/nds32.opt:461 config/arc/arc.opt:500 config/arm/arm.opt:303
#, no-c-format
msgid "Enable unaligned word and halfword accesses to packed data."
msgstr "Iespējot neizlīdzinātu vārdu un pusvārdu piekļuvi pakotiem datiem."

#: config/nds32/nds32.opt:465
#, no-c-format
msgid "Allow use r15 for inline ASM."
msgstr "Atļaut izmantot r15 iekļautajā ASM."

#: config/arc/arc-tables.opt:25
