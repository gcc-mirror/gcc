#, no-c-format
msgid "Compile code for big endian mode."
msgstr "Kompilēt kodu \"big endian\" režīmam."

#: config/arc/arc.opt:32
#, no-c-format
msgid "Compile code for little endian mode.  This is the default."
msgstr "Kompilēt kodu \"little endian\" režīmam. Tas ir noklusējums."

#: config/arc/arc.opt:36
#, no-c-format
msgid "Disable ARCompact specific pass to generate conditional execution instructions."
msgstr "Atspējot ARCompact specifisko gājienu, kas ģenerē nosacītas izpildes instrukcijas."

#: config/arc/arc.opt:40
#, no-c-format
msgid "Generate ARCompact 32-bit code for ARC600 processor."
msgstr "Ģenerēt ARCompact 32 bitu kodu ARC600 procesoram."

#: config/arc/arc.opt:44
#, no-c-format
msgid "Same as -mA6."
msgstr "Tas pats, kas -mA6."

#: config/arc/arc.opt:48
#, no-c-format
msgid "Generate ARCompact 32-bit code for ARC601 processor."
msgstr "Ģenerēt ARCompact 32 bitu kodu ARC601 procesoram."

#: config/arc/arc.opt:52
#, no-c-format
msgid "Generate ARCompact 32-bit code for ARC700 processor."
msgstr "Ģenerēt ARCompact 32 bitu kodu ARC700 procesoram."

#: config/arc/arc.opt:56
#, no-c-format
msgid "Same as -mA7."
msgstr "Tas pats, kas -mA7."

