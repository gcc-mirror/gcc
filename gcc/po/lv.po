#: config/cris/cris.opt:71
#, no-c-format
msgid "Do not use condition codes from normal instructions."
msgstr "Neizmantot nosacījumu kodus no parastajām instrukcijām."

#: config/cris/cris.opt:80
#, no-c-format
msgid "Do not emit addressing modes with side-effect assignment."
msgstr "Neizvadīt adresēšanas režīmus ar blakusefekta piešķiršanu."

#: config/cris/cris.opt:89
#, no-c-format
msgid "Do not tune stack alignment."
msgstr "Nenoskaņot steka izlīdzināšanu."

#: config/cris/cris.opt:98
#, no-c-format
msgid "Do not tune writable data alignment."
msgstr "Nenoskaņot rakstāmo datu izlīdzināšanu."

#: config/cris/cris.opt:107
#, no-c-format
msgid "Do not tune code and read-only data alignment."
msgstr "Nenoskaņot koda un tikai lasāmo datu izlīdzināšanu."

#: config/cris/cris.opt:112 config/cris/cris.opt:117
#, no-c-format
msgid "Align code and data to 32 bits."
msgstr "Izlīdzināt kodu un datus uz 32 bitu robežu."

#: config/cris/cris.opt:122 config/cris/cris.opt:127
#, no-c-format
msgid "Align code and data to 16 bits."
msgstr "Izlīdzināt kodu un datus uz 16 bitu robežu."

#: config/cris/cris.opt:132 config/cris/cris.opt:137
#, no-c-format
msgid "Don't align items in code or data."
msgstr "Neizlīdzināt elementus kodā vai datos."

#: config/cris/cris.opt:146
#, no-c-format
msgid "Do not emit function prologue or epilogue."
msgstr "Neizvadīt funkcijas prologu vai epilogu."

#: config/cris/cris.opt:153
#, no-c-format
msgid "Use the most feature-enabling options allowed by other options."
msgstr "Izmantot opcijas, kas iespējo visvairāk līdzekļu, ciktāl to atļauj citas opcijas."

#: config/cris/cris.opt:162
#, no-c-format
msgid "Override -mbest-lib-options."
msgstr "Atcelt -mbest-lib-options."

#: config/cris/cris.opt:169
#, no-c-format
msgid "-march=ARCH\tGenerate code for the specified chip or CPU version."
msgstr "-march=ARCH\tĢenerēt kodu norādītajai mikroshēmas vai CPU versijai."

#: config/cris/cris.opt:173
#, no-c-format
msgid "-mtune=ARCH\tTune alignment for the specified chip or CPU version."
msgstr "-mtune=ARCH\tNoskaņot izlīdzināšanu norādītajai mikroshēmas vai CPU versijai."

#: config/cris/cris.opt:177
#, no-c-format
msgid "-mmax-stackframe=SIZE\tWarn when a stackframe is larger than the specified size."
msgstr "-mmax-stackframe=SIZE\tBrīdināt, ja steka kadrs ir lielāks par norādīto izmēru."

#: config/cris/cris.opt:184
#, no-c-format
msgid "Emit traps as \"break 8\", default for CRIS v3 and up.  If disabled, calls to abort() are used."
msgstr "Izvadīt slazdus kā \"break 8\" (noklusējums CRIS v3 un jaunākām versijām). Ja tas ir atspējots, tiek izmantoti abort() izsaukumi."

#: config/cris/cris.opt:188
#, no-c-format
msgid "Emit checks causing \"break 8\" instructions to execute when applying atomic builtins on misaligned memory."
msgstr "Izvadīt pārbaudes, kas izraisa \"break 8\" instrukciju izpildi, ja atomārās iebūvētās funkcijas tiek lietotas neizlīdzinātai atmiņai."

#: config/cris/cris.opt:192
#, no-c-format
msgid "Handle atomic builtins that may be applied to unaligned data by calling library functions. Overrides -mtrap-unaligned-atomic."
msgstr "Apstrādāt atomārās iebūvētās funkcijas, ko var lietot neizlīdzinātiem datiem, izsaucot bibliotēkas funkcijas. Atceļ -mtrap-unaligned-atomic."

#: config/msp430/msp430.opt:7
#, no-c-format
msgid "Use a lightweight configuration of printf and puts to reduce code size. For single-threaded applications, not requiring reentrant I/O only. Requires Newlib Nano IO."
msgstr "Izmantot vieglu printf un puts konfigurāciju, lai samazinātu koda izmēru. Tikai vienpavediena lietojumprogrammām, kurām nav nepieciešama reentranta I/O. Nepieciešams Newlib Nano IO."

#: config/msp430/msp430.opt:11
#, no-c-format
msgid "Force assembly output to always use hex constants."
msgstr "Piespiest asemblera izvadei vienmēr izmantot heksadecimālās konstantes."

#: config/msp430/msp430.opt:15
#, no-c-format
msgid "Specify the MCU to build for."
msgstr "Norādīt MCU, kuram būvēt."

#: config/msp430/msp430.opt:19
#, no-c-format
msgid "Warn if an MCU name is unrecognized or conflicts with other options (default: on)."
msgstr "Brīdināt, ja MCU nosaukums nav atpazīts vai konfliktē ar citām opcijām (noklusējums: ieslēgts)."

#: config/msp430/msp430.opt:23
#, no-c-format
msgid "Warn if devices.csv is not found or there are problem parsing it (default: on)."
msgstr "Brīdināt, ja nav atrasts devices.csv vai ir problēmas ar tā parsēšanu (noklusējums: ieslēgts)."

#: config/msp430/msp430.opt:27
#, no-c-format
msgid "Specify the ISA to build for: msp430, msp430x, msp430xv2."
msgstr "Norādīt ISA, kurai būvēt: msp430, msp430x, msp430xv2."

#: config/msp430/msp430.opt:52
#, no-c-format
msgid "Select large model - 20-bit addresses/pointers."
msgstr "Izvēlēties lielo modeli — 20 bitu adreses/rādītāji."

#: config/msp430/msp430.opt:56
#, no-c-format
msgid "Select small model - 16-bit addresses/pointers (default)."
msgstr "Izvēlēties mazo modeli — 16 bitu adreses/rādītāji (noklusējums)."

#: config/msp430/msp430.opt:60
#, no-c-format
msgid "Optimize opcode sizes at link time."
msgstr "Optimizēt opkodu izmērus saistīšanas laikā."

#: config/msp430/msp430.opt:67 config/pru/pru.opt:26
#, no-c-format
msgid "Use a minimum runtime (no static initializers or ctors) for memory-constrained devices."
msgstr "Izmantot minimālu izpildlaiku (bez statiskiem inicializatoriem vai konstruktoriem) ierīcēm ar ierobežotu atmiņu."

#: config/msp430/msp430.opt:74
#, no-c-format
msgid "Specify the type of hardware multiply to support."
msgstr "Norādīt atbalstāmās aparatūras reizināšanas veidu."

#: config/msp430/msp430.opt:96
#, no-c-format
msgid "Specify whether functions should be placed into the lower or upper memory regions, or if they should be shuffled between the regions (either) for best fit (default: lower)."
msgstr "Norādīt, vai funkcijas jāizvieto apakšējā vai augšējā atmiņas apgabalā, vai arī tās jāizkārto starp abiem apgabaliem (either) vislabākajai atbilstībai (noklusējums: lower)."

#: config/msp430/msp430.opt:100
#, no-c-format
msgid "Specify whether variables should be placed into the lower or upper memory regions, or if they should be shuffled between the regions (either) for best fit (default: lower)."
msgstr "Norādīt, vai mainīgie jāizvieto apakšējā vai augšējā atmiņas apgabalā, vai arī tie jāizkārto starp abiem apgabaliem (either) vislabākajai atbilstībai (noklusējums: lower)."

#: config/msp430/msp430.opt:104
#, no-c-format
msgid "Add the .lower prefix to section names when compiling with -m{code,data}-region=lower (disabled by default)."
msgstr "Pievienot .lower priedēkli sekciju nosaukumiem, kompilējot ar -m{code,data}-region=lower (pēc noklusējuma atspējots)."

#: config/msp430/msp430.opt:123
#, no-c-format
msgid "Passes on a request to the assembler to enable fixes for various silicon errata."
msgstr "Nodot asemblerim pieprasījumu iespējot dažādu silīcija kļūdu (errata) labojumus."

#: config/msp430/msp430.opt:127
#, no-c-format
msgid "Passes on a request to the assembler to warn about various silicon errata."
msgstr "Nodot asemblerim pieprasījumu brīdināt par dažādām silīcija kļūdām (errata)."

#: config/msp430/msp430.opt:131
#, no-c-format
msgid "The path to devices.csv.  The GCC driver can normally locate devices.csv itself and pass this option to the compiler, so the user shouldn't need to pass this."
msgstr "Ceļš uz devices.csv. GCC draiveris parasti pats spēj atrast devices.csv un nodot šo opciju kompilatoram, tāpēc lietotājam to parasti nav jānorāda."

#: config/msp430/msp430.opt:136
#, no-c-format
msgid "For shift operations by a constant amount, which require an individual instruction to shift by one position, set the maximum number of inline shift instructions (maximum value 64) to emit instead of using the corresponding __mspabi helper function. The default value is 4."
msgstr "Bīdes operācijām par konstantu apjomu, kurām katrai bīdei par vienu pozīciju nepieciešama atsevišķa instrukcija, iestatīt maksimālo izvadāmo iekļauto bīdes instrukciju skaitu (maksimālā vērtība 64), pirms tiek izmantota atbilstošā __mspabi palīgfunkcija. Noklusējuma vērtība ir 4."

#: config/frv/frv.opt:30
#, no-c-format
msgid "Use 4 media accumulators."
msgstr "Izmantot 4 multivides akumulatorus."

#: config/frv/frv.opt:34
#, no-c-format
msgid "Use 8 media accumulators."
msgstr "Izmantot 8 multivides akumulatorus."

#: config/frv/frv.opt:38
#, no-c-format
msgid "Enable label alignment optimizations."
msgstr "Iespējot etiķešu izlīdzināšanas optimizācijas."

#: config/frv/frv.opt:42
#, no-c-format
msgid "Dynamically allocate cc registers."
msgstr "Dinamiski piešķirt cc reģistrus."

#: config/frv/frv.opt:49
#, no-c-format
msgid "Set the cost of branches."
msgstr "Iestatīt zarošanās izmaksas."

#: config/frv/frv.opt:53
#, no-c-format
msgid "Enable conditional execution other than moves/scc."
msgstr "Iespējot nosacītu izpildi, kas nav pārvietošana/scc."

#: config/frv/frv.opt:57
#, no-c-format
msgid "Change the maximum length of conditionally-executed sequences."
msgstr "Mainīt nosacīti izpildāmo secību maksimālo garumu."

#: config/frv/frv.opt:61
#, no-c-format
msgid "Change the number of temporary registers that are available to conditionally-executed sequences."
msgstr "Mainīt pagaidu reģistru skaitu, kas pieejams nosacīti izpildāmām secībām."

#: config/frv/frv.opt:65
#, no-c-format
msgid "Enable conditional moves."
msgstr "Iespējot nosacītās pārvietošanas."

#: config/frv/frv.opt:69
#, no-c-format
msgid "Set the target CPU type."
msgstr "Iestatīt mērķa CPU tipu."

#: config/frv/frv.opt:73
#, no-c-format
msgid "Known FR-V CPUs (for use with the -mcpu= option):"
msgstr "Zināmie FR-V CPU (izmantošanai ar opciju -mcpu=):"

#: config/frv/frv.opt:122
#, no-c-format
msgid "Use fp double instructions."
msgstr "Izmantot fp double instrukcijas."

#: config/frv/frv.opt:126
#, no-c-format
msgid "Change the ABI to allow double word insns."
msgstr "Mainīt ABI, lai atļautu dubultvārdu insn."

#: config/frv/frv.opt:134
#, no-c-format
msgid "Just use icc0/fcc0."
msgstr "Izmantot tikai icc0/fcc0."

#: config/frv/frv.opt:138
#, no-c-format
msgid "Only use 32 FPRs."
msgstr "Izmantot tikai 32 FPR."

#: config/frv/frv.opt:142
#, no-c-format
msgid "Use 64 FPRs."
msgstr "Izmantot 64 FPR."

#: config/frv/frv.opt:146
#, no-c-format
msgid "Only use 32 GPRs."
msgstr "Izmantot tikai 32 GPR."

#: config/frv/frv.opt:150
#, no-c-format
msgid "Use 64 GPRs."
msgstr "Izmantot 64 GPR."

#: config/frv/frv.opt:154
#, no-c-format
msgid "Enable use of GPREL for read-only data in FDPIC."
msgstr "Iespējot GPREL izmantošanu tikai lasāmiem datiem FDPIC."

#: config/frv/frv.opt:166
#, no-c-format
msgid "Enable PIC support for building libraries."
msgstr "Iespējot PIC atbalstu bibliotēku būvēšanai."

#: config/frv/frv.opt:170
#, no-c-format
msgid "Follow the EABI linkage requirements."
msgstr "Ievērot EABI saistīšanas prasības."

#: config/frv/frv.opt:174
#, no-c-format
msgid "Disallow direct calls to global functions."
msgstr "Aizliegt tiešus globālo funkciju izsaukumus."

#: config/frv/frv.opt:178
#, no-c-format
msgid "Use media instructions."
msgstr "Izmantot multivides instrukcijas."

#: config/frv/frv.opt:182
#, no-c-format
msgid "Use multiply add/subtract instructions."
msgstr "Izmantot reizināšanas-saskaitīšanas/atņemšanas instrukcijas."

#: config/frv/frv.opt:186
#, no-c-format
msgid "Enable optimizing &&/|| in conditional execution."
msgstr "Iespējot &&/|| optimizāciju nosacītajā izpildē."

#: config/frv/frv.opt:190
#, no-c-format
msgid "Enable nested conditional execution optimizations."
msgstr "Iespējot ligzdotas nosacītās izpildes optimizācijas."

#: config/frv/frv.opt:195
#, no-c-format
msgid "Do not mark ABI switches in e_flags."
msgstr "Neatzīmēt ABI slēdžus laukā e_flags."

#: config/frv/frv.opt:199
#, no-c-format
msgid "Remove redundant membars."
msgstr "Noņemt liekās atmiņas barjeras (membar)."

#: config/frv/frv.opt:203
#, no-c-format
msgid "Pack VLIW instructions."
msgstr "Pakot VLIW instrukcijas."

#: config/frv/frv.opt:207
#, no-c-format
msgid "Enable setting GPRs to the result of comparisons."
msgstr "Iespējot GPR iestatīšanu uz salīdzinājumu rezultātu."

#: config/frv/frv.opt:212
#, no-c-format
msgid "Change the amount of scheduler lookahead."
msgstr "Mainīt plānotāja apskates uz priekšu (lookahead) apjomu."

#: config/frv/frv.opt:220
#, no-c-format
msgid "Assume a large TLS segment."
msgstr "Pieņemt lielu TLS segmentu."

#: config/frv/frv.opt:224
#, no-c-format
msgid "Do not assume a large TLS segment."
msgstr "Nepieņemt lielu TLS segmentu."

#: config/frv/frv.opt:229
#, no-c-format
msgid "Cause gas to print tomcat statistics."
msgstr "Likt gas izdrukāt tomcat statistiku."

#: config/frv/frv.opt:234
#, no-c-format
msgid "Link with the library-pic libraries."
msgstr "Saistīt ar library-pic bibliotēkām."

#: config/frv/frv.opt:238
#, no-c-format
msgid "Allow branches to be packed with other instructions."
msgstr "Atļaut zarošanās instrukcijas pakot kopā ar citām instrukcijām."

#: config/mmix/mmix.opt:24
#, no-c-format
msgid "For intrinsics library: pass all parameters in registers."
msgstr "Iekšējo funkciju bibliotēkai: visus parametrus nodot reģistros."

#: config/mmix/mmix.opt:28
#, no-c-format
msgid "Use register stack for parameters and return value."
msgstr "Parametriem un atgriešanas vērtībai izmantot reģistru steku."

#: config/mmix/mmix.opt:32
#, no-c-format
msgid "Use call-clobbered registers for parameters and return value."
msgstr "Parametriem un atgriešanas vērtībai izmantot izsaukumā pārrakstāmos (call-clobbered) reģistrus."

#: config/mmix/mmix.opt:37
#, no-c-format
msgid "Use epsilon-respecting floating point compare instructions."
msgstr "Izmantot epsilonu respektējošas peldošā komata salīdzināšanas instrukcijas."

#: config/mmix/mmix.opt:41
#, no-c-format
msgid "Use zero-extending memory loads, not sign-extending ones."
msgstr "Izmantot atmiņas ielādes ar nulles paplašināšanu, nevis ar zīmes paplašināšanu."

#: config/mmix/mmix.opt:45
#, no-c-format
msgid "Generate divide results with reminder having the same sign as the divisor (not the dividend)."
msgstr "Ģenerēt dalīšanas rezultātus tā, lai atlikumam būtu tāda pati zīme kā dalītājam (nevis dalāmajam)."

#: config/mmix/mmix.opt:49
#, no-c-format
msgid "Prepend global symbols with \":\" (for use with PREFIX)."
msgstr "Pievienot globālajiem simboliem priedēkli \":\" (izmantošanai ar PREFIX)."

#: config/mmix/mmix.opt:53
#, no-c-format
msgid "Do not provide a default start-address 0x100 of the program."
msgstr "Nenodrošināt programmas noklusējuma sākuma adresi 0x100."

#: config/mmix/mmix.opt:57
#, no-c-format
msgid "Link to emit program in ELF format (rather than mmo)."
msgstr "Saistīt tā, lai programma tiktu izvadīta ELF formātā (nevis mmo)."

#: config/mmix/mmix.opt:61
#, no-c-format
msgid "Use P-mnemonics for branches statically predicted as taken."
msgstr "Izmantot P-mnemonikas zarošanās instrukcijām, kas statiski prognozētas kā izpildāmas."

#: config/mmix/mmix.opt:65
#, no-c-format
msgid "Don't use P-mnemonics for branches."
msgstr "Neizmantot P-mnemonikas zarošanās instrukcijām."

#: config/mmix/mmix.opt:79
#, no-c-format
msgid "Use addresses that allocate global registers."
msgstr "Izmantot adreses, kas piešķir globālos reģistrus."

#: config/mmix/mmix.opt:83
#, no-c-format
msgid "Do not use addresses that allocate global registers."
msgstr "Neizmantot adreses, kas piešķir globālos reģistrus."

#: config/mmix/mmix.opt:87
#, no-c-format
msgid "Generate a single exit point for each function."
msgstr "Ģenerēt vienu izejas punktu katrai funkcijai."

#: config/mmix/mmix.opt:91
#, no-c-format
msgid "Do not generate a single exit point for each function."
msgstr "Neģenerēt vienu izejas punktu katrai funkcijai."

#: config/mmix/mmix.opt:95
#, no-c-format
msgid "Set start-address of the program."
msgstr "Iestatīt programmas sākuma adresi."

#: config/mmix/mmix.opt:99
#, no-c-format
msgid "Set start-address of data."
msgstr "Iestatīt datu sākuma adresi."

#: config/sparc/sparc.opt:42
#, no-c-format
msgid "Use flat register window model."
msgstr "Izmantot plakano reģistru logu modeli."

#: config/sparc/sparc.opt:46
#, no-c-format
msgid "Assume possible double misalignment."
msgstr "Pieņemt iespējamu double neizlīdzinājumu."

#: config/sparc/sparc.opt:50
#, no-c-format
msgid "Use ABI reserved registers."
msgstr "Izmantot ABI rezervētos reģistrus."

#: config/sparc/sparc.opt:54
#, no-c-format
msgid "Use hardware quad FP instructions."
msgstr "Izmantot aparatūras četrkāršās precizitātes FP instrukcijas."

#: config/sparc/sparc.opt:58
#, no-c-format
msgid "Do not use hardware quad fp instructions."
msgstr "Neizmantot aparatūras četrkāršās precizitātes FP instrukcijas."

#: config/sparc/sparc.opt:62
#, no-c-format
msgid "Compile for V8+ ABI."
msgstr "Kompilēt V8+ ABI."

#: config/sparc/sparc.opt:66
#, no-c-format
msgid "Use UltraSPARC Visual Instruction Set version 1.0 extensions."
msgstr "Izmantot UltraSPARC Visual Instruction Set 1.0 versijas paplašinājumus."

#: config/sparc/sparc.opt:70
#, no-c-format
msgid "Use UltraSPARC Visual Instruction Set version 2.0 extensions."
msgstr "Izmantot UltraSPARC Visual Instruction Set 2.0 versijas paplašinājumus."

#: config/sparc/sparc.opt:74
#, no-c-format
msgid "Use UltraSPARC Visual Instruction Set version 3.0 extensions."
msgstr "Izmantot UltraSPARC Visual Instruction Set 3.0 versijas paplašinājumus."

#: config/sparc/sparc.opt:78
#, no-c-format
msgid "Use additional VIS 3 instructions introduced in OSA2011."
msgstr "Izmantot papildu VIS 3 instrukcijas, kas ieviestas OSA2011."

#: config/sparc/sparc.opt:82
#, no-c-format
msgid "Use UltraSPARC Visual Instruction Set version 4.0 extensions."
msgstr "Izmantot UltraSPARC Visual Instruction Set 4.0 versijas paplašinājumus."

#: config/sparc/sparc.opt:86
#, no-c-format
msgid "Use additional VIS 4 instructions introduced in OSA2017."
msgstr "Izmantot papildu VIS 4 instrukcijas, kas ieviestas OSA2017."

#: config/sparc/sparc.opt:90
#, no-c-format
msgid "Use UltraSPARC Compare-and-Branch extensions."
msgstr "Izmantot UltraSPARC Compare-and-Branch paplašinājumus."

#: config/sparc/sparc.opt:94
#, no-c-format
msgid "Use UltraSPARC Fused Multiply-Add extensions."
msgstr "Izmantot UltraSPARC Fused Multiply-Add paplašinājumus."

#: config/sparc/sparc.opt:98
#, no-c-format
msgid "Use Floating-point Multiply Single to Double (FsMULd) instruction."
msgstr "Izmantot peldošā komata reizināšanas no vienkāršās uz dubulto precizitāti (FsMULd) instrukciju."

#: config/sparc/sparc.opt:102
#, no-c-format
msgid "Use UltraSPARC Population-Count instruction."
msgstr "Izmantot UltraSPARC Population-Count instrukciju."

#: config/sparc/sparc.opt:106
#, no-c-format
msgid "Use UltraSPARC Subtract-Extended-with-Carry instruction."
msgstr "Izmantot UltraSPARC Subtract-Extended-with-Carry instrukciju."

#: config/sparc/sparc.opt:110
#, no-c-format
msgid "Pointers are 64-bit."
msgstr "Rādītāji ir 64 bitu."

#: config/sparc/sparc.opt:114
#, no-c-format
msgid "Pointers are 32-bit."
msgstr "Rādītāji ir 32 bitu."

#: config/sparc/sparc.opt:118
#, no-c-format
msgid "Use 64-bit ABI."
msgstr "Izmantot 64 bitu ABI."

#: config/sparc/sparc.opt:122
#, no-c-format
msgid "Use 32-bit ABI."
msgstr "Izmantot 32 bitu ABI."

#: config/sparc/sparc.opt:126
#, no-c-format
msgid "Use stack bias."
msgstr "Izmantot steka nobīdi (stack bias)."

#: config/sparc/sparc.opt:130
#, no-c-format
msgid "Use structs on stronger alignment for double-word copies."
msgstr "Dubultvārdu kopijām izmantot struktūras ar stingrāku izlīdzinājumu."

#: config/sparc/sparc.opt:134
#, no-c-format
msgid "Optimize tail call instructions in assembler and linker."
msgstr "Optimizēt astes izsaukumu instrukcijas asemblerī un saistītājā."

#: config/sparc/sparc.opt:138
#, no-c-format
msgid "Do not generate code that can only run in supervisor mode (default)."
msgstr "Neģenerēt kodu, ko var izpildīt tikai supervizora režīmā (noklusējums)."

#: config/sparc/sparc.opt:142
#, no-c-format
msgid "Use instructions of and schedule code for given CPU."
msgstr "Izmantot norādītā CPU instrukcijas un plānot kodu tam."

#: config/sparc/sparc.opt:228
#, no-c-format
msgid "Use given SPARC-V9 code model."
msgstr "Izmantot norādīto SPARC-V9 koda modeli."

#: config/sparc/sparc.opt:250
#, no-c-format
msgid "Enable debug output."
msgstr "Iespējot atkļūdošanas izvadi."

#: config/sparc/sparc.opt:254
#, no-c-format
