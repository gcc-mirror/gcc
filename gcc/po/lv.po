#, no-c-format
msgid "FPX: Enable Argonaut ARC CPU Double Precision Floating Point extensions."
msgstr "FPX: Iespējot Argonaut ARC CPU dubultās precizitātes peldošā komata paplašinājumus."

#: config/arc/arc.opt:217 config/arc/arc.opt:221
#, no-c-format
msgid "FPX: Generate Double Precision FPX (compact) instructions."
msgstr "FPX: Ģenerēt dubultās precizitātes FPX (kompaktās) instrukcijas."

#: config/arc/arc.opt:225
#, no-c-format
msgid "FPX: Generate Double Precision FPX (fast) instructions."
msgstr "FPX: Ģenerēt dubultās precizitātes FPX (ātrās) instrukcijas."

#: config/arc/arc.opt:229
#, no-c-format
msgid "Enable LR and SR instructions to use FPX extension aux registers."
msgstr "Iespējot LR un SR instrukcijām izmantot FPX paplašinājuma palīgreģistrus."

#: config/arc/arc.opt:233
#, no-c-format
msgid "Enable generation of ARC SIMD instructions via target-specific builtins."
msgstr "Iespējot ARC SIMD instrukciju ģenerēšanu, izmantojot mērķim specifiskas iebūvētās funkcijas."

#: config/arc/arc.opt:237
#, no-c-format
msgid "-mcpu=CPU\tCompile code for ARC variant CPU."
msgstr "-mcpu=CPU\tKompilēt kodu ARC variantam CPU."

#: config/arc/arc.opt:241
#, no-c-format
msgid "Size optimization level: 0:none 1:opportunistic 2: regalloc 3:drop align, -Os."
msgstr "Izmēra optimizācijas līmenis: 0:nav 1:oportūnistisks 2: reģistru piešķiršana 3:atmest izlīdzināšanu, -Os."

#: config/arc/arc.opt:245 config/sh/sh.opt:243
#, no-c-format
msgid "Annotate assembler instructions with estimated addresses."
msgstr "Anotēt asemblera instrukcijas ar aptuvenajām adresēm."

#: config/arc/arc.opt:249
#, no-c-format
msgid "Cost to assume for a multiply instruction, with 4 being equal to a normal insn."
msgstr "Pieņemtās reizināšanas instrukcijas izmaksas, kur 4 atbilst parastai insn."

#: config/arc/arc.opt:253
