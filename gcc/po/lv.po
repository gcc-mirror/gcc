msgid "Deprecated in favor of -std=gnu11."
msgstr "Novecojis; tā vietā izmantojiet -std=gnu11."

#: c-family/c.opt:2791 c-family/c.opt:2795
#, no-c-format
msgid "Conform to the ISO 2017 C standard (published in 2018) with GNU extensions."
msgstr "Ievērot ISO 2017 C standartu (publicēts 2018. gadā) ar GNU paplašinājumiem."

#: c-family/c.opt:2799
#, no-c-format
msgid "Conform to the ISO 2023 C standard (published in 2024) with GNU extensions."
msgstr "Ievērot ISO 2023 C standartu (publicēts 2024. gadā) ar GNU paplašinājumiem."

#: c-family/c.opt:2803
#, no-c-format
msgid "Deprecated in favor of -std=gnu23."
msgstr "Novecojis; tā vietā izmantojiet -std=gnu23."

#: c-family/c.opt:2807
#, no-c-format
msgid "Conform to the ISO 202Y C standard draft with GNU extensions (experimental and incomplete support)."
msgstr "Ievērot ISO 202Y C standarta projektu ar GNU paplašinājumiem (eksperimentāls un nepilnīgs atbalsts)."

#: c-family/c.opt:2811 c-family/c.opt:2815
#, no-c-format
msgid "Conform to the ISO 1990 C standard with GNU extensions."
msgstr "Ievērot ISO 1990 C standartu ar GNU paplašinājumiem."

#: c-family/c.opt:2819
#, no-c-format
msgid "Conform to the ISO 1999 C standard with GNU extensions."
msgstr "Ievērot ISO 1999 C standartu ar GNU paplašinājumiem."

#: c-family/c.opt:2823
#, no-c-format
msgid "Deprecated in favor of -std=gnu99."
msgstr "Novecojis; tā vietā izmantojiet -std=gnu99."

#: c-family/c.opt:2831
#, no-c-format
msgid "Conform to the ISO 1990 C standard as amended in 1994."
msgstr "Ievērot ISO 1990 C standartu ar 1994. gada grozījumiem."

#: c-family/c.opt:2839
#, no-c-format
msgid "Deprecated in favor of -std=iso9899:1999."
msgstr "Novecojis; tā vietā izmantojiet -std=iso9899:1999."

#: c-family/c.opt:2859
#, no-c-format
msgid "-stdlib=[libstdc++|libc++]\tThe standard library to be used for C++ headers and runtime."
msgstr "-stdlib=[libstdc++|libc++]\tStandarta bibliotēka, kas jāizmanto C++ galvenēm un izpildlaikam."

#: c-family/c.opt:2876
#, no-c-format
msgid "Enable traditional preprocessing."
msgstr "Iespējot tradicionālo priekšapstrādi."

#: c-family/c.opt:2880
#, no-c-format
msgid "-trigraphs\tSupport ISO C trigraphs."
msgstr "-trigraphs\tAtbalstīt ISO C trigrāfus."

#: c-family/c.opt:2884
#, no-c-format
msgid "Do not predefine system-specific and GCC-specific macros."
msgstr "Iepriekš nedefinēt sistēmai specifiskus un GCC specifiskus makro."

#: cobol/lang.opt:48
#, no-c-format
msgid "Accept COBOL constructs used by non-ISO compilers."
msgstr "Pieņemt COBOL konstrukcijas, ko izmanto ne-ISO kompilatori."

#: cobol/lang.opt:70
#, no-c-format
msgid "-fcobol-exceptions=<n>\tEnable some exceptions by default."
msgstr "-fcobol-exceptions=<n>\tPēc noklusējuma iespējot dažus izņēmumus."

#: cobol/lang.opt:74
#, no-c-format
msgid "Define alternative implicit copybook filename extension."
msgstr "Definēt alternatīvu netiešo copybook faila nosaukuma paplašinājumu."

#: cobol/lang.opt:82
#, no-c-format
msgid "Set the default execution character set for NATIONAL data items."
msgstr "Iestatīt noklusējuma izpildes rakstzīmju kopu NATIONAL datu elementiem."

#: cobol/lang.opt:89
#, no-c-format
msgid "Warn if CDF defines Level 78 constant."
msgstr "Brīdināt, ja CDF definē 78. līmeņa konstanti."

#: cobol/lang.opt:94
#, no-c-format
msgid "Warn if BINARY-LONG-LONG is used."
msgstr "Brīdināt, ja tiek izmantots BINARY-LONG-LONG."

#: cobol/lang.opt:99
#, no-c-format
msgid "Warn if CALL ... GIVING is used."
msgstr "Brīdināt, ja tiek izmantots CALL ... GIVING."

#: cobol/lang.opt:104
#, no-c-format
msgid "Warn if CALL is used is used with a literal parameter by reference."
msgstr "Brīdināt, ja CALL tiek izmantots ar literāļa parametru pēc atsauces."

#: cobol/lang.opt:109
#, no-c-format
msgid "Warn if CDF %<$IF%> is used."
msgstr "Brīdināt, ja tiek izmantots CDF %<$IF%>."

#: cobol/lang.opt:114
#, no-c-format
msgid "Warn if COMPUTATIONAL-6 is used."
msgstr "Brīdināt, ja tiek izmantots COMPUTATIONAL-6."

#: cobol/lang.opt:119
#, no-c-format
msgid "Warn if COMPUTATIONAL is used with PICTURE X."
msgstr "Brīdināt, ja COMPUTATIONAL tiek izmantots ar PICTURE X."

#: cobol/lang.opt:124
#, no-c-format
msgid "Warn if INSPECT ... TRAILING is used."
msgstr "Brīdināt, ja tiek izmantots INSPECT ... TRAILING."

#: cobol/lang.opt:129
#, no-c-format
msgid "Warn if Level 01 is used with OCCURS."
msgstr "Brīdināt, ja 01. līmenis tiek izmantots ar OCCURS."

#: cobol/lang.opt:134
#, no-c-format
msgid "Warn if Level 78 is used."
msgstr "Brīdināt, ja tiek izmantots 78. līmenis."

#: cobol/lang.opt:139
#, no-c-format
msgid "Warn if ANY LENGTH is used in outermost program."
msgstr "Brīdināt, ja ārējā programmā tiek izmantots ANY LENGTH."

#: cobol/lang.opt:144
#, no-c-format
msgid "Warn if MOVE INDEX is used."
msgstr "Brīdināt, ja tiek izmantots MOVE INDEX."

#: cobol/lang.opt:149
#, no-c-format
msgid "Warn if MOVE POINTER is used."
msgstr "Brīdināt, ja tiek izmantots MOVE POINTER."

#: cobol/lang.opt:154
#, no-c-format
msgid "Warn if RETURNING <number> is used."
msgstr "Brīdināt, ja tiek izmantots RETURNING <number>."

#: cobol/lang.opt:159
#, no-c-format
msgid "Warn if USAGE IS TYPENAME is used."
msgstr "Brīdināt, ja tiek izmantots USAGE IS TYPENAME."

#: cobol/lang.opt:164
#, no-c-format
msgid "Warn if numeric string is invalid."
msgstr "Brīdināt, ja skaitliskā virkne nav derīga."

#: cobol/lang.opt:169
#, no-c-format
msgid "Warn if referenced CDF PARAMETER is not defined."
msgstr "Brīdināt, ja atsauktais CDF PARAMETER nav definēts."

#: cobol/lang.opt:174
#, no-c-format
msgid "Warn if referenced CDF name is not defined."
msgstr "Brīdināt, ja atsauktais CDF nosaukums nav definēts."

#: cobol/lang.opt:179
#, no-c-format
msgid "Print message when copybook is processed."
msgstr "Izdrukāt ziņojumu, kad tiek apstrādāts copybook."

#: cobol/lang.opt:184
#, no-c-format
msgid "Warn if unimplemented/unknown exception condition is referenced."
msgstr "Brīdināt, ja tiek atsaukts neieviests/nezināms izņēmuma nosacījums."

#: cobol/lang.opt:189
#, no-c-format
msgid "Print message when ENTRY CONVENTION is specified."
msgstr "Izdrukāt ziņojumu, kad ir norādīta ENTRY CONVENTION."

#: cobol/lang.opt:194
#, no-c-format
msgid "Print message when include file is processed."
msgstr "Izdrukāt ziņojumu, kad tiek apstrādāts iekļaujamais fails."

#: cobol/lang.opt:199
#, no-c-format
msgid "Warn if concatenated literals use different encodings."
msgstr "Brīdināt, ja savienotie literāļi izmanto atšķirīgus kodējumus."

#: cobol/lang.opt:204
#, no-c-format
msgid "Warn if locale(3) fails."
msgstr "Brīdināt, ja locale(3) neizdodas."

#: cobol/lang.opt:209
#, no-c-format
msgid "Warn if COBOL MOVE has no corresponding fields."
msgstr "Brīdināt, ja COBOL MOVE nav atbilstošu lauku."

#: cobol/lang.opt:214
#, no-c-format
msgid "Warn if nlanglanginfo(3) fails."
msgstr "Brīdināt, ja nlanglanginfo(3) neizdodas."

#: cobol/lang.opt:219
#, no-c-format
msgid "Warn if LENGTH OF is used."
msgstr "Brīdināt, ja tiek izmantots LENGTH OF."

#: cobol/lang.opt:224
#, no-c-format
msgid "Warn if PROCEDURE POINTER is used."
msgstr "Brīdināt, ja tiek izmantots PROCEDURE POINTER."

#: cobol/lang.opt:229
#, no-c-format
msgid "Warn if SECTION segments are used."
msgstr "Brīdināt, ja tiek izmantoti SECTION segmenti."

#: cobol/lang.opt:234
#, no-c-format
msgid "Warn if resume is used (instead of error for IBM)."
msgstr "Brīdināt, ja tiek izmantots resume (IBM gadījumā kļūdas vietā)."

#: cobol/lang.opt:241
#, no-c-format
msgid "Warn if APPLY COMMIT is used."
msgstr "Brīdināt, ja tiek izmantots APPLY COMMIT."

#: cobol/lang.opt:246
#, no-c-format
msgid "Warn if HIGH-ORDER-LEFT HIGH-ORDER-RIGHT is used."
msgstr "Brīdināt, ja tiek izmantots HIGH-ORDER-LEFT HIGH-ORDER-RIGHT."

#: cobol/lang.opt:251
#, no-c-format
msgid "Warn if FILE CODE SET is used."
msgstr "Brīdināt, ja tiek izmantots FILE CODE SET."

#: cobol/lang.opt:256
#, no-c-format
msgid "Warn if RECORDING MODE is used."
msgstr "Brīdināt, ja tiek izmantots RECORDING MODE."

#: cobol/lang.opt:261
#, no-c-format
msgid "Warn if SET LOCALE ... TO is used."
msgstr "Brīdināt, ja tiek izmantots SET LOCALE ... TO."

#: cobol/lang.opt:266
#, no-c-format
msgid "Warn if SET ... TO LOCALE is used."
msgstr "Brīdināt, ja tiek izmantots SET ... TO LOCALE."

#: cobol/lang.opt:273
#, no-c-format
msgid "Warn if a line directive is malformed (instead of error)."
msgstr "Brīdināt, ja rindas direktīva ir nekorekta (kļūdas vietā)."

#: cobol/lang.opt:278
#, no-c-format
msgid "Warn if EQUAL used as assignment operator (instead of error)."
msgstr "Brīdināt, ja EQUAL tiek izmantots kā piešķiršanas operators (kļūdas vietā)."

#: cobol/lang.opt:283
#, no-c-format
msgid "Warn if iconv(3) cannot convert between encodings (instead of error)."
msgstr "Brīdināt, ja iconv(3) nevar pārveidot starp kodējumiem (kļūdas vietā)."

#: cobol/lang.opt:288
#, no-c-format
msgid "Warn if include file is not found (instead of error)."
msgstr "Brīdināt, ja iekļaujamais fails nav atrasts (kļūdas vietā)."

#: cobol/lang.opt:293
#, no-c-format
msgid "Warn if a preprocessor fails (instead of error)."
msgstr "Brīdināt, ja priekšprocesors neizdodas (kļūdas vietā)."

#: cobol/lang.opt:298
#, no-c-format
msgid "Warn if a referenced procedure is not found (instead of error)."
msgstr "Brīdināt, ja atsauktā procedūra nav atrasta (kļūdas vietā)."

#: cobol/lang.opt:303
#, no-c-format
msgid "Warn if REPLACE cannot be processed (instead of error)."
msgstr "Brīdināt, ja REPLACE nevar apstrādāt (kļūdas vietā)."

#: cobol/lang.opt:308
#, no-c-format
msgid "Warn if a SEGMENT section is invalid (instead of error)."
msgstr "Brīdināt, ja SEGMENT sekcija ir nederīga (kļūdas vietā)."

#: cobol/lang.opt:313
#, no-c-format
msgid "Warn if a SEGMENT range is negative (instead of error)."
msgstr "Brīdināt, ja SEGMENT diapazons ir negatīvs (kļūdas vietā)."

#: cobol/lang.opt:318
#, no-c-format
msgid "Warn if indicator column has no recognized meaning (instead of error)."
msgstr "Brīdināt, ja indikatora kolonnai nav atpazīstamas nozīmes (kļūdas vietā)."

#: cobol/lang.opt:323
#, no-c-format
msgid "Warn if relational operator not followed by space (instead of error)."
msgstr "Brīdināt, ja relāciju operatoram neseko atstarpe (kļūdas vietā)."

#: cobol/lang.opt:328
#, no-c-format
msgid "Warn if IBM-style EJECT is used (instead of error)."
msgstr "Brīdināt, ja tiek izmantots IBM stila EJECT (kļūdas vietā)."

#: cobol/lang.opt:333
#, no-c-format
msgid "Warn if IBM-style STOP <number> is used (instead of error)."
msgstr "Brīdināt, ja tiek izmantots IBM stila STOP <number> (kļūdas vietā)."

#: cobol/lang.opt:338
#, no-c-format
msgid "Warn if VOLATILE is used (instead of error if -dialect ibm)."
msgstr "Brīdināt, ja tiek izmantots VOLATILE (kļūdas vietā, ja -dialect ibm)."

#: cobol/lang.opt:344
#, no-c-format
msgid "Set Working-Storage data items to the supplied value."
msgstr "Iestatīt Working-Storage datu elementus uz norādīto vērtību."

#: cobol/lang.opt:348
#, no-c-format
msgid "Enable Cobol lex debugging."
msgstr "Iespējot Cobol leksiskās analīzes atkļūdošanu."

#: cobol/lang.opt:360
#, no-c-format
msgid "-findicator-column=<n>\tColumn after which Region A begins."
msgstr "-findicator-column=<n>\tKolonna, pēc kuras sākas Region A."

#: cobol/lang.opt:364
#, no-c-format
msgid "Enable/disable static linkage for CALL literals."
msgstr "Iespējot/atspējot statisko saistīšanu CALL literāļiem."

#: cobol/lang.opt:368
#, no-c-format
msgid "Enable Cobol parser debugging."
msgstr "Iespējot Cobol parsētāja atkļūdošanu."

#: cobol/lang.opt:372
#, no-c-format
msgid "Enable Cobol yacc debugging."
msgstr "Iespējot Cobol yacc atkļūdošanu."

#: cobol/lang.opt:376
#, no-c-format
msgid "Preprocess <source_filter> before compiling."
msgstr "Pirms kompilēšanas priekšapstrādāt <source_filter>."

#: cobol/lang.opt:396
#, no-c-format
msgid "-main\tThe first program-id in the next source file is called by a generated main() entry point."
msgstr "-main\tPirmais program-id nākamajā pirmkoda failā tiek izsaukts no ģenerēta main() ieejas punkta."

#: cobol/lang.opt:400
#, no-c-format
msgid "-main=<source_file> source_file/PROGRAM-ID is called by the generated main()."
msgstr "-main=<source_file> source_file/PROGRAM-ID tiek izsaukts no ģenerētā main()."

#: cobol/lang.opt:404
#, no-c-format
msgid "-nomain\tNo main() function is created from COBOL source files."
msgstr "-nomain\tNo COBOL pirmkoda failiem netiek izveidota main() funkcija."

#: d/lang.opt:51
#, no-c-format
msgid "-Hd <dir>\tWrite D interface files to directory <dir>."
msgstr "-Hd <dir>\tRakstīt D saskarnes failus direktorijā <dir>."

#: d/lang.opt:55
#, no-c-format
msgid "-Hf <file>\tWrite D interface to <file>."
msgstr "-Hf <file>\tRakstīt D saskarni failā <file>."

#: d/lang.opt:127
#, no-c-format
msgid "Warn about casts that will produce a null result."
msgstr "Brīdināt par tipu pārveidošanu, kas dos null rezultātu."

#: d/lang.opt:143
#, no-c-format
msgid "Warn when a special enum is declared with the wrong base type."
msgstr "Brīdināt, ja īpašs uzskaitījums (enum) ir deklarēts ar nepareizu bāzes tipu."

#: d/lang.opt:151
#, no-c-format
msgid "Warn from speculative compiles such as __traits(compiles)."
msgstr "Brīdināt arī spekulatīvas kompilēšanas laikā, piemēram, __traits(compiles)."

#: d/lang.opt:163
#, no-c-format
msgid "Generate JSON file."
msgstr "Ģenerēt JSON failu."

#: d/lang.opt:167
#, no-c-format
msgid "-Xf <file>\tWrite JSON output to the given <file>."
msgstr "-Xf <file>\tRakstīt JSON izvadi failā <file>."

#: d/lang.opt:171
#, no-c-format
msgid "Debug library to use instead of phobos."
msgstr "Atkļūdošanas bibliotēka, ko izmantot phobos vietā."

#: d/lang.opt:175
#, no-c-format
msgid "Default library to use instead of phobos."
msgstr "Noklusējuma bibliotēka, ko izmantot phobos vietā."

#: d/lang.opt:179
#, no-c-format
msgid "Do link the standard D startup files in the compilation."
msgstr "Kompilējot saistīt standarta D starta failus."

#: d/lang.opt:186
#, no-c-format
msgid "Generate code for all template instantiations."
msgstr "Ģenerēt kodu visām veidņu instancēm."

#: d/lang.opt:198
#, no-c-format
msgid "-fbounds-check=[on|safeonly|off]\tTurn array bounds checks on, in @safe code only, or off."
msgstr "-fbounds-check=[on|safeonly|off]\tIeslēgt masīvu robežu pārbaudes, tikai @safe kodā vai izslēgt."

#: d/lang.opt:240
#, no-c-format
msgid "-fcheckaction=[throw,halt,context]\tBehavior on contract failure."
msgstr "-fcheckaction=[throw,halt,context]\tRīcība līguma kļūmes gadījumā."

#: d/lang.opt:256
#, no-c-format
msgid "Compile in debug code."
msgstr "Iekļaut kompilācijā atkļūdošanas kodu."

#: d/lang.opt:260
#, no-c-format
msgid "-fdebug=<ident>\tCompile in debug code identified by <ident>."
msgstr "-fdebug=<ident>\tIekļaut kompilācijā atkļūdošanas kodu, kas identificēts ar <ident>."

#: d/lang.opt:264
#, no-c-format
msgid "Generate documentation."
msgstr "Ģenerēt dokumentāciju."

#: d/lang.opt:268
#, no-c-format
msgid "-fdoc-dir=<dir>\tWrite documentation file to directory <dir>."
msgstr "-fdoc-dir=<dir>\tRakstīt dokumentācijas failu direktorijā <dir>."

#: d/lang.opt:272
#, no-c-format
msgid "-fdoc-file=<file>\tWrite documentation to <file>."
msgstr "-fdoc-file=<file>\tRakstīt dokumentāciju failā <file>."

#: d/lang.opt:276
#, no-c-format
msgid "-fdoc-inc=<file>\tInclude a Ddoc macro <file>."
msgstr "-fdoc-inc=<file>\tIekļaut Ddoc makro failu <file>."

#: d/lang.opt:280
#, no-c-format
msgid "Assume that standard D runtime libraries and \"D main\" exist."
msgstr "Pieņemt, ka eksistē standarta D izpildlaika bibliotēkas un \"D main\"."

#: d/lang.opt:284
#, no-c-format
msgid "Add comments for ignored declarations in the generated C++ header."
msgstr "Pievienot komentārus ignorētajām deklarācijām ģenerētajā C++ galvenē."

#: d/lang.opt:288
#, no-c-format
msgid "-fdump-cxx-spec=<filename>\tWrite all declarations as C++ code to <filename>."
msgstr "-fdump-cxx-spec=<filename>\tRakstīt visas deklarācijas kā C++ kodu failā <filename>."

#: d/lang.opt:292
#, no-c-format
msgid "Display the frontend AST after parsing and semantic passes."
msgstr "Parādīt priekšējās daļas AST pēc parsēšanas un semantiskajiem gājieniem."

#: d/lang.opt:300
#, no-c-format
msgid "-fextern-std=<standard>\tSet C++ name mangling compatibility with <standard>."
msgstr "-fextern-std=<standard>\tIestatīt C++ nosaukumu sagrozīšanas saderību ar <standard>."

#: d/lang.opt:328
#, no-c-format
msgid "Ignore unsupported pragmas."
msgstr "Ignorēt neatbalstītas pragmas."

#: d/lang.opt:332
#, no-c-format
msgid "Include imported modules in the compilation."
msgstr "Iekļaut importētos moduļus kompilācijā."

#: d/lang.opt:336
#, no-c-format
msgid "Generate code for class invariant contracts."
msgstr "Ģenerēt kodu klases invariantu līgumiem."

#: d/lang.opt:340
#, no-c-format
msgid "Generate a default D main() function when compiling."
msgstr "Kompilēšanas laikā ģenerēt noklusējuma D main() funkciju."

#: d/lang.opt:344
#, no-c-format
msgid "-fmodule-file=<package.module>=<filespec>\tuse <filespec> as source file for <package.module>."
msgstr "-fmodule-file=<package.module>=<filespec>\tizmantot <filespec> kā <package.module> pirmkoda failu."

#: d/lang.opt:348
#, no-c-format
msgid "Generate ModuleInfo struct for output module."
msgstr "Ģenerēt ModuleInfo struktūru izvades modulim."

#: d/lang.opt:352
#, no-c-format
msgid "Process all modules specified on the command line, but only generate code for the module specified by the argument."
msgstr "Apstrādāt visus komandrindā norādītos moduļus, bet ģenerēt kodu tikai argumentā norādītajam modulim."

#: d/lang.opt:356
#, no-c-format
msgid "Generate code for postcondition contracts."
msgstr "Ģenerēt kodu pēcnosacījumu līgumiem."

#: d/lang.opt:360
#, no-c-format
msgid "Generate code for precondition contracts."
msgstr "Ģenerēt kodu priekšnosacījumu līgumiem."

#: d/lang.opt:364
#, no-c-format
msgid "Turn on all upcoming D language features."
msgstr "Ieslēgt visus gaidāmos D valodas līdzekļus."

#: d/lang.opt:368
#, no-c-format
msgid "Implement D bit-fields."
msgstr "Īstenot D bitu laukus."

#: d/lang.opt:372
#, no-c-format
msgid "Implement DIP1000: Scoped pointers."
msgstr "Īstenot DIP1000: tvēruma rādītāji."

#: d/lang.opt:376
#, no-c-format
msgid "Implement DIP1008: Allow exceptions in @nogc code."
msgstr "Īstenot DIP1008: atļaut izņēmumus @nogc kodā."

#: d/lang.opt:380
#, no-c-format
msgid "Implement DIP1021: Mutable function arguments."
msgstr "Īstenot DIP1021: maināmi funkciju argumenti."

#: d/lang.opt:384
#, no-c-format
msgid "Destruct fields of partially constructed objects."
msgstr "Iznīcināt daļēji konstruētu objektu laukus."

#: d/lang.opt:388
#, no-c-format
msgid "Use field-wise comparisons for struct equality."
msgstr "Struktūru vienlīdzībai izmantot lauku salīdzinājumus."

#: d/lang.opt:392
#, no-c-format
msgid "When a symbol is resolved, check `alias this' scope before going to upper scopes."
msgstr "Atrisinot simbolu, pārbaudīt `alias this' tvērumu, pirms pāriet uz augstākiem tvērumiem."

#: d/lang.opt:396
#, no-c-format
msgid "Disallow unsound immutable conversions that were formerly incorrectly permitted."
msgstr "Aizliegt nekorektas nemaināmības konversijas, kas agrāk tika kļūdaini atļautas."

#: d/lang.opt:400
#, no-c-format
msgid "Implement 'in' parameters to mean scope const."
msgstr "Īstenot 'in' parametrus ar nozīmi scope const."

#: d/lang.opt:404
#, no-c-format
msgid "Implement 'in' contracts of overridden methods to be a superset of parent contract."
msgstr "Īstenot pārrakstīto metožu 'in' līgumus kā vecāka līguma virskopu."

#: d/lang.opt:408
#, no-c-format
msgid "Disable access to shared memory objects."
msgstr "Aizliegt piekļuvi koplietojamās atmiņas objektiem."

#: d/lang.opt:412
#, no-c-format
msgid "Enable safety checks on all functions by default."
msgstr "Pēc noklusējuma iespējot drošības pārbaudes visām funkcijām."

#: d/lang.opt:416
#, no-c-format
msgid "Enable rvalue arguments to ref parameters."
msgstr "Atļaut rvalue argumentus ref parametriem."

#: d/lang.opt:420
#, no-c-format
msgid "Disable access to variables marked `@system' from @safe code."
msgstr "Aizliegt piekļuvi ar `@system' atzīmētiem mainīgajiem no @safe koda."

#: d/lang.opt:424
#, no-c-format
msgid "Compile release version."
msgstr "Kompilēt laidiena versiju."

#: d/lang.opt:428
#, no-c-format
msgid "Turn off all revertable D language features."
msgstr "Izslēgt visus atsaucamos D valodas līdzekļus."

#: d/lang.opt:432
#, no-c-format
msgid "Revert DIP1000: Scoped pointers."
msgstr "Atsaukt DIP1000: tvēruma rādītāji."

#: d/lang.opt:436
#, no-c-format
msgid "Don't destruct fields of partially constructed objects."
msgstr "Neiznīcināt daļēji konstruētu objektu laukus."

#: d/lang.opt:440
#, no-c-format
msgid "Don't use C-style integral promotion for unary '+', '-' and '~'."
msgstr "Neizmantot C stila veselo skaitļu paaugstināšanu unārajiem '+', '-' un '~'."

#: d/lang.opt:448
#, no-c-format
msgid "-fsave-mixins=<filename>\tExpand and save mixins to file specified by <filename>."
msgstr "-fsave-mixins=<filename>\tIzvērst un saglabāt mixin failā <filename>."

#: d/lang.opt:452
#, no-c-format
msgid "Generate code for switches without a default case."
msgstr "Ģenerēt kodu switch priekšrakstiem bez default gadījuma."

#: d/lang.opt:456
#, no-c-format
msgid "List information on all D language transitions."
msgstr "Uzskaitīt informāciju par visām D valodas pārejām."

#: d/lang.opt:460
#, no-c-format
msgid "List all non-mutable fields which occupy an object instance."
msgstr "Uzskaitīt visus nemainīgos laukus, kas aizņem objekta instanci."

#: d/lang.opt:464
#, no-c-format
msgid "List all usages of 'in' on parameter."
msgstr "Uzskaitīt visus 'in' lietojumus parametriem."

#: d/lang.opt:468
#, no-c-format
msgid "List all hidden GC allocations."
msgstr "Uzskaitīt visas slēptās GC izdales."

#: d/lang.opt:472
#, no-c-format
msgid "List statistics on template instantiations."
msgstr "Uzskaitīt veidņu instancēšanas statistiku."

#: d/lang.opt:476
#, no-c-format
msgid "List all variables going into thread local storage."
msgstr "Uzskaitīt visus mainīgos, kas nonāk pavedienlokālajā glabātuvē."

#: d/lang.opt:480
#, no-c-format
msgid "Compile in unittest code."
msgstr "Iekļaut kompilācijā unittest kodu."

#: d/lang.opt:484
#, no-c-format
msgid "-fversion=<ident>\tCompile in version code identified by <ident>."
msgstr "-fversion=<ident>\tIekļaut kompilācijā versijas kodu, kas identificēts ar <ident>."

#: d/lang.opt:488
#, no-c-format
msgid "Emit template instantiations as weak symbols."
msgstr "Izvadīt veidņu instances kā vājus simbolus."

#: d/lang.opt:508
#, no-c-format
msgid "Do not link the standard D library in the compilation."
msgstr "Kompilējot nesaistīt standarta D bibliotēku."

#: d/lang.opt:516
#, no-c-format
msgid "Link the standard D library statically in the compilation."
msgstr "Kompilējot statiski saistīt standarta D bibliotēku."

#: d/lang.opt:520
#, no-c-format
msgid "Link the standard D library dynamically in the compilation."
msgstr "Kompilējot dinamiski saistīt standarta D bibliotēku."

#: d/lang.opt:524
#, no-c-format
msgid "Conform to the 2024 D language edition."
msgstr "Ievērot 2024. gada D valodas izdevumu."

#: d/lang.opt:528
#, no-c-format
msgid "Conform to the latest 202Y D language edition (experimental)."
msgstr "Ievērot jaunāko 202Y D valodas izdevumu (eksperimentāls)."

