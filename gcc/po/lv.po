msgid "Enable DIV-REM instructions for ARCv2."
msgstr "Iespējot DIV-REM instrukcijas ARCv2."

#: config/arc/arc.opt:138
#, no-c-format
msgid "Enable code density instructions for ARCv2."
msgstr "Iespējot koda blīvuma instrukcijas ARCv2."

