msgstr "Norādīt no libc saistāmo printf versiju."

#: config/picolibc.opt:47
#, no-c-format
msgid "Specify the scanf version linked from libc."
msgstr "Norādīt no libc saistāmo scanf versiju."

#: config/nds32/nds32-elf.opt:3 config/nds32/nds32-linux.opt:3
#, no-c-format
msgid "Specify the address generation strategy for code model."
msgstr "Norādīt adrešu ģenerēšanas stratēģiju koda modelim."

#: config/nds32/nds32-elf.opt:7 config/nds32/nds32-linux.opt:7
#, no-c-format
msgid "Known cmodel types (for use with the -mcmodel= option):"
msgstr "Zināmie koda modeļu tipi (izmantošanai ar opciju -mcmodel=):"

#: config/nds32/nds32.opt:29 config/nds32/nds32.opt:89
#, no-c-format
msgid "Generate code in big-endian mode."
msgstr "Ģenerēt kodu big-endian režīmā."

#: config/nds32/nds32.opt:33 config/nds32/nds32.opt:93
#, no-c-format
msgid "Generate code in little-endian mode."
msgstr "Ģenerēt kodu little-endian režīmā."

#: config/nds32/nds32.opt:37
#, no-c-format
msgid "Force performing fp-as-gp optimization."
msgstr "Piespiest veikt fp-as-gp optimizāciju."

#: config/nds32/nds32.opt:41
#, no-c-format
msgid "Forbid performing fp-as-gp optimization."
msgstr "Aizliegt veikt fp-as-gp optimizāciju."

#: config/nds32/nds32.opt:47
#, no-c-format
msgid "Specify which ABI type to generate code for: 2, 2fp+."
msgstr "Norādīt ABI tipu, kuram ģenerēt kodu: 2, 2fp+."

#: config/nds32/nds32.opt:51 config/i386/i386.opt:558
#, no-c-format
msgid "Known ABIs (for use with the -mabi= option):"
msgstr "Zināmie ABI (izmantošanai ar opciju -mabi=):"

#: config/nds32/nds32.opt:61
#, no-c-format
msgid "Specify the soft floating-point ABI, aliased to -mabi=2."
msgstr "Norādīt programmatūras peldošā komata ABI; aizstājvārds opcijai -mabi=2."

#: config/nds32/nds32.opt:65
#, no-c-format
msgid "Specify the hard floating-point ABI, aliased to -mabi=2fp+."
msgstr "Norādīt aparatūras peldošā komata ABI; aizstājvārds opcijai -mabi=2fp+."

#: config/nds32/nds32.opt:71
#, no-c-format
msgid "Use reduced-set registers for register allocation."
msgstr "Reģistru piešķiršanai izmantot samazinātās kopas reģistrus."

#: config/nds32/nds32.opt:75
#, no-c-format
msgid "Use full-set registers for register allocation."
msgstr "Reģistru piešķiršanai izmantot pilnās kopas reģistrus."

#: config/nds32/nds32.opt:81
#, no-c-format
msgid "Always align function entry, jump target and return address."
msgstr "Vienmēr izlīdzināt funkcijas sākumu, lēciena mērķi un atgriešanās adresi."

#: config/nds32/nds32.opt:85
#, no-c-format
msgid "Align function entry to 4 bytes."
msgstr "Izlīdzināt funkcijas sākumu pie 4 baitu robežas."

#: config/nds32/nds32.opt:97
#, no-c-format
msgid "Prevent $fp being allocated during register allocation so that compiler is able to force performing fp-as-gp optimization."
msgstr "Nepieļaut $fp piešķiršanu reģistru piešķiršanas laikā, lai kompilators varētu piespiedu kārtā veikt fp-as-gp optimizāciju."

#: config/nds32/nds32.opt:101
#, no-c-format
msgid "Forbid using $fp to access static and global variables.  This option strictly forbids fp-as-gp optimization regardless of '-mforce-fp-as-gp'."
msgstr "Aizliegt izmantot $fp, lai piekļūtu statiskajiem un globālajiem mainīgajiem. Šī opcija stingri aizliedz fp-as-gp optimizāciju neatkarīgi no '-mforce-fp-as-gp'."

#: config/nds32/nds32.opt:105
#, no-c-format
msgid "Specify the address generation strategy for ICT call's code model."
msgstr "Norādīt adrešu ģenerēšanas stratēģiju ICT izsaukumu koda modelim."

#: config/nds32/nds32.opt:109
#, no-c-format
