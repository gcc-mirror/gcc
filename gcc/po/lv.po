msgstr "Nodot -marclinux opciju saistītājam."

#: config/arc/arc.opt:405
#, no-c-format
msgid "Pass -marclinux_prof option through to linker."
msgstr "Nodot -marclinux_prof opciju saistītājam."

#: config/arc/arc.opt:413
#, no-c-format
