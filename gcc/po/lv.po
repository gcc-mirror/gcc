msgstr "-mtune=TUNE\tNoskaņot kodu norādītajam ARC variantam."

#: config/arc/arc.opt:287
#, no-c-format
msgid "Enable the use of indexed loads."
msgstr "Iespējot indeksētas ielādes izmantošanu."

#: config/arc/arc.opt:291
#, no-c-format
msgid "Enable the use of pre/post modify with register displacement."
msgstr "Iespējot pirms/pēc modificēšanas izmantošanu ar reģistra nobīdi."

#: config/arc/arc.opt:295
#, no-c-format
msgid "Generate 32x16 multiply and mac instructions."
msgstr "Ģenerēt 32x16 reizināšanas un MAC instrukcijas."

#: config/arc/arc.opt:303
#, no-c-format
msgid "Don't use less than 25 bit addressing range for calls."
msgstr "Izsaukumiem neizmantot mazāk par 25 bitu adresācijas diapazonu."

#: config/arc/arc.opt:325
#, no-c-format
msgid "Enable pre-reload use of cbranchsi pattern."
msgstr "Iespējot cbranchsi šablona izmantošanu pirms reload."

#: config/arc/arc.opt:333
#, no-c-format
msgid "Use pc-relative switch case tables - this enables case table shortening."
msgstr "Izmantot PC relatīvas switch gadījumu tabulas – tas ļauj saīsināt gadījumu tabulas."

#: config/arc/arc.opt:337
#, no-c-format
msgid "Enable compact casesi pattern."
msgstr "Iespējot kompakto casesi šablonu."

#: config/arc/arc.opt:341
#, no-c-format
msgid "Enable 'q' instruction alternatives."
msgstr "Iespējot 'q' instrukciju alternatīvas."

#: config/arc/arc.opt:345
#, no-c-format
msgid "Expand adddi3 and subdi3 at rtl generation time into add.f / adc etc."
msgstr "Izvērst adddi3 un subdi3 RTL ģenerēšanas laikā par add.f / adc utt."

#: config/arc/arc.opt:352
#, no-c-format
msgid "Enable variable polynomial CRC extension."
msgstr "Iespējot mainīgā polinoma CRC paplašinājumu."

#: config/arc/arc.opt:356
#, no-c-format
msgid "Enable DSP 3.1 Pack A extensions."
msgstr "Iespējot DSP 3.1 Pack A paplašinājumus."

#: config/arc/arc.opt:360
#, no-c-format
msgid "Enable dual viterbi butterfly extension."
msgstr "Iespējot dubulto Viterbi tauriņa paplašinājumu."

#: config/arc/arc.opt:370
#, no-c-format
msgid "Enable Dual and Single Operand Instructions for Telephony."
msgstr "Iespējot divu un viena operanda instrukcijas telefonijai."

#: config/arc/arc.opt:374
#, no-c-format
msgid "Enable XY Memory extension (DSP version 3)."
msgstr "Iespējot XY atmiņas paplašinājumu (DSP 3. versija)."

#: config/arc/arc.opt:379
#, no-c-format
msgid "Enable Locked Load/Store Conditional extension."
msgstr "Iespējot Locked Load/Store Conditional paplašinājumu."

#: config/arc/arc.opt:383
#, no-c-format
msgid "Enable swap byte ordering extension instruction."
msgstr "Iespējot baitu secības maiņas paplašinājuma instrukciju."

#: config/arc/arc.opt:387
#, no-c-format
msgid "Enable 64-bit Time-Stamp Counter extension instruction."
msgstr "Iespējot 64 bitu laika zīmoga skaitītāja paplašinājuma instrukciju."

#: config/arc/arc.opt:392
#, no-c-format
msgid "Pass -EB option through to linker."
msgstr "Nodot -EB opciju saistītājam."

#: config/arc/arc.opt:397
#, no-c-format
msgid "Pass -EL option through to linker."
msgstr "Nodot -EL opciju saistītājam."

#: config/arc/arc.opt:401
#, no-c-format
