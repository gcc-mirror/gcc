msgstr "Norādīt pavediena rādītāja reģistra numuru."

#: config/arc/arc.opt:492
#, no-c-format
msgid "Enable use of NPS400 bit operations."
msgstr "Iespējot NPS400 bitu operāciju izmantošanu."

#: config/arc/arc.opt:496
#, no-c-format
msgid "Enable use of NPS400 xld/xst extension."
msgstr "Iespējot NPS400 xld/xst paplašinājuma izmantošanu."

#: config/arc/arc.opt:504
