#: lto/lang.opt:50
#, no-c-format
msgid "Set linker output type (used internally during LTO optimization)."
msgstr "Iestatīt saistītāja izvades tipu (iekšēji izmanto LTO optimizācijā)."

#: lto/lang.opt:54
#, no-c-format
msgid "Run the link-time optimizer in local transformation (LTRANS) mode."
msgstr "Palaist saistīšanas laika optimizētāju lokālās transformācijas (LTRANS) režīmā."

#: lto/lang.opt:58
#, no-c-format
msgid "Specify a file to which a list of files output by LTRANS is written."
msgstr "Norādīt failu, kurā ierakstīt LTRANS izvadīto failu sarakstu."

#: lto/lang.opt:62
#, no-c-format
msgid "The resolution file."
msgstr "Atrisināšanas fails."

#: lto/lang.opt:66
#, no-c-format
msgid "Run the link-time optimizer in whole program analysis (WPA) mode."
msgstr "Palaist saistīšanas laika optimizētāju visas programmas analīzes (WPA) režīmā."

#: lto/lang.opt:70
#, no-c-format
msgid "Whole program analysis (WPA) mode with number of parallel jobs specified."
msgstr "Visas programmas analīzes (WPA) režīms ar norādītu paralēlo darbu skaitu."

#: lto/lang.opt:78
#, no-c-format
msgid "Call the dump function for variables and function in IL."
msgstr "Izsaukt izmešanas funkciju IL mainīgajiem un funkcijām."

#: lto/lang.opt:82
#, no-c-format
msgid "Dump the demangled output."
msgstr "Izmest atšifrēto (demangled) izvadi."

#: lto/lang.opt:86
#, no-c-format
msgid "Dump only the defined symbols."
msgstr "Izmest tikai definētos simbolus."

#: lto/lang.opt:90
#, no-c-format
msgid "Print the initial values of the variables."
msgstr "Izdrukāt mainīgo sākotnējās vērtības."

#: lto/lang.opt:94
#, no-c-format
msgid "Sort the symbols alphabetically."
msgstr "Kārtot simbolus alfabētiskā secībā."

#: lto/lang.opt:98
#, no-c-format
msgid "Sort the symbols according to size."
msgstr "Kārtot simbolus pēc izmēra."

#: lto/lang.opt:102
#, no-c-format
msgid "Display the symbols in reverse order."
msgstr "Rādīt simbolus apgrieztā secībā."

#: lto/lang.opt:109
#, no-c-format
msgid "Dump the details of LTO objects."
msgstr "Izmest LTO objektu informāciju."

#: lto/lang.opt:113
#, no-c-format
msgid "Dump the statistics of tree types."
msgstr "Izmest koku tipu statistiku."

#: lto/lang.opt:117
#, no-c-format
msgid "Dump the statistics of trees."
msgstr "Izmest koku statistiku."

#: lto/lang.opt:121
#, no-c-format
msgid "Dump the statistics of gimple statements."
msgstr "Izmest gimple priekšrakstu statistiku."

#: lto/lang.opt:131
#, no-c-format
msgid "Dump the dump tool command line options."
msgstr "Izmest izmešanas rīka komandrindas opcijas."

#: lto/lang.opt:135
#, no-c-format
msgid "Dump the symtab callgraph."
msgstr "Izmest symtab izsaukumu grafu."

#: config/picolibc.opt:26
#, no-c-format
