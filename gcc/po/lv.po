#: config/arm/arm.opt:241
#, no-c-format
msgid "Thumb: Generate (non-leaf) stack frames even if not needed."
msgstr "Thumb: Ģenerēt (ne-lapas) steka kadrus pat tad, ja tie nav nepieciešami."

#: config/arm/arm.opt:245
#, no-c-format
msgid "Thumb: Generate (leaf) stack frames even if not needed."
msgstr "Thumb: Ģenerēt (lapas) steka kadrus pat tad, ja tie nav nepieciešami."

#: config/arm/arm.opt:249 config/mn10300/mn10300.opt:42
#, no-c-format
msgid "Tune code for the given processor."
msgstr "Noskaņot kodu norādītajam procesoram."

#: config/arm/arm.opt:253
#, no-c-format
msgid "Print CPU tuning information as comment in assembler file.  This is an option used only for regression testing of the compiler and not intended for ordinary use in compiling code."
msgstr "Izdrukāt CPU noskaņošanas informāciju kā komentāru asemblera failā. Šī opcija tiek izmantota tikai kompilatora regresijas testēšanai un nav paredzēta parastai lietošanai koda kompilēšanā."

#: config/arm/arm.opt:264
#, no-c-format
msgid "Use Neon quad-word (rather than double-word) registers for vectorization."
msgstr "Vektorizācijai izmantot Neon četrvārdu (nevis divvārdu) reģistrus."

#: config/arm/arm.opt:268
#, no-c-format
msgid "Use Neon double-word (rather than quad-word) registers for vectorization."
msgstr "Vektorizācijai izmantot Neon divvārdu (nevis četrvārdu) reģistrus."

#: config/arm/arm.opt:272
#, no-c-format
msgid "Enable more verbose RTX cost dumps during debug.  For GCC developers use only."
msgstr "Iespējot detalizētākas RTX izmaksu izmetes atkļūdošanas laikā. Tikai GCC izstrādātājiem."

#: config/arm/arm.opt:276
#, no-c-format
msgid "Only generate absolute relocations on word sized values."
msgstr "Ģenerēt absolūtās relokācijas tikai vārda izmēra vērtībām."

#: config/arm/arm.opt:280
#, no-c-format
msgid "Generate IT blocks appropriate for ARMv8."
msgstr "Ģenerēt ARMv8 piemērotus IT blokus."

#: config/arm/arm.opt:284
#, no-c-format
msgid "Avoid overlapping destination and address registers on LDRD instructions that may trigger Cortex-M3 errata."
msgstr "Izvairīties no mērķa un adreses reģistru pārklāšanās LDRD instrukcijās, kas var izraisīt Cortex-M3 kļūdu (errata)."

#: config/arm/arm.opt:289
#, no-c-format
msgid "Mitigate issues with VLLDM on some M-profile devices (CVE-2021-35465)."
msgstr "Mazināt problēmas ar VLLDM dažās M-profila ierīcēs (CVE-2021-35465)."

#: config/arm/arm.opt:293
#, no-c-format
msgid "Mitigate issues with AES instructions on Cortex-A57 and Cortex-A72 (Arm erratum #1742098)."
msgstr "Mazināt problēmas ar AES instrukcijām Cortex-A57 un Cortex-A72 (Arm erratum #1742098)."

#: config/arm/arm.opt:298
#, no-c-format
msgid "Mitigate issues with AES instructions on Cortex-A57 and Cortex-A72 (Arm erratum #1655431)."
msgstr "Mazināt problēmas ar AES instrukcijām Cortex-A57 un Cortex-A72 (Arm erratum #1655431)."

#: config/arm/arm.opt:307
#, no-c-format
msgid "This option is deprecated and has no effect."
msgstr "Šī opcija ir novecojusi un tai nav ietekmes."

#: config/arm/arm.opt:311
#, no-c-format
msgid "Assume loading data from flash is slower than fetching instructions."
msgstr "Pieņemt, ka datu ielāde no zibatmiņas ir lēnāka nekā instrukciju ielāde."

#: config/arm/arm.opt:315
#, no-c-format
msgid "Assume unified syntax for inline assembly code."
msgstr "Pieņemt vienoto sintaksi iekļautajam asemblera kodam."

#: config/arm/arm.opt:319
#, no-c-format
msgid "Do not allow constant data to be placed in code sections."
msgstr "Neļaut konstantus datus izvietot koda sekcijās."

#: config/arm/arm.opt:323
#, no-c-format
msgid "When linking for big-endian targets, generate a BE8 format image."
msgstr "Saistot big-endian mērķiem, ģenerēt BE8 formāta tēlu."

#: config/arm/arm.opt:327
#, no-c-format
msgid "When linking for big-endian targets, generate a legacy BE32 format image."
msgstr "Saistot big-endian mērķiem, ģenerēt novecojušā BE32 formāta tēlu."

#: config/arm/arm.opt:331 config/sh/sh.opt:195
#, no-c-format
msgid "Cost to assume for a branch insn."
msgstr "Pieņemamās zarošanās insn izmaksas."

#: config/arm/arm.opt:335 config/aarch64/aarch64.opt:229
#, no-c-format
msgid "Use branch-protection features."
msgstr "Izmantot zarošanās aizsardzības līdzekļus."

#: config/arm/arm.opt:339
#, no-c-format
msgid "Generate code which uses the core registers only (r0-r14)."
msgstr "Ģenerēt kodu, kas izmanto tikai kodola reģistrus (r0-r14)."

#: config/arm/arm.opt:361
#, no-c-format
msgid "Use an immediate to offset from the TLS register. This option is for use with fstack-protector-guard=tls and not for use in user-land code."
msgstr "Izmantot tiešo vērtību kā nobīdi no TLS reģistra. Šī opcija paredzēta lietošanai ar fstack-protector-guard=tls, nevis lietotāja telpas kodā."

#: config/mcore/mcore.opt:23
#, no-c-format
msgid "Generate code for the M*Core M210."
msgstr "Ģenerēt kodu M*Core M210 procesoram."

#: config/mcore/mcore.opt:27
