#: config/pru/pru.opt:48
#, no-c-format
msgid "Allow (or do not allow) gcc to use the FILL and ZERO instructions."
msgstr "Atļaut (vai neatļaut) gcc izmantot FILL un ZERO instrukcijas."

#: config/pru/pru.opt:52
#, no-c-format
msgid "Select target ABI variant."
msgstr "Izvēlēties mērķa ABI variantu."

#: config/pru/pru.opt:56
#, no-c-format
msgid "ABI variant code generation (for use with -mabi= option):"
msgstr "ABI varianta koda ģenerēšana (izmantošanai ar opciju -mabi=):"

#: config/microblaze/microblaze.opt:40
#, no-c-format
msgid "Use software emulation for floating point (default)."
msgstr "Izmantot programmatūras emulāciju peldošajam komatam (noklusējums)."

#: config/microblaze/microblaze.opt:44
#, no-c-format
msgid "Use hardware floating point instructions."
msgstr "Izmantot aparatūras peldošā komata instrukcijas."

#: config/microblaze/microblaze.opt:48
#, no-c-format
msgid "Use table lookup optimization for small signed integer divisions."
msgstr "Izmantot tabulas uzmeklēšanas optimizāciju mazu veselu skaitļu ar zīmi dalīšanai."

#: config/microblaze/microblaze.opt:52
#, no-c-format
msgid "-mcpu=PROCESSOR\t\tUse features of and schedule code for given CPU."
msgstr "-mcpu=PROCESSOR\t\tIzmantot norādītā CPU iespējas un plānot kodu tam."

#: config/microblaze/microblaze.opt:56
#, no-c-format
msgid "Don't optimize block moves, use memcpy."
msgstr "Neoptimizēt bloku pārvietošanu, izmantot memcpy."

#: config/microblaze/microblaze.opt:68
#, no-c-format
msgid "Use the soft multiply emulation (default)."
msgstr "Izmantot programmatūras reizināšanas emulāciju (noklusējums)."

#: config/microblaze/microblaze.opt:72
#, no-c-format
msgid "Use reorder instructions (swap and byte reversed load/store) (default)."
msgstr "Izmantot pārkārtošanas instrukcijas (swap un baitu apgrieztās ielādes/saglabāšanas) (noklusējums)."

#: config/microblaze/microblaze.opt:76
#, no-c-format
msgid "Use the software emulation for divides (default)."
msgstr "Dalīšanai izmantot programmatūras emulāciju (noklusējums)."

#: config/microblaze/microblaze.opt:80
#, no-c-format
msgid "Use the hardware barrel shifter instead of emulation."
msgstr "Emulācijas vietā izmantot aparatūras cilindrisko bīdītāju (barrel shifter)."

#: config/microblaze/microblaze.opt:84
#, no-c-format
msgid "Use pattern compare instructions."
msgstr "Izmantot šablonu salīdzināšanas instrukcijas."

#: config/microblaze/microblaze.opt:88
#, no-c-format
msgid "Check for stack overflow at runtime."
msgstr "Izpildlaikā pārbaudīt steka pārpildi."

#: config/microblaze/microblaze.opt:96
#, no-c-format
msgid "Clear the BSS to zero and place zero initialized in BSS."
msgstr "Notīrīt BSS ar nullēm un nullēm inicializētos datus izvietot BSS."

#: config/microblaze/microblaze.opt:100
#, no-c-format
msgid "Use multiply high instructions for high part of 32x32 multiply."
msgstr "32x32 reizināšanas augstākajai daļai izmantot instrukcijas multiply high."

#: config/microblaze/microblaze.opt:104
#, no-c-format
msgid "Use hardware floating point conversion instructions."
msgstr "Izmantot aparatūras peldošā komata konversijas instrukcijas."

#: config/microblaze/microblaze.opt:108
#, no-c-format
msgid "Use hardware floating point square root instruction."
msgstr "Izmantot aparatūras peldošā komata kvadrātsaknes instrukciju."

#: config/microblaze/microblaze.opt:112
#, no-c-format
msgid "Build application as normal executable."
msgstr "Būvēt lietojumprogrammu kā parastu izpildāmo failu."

#: config/microblaze/microblaze.opt:116
#, no-c-format
msgid "Build application for use with xmdstub debug agent."
msgstr "Būvēt lietojumprogrammu lietošanai ar xmdstub atkļūdošanas aģentu."

#: config/microblaze/microblaze.opt:120
#, no-c-format
msgid "Build application to be loaded using a bootloader."
msgstr "Būvēt lietojumprogrammu, kas tiks ielādēta ar sāknēšanas ielādētāju."

#: config/microblaze/microblaze.opt:124
#, no-c-format
msgid "Build application without any of the MicroBlaze vectors."
msgstr "Būvēt lietojumprogrammu bez MicroBlaze vektoriem."

#: config/microblaze/microblaze.opt:128
#, no-c-format
msgid "Use hardware prefetch instruction."
msgstr "Izmantot aparatūras priekšielādes instrukciju."

#: config/microblaze/microblaze.opt:132
#, no-c-format
msgid "Data referenced by offset from start of text instead of GOT (with -fPIC/-fPIE)."
msgstr "Datus adresēt ar nobīdi no teksta sākuma, nevis caur GOT (ar -fPIC/-fPIE)."

#: config/m32r/m32r.opt:34
#, no-c-format
msgid "Compile for the m32rx."
msgstr "Kompilēt procesoram m32rx."

#: config/m32r/m32r.opt:38
#, no-c-format
msgid "Compile for the m32r2."
msgstr "Kompilēt procesoram m32r2."

#: config/m32r/m32r.opt:42
#, no-c-format
msgid "Compile for the m32r."
msgstr "Kompilēt procesoram m32r."

#: config/m32r/m32r.opt:46
#, no-c-format
msgid "Align all loops to 32 byte boundary."
msgstr "Izlīdzināt visus ciklus uz 32 baitu robežu."

#: config/m32r/m32r.opt:50
#, no-c-format
msgid "Prefer branches over conditional execution."
msgstr "Dot priekšroku zarošanai, nevis nosacītai izpildei."

#: config/m32r/m32r.opt:54
#, no-c-format
msgid "Give branches their default cost."
msgstr "Piešķirt zarošanās instrukcijām to noklusējuma izmaksas."

#: config/m32r/m32r.opt:58
#, no-c-format
msgid "Display compile time statistics."
msgstr "Parādīt kompilēšanas laika statistiku."

#: config/m32r/m32r.opt:62
#, no-c-format
msgid "Specify cache flush function."
msgstr "Norādīt kešatmiņas izskalošanas funkciju."

#: config/m32r/m32r.opt:66
#, no-c-format
msgid "Specify cache flush trap number."
msgstr "Norādīt kešatmiņas izskalošanas slazda numuru."

#: config/m32r/m32r.opt:70
#, no-c-format
msgid "Only issue one instruction per cycle."
msgstr "Katrā ciklā izdot tikai vienu instrukciju."

#: config/m32r/m32r.opt:74
#, no-c-format
msgid "Allow two instructions to be issued per cycle."
msgstr "Atļaut katrā ciklā izdot divas instrukcijas."

#: config/m32r/m32r.opt:78
#, no-c-format
msgid "Code size: small, medium or large."
msgstr "Koda izmērs: mazs, vidējs vai liels."

#: config/m32r/m32r.opt:94
#, no-c-format
msgid "Don't call any cache flush functions."
msgstr "Neizsaukt nevienu kešatmiņas izskalošanas funkciju."

#: config/m32r/m32r.opt:98
#, no-c-format
msgid "Don't call any cache flush trap."
msgstr "Neizsaukt nevienu kešatmiņas izskalošanas slazdu."

#: config/m32r/m32r.opt:105
#, no-c-format
msgid "Small data area: none, sdata, use."
msgstr "Mazo datu apgabals: none, sdata, use."

#: config/aarch64/aarch64.opt:70 config/loongarch/loongarch.opt:276
#, no-c-format
msgid "The code model option names for -mcmodel:"
msgstr "Koda modeļa opciju nosaukumi opcijai -mcmodel:"

#: config/aarch64/aarch64.opt:87
#, no-c-format
msgid "Generates an error message if an attempt is made to access a system register which is not available on the target architecture."
msgstr "Ģenerēt kļūdas ziņojumu, ja tiek mēģināts piekļūt sistēmas reģistram, kas nav pieejams mērķa arhitektūrā."

#: config/aarch64/aarch64.opt:100
#, no-c-format
msgid "Workaround for ARM Cortex-A53 Erratum number 835769."
msgstr "ARM Cortex-A53 kļūdas (erratum) Nr. 835769 apiešana."

#: config/aarch64/aarch64.opt:104
#, no-c-format
msgid "Workaround for ARM Cortex-A53 Erratum number 843419."
msgstr "ARM Cortex-A53 kļūdas (erratum) Nr. 843419 apiešana."

#: config/aarch64/aarch64.opt:108
#, no-c-format
msgid "Enable narrowing of 64-bit general purpose register writes to 32-bit when upper 32 bits of the register are unused."
msgstr "Iespējot 64 bitu vispārējas nozīmes reģistra rakstīšanas sašaurināšanu uz 32 bitiem, ja reģistra augšējie 32 biti netiek izmantoti."

#: config/aarch64/aarch64.opt:121
#, no-c-format
msgid "The register used to access the thread pointer:"
msgstr "Reģistrs, ko izmanto, lai piekļūtu pavediena rādītājam:"

#: config/aarch64/aarch64.opt:152
#, no-c-format
msgid "Specify the thread pointer register."
msgstr "Norādīt pavediena rādītāja reģistru."

#: config/aarch64/aarch64.opt:156
#, no-c-format
msgid "Don't assume that unaligned accesses are handled by the system."
msgstr "Nepieņemt, ka sistēma apstrādā neizlīdzinātas piekļuves."

#: config/aarch64/aarch64.opt:168
#, no-c-format
msgid "Specifies bit size of immediate TLS offsets.  Valid values are 12, 24, 32, 48."
msgstr "Norāda tiešo TLS nobīžu bitu izmēru. Derīgās vērtības ir 12, 24, 32, 48."

#: config/aarch64/aarch64.opt:187
#, no-c-format
msgid "Use features of architecture ARCH."
msgstr "Izmantot arhitektūras ARCH iespējas."

#: config/aarch64/aarch64.opt:191
#, no-c-format
msgid "Use features of and optimize for CPU."
msgstr "Izmantot CPU iespējas un optimizēt tam."

#: config/aarch64/aarch64.opt:195
#, no-c-format
msgid "Optimize for CPU."
msgstr "Optimizēt norādītajam CPU."

#: config/aarch64/aarch64.opt:199
#, no-c-format
msgid "Generate code that conforms to the specified ABI."
msgstr "Ģenerēt kodu, kas atbilst norādītajam ABI."

#: config/aarch64/aarch64.opt:203
#, no-c-format
msgid "-fdump-tuning-model=<filename> Dump current tuning model to a JSON file."
msgstr "-fdump-tuning-model=<filename> Izmest pašreizējo noskaņošanas modeli JSON failā."

#: config/aarch64/aarch64.opt:207
#, no-c-format
msgid "-muser-provided-CPU=<json-tuning-file> User specific CPU tunings."
msgstr "-muser-provided-CPU=<json-tuning-file> Lietotāja specifiski CPU noskaņojumi."

#: config/aarch64/aarch64.opt:211
#, no-c-format
msgid "-moverride=<string>\tPower users only! Override CPU optimization parameters."
msgstr "-moverride=<string>\tTikai pieredzējušiem lietotājiem! Pārrakstīt CPU optimizācijas parametrus."

#: config/aarch64/aarch64.opt:215
#, no-c-format
msgid "Known AArch64 ABIs (for use with the -mabi= option):"
msgstr "Zināmie AArch64 ABI (izmantošanai ar opciju -mabi=):"

#: config/aarch64/aarch64.opt:225
#, no-c-format
msgid "PC relative literal loads."
msgstr "PC relatīvas literāļu ielādes."

#: config/aarch64/aarch64.opt:233
#, no-c-format
msgid "Select return address signing scope."
msgstr "Izvēlēties atgriešanās adreses parakstīšanas tvērumu."

#: config/aarch64/aarch64.opt:237
#, no-c-format
msgid "Supported AArch64 return address signing scope (for use with -msign-return-address= option):"
msgstr "Atbalstītie AArch64 atgriešanās adreses parakstīšanas tvērumi (izmantošanai ar opciju -msign-return-address=):"

#: config/aarch64/aarch64.opt:250
#, no-c-format
msgid "Enable the reciprocal square root approximation.  Enabling this reduces precision of reciprocal square root results to about 16 bits for single precision and to 32 bits for double precision."
msgstr "Iespējot apgrieztās kvadrātsaknes aproksimāciju. Iespējojot to, apgriezto kvadrātsakņu rezultātu precizitāte tiek samazināta līdz aptuveni 16 bitiem vienkāršai precizitātei un līdz 32 bitiem dubultai precizitātei."

#: config/aarch64/aarch64.opt:256
#, no-c-format
msgid "Enable the square root approximation.  Enabling this reduces precision of square root results to about 16 bits for single precision and to 32 bits for double precision. If enabled, it implies -mlow-precision-recip-sqrt."
msgstr "Iespējot kvadrātsaknes aproksimāciju. Iespējojot to, kvadrātsaknes rezultātu precizitāte tiek samazināta līdz aptuveni 16 bitiem vienkāršai precizitātei un līdz 32 bitiem dubultai precizitātei. Ja iespējots, tas ietver -mlow-precision-recip-sqrt."

#: config/aarch64/aarch64.opt:263
#, no-c-format
msgid "Enable the division approximation.  Enabling this reduces precision of division results to about 16 bits for single precision and to 32 bits for double precision."
msgstr "Iespējot dalīšanas aproksimāciju. Iespējojot to, dalīšanas rezultātu precizitāte tiek samazināta līdz aptuveni 16 bitiem vienkāršai precizitātei un līdz 32 bitiem dubultai precizitātei."

#: config/aarch64/aarch64.opt:281
#, no-c-format
msgid "Specify when to enable an early register allocation pass.  The possibilities are: all functions, functions that have access to strided multi-register instructions, and no functions."
msgstr "Norādīt, kad iespējot agrīno reģistru piešķiršanas gājienu. Iespējas: visas funkcijas, funkcijas, kurām ir piekļuve soļotām vairāku reģistru instrukcijām, un neviena funkcija."

#: config/aarch64/aarch64.opt:287
#, no-c-format
msgid "The possible SVE vector lengths:"
msgstr "Iespējamie SVE vektora garumi:"

#: config/aarch64/aarch64.opt:309
#, no-c-format
msgid "-msve-vector-bits=<number>\tSet the number of bits in an SVE vector register."
msgstr "-msve-vector-bits=<number>\tIestatīt bitu skaitu SVE vektora reģistrā."

#: config/aarch64/aarch64.opt:313
#, no-c-format
msgid "-mautovec-preference=[default|asimd-only|sve-only|prefer-asimd|prefer-sve] Force an ISA selection strategy for auto-vectorization.  For best performance it is highly recommended to use -mcpu or -mtune instead.  This parameter should only be used for code exploration."
msgstr "-mautovec-preference=[default|asimd-only|sve-only|prefer-asimd|prefer-sve] Piespiest ISA izvēles stratēģiju automātiskajai vektorizācijai. Labākai veiktspējai ļoti ieteicams tā vietā izmantot -mcpu vai -mtune. Šis parametrs jāizmanto tikai koda izpētei."

#: config/aarch64/aarch64.opt:324
#, no-c-format
msgid "Enables verbose cost model dumping in the debug dump files."
msgstr "Iespējo detalizētu izmaksu modeļa izmešanu atkļūdošanas izmetes failos."

#: config/aarch64/aarch64.opt:328
#, no-c-format
msgid "Generate code to track when the CPU might be speculating incorrectly."
msgstr "Ģenerēt kodu, lai izsekotu, kad CPU varētu nepareizi spekulēt."

#: config/aarch64/aarch64.opt:332
#, no-c-format
msgid "Enable the copy of the AArch64 load/store pair fusion pass that runs before register allocation."
msgstr "Iespējot AArch64 ielādes/saglabāšanas pāru sapludināšanas gājiena kopiju, kas tiek izpildīta pirms reģistru piešķiršanas."

#: config/aarch64/aarch64.opt:337
#, no-c-format
msgid "Enable the copy of the AArch64 load/store pair fusion pass that runs after register allocation."
msgstr "Iespējot AArch64 ielādes/saglabāšanas pāru sapludināšanas gājiena kopiju, kas tiek izpildīta pēc reģistru piešķiršanas."

#: config/aarch64/aarch64.opt:356
#, no-c-format
msgid "Use the system register specified on the command line as the stack protector guard register. This option is for use with fstack-protector-strong and not for use in user-land code."
msgstr "Izmantot komandrindā norādīto sistēmas reģistru kā stack-protector sargvērtības reģistru. Šī opcija paredzēta lietošanai ar fstack-protector-strong, nevis lietotāja telpas kodā."

#: config/aarch64/aarch64.opt:362
#, no-c-format
msgid "Use an immediate to offset from the stack protector guard register, sp_el0. This option is for use with fstack-protector-strong and not for use in user-land code."
msgstr "Izmantot tiešo vērtību kā nobīdi no stack-protector sargvērtības reģistra sp_el0. Šī opcija paredzēta lietošanai ar fstack-protector-strong, nevis lietotāja telpas kodā."

#: config/aarch64/aarch64.opt:371
#, no-c-format
msgid "Generate local calls to out-of-line atomic operations."
msgstr "Ģenerēt lokālus izsaukumus uz ārpus rindas (out-of-line) atomārajām operācijām."

#: config/aarch64/aarch64.opt:375
#, no-c-format
msgid "When vectorizing, consider using multiple different approaches and use the cost model to choose the cheapest one."
msgstr "Vektorizējot apsvērt vairākas dažādas pieejas un ar izmaksu modeli izvēlēties lētāko."

#: config/aarch64/aarch64.opt:380
#, no-c-format
msgid "The number of Newton iterations for calculating the reciprocal for float type.  The precision of division is proportional to this param when division approximation is enabled.  The default value is 1."
msgstr "Ņūtona iterāciju skaits apgrieztās vērtības aprēķināšanai float tipam. Ja ir iespējota dalīšanas aproksimācija, dalīšanas precizitāte ir proporcionāla šim parametram. Noklusējuma vērtība ir 1."

#: config/aarch64/aarch64.opt:384
#, no-c-format
msgid "The number of Newton iterations for calculating the reciprocal for double type.  The precision of division is proportional to this param when division approximation is enabled.  The default value is 2."
msgstr "Ņūtona iterāciju skaits apgrieztās vērtības aprēķināšanai double tipam. Ja ir iespējota dalīšanas aproksimācija, dalīšanas precizitāte ir proporcionāla šim parametram. Noklusējuma vērtība ir 2."

#: config/aarch64/aarch64.opt:388
#, no-c-format
msgid "An old alias for -mautovec-preference.  If both -mautovec-preference and --param=aarch64-autovec-preference are passed, the --param value will be used."
msgstr "Vecs aizstājvārds opcijai -mautovec-preference. Ja ir norādīti gan -mautovec-preference, gan --param=aarch64-autovec-preference, tiks izmantota --param vērtība."

#: config/aarch64/aarch64.opt:414
#, no-c-format
msgid "Constant memcpy size in bytes above which to start using MOPS sequence."
msgstr "Konstants memcpy izmērs baitos, virs kura sākt izmantot MOPS secību."

#: config/aarch64/aarch64.opt:418
#, no-c-format
msgid "Constant memmove size in bytes above which to start using MOPS sequence."
msgstr "Konstants memmove izmērs baitos, virs kura sākt izmantot MOPS secību."

#: config/aarch64/aarch64.opt:422
#, no-c-format
msgid "Constant memset size in bytes from which to start using MOPS sequence."
msgstr "Konstants memset izmērs baitos, no kura sākt izmantot MOPS secību."

#: config/aarch64/aarch64.opt:430
#, no-c-format
msgid "--param=aarch64-ldp-policy=[default|always|never|aligned] Fine-grained policy for load pairs."
msgstr "--param=aarch64-ldp-policy=[default|always|never|aligned] Precīza politika ielādes pāriem."

#: config/aarch64/aarch64.opt:434
#, no-c-format
msgid "--param=aarch64-stp-policy=[default|always|never|aligned] Fine-grained policy for store pairs."
msgstr "--param=aarch64-stp-policy=[default|always|never|aligned] Precīza politika saglabāšanas pāriem."

#: config/aarch64/aarch64.opt:453
#, no-c-format
msgid "Limit on number of alias checks performed when attempting to form an ldp/stp."
msgstr "Ierobežojums pārklāšanās (alias) pārbaužu skaitam, mēģinot izveidot ldp/stp."

#: config/aarch64/aarch64.opt:457
#, no-c-format
msgid "Param to control which writeback opportunities we try to handle in the load/store pair fusion pass.  A value of zero disables writeback handling.  One means we try to form pairs involving one or more existing individual writeback accesses where possible.  A value of two means we also try to opportunistically form writeback opportunities by folding in trailing destructive updates of the base register used by a pair."
msgstr "Parametrs, kas nosaka, kuras atpakaļrakstīšanas (writeback) iespējas mēģināt apstrādāt ielādes/saglabāšanas pāru sapludināšanas gājienā. Vērtība nulle atspējo atpakaļrakstīšanas apstrādi. Viens nozīmē, ka, ja iespējams, tiek mēģināts veidot pārus, kas ietver vienu vai vairākas esošas atsevišķas atpakaļrakstīšanas piekļuves. Vērtība divi nozīmē, ka tiek mēģināts arī oportūnistiski veidot atpakaļrakstīšanas iespējas, iekļaujot pāra bāzes reģistra sekojošos destruktīvos atjauninājumus."

#: config/aarch64/aarch64.opt:466
#, no-c-format
msgid "Param to control the treshold in number of granules beyond which an explicit loop for tagging a memory block is emitted."
msgstr "Parametrs, kas nosaka granulu skaita slieksni, virs kura atmiņas bloka marķēšanai tiek ģenerēts eksplicīts cikls."

#: config/aarch64/aarch64.opt:471
#, no-c-format
msgid "This option is deprecated."
msgstr "Šī opcija ir novecojusi."

#: config/vms/vms.opt:27
#, no-c-format
msgid "Malloc data into P2 space."
msgstr "Izdalīt datus (malloc) P2 telpā."

#: config/vms/vms.opt:31
#, no-c-format
msgid "Set name of main routine for the debugger."
msgstr "Iestatīt galvenās rutīnas nosaukumu atkļūdotājam."

#: config/vms/vms.opt:35
#, no-c-format
msgid "Use VMS exit codes instead of posix ones."
msgstr "Izmantot VMS izejas kodus, nevis POSIX kodus."

#: config/vms/vms.opt:39
#, no-c-format
msgid "-mpointer-size=[no,32,short,64,long]\tSet the default pointer size."
msgstr "-mpointer-size=[no,32,short,64,long]\tIestatīt noklusējuma rādītāja izmēru."

#: config/xtensa/xtensa.opt:26
#, no-c-format
msgid "Use CONST16 instruction to load constants."
msgstr "Izmantot CONST16 instrukciju, lai ielādētu konstantes."

#: config/xtensa/xtensa.opt:30
#, no-c-format
msgid "Disable position-independent code (PIC) for use in OS kernel code."
msgstr "Atspējot no pozīcijas neatkarīgu kodu (PIC), lai to izmantotu OS kodola kodā."

#: config/xtensa/xtensa.opt:34
#, no-c-format
msgid "Use indirect CALLXn instructions for large programs."
msgstr "Lielām programmām izmantot netiešās CALLXn instrukcijas."

#: config/xtensa/xtensa.opt:38
#, no-c-format
msgid "Set extra memory access cost for L32R instruction, in clock-cycle units."
msgstr "Iestatīt papildu atmiņas piekļuves izmaksas L32R instrukcijai takts ciklos."

#: config/xtensa/xtensa.opt:46
#, no-c-format
msgid "Automatically align branch targets to reduce branch penalties."
msgstr "Automātiski izlīdzināt zarošanās mērķus, lai samazinātu zarošanās sodus."

#: config/xtensa/xtensa.opt:50
#, no-c-format
msgid "Intersperse literal pools with code in the text section."
