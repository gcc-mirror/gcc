msgstr "Politikas, kas pieejamas izmantošanai ar -mcompact-branches=:"

#: config/mips/mips.opt:506
#, no-c-format
msgid "Use Loongson MultiMedia extensions Instructions (MMI) instructions."
msgstr "Izmantot Loongson MultiMedia Extensions (MMI) instrukcijas."

#: config/mips/mips.opt:510
#, no-c-format
msgid "Use Loongson EXTension (EXT) instructions."
msgstr "Izmantot Loongson EXTension (EXT) instrukcijas."

#: config/mips/mips.opt:514
#, no-c-format
msgid "Use Loongson EXTension R2 (EXT2) instructions."
msgstr "Izmantot Loongson EXTension R2 (EXT2) instrukcijas."

#: config/mips/mips-tables.opt:24
#, no-c-format
msgid "Known MIPS CPUs (for use with the -march= and -mtune= options):"
msgstr "Zināmie MIPS CPU (izmantošanai ar opcijām -march= un -mtune=):"

#: config/mips/mips-tables.opt:28
#, no-c-format
msgid "Known MIPS ISA levels (for use with the -mips option):"
msgstr "Zināmie MIPS ISA līmeņi (izmantošanai ar opciju -mips):"

#: config/s390/tpf.opt:23
#, no-c-format
msgid "Enable TPF-OS tracing code."
msgstr "Iespējot TPF-OS izsekošanas kodu."

#: config/s390/tpf.opt:29
#, no-c-format
msgid "Set the trace check address for prologue tpf hook"
msgstr "Iestatīt izsekošanas pārbaudes adresi prologa TPF āķim"

#: config/s390/tpf.opt:33
#, no-c-format
msgid "Set the trace jump address for prologue tpf hook"
msgstr "Iestatīt izsekošanas lēciena adresi prologa TPF āķim"

#: config/s390/tpf.opt:37
#, no-c-format
msgid "Set the trace check address for epilogue tpf hook"
msgstr "Iestatīt izsekošanas pārbaudes adresi epiloga TPF āķim"

#: config/s390/tpf.opt:41
#, no-c-format
msgid "Set the trace jump address for epilogue tpf hook"
msgstr "Iestatīt izsekošanas lēciena adresi epiloga TPF āķim"

#: config/s390/tpf.opt:45
#, no-c-format
msgid "Set the prologue and epilogue hook addresses to TPF_TRACE_PROLOGUE_SKIP_TARGET and TPF_TRACE_EPILOGUE_SKIP_TARGET. Equivalent to using -mtpf-trace-hook-prologue-target=TPF_TRACE_PROLOGUE_SKIP_TARGET and -mtpf-trace-hook-epilogue-target=TPF_TRACE_EPILOGUE_SKIP_TARGET"
msgstr "Iestatīt prologa un epiloga āķa adreses uz TPF_TRACE_PROLOGUE_SKIP_TARGET un TPF_TRACE_EPILOGUE_SKIP_TARGET. Tas ir līdzvērtīgi, lietojot -mtpf-trace-hook-prologue-target=TPF_TRACE_PROLOGUE_SKIP_TARGET un -mtpf-trace-hook-epilogue-target=TPF_TRACE_EPILOGUE_SKIP_TARGET"

#: config/s390/tpf.opt:49
#, no-c-format
msgid "Specify main object for TPF-OS."
msgstr "Norādīt galveno objektu TPF-OS."

#: config/s390/s390.opt:48
#, no-c-format
msgid "31 bit ABI."
msgstr "31 bitu ABI."

#: config/s390/s390.opt:52
#, no-c-format
msgid "64 bit ABI."
msgstr "64 bitu ABI."

#: config/s390/s390.opt:135
#, no-c-format
msgid "Maintain backchain pointer."
msgstr "Uzturēt atpakaļķēdes rādītāju."

#: config/s390/s390.opt:139
#, no-c-format
msgid "Additional debug prints."
msgstr "Papildu atkļūdošanas izdrukas."

#: config/s390/s390.opt:143
#, no-c-format
msgid "ESA/390 architecture."
msgstr "ESA/390 arhitektūra."

#: config/s390/s390.opt:147
#, no-c-format
msgid "Enable decimal floating point hardware support."
msgstr "Iespējot decimālā peldošā komata aparatūras atbalstu."

#: config/s390/s390.opt:151
#, no-c-format
msgid "Enable hardware floating point."
msgstr "Iespējot aparatūras peldošo komatu."

#: config/s390/s390.opt:155
#, no-c-format
msgid "Takes two non-negative integer numbers separated by a comma. Prepend the function label with the number of two-byte Nop instructions indicated by the first.  Append Nop instructions covering the number of halfwords indicated by the second after the label.  Nop instructions of the largest possible size are used (six, four or two bytes), beginning with the largest possible size.  Using 0 for both values disables hotpatching."
msgstr "Pieņem divus nenegatīvus veselus skaitļus, kas atdalīti ar komatu. Funkcijas etiķetes priekšā pievieno pirmajā skaitlī norādīto divu baitu Nop instrukciju skaitu. Pēc etiķetes pievieno Nop instrukcijas, kas aptver otrajā skaitlī norādīto pusvārdu skaitu. Tiek izmantotas lielākā iespējamā izmēra Nop instrukcijas (seši, četri vai divi baiti), sākot ar lielāko iespējamo izmēru. Ja abām vērtībām norāda 0, karstā labošana (hotpatching) tiek atspējota."

#: config/s390/s390.opt:173
#, no-c-format
msgid "Use hardware transactional execution instructions."
msgstr "Izmantot aparatūras transakciju izpildes instrukcijas."

#: config/s390/s390.opt:177
#, no-c-format
msgid "Use hardware vector facility instructions and enable the vector ABI."
msgstr "Izmantot aparatūras vektoru iespēju instrukcijas un iespējot vektoru ABI."

#: config/s390/s390.opt:181
#, no-c-format
msgid "Use packed stack layout."
msgstr "Izmantot pakotu steka izkārtojumu."

#: config/s390/s390.opt:185
#, no-c-format
msgid "Use bras for executable < 64k."
msgstr "Izmantot bras izpildāmajam failam < 64k."

#: config/s390/s390.opt:189
#, no-c-format
msgid "Disable hardware floating point."
msgstr "Atspējot aparatūras peldošo komatu."

#: config/s390/s390.opt:193
#, no-c-format
msgid "Set the max. number of bytes which has to be left to stack size before a trap instruction is triggered."
msgstr "Iestatīt maksimālo baitu skaitu, kam jāpaliek līdz steka izmēra robežai, pirms tiek izraisīta slazda instrukcija."

#: config/s390/s390.opt:197
#, no-c-format
msgid "Switches off the -mstack-guard= option."
msgstr "Izslēdz opciju -mstack-guard=."

#: config/s390/s390.opt:215
#, no-c-format
msgid "Generate section __stack_protector_loc containing pointers to all instructions which load the address of the global guard."
msgstr "Ģenerēt sekciju __stack_protector_loc, kas satur rādītājus uz visām instrukcijām, kuras ielādē globālās sargvērtības adresi."

#: config/s390/s390.opt:219
#, no-c-format
msgid "Emit extra code in the function prologue in order to trap if the stack size exceeds the given limit."
msgstr "Izvadīt funkcijas prologā papildu kodu, kas izraisa slazdu, ja steka izmērs pārsniedz norādīto robežu."

#: config/s390/s390.opt:223
#, no-c-format
msgid "Switches off the -mstack-size= option."
msgstr "Izslēdz opciju -mstack-size=."

#: config/s390/s390.opt:231
#, no-c-format
msgid "Use the mvcle instruction for block moves."
msgstr "Izmantot mvcle instrukciju bloku pārvietošanai."

#: config/s390/s390.opt:235
#, no-c-format
msgid "Enable the z vector language extension providing the context-sensitive vector macro and enable the Altivec-style builtins in vecintrin.h."
msgstr "Iespējot z vektoru valodas paplašinājumu, kas nodrošina kontekstjutīgu vektoru makro, un iespējot Altivec stila iebūvētās funkcijas failā vecintrin.h."

#: config/s390/s390.opt:240
#, no-c-format
msgid "Warn if a function uses alloca or creates an array with dynamic size."
msgstr "Brīdināt, ja funkcija izmanto alloca vai izveido masīvu ar dinamisku izmēru."

#: config/s390/s390.opt:244
#, no-c-format
msgid "Warn if a single function's framesize exceeds the given framesize."
msgstr "Brīdināt, ja vienas funkcijas kadra izmērs pārsniedz norādīto kadra izmēru."

#: config/s390/s390.opt:248
#, no-c-format
msgid "z/Architecture."
msgstr "z/Arhitektūra."

#: config/s390/s390.opt:253
#, no-c-format
msgid "Set the branch costs for conditional branch instructions.  Reasonable values are small, non-negative integers.  The default branch cost is 1."
msgstr "Iestatīt zarošanās izmaksas nosacītās zarošanās instrukcijām. Saprātīgas vērtības ir mazi, nenegatīvi veseli skaitļi. Noklusējuma zarošanās izmaksas ir 1."

#: config/s390/s390.opt:264
#, no-c-format
msgid "Wrap all indirect branches into execute in order to disable branch prediction."
msgstr "Ietīt visas netiešās zarošanās instrukcijā execute, lai atspējotu zarošanās prognozēšanu."

#: config/s390/s390.opt:269
#, no-c-format
msgid "Wrap indirect table jumps and computed gotos into execute in order to disable branch prediction.  Using thunk or thunk-extern with this option requires the thunks to be considered signal handlers to order to generate correct CFI.  For environments where unwinding (e.g. for exceptions) is required please use thunk-inline instead."
msgstr "Ietīt netiešos tabulas lēcienus un aprēķinātos goto instrukcijā execute, lai atspējotu zarošanās prognozēšanu. Izmantojot thunk vai thunk-extern ar šo opciju, thunk funkcijas jāuzskata par signālu apstrādātājiem, lai ģenerētu pareizu CFI. Vidēs, kur nepieciešama attīšana (piemēram, izņēmumiem), lūdzu, tā vietā izmantojiet thunk-inline."

#: config/s390/s390.opt:277
#, no-c-format
msgid "Wrap all indirect calls into execute in order to disable branch prediction."
msgstr "Ietīt visus netiešos izsaukumus instrukcijā execute, lai atspējotu zarošanās prognozēšanu."

#: config/s390/s390.opt:281
#, no-c-format
msgid "Wrap all indirect return branches into execute in order to disable branch prediction."
msgstr "Ietīt visas netiešās atgriešanās zarošanās instrukcijā execute, lai atspējotu zarošanās prognozēšanu."

#: config/s390/s390.opt:286
#, no-c-format
msgid "Wrap indirect return branches into execute in order to disable branch prediction. This affects only branches where the return address is going to be restored from memory."
msgstr "Ietīt netiešās atgriešanās zarošanās instrukcijā execute, lai atspējotu zarošanās prognozēšanu. Tas ietekmē tikai zarošanās, kurās atgriešanās adrese tiks atjaunota no atmiņas."

#: config/s390/s390.opt:292
#, no-c-format
msgid "Wrap indirect return branches into execute in order to disable branch prediction. This affects only branches where the return address doesn't need to be restored from memory."
msgstr "Ietīt netiešās atgriešanās zarošanās instrukcijā execute, lai atspējotu zarošanās prognozēšanu. Tas ietekmē tikai zarošanās, kurās atgriešanās adrese nav jāatjauno no atmiņas."

#: config/s390/s390.opt:314
#, no-c-format
msgid "Generate sections .s390_indirect_jump, .s390_indirect_call, .s390_return_reg, and .s390_return_mem to contain the indirect branch locations which have been patched as part of using one of the -mindirect-branch* or -mfunction-return* options.  The sections consist of an array of 32 bit elements. Each entry holds the offset from the entry to the patched location."
msgstr "Ģenerēt sekcijas .s390_indirect_jump, .s390_indirect_call, .s390_return_reg un .s390_return_mem, kas satur netiešo zarošanās vietas, kuras ir ielāpotas, izmantojot kādu no opcijām -mindirect-branch* vai -mfunction-return*. Sekcijas sastāv no 32 bitu elementu masīva. Katrs ieraksts satur nobīdi no ieraksta līdz ielāpotajai vietai."

#: config/s390/s390.opt:323
#, no-c-format
msgid "Emit profiling counter call at function entry before prologue. The compiled code will require a 64-bit CPU and glibc 2.29 or newer to run."
msgstr "Izvadīt profilēšanas skaitītāja izsaukumu funkcijas sākumā pirms prologa. Kompilētā koda izpildei būs nepieciešams 64 bitu CPU un glibc 2.29 vai jaunāka versija."

#: config/s390/s390.opt:328
#, no-c-format
msgid "Generate __mcount_loc section with all _mcount and __fentry__ calls."
msgstr "Ģenerēt __mcount_loc sekciju ar visiem _mcount un __fentry__ izsaukumiem."

#: config/s390/s390.opt:337
#, no-c-format
msgid "Emit fused multiply-add instructions for long doubles in vector registers (wfmaxb, wfmsxb, wfnmaxb, wfnmsxb).  Reassociation pass does not handle fused multiply-adds, therefore code generated by the middle-end is prone to having long fused multiply-add chains.  This is not pipeline-friendly, and the default behavior is to emit separate multiplication and addition instructions for long doubles in vector registers, because measurements show that this improves performance.  This option allows overriding it for testing purposes."
msgstr "Izvadīt sapludinātās reizināšanas-saskaitīšanas instrukcijas long double vērtībām vektoru reģistros (wfmaxb, wfmsxb, wfnmaxb, wfnmsxb). Reasociācijas gājiens neapstrādā sapludinātās reizināšanas-saskaitīšanas, tāpēc vidusdaļas (middle-end) ģenerētajā kodā mēdz veidoties garas sapludināto reizināšanas-saskaitīšanas ķēdes. Tas nav labvēlīgi konveijeram, un pēc noklusējuma long double vērtībām vektoru reģistros tiek izvadītas atsevišķas reizināšanas un saskaitīšanas instrukcijas, jo mērījumi liecina, ka tas uzlabo veiktspēju. Šī opcija ļauj to pārrakstīt testēšanas nolūkos."

#: config/s390/s390.opt:352
#, no-c-format
msgid "Store all argument registers on the stack."
msgstr "Saglabāt visus argumentu reģistrus stekā."

#: config/s390/s390.opt:356
#, no-c-format
msgid "Assume external symbols, whose natural alignment would be 1, to be potentially unaligned.  By default all symbols without explicit alignment are assumed to reside on a 2 byte boundary as mandated by the IBM Z ABI."
msgstr "Pieņemt, ka ārējie simboli, kuru dabiskais izlīdzinājums būtu 1, var būt neizlīdzināti. Pēc noklusējuma tiek pieņemts, ka visi simboli bez eksplicīta izlīdzinājuma atrodas uz 2 baitu robežas, kā to nosaka IBM Z ABI."

#: config/lynx.opt:23
#, no-c-format
msgid "Support legacy multi-threading."
msgstr "Atbalstīt novecojušo daudzpavedienu režīmu."

#: config/lynx.opt:27
#, no-c-format
msgid "Use shared libraries."
msgstr "Izmantot koplietojamās bibliotēkas."

#: config/lynx.opt:31
#, no-c-format
msgid "Support multi-threading."
msgstr "Atbalstīt daudzpavedienu režīmu."

#: config/fr30/fr30.opt:23
#, no-c-format
msgid "Assume small address space."
msgstr "Pieņemt mazu adrešu telpu."

#: config/pdp11/pdp11.opt:23
#, no-c-format
msgid "Generate code for an 11/10."
msgstr "Ģenerēt kodu modelim 11/10."

#: config/pdp11/pdp11.opt:27
#, no-c-format
msgid "Generate code for an 11/40."
msgstr "Ģenerēt kodu modelim 11/40."

#: config/pdp11/pdp11.opt:31
#, no-c-format
msgid "Generate code for an 11/45."
msgstr "Ģenerēt kodu modelim 11/45."

#: config/pdp11/pdp11.opt:35
#, no-c-format
msgid "Return floating-point results in ac0 (fr0 in Unix assembler syntax)."
msgstr "Atgriezt peldošā komata rezultātus ac0 (fr0 Unix asemblera sintaksē)."

#: config/pdp11/pdp11.opt:39
#, no-c-format
msgid "Use the DEC assembler syntax."
msgstr "Izmantot DEC asemblera sintaksi."

#: config/pdp11/pdp11.opt:43
#, no-c-format
msgid "Use the GNU assembler syntax."
msgstr "Izmantot GNU asemblera sintaksi."

#: config/pdp11/pdp11.opt:51
#, no-c-format
msgid "Use 16 bit int."
msgstr "Izmantot 16 bitu int."

#: config/pdp11/pdp11.opt:55
#, no-c-format
msgid "Use 32 bit int."
msgstr "Izmantot 32 bitu int."

#: config/pdp11/pdp11.opt:63
#, no-c-format
msgid "Target has split I&D."
msgstr "Mērķim ir sadalīts I&D."

#: config/pdp11/pdp11.opt:67
#, no-c-format
msgid "Use UNIX assembler syntax."
msgstr "Izmantot UNIX asemblera sintaksi."

#: config/pdp11/pdp11.opt:71
#, no-c-format
msgid "Use LRA register allocator."
msgstr "Izmantot LRA reģistru piešķīrēju."

#: config/or1k/or1k.opt:29
#, no-c-format
msgid "Enable generation of hardware divide (l.div, l.divu) instructions.  This is the default; use -msoft-div to override."
msgstr "Iespējot aparatūras dalīšanas (l.div, l.divu) instrukciju ģenerēšanu. Tas ir noklusējuma iestatījums; lai to atceltu, izmantojiet -msoft-div."

#: config/or1k/or1k.opt:34
#, no-c-format
msgid "Enable generation of binaries which use functions from libgcc to perform divide operations.  The default is -mhard-div."
msgstr "Iespējot tādu bināro failu ģenerēšanu, kas dalīšanas operācijām izmanto libgcc funkcijas. Noklusējums ir -mhard-div."

#: config/or1k/or1k.opt:39
#, no-c-format
msgid "Enable generation of hardware multiply instructions (l.mul, l.muli) instructions. This is the default; use -msoft-mul to override."
msgstr "Iespējot aparatūras reizināšanas instrukciju (l.mul, l.muli) ģenerēšanu. Tas ir noklusējuma iestatījums; lai to atceltu, izmantojiet -msoft-mul."

#: config/or1k/or1k.opt:44
#, no-c-format
msgid "Enable generation of binaries which use functions from libgcc to perform multiply operations. The default is -mhard-mul."
msgstr "Iespējot tādu bināro failu ģenerēšanu, kas reizināšanas operācijām izmanto libgcc funkcijas. Noklusējums ir -mhard-mul."

#: config/or1k/or1k.opt:49
#, no-c-format
msgid "Enable generation of binaries which use functions from libgcc to perform floating point operations.  This is the default; use -mhard-float to override."
msgstr "Iespējot tādu bināro failu ģenerēšanu, kas peldošā komata operācijām izmanto libgcc funkcijas. Tas ir noklusējums; lai to pārrakstītu, izmantojiet -mhard-float."

#: config/or1k/or1k.opt:54
#, no-c-format
msgid "Enable generation of hardware floating point instructions. The default is -msoft-float."
msgstr "Iespējot aparatūras peldošā komata instrukciju ģenerēšanu. Noklusējuma iestatījums ir -msoft-float."

#: config/or1k/or1k.opt:59
#, no-c-format
msgid "When -mhard-float is selected, enables generation of double-precision floating point instructions.  By default functions from libgcc are used to perform double-precision floating point operations."
msgstr "Ja izvēlēta -mhard-float, iespējo dubultās precizitātes peldošā komata instrukciju ģenerēšanu. Pēc noklusējuma dubultās precizitātes peldošā komata operācijām tiek izmantotas libgcc funkcijas."

#: config/or1k/or1k.opt:65
#, no-c-format
msgid "When -mhard-float is selected, enables generation of unordered floating point compare and set flag (lf.sfun*) instructions.  By default functions from libgcc are used to perform unordered floating point compare and set flag operations."
msgstr "Ja izvēlēta -mhard-float, iespējo nesakārtotās peldošā komata salīdzināšanas un karoga iestatīšanas (lf.sfun*) instrukciju ģenerēšanu. Pēc noklusējuma nesakārtotās peldošā komata salīdzināšanas un karoga iestatīšanas operācijām tiek izmantotas libgcc funkcijas."

#: config/or1k/or1k.opt:71
#, no-c-format
msgid "Specify the code model used for accessing memory addresses.  Specifying large enables generating binaries with large global offset tables and calling functions anywhere in an executable.  By default the value is small."
msgstr "Norādīt koda modeli, ko izmanto piekļuvei atmiņas adresēm. Norādot large, var ģenerēt bināros failus ar lielām globālo nobīžu tabulām un izsaukt funkcijas jebkurā izpildāmā faila vietā. Pēc noklusējuma vērtība ir small."

#: config/or1k/or1k.opt:77
#, no-c-format
msgid "Known code model types (for use with the -mcmodel= option):"
msgstr "Zināmie koda modeļu tipi (izmantošanai ar opciju -mcmodel=):"

#: config/or1k/or1k.opt:87
#, no-c-format
msgid "Enable generation of conditional move (l.cmov) instructions.  By default the equivalents are generated using set and branch."
msgstr "Iespējot nosacītās pārvietošanas (l.cmov) instrukciju ģenerēšanu. Pēc noklusējuma ekvivalenti tiek ģenerēti, izmantojot set un branch."

#: config/or1k/or1k.opt:92
#, no-c-format
msgid "Enable generation of rotate right (l.ror) instructions.  By default functions from libgcc are used to perform rotate right operations."
msgstr "Iespējot rotēšanas pa labi (l.ror) instrukciju ģenerēšanu. Pēc noklusējuma rotēšanas pa labi operāciju veikšanai tiek izmantotas funkcijas no libgcc."

#: config/or1k/or1k.opt:97
#, no-c-format
msgid "Enable generation of rotate right with immediate (l.rori) instructions.  By default functions from libgcc are used to perform rotate right with immediate operations."
msgstr "Iespējot rotēšanas pa labi ar tiešo vērtību (l.rori) instrukciju ģenerēšanu. Pēc noklusējuma rotēšanas pa labi ar tiešo vērtību operācijām tiek izmantotas libgcc funkcijas."

#: config/or1k/or1k.opt:103
#, no-c-format
msgid "Enable generation of sign extension (l.ext*) instructions.  By default memory loads are used to perform sign extension."
msgstr "Iespējot zīmes paplašināšanas (l.ext*) instrukciju ģenerēšanu. Pēc noklusējuma zīmes paplašināšanai tiek izmantotas atmiņas ielādes."

#: config/or1k/or1k.opt:108
#, no-c-format
msgid "Enable generation of compare and set flag with immediate (l.sf*i) instructions. By default extra instructions are generated to store the immediate to a register first."
msgstr "Iespējot salīdzināšanas un karoga iestatīšanas ar tiešo vērtību (l.sf*i) instrukciju ģenerēšanu. Pēc noklusējuma tiek ģenerētas papildu instrukcijas, kas vispirms saglabā tiešo vērtību reģistrā."

#: config/or1k/or1k.opt:114
#, no-c-format
msgid "Enable generation of shift with immediate (l.srai, l.srli, l.slli) instructions. By default extra instructions are generated to store the immediate to a register first."
msgstr "Iespējot bīdes ar tiešo vērtību (l.srai, l.srli, l.slli) instrukciju ģenerēšanu. Pēc noklusējuma tiek ģenerētas papildu instrukcijas, kas vispirms saglabā tiešo vērtību reģistrā."

#: config/or1k/elf.opt:28
#, no-c-format
msgid "Configure the newlib board specific runtime.  The default is or1ksim."
msgstr "Konfigurēt newlib platei specifisko izpildlaiku. Noklusējums ir or1ksim."

#: config/or1k/elf.opt:32
#, no-c-format
msgid "This option is ignored; it is provided for compatibility purposes only.  This used to select linker and preprocessor options for use with newlib."
msgstr "Šī opcija tiek ignorēta; tā paredzēta tikai saderībai. Agrāk ar to izvēlējās saistītāja un priekšprocesora opcijas lietošanai ar newlib."

#: config/ia64/ia64.opt:28
#, no-c-format
msgid "Generate big endian code."
