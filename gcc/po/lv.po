msgstr "Piespiest visus izsaukumus veikt, izmantojot jli instrukciju."

#: config/arc/arc.opt:64
#, no-c-format
msgid "-mmpy-option=MPY\tCompile ARCv2 code with a multiplier design option."
msgstr "-mmpy-option=MPY\tKompilēt ARCv2 kodu ar reizinātāja konstrukcijas opciju."

