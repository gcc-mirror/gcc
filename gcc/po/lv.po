msgstr "Ievērot ISO 2020 C++ standartu ar GNU paplašinājumiem."

#: c-family/c.opt:2767
#, no-c-format
msgid "Deprecated in favor of -std=gnu++23."
msgstr "Novecojis; tā vietā izmantojiet -std=gnu++23."

#: c-family/c.opt:2771
#, no-c-format
msgid "Conform to the ISO 2023 C++ standard with GNU extensions (published in 2024; experimental and incomplete support)."
msgstr "Ievērot ISO 2023 C++ standartu ar GNU paplašinājumiem (publicēts 2024. gadā; eksperimentāls un nepilnīgs atbalsts)."

#: c-family/c.opt:2775 c-family/c.opt:2779
#, no-c-format
msgid "Conform to the ISO 2026 C++ draft standard with GNU extensions (experimental and incomplete support)."
msgstr "Ievērot ISO 2026 C++ standarta projektu ar GNU paplašinājumiem (eksperimentāls un nepilnīgs atbalsts)."

#: c-family/c.opt:2783
#, no-c-format
