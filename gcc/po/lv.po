#: gcc.cc:3755
#, c-format
msgid "Usage: %s [options] file...\n"
msgstr "Lietošana: %s [opcijas] fails...\n"

#: gcc.cc:3756
msgid "Options:\n"
msgstr "Opcijas:\n"

#: gcc.cc:3758
msgid "  -pass-exit-codes         Exit with highest error code from a phase.\n"
msgstr "  -pass-exit-codes         Iziet ar augstāko kļūdas kodu no kādas fāzes.\n"

#: gcc.cc:3759
msgid "  --help                   Display this information.\n"
msgstr "  --help                   Parādīt šo informāciju.\n"

#: gcc.cc:3760
msgid "  --target-help            Display target specific command line options (including assembler and linker options).\n"
msgstr "  --target-help            Parādīt mērķim specifiskās komandrindas opcijas (ieskaitot asemblera un saistītāja opcijas).\n"

#: gcc.cc:3762
msgid "  --help={common|optimizers|params|target|warnings|[^]{joined|separate|undocumented}}[,...].\n"
msgstr "  --help={common|optimizers|params|target|warnings|[^]{joined|separate|undocumented}}[,...].\n"

#: gcc.cc:3763
msgid "                           Display specific types of command line options.\n"
msgstr "                           Parādīt noteiktu veidu komandrindas opcijas.\n"

#: gcc.cc:3765
msgid "  (Use '-v --help' to display command line options of sub-processes).\n"
msgstr "  (Izmantojiet '-v --help', lai parādītu apakšprocesu komandrindas opcijas).\n"

#: gcc.cc:3766
msgid "  --version                Display compiler version information.\n"
msgstr "  --version                Parādīt kompilatora versijas informāciju.\n"

#: gcc.cc:3767
msgid "  -dumpspecs               Display all of the built in spec strings.\n"
msgstr "  -dumpspecs               Parādīt visas iebūvētās specs virknes.\n"

#: gcc.cc:3768
msgid "  -dumpversion             Display the version of the compiler.\n"
msgstr "  -dumpversion             Parādīt kompilatora versiju.\n"

#: gcc.cc:3769
msgid "  -dumpmachine             Display the compiler's target processor.\n"
msgstr "  -dumpmachine             Parādīt kompilatora mērķa procesoru.\n"

#: gcc.cc:3770
msgid "  -foffload=<targets>      Specify offloading targets.\n"
msgstr "  -foffload=<targets>      Norādīt pārnešanas (offload) mērķus.\n"

#: gcc.cc:3771
msgid "  -print-search-dirs       Display the directories in the compiler's search path.\n"
msgstr "  -print-search-dirs       Parādīt kompilatora meklēšanas ceļa direktorijas.\n"

#: gcc.cc:3772
msgid "  -print-libgcc-file-name  Display the name of the compiler's companion library.\n"
msgstr "  -print-libgcc-file-name  Parādīt kompilatora pavadbibliotēkas nosaukumu.\n"

#: gcc.cc:3773
msgid "  -print-file-name=<lib>   Display the full path to library <lib>.\n"
msgstr "  -print-file-name=<lib>   Parādīt pilno ceļu līdz bibliotēkai <lib>.\n"

#: gcc.cc:3774
msgid "  -print-prog-name=<prog>  Display the full path to compiler component <prog>.\n"
msgstr ""
"  -print-prog-name=<prog>  Parādīt pilno ceļu līdz kompilatora komponentam\n"
"                           <prog>.\n"

#: gcc.cc:3775
msgid ""
"  -print-multiarch         Display the target's normalized GNU triplet, used as\n"
"                           a component in the library path.\n"
msgstr ""
"  -print-multiarch         Parādīt mērķa normalizēto GNU trijnieku, ko izmanto\n"
"                           kā komponentu bibliotēku ceļā.\n"

#: gcc.cc:3778
msgid "  -print-multi-directory   Display the root directory for versions of libgcc.\n"
msgstr "  -print-multi-directory   Parādīt libgcc versiju saknes direktoriju.\n"

#: gcc.cc:3779
msgid ""
"  -print-multi-lib         Display the mapping between command line options and\n"
"                           multiple library search directories.\n"
msgstr ""
"  -print-multi-lib         Parādīt atbilstību starp komandrindas opcijām un\n"
"                           vairākām bibliotēku meklēšanas direktorijām.\n"

#: gcc.cc:3782
msgid "  -print-multi-os-directory Display the relative path to OS libraries.\n"
msgstr "  -print-multi-os-directory Parādīt relatīvo ceļu līdz OS bibliotēkām.\n"

#: gcc.cc:3783
msgid "  -print-sysroot           Display the target libraries directory.\n"
msgstr "  -print-sysroot           Parādīt mērķa bibliotēku direktoriju.\n"

#: gcc.cc:3784
msgid "  -print-sysroot-headers-suffix Display the sysroot suffix used to find headers.\n"
msgstr ""
"  -print-sysroot-headers-suffix Parādīt sysroot piedēkli, ko izmanto galveņu\n"
"                                meklēšanai.\n"

#: gcc.cc:3785
msgid "  -Wa,<options>            Pass comma-separated <options> on to the assembler.\n"
msgstr "  -Wa,<options>            Nodot ar komatiem atdalītās <options> asemblerim.\n"

#: gcc.cc:3786
msgid "  -Wp,<options>            Pass comma-separated <options> on to the preprocessor.\n"
msgstr "  -Wp,<options>            Nodot ar komatiem atdalītās <options> priekšprocesoram.\n"

#: gcc.cc:3787
msgid "  -Wl,<options>            Pass comma-separated <options> on to the linker.\n"
msgstr "  -Wl,<options>            Nodot ar komatiem atdalītās <options> saistītājam.\n"

#: gcc.cc:3788
msgid "  -Xassembler <arg>        Pass <arg> on to the assembler.\n"
msgstr "  -Xassembler <arg>        Nodot <arg> asemblerim.\n"

#: gcc.cc:3789
msgid "  -Xpreprocessor <arg>     Pass <arg> on to the preprocessor.\n"
msgstr "  -Xpreprocessor <arg>     Nodot <arg> priekšprocesoram.\n"

#: gcc.cc:3790
msgid "  -Xlinker <arg>           Pass <arg> on to the linker.\n"
msgstr "  -Xlinker <arg>           Nodot <arg> saistītājam.\n"

#: gcc.cc:3791
msgid "  -save-temps              Do not delete intermediate files.\n"
msgstr "  -save-temps              Nedzēst starpfailus.\n"

#: gcc.cc:3792
msgid "  -save-temps=<arg>        Do not delete intermediate files.\n"
msgstr "  -save-temps=<arg>        Nedzēst starpfailus.\n"

#: gcc.cc:3793
msgid ""
"  -no-canonical-prefixes   Do not canonicalize paths when building relative\n"
"                           prefixes to other gcc components.\n"
msgstr ""
"  -no-canonical-prefixes   Veidojot relatīvus priedēkļus uz citiem gcc\n"
"                           komponentiem, nekanonizēt ceļus.\n"

#: gcc.cc:3796
msgid "  -pipe                    Use pipes rather than intermediate files.\n"
msgstr "  -pipe                    Izmantot cauruļvadus, nevis starpfailus.\n"

#: gcc.cc:3797
msgid "  -time                    Time the execution of each subprocess.\n"
msgstr "  -time                    Mērīt katra apakšprocesa izpildes laiku.\n"

#: gcc.cc:3798
msgid "  -specs=<file>            Override built-in specs with the contents of <file>.\n"
msgstr "  -specs=<file>            Pārrakstīt iebūvētās specs ar faila <file> saturu.\n"

#: gcc.cc:3799
msgid "  -std=<standard>          Assume that the input sources are for <standard>.\n"
msgstr "  -std=<standard>          Pieņemt, ka ievades pirmkods atbilst <standard>.\n"

#: gcc.cc:3800
msgid ""
"  --sysroot=<directory>    Use <directory> as the root directory for headers\n"
"                           and libraries.\n"
msgstr ""
"  --sysroot=<directory>    Izmantot <directory> kā galveņu un bibliotēku\n"
"                           saknes direktoriju.\n"

#: gcc.cc:3803
msgid "  -B <directory>           Add <directory> to the compiler's search paths.\n"
msgstr "  -B <directory>           Pievienot <directory> kompilatora meklēšanas ceļiem.\n"

#: gcc.cc:3804
msgid "  -v                       Display the programs invoked by the compiler.\n"
msgstr "  -v                       Parādīt kompilatora izsauktās programmas.\n"

#: gcc.cc:3805
msgid "  -###                     Like -v but options quoted and commands not executed.\n"
msgstr ""
"  -###                     Līdzīgi kā -v, bet opcijas tiek pēdiņotas un komandas\n"
"                           netiek izpildītas.\n"

#: gcc.cc:3806
msgid "  -E                       Preprocess only; do not compile, assemble or link.\n"
msgstr ""
"  -E                       Tikai priekšapstrādāt; nekompilēt, neasemblēt un\n"
"                           nesaistīt.\n"

#: gcc.cc:3807
msgid "  -S                       Compile only; do not assemble or link.\n"
msgstr "  -S                       Tikai kompilēt; neasemblēt un nesaistīt.\n"

#: gcc.cc:3808
msgid "  -c                       Compile and assemble, but do not link.\n"
msgstr "  -c                       Kompilēt un asemblēt, bet nesaistīt.\n"

#: gcc.cc:3809
msgid "  -o <file>                Place the output into <file>.\n"
msgstr "  -o <file>                Ievietot izvadi failā <file>.\n"

#: gcc.cc:3810
msgid ""
"  -pie                     Create a dynamically linked position independent\n"
"                           executable.\n"
msgstr ""
"  -pie                     Izveidot dinamiski saistītu, no pozīcijas neatkarīgu\n"
"                           izpildāmo failu.\n"

#: gcc.cc:3812
msgid "  -shared                  Create a shared library.\n"
msgstr "  -shared                  Izveidot koplietojamo bibliotēku.\n"

#: gcc.cc:3813
msgid ""
"  -x <language>            Specify the language of the following input files.\n"
"                           Permissible languages include: c c++ assembler none\n"
"                           'none' means revert to the default behavior of\n"
"                           guessing the language based on the file's extension.\n"
msgstr ""
"  -x <language>            Norādīt turpmāko ievades failu valodu.\n"
"                           Pieļaujamās valodas: c c++ assembler none\n"
"                           'none' nozīmē atgriezties pie noklusējuma uzvedības —\n"
"                           valodas noteikšanas pēc faila paplašinājuma.\n"

#: gcc.cc:3820
#, c-format
msgid ""
"\n"
"Options starting with -g, -f, -m, -O, -W, or --param are automatically\n"
" passed on to the various sub-processes invoked by %s.  In order to pass\n"
" other options on to these processes the -W<letter> options must be used.\n"
msgstr ""
"\n"
"Opcijas, kas sākas ar -g, -f, -m, -O, -W vai --param, tiek automātiski\n"
" nodotas dažādajiem apakšprocesiem, ko izsauc %s.  Lai nodotu\n"
" citas opcijas šiem procesiem, jāizmanto opcijas -W<letter>.\n"

