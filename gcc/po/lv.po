msgstr "Ģenerēt izsaukumu insn kā reģistra netiešos izsaukumus."

#: config/arc/arc.opt:188
#, no-c-format
msgid "Generate BRcc instructions in arc_reorg."
msgstr "Ģenerēt BRcc instrukcijas arc_reorg."

#: config/arc/arc.opt:192
#, no-c-format
msgid "Generate sdata references.  This is the default, unless you compile for PIC."
msgstr "Ģenerēt sdata atsauces. Tas ir noklusējums, ja vien nekompilē PIC."

#: config/arc/arc.opt:196
#, no-c-format
msgid "Generate millicode thunks."
msgstr "Ģenerēt millicode thunk funkcijas."

#: config/arc/arc.opt:200 config/arc/arc.opt:204
