#: cif-code.def:39
msgid "function not considered for inlining"
msgstr "funkcija netiek ņemta vērā iekļaušanai"

#: cif-code.def:43
msgid "caller is not optimized"
msgstr "izsaucējs nav optimizēts"

#: cif-code.def:47
msgid "function body not available"
msgstr "funkcijas ķermenis nav pieejams"

#: cif-code.def:51
msgid "redefined extern inline functions are not considered for inlining"
msgstr "pārdefinētās extern inline funkcijas netiek ņemtas vērā iekļaušanai"

#: cif-code.def:56
msgid "function not inlinable"
msgstr "funkcija nav iekļaujama"

#: cif-code.def:60
msgid "function body can be overwritten at link time"
msgstr "funkcijas ķermeni var pārrakstīt saistīšanas laikā"

#: cif-code.def:64
msgid "function not inline candidate"
msgstr "funkcija nav iekļaušanas kandidāts"

#: cif-code.def:68
msgid "--param large-function-growth limit reached"
msgstr "--param large-function-growth ierobežojums sasniegts"

#: cif-code.def:70
msgid "--param large-stack-frame-growth limit reached"
msgstr "--param large-stack-frame-growth ierobežojums sasniegts"

#: cif-code.def:72
msgid "--param max-inline-insns-single limit reached"
msgstr "--param max-inline-insns-single ierobežojums sasniegts"

#: cif-code.def:74
msgid "--param max-inline-insns-auto limit reached"
msgstr "--param max-inline-insns-auto ierobežojums sasniegts"

#: cif-code.def:76
msgid "--param inline-unit-growth limit reached"
msgstr "--param inline-unit-growth ierobežojums sasniegts"

#: cif-code.def:80
msgid "recursive inlining"
msgstr "rekursīva iekļaušana"

#: cif-code.def:84
msgid "call is unlikely and code size would grow"
msgstr "izsaukums ir maz ticams, un koda izmērs pieaugtu"

#: cif-code.def:88
msgid "call is considered never executed and code size would grow"
msgstr "izsaukums tiek uzskatīts par nekad neizpildītu, un koda izmērs pieaugtu"

#: cif-code.def:92
msgid "function not declared inline and code size would grow"
msgstr "funkcija nav deklarēta kā inline, un koda izmērs pieaugtu"

#: cif-code.def:96
msgid "mismatched declarations during linktime optimization"
msgstr "nesaskaņotas deklarācijas saistīšanas laika optimizācijā"

#: cif-code.def:100
msgid "variadic thunk call"
msgstr "thunk izsaukums ar mainīgu argumentu skaitu"

#: cif-code.def:104
msgid "originally indirect function call not considered for inlining"
msgstr "sākotnēji netiešs funkcijas izsaukums netiek ņemts vērā iekļaušanai"

#: cif-code.def:108
msgid "indirect function call with a yet undetermined callee"
msgstr "netiešs funkcijas izsaukums ar vēl nenoteiktu izsaucamo funkciju"

#: cif-code.def:112
msgid "exception handling personality mismatch"
msgstr "izņēmumu apstrādes personības neatbilstība"

#: cif-code.def:117
msgid "non-call exception handling mismatch"
msgstr "non-call izņēmumu apstrādes neatbilstība"

#: cif-code.def:121
msgid "target specific option mismatch"
msgstr "mērķim specifiskas opcijas neatbilstība"

#: cif-code.def:125
msgid "optimization level attribute mismatch"
msgstr "optimizācijas līmeņa atribūtu neatbilstība"

#: cif-code.def:129
msgid "callee refers to comdat-local symbols"
msgstr "izsaucamā funkcija atsaucas uz comdat-lokāliem simboliem"

#: cif-code.def:134
msgid "sanitizer function attribute mismatch"
msgstr "sanitizatora funkcijas atribūtu neatbilstība"

#: cif-code.def:139
msgid "function has external linkage when the user requests only inlining static for live patching"
msgstr "funkcijai ir ārēja saistīšana, lai gan lietotājs labošanai darbības laikā pieprasa tikai statisku iekļaušanu"

#: cif-code.def:145
msgid "callee must remain in translation unit"
msgstr "izsaucamajai funkcijai jāpaliek translācijas vienībā"

#: cif-code.def:149
msgid "unreachable"
msgstr "nesasniedzams"

#: cif-code.def:154
msgid "callback edges cannot be inlined"
msgstr "atpakaļizsaukuma šķautnes nevar iekļaut"

