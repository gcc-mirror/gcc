msgid "Use %reloc() assembly operators."
msgstr "Izmantot %reloc() asemblera operatorus."

#: config/loongarch/loongarch.opt:263 config/mips/mips.opt:167
#, no-c-format
msgid "Use %reloc() assembly operators (for backward compatibility)."
msgstr "Izmantot %reloc() asemblera operatorus (atpakaļsaderībai)."

#: config/loongarch/loongarch.opt:271
#, no-c-format
msgid "Generate approximate reciprocal divide and square root for better throughput."
msgstr "Ģenerēt aptuvenu apgrieztā skaitļa dalīšanu un kvadrātsakni labākai caurlaidspējai."

#: config/loongarch/loongarch.opt:302
#, no-c-format
msgid "Avoid using the GOT to access external symbols."
msgstr "Izvairīties no GOT izmantošanas, piekļūstot ārējiem simboliem."

#: config/loongarch/loongarch.opt:311
#, no-c-format
msgid "Pass -mrelax or -mno-relax option to the assembler."
msgstr "Nodot asemblerim opciju -mrelax vai -mno-relax."

#: config/loongarch/loongarch.opt:329
#, no-c-format
msgid "Used to limit unroll factor which indicates how much the autovectorizer may unroll a loop.  The default value is 6."
msgstr "Izmanto, lai ierobežotu izvēršanas koeficientu, kas norāda, cik reižu autovektorizētājs drīkst izvērst ciklu. Noklusējuma vērtība ir 6."

#: config/loongarch/loongarch.opt:347
#, no-c-format
msgid "Annotate table jump instruction (jr {reg}) to correlate it with the jump table."
msgstr "Anotēt tabulas lēciena instrukciju (jr {reg}), lai sasaistītu to ar lēcienu tabulu."

#: config/loongarch/loongarch.opt:351
#, no-c-format
msgid "Support frecipe.{s/d} and frsqrte.{s/d} instructions."
msgstr "Atbalstīt frecipe.{s/d} un frsqrte.{s/d} instrukcijas."

#: config/loongarch/loongarch.opt:355
#, no-c-format
msgid "Support div.w[u] and mod.w[u] instructions with inputs not sign-extended."
msgstr "Atbalstīt div.w[u] un mod.w[u] instrukcijas ar ievaddatiem, kuriem nav veikta zīmes paplašināšana."

#: config/loongarch/loongarch.opt:359
#, no-c-format
msgid "Support am{swap/add}[_db].{b/h} instructions."
msgstr "Atbalstīt am{swap/add}[_db].{b/h} instrukcijas."

#: config/loongarch/loongarch.opt:363
#, no-c-format
msgid "Support amcas[_db].{b/h/w/d} instructions."
msgstr "Atbalstīt amcas[_db].{b/h/w/d} instrukcijas."

#: config/loongarch/loongarch.opt:367
#, no-c-format
msgid "Support sc.q instruction."
msgstr "Atbalstīt sc.q instrukciju."

#: config/loongarch/loongarch.opt:371
#, no-c-format
msgid "Do not need load-load barriers (dbar 0x700)."
msgstr "Nav nepieciešamas ielādes-ielādes barjeras (dbar 0x700)."

#: config/epiphany/epiphany.opt:24
#, no-c-format
msgid "Don't use any of r32..r63."
msgstr "Neizmantot nevienu no r32..r63."

#: config/epiphany/epiphany.opt:28
#, no-c-format
msgid "Preferentially allocate registers that allow short instruction generation."
msgstr "Priekšroku dot reģistriem, kas ļauj ģenerēt īsas instrukcijas."

#: config/epiphany/epiphany.opt:32
#, no-c-format
msgid "Set branch cost."
msgstr "Iestatīt zarošanās izmaksas."

#: config/epiphany/epiphany.opt:36
#, no-c-format
msgid "Enable conditional move instruction usage."
msgstr "Iespējot nosacītas pārvietošanas instrukcijas izmantošanu."

#: config/epiphany/epiphany.opt:40
#, no-c-format
msgid "Set number of nops to emit before each insn pattern."
msgstr "Iestatīt nop skaitu, ko izvadīt pirms katra insn šablona."

#: config/epiphany/epiphany.opt:52
#, no-c-format
msgid "Use software floating point comparisons."
msgstr "Izmantot programmatūras peldošā komata salīdzinājumus."

#: config/epiphany/epiphany.opt:56
#, no-c-format
msgid "Enable split of 32 bit immediate loads into low / high part."
msgstr "Iespējot 32 bitu tiešo vērtību ielāžu sadalīšanu zemajā/augstajā daļā."

#: config/epiphany/epiphany.opt:60
#, no-c-format
msgid "Enable use of POST_INC / POST_DEC."
msgstr "Iespējot POST_INC / POST_DEC izmantošanu."

#: config/epiphany/epiphany.opt:64
#, no-c-format
msgid "Enable use of POST_MODIFY."
msgstr "Iespējot POST_MODIFY izmantošanu."

#: config/epiphany/epiphany.opt:68
#, no-c-format
msgid "Set number of bytes on the stack preallocated for use by the callee."
msgstr "Iestatīt baitu skaitu stekā, kas iepriekš rezervēts izsaucamās funkcijas lietošanai."

#: config/epiphany/epiphany.opt:72
#, no-c-format
msgid "Assume round to nearest is selected for purposes of scheduling."
msgstr "Pieņemt, ka plānošanas nolūkā ir izvēlēta noapaļošana uz tuvāko."

#: config/epiphany/epiphany.opt:76
#, no-c-format
msgid "Generate call insns as indirect calls."
msgstr "Ģenerēt izsaukumu insn kā netiešus izsaukumus."

#: config/epiphany/epiphany.opt:80
#, no-c-format
msgid "Generate call insns as direct calls."
msgstr "Ģenerēt izsaukumu insn kā tiešus izsaukumus."

#: config/epiphany/epiphany.opt:84
#, no-c-format
msgid "Assume labels and symbols can be addressed using 16 bit absolute addresses."
msgstr "Pieņemt, ka etiķetes un simbolus var adresēt, izmantojot 16 bitu absolūtās adreses."

#: config/epiphany/epiphany.opt:113
#, no-c-format
msgid "A floating point to integer truncation may be replaced with rounding to save mode switching."
msgstr "Peldošā komata skaitļa nogriešanu līdz veselam skaitlim var aizstāt ar noapaļošanu, lai izvairītos no režīma pārslēgšanas."

#: config/epiphany/epiphany.opt:117
#, no-c-format
msgid "Vectorize for double-word operations."
msgstr "Vektorizēt divvārdu operācijām."

#: config/epiphany/epiphany.opt:133
#, no-c-format
msgid "Split unaligned 8 byte vector moves before post-modify address generation."
msgstr "Sadalīt neizlīdzinātas 8 baitu vektoru pārvietošanas pirms post-modify adrešu ģenerēšanas."

#: config/epiphany/epiphany.opt:137
#, no-c-format
msgid "Use the floating-point unit for integer add/subtract."
msgstr "Saskaitīšanai/atņemšanai ar veseliem skaitļiem izmantot peldošā komata vienību."

#: config/epiphany/epiphany.opt:141
#, no-c-format
msgid "Set register to hold -1."
msgstr "Iestatīt reģistru, kas satur -1."

#: config/darwin.opt:34
#, no-c-format
msgid "Generate code for darwin loadable kernel extensions."
msgstr "Ģenerēt kodu darwin ielādējamiem kodola paplašinājumiem."

#: config/darwin.opt:38 config/darwin.opt:46
#, no-c-format
msgid "Generate compile-time CFString objects."
msgstr "Ģenerēt kompilēšanas laika CFString objektus."

#: config/darwin.opt:42
#, no-c-format
msgid "-iframework <dir>\tAdd <dir> to the end of the system framework include path."
msgstr "-iframework <dir>\tPievienot <dir> sistēmas ietvaru (framework) iekļaušanas ceļa beigām."

#: config/darwin.opt:50
#, no-c-format
msgid "Warn if constant CFString objects contain non-portable characters."
msgstr "Brīdināt, ja konstanti CFString objekti satur nepārnesamas rakstzīmes."

#: config/darwin.opt:55
#, no-c-format
msgid "Generate AT&T-style stubs for Mach-O."
msgstr "Ģenerēt AT&T stila aizbāžņus Mach-O formātam."

#: config/darwin.opt:59
#, no-c-format
msgid "Generate code suitable for executables (NOT shared libs)."
msgstr "Ģenerēt kodu, kas piemērots izpildāmajiem failiem (NEVIS koplietojamām bibliotēkām)."

#: config/darwin.opt:63
#, no-c-format
msgid "Generate code suitable for fast turn around debugging."
msgstr "Ģenerēt kodu, kas piemērots ātram atkļūdošanas ciklam."

#: config/darwin.opt:67
#, no-c-format
msgid "Generate code for the kernel or loadable kernel extensions."
msgstr "Ģenerēt kodu kodolam vai ielādējamiem kodola paplašinājumiem."

#: config/darwin.opt:75
#, no-c-format
msgid "The earliest macOS version on which this program will run."
msgstr "Agrākā macOS versija, kurā darbosies šī programma."

#: config/darwin.opt:80
#, no-c-format
msgid "Set sizeof(bool) to 1."
msgstr "Iestatīt sizeof(bool) uz 1."

#: config/darwin.opt:84
#, no-c-format
msgid "Force generation of external symbol indirection stubs."
msgstr "Piespiest ārējo simbolu netiešās adresācijas aizbāžņu ģenerēšanu."

#: config/darwin.opt:92
#, no-c-format
msgid "-mtarget-linker <version>\tSpecify that ld64 <version> is the toolchain linker for the current invocation."
msgstr "-mtarget-linker <version>\tNorādīt, ka ld64 <version> ir rīkkopas saistītājs pašreizējam izsaukumam."

#: config/darwin.opt:98
#, no-c-format
msgid "Load all members of archive libraries, rather than only those that satisfy undefined symbols."
msgstr "Ielādēt visus arhīva bibliotēku locekļus, nevis tikai tos, kas atrisina nedefinētus simbolus."

#: config/darwin.opt:102
#, no-c-format
msgid "-allowable_client <name>\tThe output dylib is private to the client <name>."
msgstr "-allowable_client <name>\tIzvades dylib ir privāts klientam <name>."

#: config/darwin.opt:106
#, no-c-format
msgid "-arch <name>\tGenerate output for architecture <name>."
msgstr "-arch <name>\tĢenerēt izvadi arhitektūrai <name>."

#: config/darwin.opt:110
#, no-c-format
msgid "Mismatches between file architecture and one specified by \"-arch\" are errors instead of warnings."
msgstr "Neatbilstības starp faila arhitektūru un ar \"-arch\" norādīto arhitektūru ir kļūdas, nevis brīdinājumi."

#: config/darwin.opt:114
#, no-c-format
msgid "The earliest macOS version on which this program will run (formatted for the assembler)."
msgstr "Agrākā macOS versija, kurā darbosies šī programma (formatēta asemblerim)."

#: config/darwin.opt:118
#, no-c-format
msgid "Generate an output executable that binds symbols on load, rather than lazily."
msgstr "Ģenerēt izpildāmo failu, kas saista simbolus ielādes laikā, nevis atliktā (lazy) režīmā."

#: config/darwin.opt:122
#, no-c-format
msgid "Generate a Mach-O bundle (file type MH_BUNDLE)."
msgstr "Ģenerēt Mach-O saišķi (faila tips MH_BUNDLE)."

#: config/darwin.opt:126
#, no-c-format
msgid "-bundle_loader <executable>\tTreat <executable> (that will be loading this bundle) as if it was one of the dynamic libraries the bundle is linked against for symbol resolution."
msgstr "-bundle_loader <executable>\tApstrādāt <executable> (kas ielādēs šo saišķi) tā, it kā tā būtu viena no dinamiskajām bibliotēkām, ar kurām saišķis ir saistīts simbolu atrisināšanai."

#: config/darwin.opt:130
#, no-c-format
msgid "-client_name <name>\tEnable the executable being built to link against a private dylib (using allowable_client)."
msgstr "-client_name <name>\tĻaut būvējamajam izpildāmajam failam saistīties ar privātu dylib (izmantojot allowable_client)."

#: config/darwin.opt:134
#, no-c-format
msgid "-compatibility_version <number>\tSet the version for the client interface.  Client programs must record a value less than or equal to <number>, or the binding will fail at runtime."
msgstr "-compatibility_version <number>\tIestatīt klienta saskarnes versiju. Klientu programmām jāieraksta vērtība, kas ir mazāka par <number> vai vienāda ar to, citādi piesaiste izpildlaikā neizdosies."

#: config/darwin.opt:138
#, no-c-format
msgid "-current_version <number>\tSet the current version for the library to <number>."
msgstr "-current_version <number>\tIestatīt bibliotēkas pašreizējo versiju uz <number>."

#: config/darwin.opt:142
#, no-c-format
msgid "Remove code and data that is unreachable from any exported symbol (including the entry point)."
msgstr "Noņemt kodu un datus, kas nav sasniedzami ne no viena eksportētā simbola (ieskaitot ieejas punktu)."

#: config/darwin.opt:146
#, no-c-format
msgid "-dylib_file install_name:file_name\tThis allows linking of a dylib with \"install_name\" but to be found in a different install position \"file_name\""
msgstr "-dylib_file install_name:file_name\tĻauj saistīt dylib ar \"install_name\", kas atrodama citā instalācijas vietā \"file_name\""

#: config/darwin.opt:150
#, no-c-format
msgid "Produce a Mach-O dylinker (file type MH_DYLINKER), only used for building dyld."
msgstr "Izveidot Mach-O dylinker (faila tips MH_DYLINKER); izmanto tikai dyld būvēšanai."

#: config/darwin.opt:154
#, no-c-format
msgid "-dylinker_install_name <path>\tOnly used for building dyld."
msgstr "-dylinker_install_name <path>\tIzmanto tikai dyld būvēšanai."

#: config/darwin.opt:158
#, no-c-format
msgid "The default (and opposite of -static), implied by user mode executables, shared libraries and bundles."
msgstr "Noklusējums (pretējs -static), ko netieši nosaka lietotāja režīma izpildāmie faili, koplietojamās bibliotēkas un saišķi."

#: config/darwin.opt:162
#, no-c-format
msgid "Produce a Mach-O shared library (file type MH_DYLIB), synonym for \"-shared\"."
msgstr "Izveidot Mach-O koplietojamo bibliotēku (faila tips MH_DYLIB); sinonīms \"-shared\"."

#: config/darwin.opt:166
#, no-c-format
msgid "-exported_symbols_list <filename>\tExport global symbols in <filename> in linked output file; any symbols not mentioned will be treated as \"hidden\"."
msgstr "-exported_symbols_list <filename>\tEksportēt failā <filename> norādītos globālos simbolus saistītajā izvades failā; visi neminētie simboli tiks uzskatīti par \"hidden\"."

#: config/darwin.opt:170
#, no-c-format
msgid "Supply a list of objects to be linked from a file, rather than the command line."
msgstr "Norādīt saistāmo objektu sarakstu failā, nevis komandrindā."

#: config/darwin.opt:175 config/darwin.opt:196
#, no-c-format
msgid "Used for generating code for some older kernel revisions."
msgstr "Izmanto koda ģenerēšanai dažām vecākām kodola versijām."

#: config/darwin.opt:179
#, no-c-format
msgid "Ignore the normal two-level namespace; resolve symbols in command line order and do not record which library provided the resolved symbol."
msgstr "Ignorēt parasto divlīmeņu nosaukumvietu; atrisināt simbolus komandrindas secībā un nereģistrēt, kura bibliotēka nodrošināja atrisināto simbolu."

#: config/darwin.opt:183
#, no-c-format
msgid "For the assembler (and linker) permit any architecture sub-variant to be used without error."
msgstr "Asemblerim (un saistītājam) atļaut bez kļūdām izmantot jebkuru arhitektūras apakšvariantu."

#: config/darwin.opt:187
#, no-c-format
msgid "Set the output object such that, on loading, dyld will ignore any two-level namespace information and resolve symbols in the discovery order for loaded libs."
msgstr "Iestatīt izvades objektu tā, lai ielādes laikā dyld ignorētu jebkādu divlīmeņu nosaukumvietas informāciju un atrisinātu simbolus ielādēto bibliotēku atklāšanas secībā."

#: config/darwin.opt:191
#, no-c-format
msgid "-framework <name>\tThe linker should search for the framework <name> in the framework search path."
msgstr "-framework <name>\tSaistītājam jāmeklē ietvars <name> ietvaru meklēšanas ceļā."

#: config/darwin.opt:200
#, no-c-format
msgid "Abbreviation for \"-g -fno-eliminate-unused-debug-symbols\"."
msgstr "Saīsinājums opcijām \"-g -fno-eliminate-unused-debug-symbols\"."

#: config/darwin.opt:204
#, no-c-format
msgid "Abbreviation for \"-g -feliminate-unused-debug-symbols\"."
msgstr "Saīsinājums opcijām \"-g -feliminate-unused-debug-symbols\"."

#: config/darwin.opt:208
#, no-c-format
msgid "Automatically adds space for longer path names in load commands (up to MAXPATHLEN)."
msgstr "Automātiski pievieno vietu garākiem ceļu nosaukumiem ielādes komandās (līdz MAXPATHLEN)."

#: config/darwin.opt:212
#, no-c-format
msgid "-image_base <address>\tSpecify <address> as the base address for a dylib or bundle."
msgstr "-image_base <address>\tNorādīt <address> kā dylib vai saišķa bāzes adresi."

#: config/darwin.opt:216
#, no-c-format
msgid "-init <symbol_name>\tThe symbol <symbol_name> will be used as the first initializer for a dylib."
msgstr "-init <symbol_name>\tSimbols <symbol_name> tiks izmantots kā pirmais dylib inicializators."

#: config/darwin.opt:220
#, no-c-format
msgid "-install_name <name>\tSet the install name for a dylib."
msgstr "-install_name <name>\tIestatīt dylib instalācijas nosaukumu."

#: config/darwin.opt:224
#, no-c-format
msgid "Usually \"private extern\" (hidden) symbols are made local when linking, this command suppresses that such that they remain exported."
msgstr "Parasti \"private extern\" (slēptie) simboli saistīšanas laikā tiek padarīti lokāli; šī komanda to novērš, lai tie paliktu eksportēti."

#: config/darwin.opt:228
#, no-c-format
msgid "(Obsolete after 10.4) Multi modules are ignored at runtime since macOS 10.4."
msgstr "(Novecojis pēc 10.4) Kopš macOS 10.4 vairākmoduļi izpildlaikā tiek ignorēti."

#: config/darwin.opt:232
#, no-c-format
msgid "(Obsolete after 10.4) -multiply_defined <treatment>\tProvided a mechanism for warning about symbols defined in multiple dylibs."
msgstr "(Novecojis pēc 10.4) -multiply_defined <treatment>\tNodrošināja mehānismu brīdināšanai par simboliem, kas definēti vairākās dylib."

#: config/darwin.opt:236
#, no-c-format
msgid "(Obsolete after 10.4) -multiply_defined_unused <treatment>\tProvided a mechanism for warning about symbols defined in the current executable also being defined in linked dylibs."
msgstr "(Novecojis pēc 10.4) -multiply_defined_unused <treatment>\tNodrošināja mehānismu brīdināšanai par pašreizējā izpildāmajā failā definētiem simboliem, kas definēti arī saistītajās dylib."

#: config/darwin.opt:240
#, no-c-format
msgid "(Obsolete) Current linkers never dead-strip these items, so the option is not needed."
msgstr "(Novecojis) Pašreizējie saistītāji šos elementus nekad neizmet (dead-strip), tāpēc opcija nav nepieciešama."

#: config/darwin.opt:244
#, no-c-format
msgid "Do not add a default symbol exports to modules or dynamic libraries."
msgstr "Nepievienot moduļiem vai dinamiskajām bibliotēkām noklusējuma simbolu eksportus."

#: config/darwin.opt:248
#, no-c-format
msgid "Do not add default run paths (for the compiler library directories) to executables, modules or dynamic libraries."
msgstr "Nepievienot izpildāmajiem failiem, moduļiem vai dinamiskajām bibliotēkām noklusējuma izpildes ceļus (kompilatora bibliotēku direktorijām)."

#: config/darwin.opt:252
#, no-c-format
msgid "(Obsolete after 10.3.9) Set MH_NOPREFIXBINDING, in an executable."
msgstr "(Novecojis pēc 10.3.9) Iestatīt MH_NOPREFIXBINDING izpildāmajā failā."

#: config/darwin.opt:256
#, no-c-format
msgid "(Obsolete after 10.4)\tSet MH_NOMULTIDEFS in an umbrella framework."
msgstr "(Novecojis pēc 10.4)\tIestatīt MH_NOMULTIDEFS jumta ietvarā (umbrella framework)."

#: config/darwin.opt:260 config/darwin.opt:286 config/darwin.opt:290
#, no-c-format
msgid "(Obsolete) LD_PREBIND is no longer supported."
msgstr "(Novecojis) LD_PREBIND vairs netiek atbalstīts."

#: config/darwin.opt:264
#, no-c-format
msgid "(Obsolete) This is the default."
msgstr "(Novecojis) Tas ir noklusējums."

#: config/darwin.opt:268
#, no-c-format
msgid "Equivalent to -xobjective-c."
msgstr "Ekvivalents -xobjective-c."

#: config/darwin.opt:272
#, no-c-format
msgid "Equivalent to -xobjective-c++."
msgstr "Ekvivalents -xobjective-c++."

#: config/darwin.opt:282
#, no-c-format
msgid "-pagezero_size <size>\tAllows setting the page 0 size to 4kb when required."
msgstr "-pagezero_size <size>\tVajadzības gadījumā ļauj iestatīt lapas 0 izmēru uz 4 kb."

#: config/darwin.opt:294
#, no-c-format
msgid "Produces a Mach-O file suitable for embedded/ROM use."
msgstr "Izveidot Mach-O failu, kas piemērots iegultai/ROM lietošanai."

#: config/darwin.opt:298
#, no-c-format
msgid "(Obsolete) Allowed linking to proceed with \"-flat_namespace\" when a linked bundle contained a symbol also exported from the main executable."
msgstr "(Novecojis) Ļāva turpināt saistīšanu ar \"-flat_namespace\", ja saistītajā saišķī bija simbols, kas eksportēts arī no galvenā izpildāmā faila."

#: config/darwin.opt:305
#, no-c-format
msgid "Synonym for \"-export-dynamic\" for linker versions that support it."
msgstr "Sinonīms \"-export-dynamic\" saistītāja versijām, kas to atbalsta."

#: config/darwin.opt:309
#, no-c-format
msgid "-read_only_relocs <treatment>\tAllow relocations in read-only pages (not recommended)."
msgstr "-read_only_relocs <treatment>\tAtļaut relokācijas tikai lasāmās lapās (nav ieteicams)."

#: config/darwin.opt:313
#, no-c-format
msgid "-sectalign <segname> <sectname> <value>\tSet section <sectname> in segment <segname> to have alignment <value> which must be an integral power of two expressed in hexadecimal form."
msgstr "-sectalign <segname> <sectname> <value>\tIestatīt sekcijai <sectname> segmentā <segname> izlīdzinājumu <value>, kam jābūt divnieka pakāpei, izteiktai heksadecimālā formā."

#: config/darwin.opt:317
#, no-c-format
msgid "-sectcreate <segname> <sectname> <file>\tCreate section <sectname> in segment <segname> from the contents of <file>."
msgstr "-sectcreate <segname> <sectname> <file>\tIzveidot sekciju <sectname> segmentā <segname> no faila <file> satura."

#: config/darwin.opt:321
#, no-c-format
msgid "(Obsolete) -sectobjectsymbols <segname> <sectname>\tSetting a local symbol at the start of a section is no longer supported."
msgstr "(Novecojis) -sectobjectsymbols <segname> <sectname>\tLokāla simbola iestatīšana sekcijas sākumā vairs netiek atbalstīta."

#: config/darwin.opt:325
#, no-c-format
msgid "(Obsolete) -sectorder <segname> <sectname> <orderfile>\tReplaced by a more general option \"-order_file\"."
msgstr "(Novecojis) -sectorder <segname> <sectname> <orderfile>\tAizstāts ar vispārīgāku opciju \"-order_file\"."

#: config/darwin.opt:329
#, no-c-format
msgid "-seg_addr_table <file>\tSpecify the base addresses for dynamic libraries; <file> contains a line for each library."
msgstr "-seg_addr_table <file>\tNorādīt dinamisko bibliotēku bāzes adreses; <file> satur vienu rindu katrai bibliotēkai."

#: config/darwin.opt:334
#, no-c-format
msgid "(Obsolete, ld_classic only) -seg_addr_table_filename <path>."
msgstr "(Novecojis, tikai ld_classic) -seg_addr_table_filename <path>."

#: config/darwin.opt:338
#, no-c-format
msgid "Synonym for \"image_base\"."
msgstr "\"image_base\" sinonīms."

#: config/darwin.opt:342
#, no-c-format
msgid "-segaddr <name> <address>\tSet the base address of segment <name> to <address> which must be aligned to a page boundary (currently 4kb)."
msgstr "-segaddr <name> <address>\tIestatīt segmenta <name> bāzes adresi uz <address>, kurai jābūt izlīdzinātai uz lapas robežu (pašlaik 4 kb)."

#: config/darwin.opt:347
#, no-c-format
msgid "(Obsolete, ld_classic only) -sectcreate <segname> <sectname> <file>\tAllowed creation of a section from a file."
msgstr "(Novecojis, tikai ld_classic) -sectcreate <segname> <sectname> <file>\tĻāva izveidot sekciju no faila."

#: config/darwin.opt:351
#, no-c-format
msgid "(Obsolete) Object files with LINKEDIT sections are no longer supported."
msgstr "(Novecojis) Objektfaili ar LINKEDIT sekcijām vairs netiek atbalstīti."

#: config/darwin.opt:355
#, no-c-format
msgid "-segprot <segname> <max_prot> <init_prot>\tThe virtual memory protections for segment <segname> have maximum and initial values <max_prot> and <init_prot> respectively.  The specified values may contain \"r\", \"w\", \"x\" or \"-\" the latter meaning \"no access\"."
msgstr "-segprot <segname> <max_prot> <init_prot>\tSegmenta <segname> virtuālās atmiņas aizsardzībām ir attiecīgi maksimālās un sākotnējās vērtības <max_prot> un <init_prot>.  Norādītās vērtības var saturēt \"r\", \"w\", \"x\" vai \"-\"; pēdējais nozīmē \"nav piekļuves\"."

#: config/darwin.opt:359
#, no-c-format
msgid "-segs_read_only_addr <address>\tSpecify that <address> is the base address of the read-only segments of a dylib."
msgstr "-segs_read_only_addr <address>\tNorādīt, ka <address> ir dylib tikai lasāmo segmentu bāzes adrese."

#: config/darwin.opt:363
#, no-c-format
msgid "-segs_read_write_addr <address>\tSpecify that <address> is the base address address of the read-write segments of a dylib."
msgstr "-segs_read_write_addr <address>\tNorādīt, ka <address> ir dylib lasāmo un rakstāmo segmentu bāzes adrese."

#: config/darwin.opt:367
#, no-c-format
msgid "(Obsolete)\tThis is the default."
msgstr "(Novecojis)\tTas ir noklusējums."

#: config/darwin.opt:371
#, no-c-format
msgid "-sub_library <name>\tLibrary named <name> will be re-exported (only useful for dylibs)."
msgstr "-sub_library <name>\tBibliotēka ar nosaukumu <name> tiks atkārtoti eksportēta (noderīga tikai dylib)."

#: config/darwin.opt:375
#, no-c-format
msgid "-sub_umbrella <name>\tFramework named <name> will be re-exported (only useful for dylibs)."
msgstr "-sub_umbrella <name>\tIetvars ar nosaukumu <name> tiks atkārtoti eksportēts (noderīgs tikai dylib)."

#: config/darwin.opt:379
#, no-c-format
msgid "This is the default."
msgstr "Tas ir noklusējums."

#: config/darwin.opt:383
#, no-c-format
msgid "Add extra information to the executable that can speed up dynamic loading (provided that dependent libraries are unchanged)."
msgstr "Pievienot izpildāmajam failam papildu informāciju, kas var paātrināt dinamisko ielādi (ar nosacījumu, ka atkarīgās bibliotēkas nav mainītas)."

#: config/darwin.opt:387
#, no-c-format
msgid "-umbrella <framework>\tThe specified framework will be re-exported."
msgstr "-umbrella <framework>\tNorādītais ietvars tiks atkārtoti eksportēts."

#: config/darwin.opt:391
#, no-c-format
msgid "-undefined <treatment>\tSpecify the handling for undefined symbols (default is error)."
msgstr "-undefined <treatment>\tNorādīt, kā apstrādāt nedefinētus simbolus (noklusējums ir error)."

#: config/darwin.opt:395
#, no-c-format
msgid "-unexported_symbols_list <filename>\tDo not export the global symbols listed in <filename>."
msgstr "-unexported_symbols_list <filename>\tNeeksportēt failā <filename> uzskaitītos globālos simbolus."

#: config/darwin.opt:399
#, no-c-format
msgid "-weak_framework <framework>\tMake a weak link to the specified framework."
msgstr "-weak_framework <framework>\tIzveidot vāju saiti uz norādīto ietvaru."

#: config/darwin.opt:403
#, no-c-format
msgid "-weak_reference_mismatches <treatment>\tSpecifies what to do if a symbol import conflicts between file (weak in one and not in another) the default is to treat the symbol as non-weak."
msgstr "-weak_reference_mismatches <treatment>\tNorāda, ko darīt, ja simbola imports konfliktē starp failiem (vienā failā ir vājš, bet citā nav); pēc noklusējuma simbols tiek uzskatīts par nevāju."

#: config/darwin.opt:407
#, no-c-format
msgid "Logs which object files the linker loads."
msgstr "Reģistrē, kurus objektfailus ielādē saistītājs."

#: config/darwin.opt:411
#, no-c-format
msgid "Logs which symbol(s) caused an object to be loaded."
msgstr "Reģistrē, kurš(-i) simbols(-i) izraisīja objekta ielādēšanu."

#: config/darwin.opt:419
#, no-c-format
msgid "(Obsolete, ignored)\tOld support similar to \"-whyload\"."
msgstr "(Novecojis, ignorēts)\tVecais atbalsts, līdzīgs \"-whyload\"."

#: config/darwin.opt:423
