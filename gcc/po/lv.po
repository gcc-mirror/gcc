msgstr "Kompilēt ETRAX 4 (CRIS v3) procesoram."

#: config/cris/cris.opt:56
#, no-c-format
msgid "Compile for ETRAX 100 (CRIS v8)."
msgstr "Kompilēt ETRAX 100 (CRIS v8) procesoram."

#: config/cris/cris.opt:64
