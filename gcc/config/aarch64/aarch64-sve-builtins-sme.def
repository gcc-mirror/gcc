DEF_SME_ZA_FUNCTION (svmopa, binary_za_m, d_za, za_m)
DEF_SME_ZA_FUNCTION (svmops, binary_za_m, mop_base, za_m)
DEF_SME_ZA_FUNCTION (svmops, binary_za_m, d_za, za_m)
