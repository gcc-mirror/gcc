DEF_NEON_FUNCTION (vqaddq, all_integer, ("Q0,Q0,Q0"))
DEF_NEON_FUNCTION (vqsubb, b_integer,   ("s0,s0,s0"))
DEF_NEON_FUNCTION (vqsubh, h_integer,   ("s0,s0,s0"))
DEF_NEON_FUNCTION (vqsubs, s_integer,   ("s0,s0,s0"))
DEF_NEON_FUNCTION (vqsubd, d_integer,   ("s0,s0,s0"))
