DEF_NEON_FUNCTION (vmaxvq,   bhs_integer,          ("s0,Q0"))
DEF_NEON_FUNCTION (vminv,    bhs_integer,          ("s0,D0"))
DEF_NEON_FUNCTION (vminvq,   bhs_integer,          ("s0,Q0"))
DEF_NEON_FUNCTION (vmaxnmv,  s_float,              ("s0,D0"))
DEF_NEON_FUNCTION (vmaxnmvq, sd_float,             ("s0,Q0"))
DEF_NEON_FUNCTION (vminnmv,  s_float,              ("s0,D0"))
DEF_NEON_FUNCTION (vminnmvq, sd_float,             ("s0,Q0"))
