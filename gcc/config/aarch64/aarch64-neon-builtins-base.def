DEF_NEON_FUNCTION (vcntq, b_neon,      ("Q0,Q0"))
#undef REQUIRED_EXTENSIONS

// Permutations
#define REQUIRED_EXTENSIONS nonstreaming_only (AARCH64_FL_SIMD)
DEF_NEON_FUNCTION (vext,    bhsd_neon,  ("D0,D0,D0,ss32", lane<2>))
DEF_NEON_FUNCTION (vextq,   bhsd_neon,  ("Q0,Q0,Q0,ss32", lane<2>))
DEF_NEON_FUNCTION (vrev16,  neon_rev16, ("D0,D0"))
DEF_NEON_FUNCTION (vrev16q, neon_rev16, ("Q0,Q0"))
DEF_NEON_FUNCTION (vrev32,  neon_rev32, ("D0,D0"))
DEF_NEON_FUNCTION (vrev32q, neon_rev32, ("Q0,Q0"))
DEF_NEON_FUNCTION (vrev64,  neon_rev64, ("D0,D0"))
DEF_NEON_FUNCTION (vrev64q, neon_rev64, ("Q0,Q0"))
DEF_NEON_FUNCTION (vtrn,    bhs_neon,   ("D0x2,D0,D0"))
DEF_NEON_FUNCTION (vtrn1,   bhs_neon,   ("D0,D0,D0"))
DEF_NEON_FUNCTION (vtrn1q,  bhsd_neon,  ("Q0,Q0,Q0"))
DEF_NEON_FUNCTION (vtrn2,   bhs_neon,   ("D0,D0,D0"))
DEF_NEON_FUNCTION (vtrn2q,  bhsd_neon,  ("Q0,Q0,Q0"))
DEF_NEON_FUNCTION (vtrnq,   bhs_neon,   ("Q0x2,Q0,Q0"))
DEF_NEON_FUNCTION (vuzp,    bhs_neon,   ("D0x2,D0,D0"))
DEF_NEON_FUNCTION (vuzp1,   bhs_neon,   ("D0,D0,D0"))
DEF_NEON_FUNCTION (vuzp1q,  bhsd_neon,  ("Q0,Q0,Q0"))
DEF_NEON_FUNCTION (vuzp2,   bhs_neon,   ("D0,D0,D0"))
DEF_NEON_FUNCTION (vuzp2q,  bhsd_neon,  ("Q0,Q0,Q0"))
DEF_NEON_FUNCTION (vuzpq,   bhs_neon,   ("Q0x2,Q0,Q0"))
DEF_NEON_FUNCTION (vzip,    bhs_neon,   ("D0x2,D0,D0"))
DEF_NEON_FUNCTION (vzip1,   bhs_neon,   ("D0,D0,D0"))
DEF_NEON_FUNCTION (vzip1q,  bhsd_neon,  ("Q0,Q0,Q0"))
DEF_NEON_FUNCTION (vzip2,   bhs_neon,   ("D0,D0,D0"))
DEF_NEON_FUNCTION (vzip2q,  bhsd_neon,  ("Q0,Q0,Q0"))
DEF_NEON_FUNCTION (vzipq,   bhs_neon,   ("Q0x2,Q0,Q0"))
#undef REQUIRED_EXTENSIONS

