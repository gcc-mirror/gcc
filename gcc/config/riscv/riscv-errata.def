/* Before using #include to read this file, define a macro:

      RISCV_ERRATUM(ID, NAME, VAR)

   ID is the identifier of the erratum, RISCV_ERRATUM_<ID> is its index.
   NAME is the name of the erratum, represented as a string, as used by
   -mfix-NAME and --with-errata.
   VAR is the variable of the -mfix-NAME option, which is -1 if the option
   is not given.

   Every erratum needs a -mfix-NAME option in riscv.opt.  The cores that
   have the erratum are listed in riscv-cores.def with RISCV_CORE_ERRATUM.

   An erratum that has more than one name can also use:

      RISCV_ERRATUM_ALIAS(ALIAS, ID)

   ALIAS is the other name, represented as a string, as used by
   --with-errata.  Its -mfix-ALIAS option is an Alias of -mfix-NAME in
   riscv.opt.  */

#ifndef RISCV_ERRATUM_ALIAS
#define RISCV_ERRATUM_ALIAS(ALIAS, ID)
#endif

RISCV_ERRATUM(SIFIVE_MAL_9174, "sifive-mal-9174", riscv_fix_sifive_mal_9174)
RISCV_ERRATUM_ALIAS("sifive-mal-9191", SIFIVE_MAL_9174)

#undef RISCV_ERRATUM
#undef RISCV_ERRATUM_ALIAS
