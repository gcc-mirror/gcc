begin short short bits a
            = short short 10r256; { dg-error "denotation is too large for short short bits" }
      short bits b
            = short 16rffff1; { dg-error "denotation is too large for short bits" }
      bits c
           = 16rffffffff1; { dg-error "denotation is too large for bits" }
      long bits d
           = long 16rffffffffffffffff1; { dg-error "denotation is too large for long bits" }

      skip
end
